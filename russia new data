Private Function GetMergedValue(ByVal cell As Range) As Variant
    If cell.MergeCells Then
        GetMergedValue = cell.MergeArea.Cells(1, 1).Value
    Else
        GetMergedValue = cell.Value
    End If
End Function

Private Function NormalizeKey(ByVal s As String) As String
    Dim t As String
    t = LCase$(Trim(CStr(s)))
    t = Replace(t, vbCrLf, " ")
    t = Replace(t, vbCr, " ")
    t = Replace(t, vbLf, " ")
    t = Replace(t, ChrW(160), " ")
    Do While InStr(t, "  ") > 0
        t = Replace(t, "  ", " ")
    Loop
    NormalizeKey = t
End Function

Private Function AppendNewDestRow(ByVal ws As Worksheet, ByVal hdrRow As Long, ByVal colAnchor As Long) As Long
    Dim outRow As Long
    outRow = ws.Cells(ws.Rows.Count, colAnchor).End(xlUp).Row + 1
    If outRow <= hdrRow Then outRow = hdrRow + 1
    AppendNewDestRow = outRow
End Function

Private Sub WriteDateSmart(ByVal targetCell As Range, ByVal v As Variant)
    If targetCell Is Nothing Then Exit Sub
    If Len(Trim(CStr(v))) = 0 Then
        targetCell.Value = ""
    ElseIf IsDate(v) Then
        targetCell.Value = CDate(v)
    Else
        targetCell.Value = CStr(v)
    End If
End Sub

'============================================================
' MEANINGFUL SNIPPET
'============================================================
Private Function MakeMeaningfulSnippetPhrase(ByVal questionText As String, ByVal minWords As Long, ByVal maxWords As Long) As String
    Dim cleaned As String
    cleaned = CleanForTokenize(questionText)
    If Len(cleaned) = 0 Then MakeMeaningfulSnippetPhrase = "": Exit Function

    Dim parts() As String
    parts = Split(cleaned, " ")

    Dim out As String: out = ""
    Dim i As Long, count As Long
    count = 0

    For i = LBound(parts) To UBound(parts)
        Dim w As String
        w = Trim(parts(i))
        If Len(w) = 0 Then GoTo NextI
        If LCase$(w) = "the" Or LCase$(w) = "and" Or LCase$(w) = "of" Or LCase$(w) = "to" Then GoTo NextI
        If Len(w) <= 2 Then GoTo NextI

        count = count + 1
        If out = "" Then out = w Else out = out & " " & w
        If count >= maxWords Then Exit For

NextI:
    Next i

    If count < minWords Then
        MakeMeaningfulSnippetPhrase = Left$(cleaned, 60)
    Else
        MakeMeaningfulSnippetPhrase = ProperWords(out)
    End If
End Function

Private Function CleanForTokenize(ByVal s As String) As String
    Dim t As String
    t = Trim(CStr(s))
    If Len(t) = 0 Then CleanForTokenize = "": Exit Function

    t = Replace(t, vbCrLf, " ")
    t = Replace(t, vbCr, " ")
    t = Replace(t, vbLf, " ")

    Dim ch As Variant
    For Each ch In Array("?", ".", ",", ";", ":", "(", ")", "[", "]", "{", "}", """", "'", "/", "\")
        t = Replace(t, CStr(ch), " ")
    Next ch

    Do While InStr(t, "  ") > 0
        t = Replace(t, "  ", " ")
    Loop

    CleanForTokenize = Trim(t)
End Function

Private Function ProperWords(ByVal s As String) As String
    Dim parts() As String, i As Long
    s = Trim(s)
    If Len(s) = 0 Then ProperWords = "": Exit Function
    parts = Split(LCase$(s), " ")
    For i = LBound(parts) To UBound(parts)
        If Len(parts(i)) > 0 Then parts(i) = UCase$(Left$(parts(i), 1)) & Mid$(parts(i), 2)
    Next i
    ProperWords = Join(parts, " ")
End Function

