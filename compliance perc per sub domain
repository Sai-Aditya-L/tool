Option Explicit

Public Sub Build_App_Compliance_Summary()
    Dim wsSrc As Worksheet, wsOut As Worksheet
    Dim lastRow As Long, lastCol As Long
    Dim r As Long, c As Long
    Dim appName As String, val As String
    Dim key As Variant

    '--- CONFIG (adjust if your layout changes)
    Const SRC_SHEET As String = "Combined Metrics"
    Const OUT_SHEET As String = "App Compliance Summary"
    Const COL_APP As Long = 2          'Column B
    Const FIRST_POLICY_COL As Long = 5 'Column E
    Const LAST_POLICY_COL As Long = 15 'Column O
    Const HEADER_ROW As Long = 1
    Const FIRST_DATA_ROW As Long = 2

    Set wsSrc = ThisWorkbook.Worksheets(SRC_SHEET)

    'Create or clear output sheet
    On Error Resume Next
    Set wsOut = ThisWorkbook.Worksheets(OUT_SHEET)
    On Error GoTo 0

    If wsOut Is Nothing Then
        Set wsOut = ThisWorkbook.Worksheets.Add(After:=wsSrc)
        wsOut.Name = OUT_SHEET
    Else
        wsOut.Cells.Clear
    End If

    'Find last row based on App column
    lastRow = wsSrc.Cells(wsSrc.Rows.Count, COL_APP).End(xlUp).Row
    If lastRow < FIRST_DATA_ROW Then
        MsgBox "No data found under Application/SiteName (Column B).", vbExclamation
        Exit Sub
    End If

    'Dictionaries for counts
    Dim dictY As Object, dictN As Object
    Set dictY = CreateObject("Scripting.Dictionary")
    Set dictN = CreateObject("Scripting.Dictionary")

    'Loop through rows/apps and count Y/N across policy columns
    For r = FIRST_DATA_ROW To lastRow
        appName = Trim$(CStr(wsSrc.Cells(r, COL_APP).Value))
        If Len(appName) > 0 Then

            If Not dictY.Exists(appName) Then
                dictY(appName) = 0
                dictN(appName) = 0
            End If

            For c = FIRST_POLICY_COL To LAST_POLICY_COL
                val = UCase$(Trim$(CStr(wsSrc.Cells(r, c).Value)))

                If val = "Y" Then
                    dictY(appName) = CLng(dictY(appName)) + 1
                ElseIf val = "N" Then
                    dictN(appName) = CLng(dictN(appName)) + 1
                End If
            Next c
        End If
    Next r

    'Write output headers
    wsOut.Range("A1").Value = "Application/SiteName"
    wsOut.Range("B1").Value = "Total Y"
    wsOut.Range("C1").Value = "Total N"
    wsOut.Range("D1").Value = "Total Answered (Y+N)"
    wsOut.Range("E1").Value = "Compliance % (Y/(Y+N))"

    'Write summary rows
    Dim outRow As Long
    Dim yCnt As Long, nCnt As Long, total As Long
    outRow = 2

    For Each key In dictY.Keys
        yCnt = CLng(dictY(key))
        nCnt = CLng(dictN(key))
        total = yCnt + nCnt

        wsOut.Cells(outRow, 1).Value = key
        wsOut.Cells(outRow, 2).Value = yCnt
        wsOut.Cells(outRow, 3).Value = nCnt
        wsOut.Cells(outRow, 4).Value = total

        If total > 0 Then
            wsOut.Cells(outRow, 5).Value = yCnt / total
        Else
            wsOut.Cells(outRow, 5).Value = 0
        End If

        outRow = outRow + 1
    Next key

    'Format
    With wsOut
        .Rows(1).Font.Bold = True
        .Columns("A:E").AutoFit
        .Columns("E").NumberFormat = "0.00%"
    End With

    MsgBox "Done! Created '" & OUT_SHEET & "' with compliance % per app.", vbInformation
End Sub