Option Explicit

'============================================================
' PURPOSE
'============================================================
' Reads a consolidated Issue Report workbook (sheet: CleanIssueReport)
' and populates a Remediation Task workbook (auto-detects sheet by header "Remediation Task Name").
'
' Logic (new consolidated format):
' - Grouping key = Entity (from "Systems Exhibiting the Issue") + Policy Sub-Domain
' - First occurrence for a key writes/updates the "main" row:   Prefix + Policy + (Entity)
' - Additional occurrences write "extra" rows:                  Prefix + Policy + (Entity) - <Snippet>
' - Snippet is generated from "Original Question" using intent-based pattern labels (clean 3-4 words).
' - Copies:
'     Remediation Plan  -> Description
'     Remediation Owner -> Assigned to
'     Planned Remediation Completion Date -> Due Date
' - Skips rows where Question ID = "Summary" (case-insensitive)
' - Does NOT ignore anything based on Column S (removed)
' - Extra rows copy Issue Id from the main row (if the main row already has one)
'
' Performance:
' - Uses manual calc, no screen updating, uses in-memory arrays for source read
' - Avoids heavy parsing and excessive worksheet reads
'
' Save:
' - Uses SaveWorkbookSafe: tries Save, falls back to SaveCopyAs to Desktop if needed
'
'============================================================

Public Sub Populate_RemediationTasks_From_Consolidated_IssueReport()

    Dim dstPath As Variant, srcPath As Variant
    Dim wbD As Workbook, wsD As Worksheet
    Dim wbS As Workbook, wsS As Worksheet
    Dim wsLog As Worksheet

    Dim oldCalc As XlCalculation
    oldCalc = Application.Calculation

    On Error GoTo FailFast

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.EnableEvents = False
    Application.Calculation = xlCalculationManual

    '-----------------------------
    ' Pick destination file
    '-----------------------------
    dstPath = Application.GetOpenFilename("Excel Files (*.xlsx;*.xlsm), *.xlsx;*.xlsm", , _
                                         "Select Remediation Task file")
    If dstPath = False Then GoTo CleanExit

    Set wbD = Workbooks.Open(CStr(dstPath))

    ' Find destination sheet by header
    Set wsD = FindSheetByHeader(wbD, "Remediation Task Name", 300)
    If wsD Is Nothing Then
        MsgBox "Could not find a sheet containing header 'Remediation Task Name' in the Remediation Task workbook.", vbCritical
        GoTo CleanExit
    End If

    '-----------------------------
    ' Pick source file
    '-----------------------------
    srcPath = Application.GetOpenFilename("Excel Files (*.xlsx;*.xlsm), *.xlsx;*.xlsm", , _
                                         "Select Consolidated Issue Report file")
    If srcPath = False Then GoTo CleanExit

    Set wbS = Workbooks.Open(CStr(srcPath), ReadOnly:=True)

    ' Source sheet fixed name
    On Error Resume Next
    Set wsS = wbS.Worksheets("CleanIssueReport")
    On Error GoTo FailFast
    If wsS Is Nothing Then
        MsgBox "Could not find sheet 'CleanIssueReport' in the Issue Report file.", vbCritical
        GoTo CleanExit
    End If

    '-----------------------------
    ' Log sheet
    '-----------------------------
    Set wsLog = GetOrCreateLogSheet(wbD, "Run Log")
    InitLog wsLog
    LogEvent wsLog, "INFO", "", "", "", "Started run. Source sheet: CleanIssueReport"

    '============================================================
    ' DEST HEADERS
    '============================================================
    Dim hdrRowD As Long
    Dim colTaskName As Long, colIssueId As Long, colDesc As Long, colAssigned As Long, colDue As Long

    hdrRowD = FindHeaderRowExact(wsD, Array("Remediation Task Name", "Issue Id", "Description", "Assigned to", "Due Date"), 300)
    If hdrRowD = 0 Then
        MsgBox "Could not find required destination headers (Remediation Task Name, Issue Id, Description, Assigned to, Due Date).", vbCritical
        LogEvent wsLog, "ERROR", "", "", "", "Missing destination headers."
        GoTo CleanExit
    End If

    colTaskName = FindHeaderColumnExact(wsD, hdrRowD, "Remediation Task Name")
    colIssueId = FindHeaderColumnExact(wsD, hdrRowD, "Issue Id")
    colDesc = FindHeaderColumnExact(wsD, hdrRowD, "Description")
    colAssigned = FindHeaderColumnExact(wsD, hdrRowD, "Assigned to")
    colDue = FindHeaderColumnExact(wsD, hdrRowD, "Due Date")

    wsD.Columns(colTaskName).NumberFormat = "@"
    wsD.Columns(colIssueId).NumberFormat = "@"
    wsD.Columns(colDesc).NumberFormat = "@"
    wsD.Columns(colAssigned).NumberFormat = "@"
    wsD.Columns(colDue).NumberFormat = "m/d/yyyy"

    '============================================================
    ' SOURCE HEADERS (robust detect)
    '============================================================
    Dim hdrRowS As Long
    Dim colPolSub As Long, colSystems As Long, colQID As Long
    Dim colOrigQ As Long, colPlan As Long, colOwner As Long, colPlannedDate As Long

    hdrRowS = FindSourceHeaderRow(wsS, 800)
    If hdrRowS = 0 Then
        MsgBox "Could not find a valid header row in 'CleanIssueReport'.", vbCritical
        LogEvent wsLog, "ERROR", "", "", "", "Missing/undetected source headers."
        GoTo CleanExit
    End If

    colPolSub = FindColByKeywords(wsS, hdrRowS, Array("policy", "sub", "domain"))
    colSystems = FindColByKeywords(wsS, hdrRowS, Array("systems", "exhibiting", "issue"))
    colQID = FindColByKeywords(wsS, hdrRowS, Array("question", "id"))
    colOrigQ = FindColByKeywords(wsS, hdrRowS, Array("original", "question"))

    colPlan = FindColByKeywords(wsS, hdrRowS, Array("remediation", "plan"))
    colOwner = FindColByKeywords(wsS, hdrRowS, Array("remediation", "owner"))
    colPlannedDate = FindColByKeywords(wsS, hdrRowS, Array("planned", "completion", "date"))

    If colPolSub = 0 Or colSystems = 0 Or colQID = 0 Or colOrigQ = 0 Or colPlan = 0 Or colOwner = 0 Or colPlannedDate = 0 Then
        MsgBox "Missing required columns in CleanIssueReport." & vbCrLf & _
               "Need: Policy Sub-Domain, Systems Exhibiting the Issue, Question ID, Original Question," & vbCrLf & _
               "Remediation Plan, Remediation Owner, Planned Remediation Completion Date.", vbCritical
        LogEvent wsLog, "ERROR", "", "", "", "Missing required source columns."
        GoTo CleanExit
    End If

    '============================================================
    ' Determine prefix for THIS run (do NOT rely on 'most common' from dest)
    '============================================================
    Dim runPrefix As String
    runPrefix = DetermineRunPrefix(wbS.Name, wsS, hdrRowS, colSystems)
    If Len(runPrefix) = 0 Then runPrefix = "DTS Sweep 2 - "

    '============================================================
    ' Build destination indexes (main + issue rows) and entity-specific prefixes (if any)
    '============================================================
    Dim existingMain As Object, existingIssue As Object, entityPrefix As Object
    Set existingMain = CreateObject("Scripting.Dictionary")
    Set existingIssue = CreateObject("Scripting.Dictionary")
    Set entityPrefix = CreateObject("Scripting.Dictionary")

    BuildDestIndexes wsD, hdrRowD, colTaskName, existingMain, existingIssue, entityPrefix

    '============================================================
    ' Read source into arrays for speed
    '============================================================
    Dim lastRowS As Long, lastColS As Long
    lastRowS = FindLastRowMulti(wsS, Array(colPolSub, colSystems, colQID, colOrigQ, colPlan, colOwner, colPlannedDate))
    lastColS = wsS.Cells(hdrRowS, wsS.Columns.Count).End(xlToLeft).Column
    If lastRowS <= hdrRowS Then
        MsgBox "No data rows found under source headers.", vbInformation
        GoTo CleanExit
    End If

    Dim srcRng As Range, srcArr As Variant
    Set srcRng = wsS.Range(wsS.Cells(hdrRowS + 1, 1), wsS.Cells(lastRowS, lastColS))
    srcArr = srcRng.Value2  ' 1-based 2D

    '============================================================
    ' Process rows
    '============================================================
    Dim seenMainInRun As Object, snippetCounts As Object
    Set seenMainInRun = CreateObject("Scripting.Dictionary")
    Set snippetCounts = CreateObject("Scripting.Dictionary")

    Dim r As Long
    Dim rowOffset As Long
    rowOffset = hdrRowS  ' because srcArr starts at hdrRowS+1; we address by relative columns

    Dim addedCount As Long, updCount As Long
    addedCount = 0: updCount = 0

    For r = 1 To UBound(srcArr, 1)

        ' Read required fields from array (relative column index)
        Dim qid As String
        qid = Trim$(CStr(srcArr(r, colQID)))
        If LCase$(qid) = "summary" Then GoTo NextR

        Dim pol As String
        pol = Trim$(CStr(srcArr(r, colPolSub)))
        If Len(pol) = 0 Then GoTo NextR
        pol = CanonicalPolicySubDomain(pol)

        Dim systemsRaw As String
        systemsRaw = Trim$(CStr(srcArr(r, colSystems)))
        If Len(systemsRaw) = 0 Then GoTo NextR

        Dim qText As String
        qText = Trim$(CStr(srcArr(r, colOrigQ)))

        Dim planText As String, ownerText As String
        Dim dueVal As Variant
        planText = Trim$(CStr(srcArr(r, colPlan)))
        ownerText = Trim$(CStr(srcArr(r, colOwner)))
        dueVal = srcArr(r, colPlannedDate)

        ' Parse entities (prefer NOT splitting by comma; many entity strings can contain commas)
        Dim entities As Collection
        Set entities = ParseEntitiesSmart(systemsRaw)
        If entities.Count = 0 Then GoTo NextR

        Dim e As Variant
        For Each e In entities

            Dim entityDisplay As String, entityKey As String
            entityDisplay = CleanEntity(CStr(e))
            entityKey = NormalizeKey(entityDisplay)
            If Len(entityKey) = 0 Then GoTo NextE

            Dim prefixText As String
            If entityPrefix.Exists(entityKey) Then
                prefixText = CStr(entityPrefix(entityKey))
            Else
                prefixText = runPrefix
            End If

            Dim keyMain As String
            keyMain = entityKey & "||" & NormalizeKey(pol)

            If Not seenMainInRun.Exists(keyMain) Then
                seenMainInRun.Add keyMain, True

                Dim didAddMain As Boolean
                didAddMain = UpsertMainRow(wsD, hdrRowD, colTaskName, colIssueId, colDesc, colAssigned, colDue, _
                                           existingMain, keyMain, prefixText, pol, entityDisplay, _
                                           planText, ownerText, dueVal, wsLog)
                If didAddMain Then addedCount = addedCount + 1 Else updCount = updCount + 1

            Else
                ' Extra row
                Dim snip As String, snipKey As String, uniqSnip As String
                snip = QuestionToSnippetLabel(qText)
                If Len(snip) = 0 Then snip = "Extra issue"

                ' Ensure uniqueness per (entity+pol+snippet)
                snipKey = keyMain & "||" & NormalizeKey(snip)
                If snippetCounts.Exists(snipKey) Then
                    snippetCounts(snipKey) = CLng(snippetCounts(snipKey)) + 1
                    uniqSnip = snip & " " & CStr(snippetCounts(snipKey))
                Else
                    snippetCounts.Add snipKey, 1
                    uniqSnip = snip
                End If

                Dim didAddIssue As Boolean
                didAddIssue = UpsertIssueRow(wsD, hdrRowD, colTaskName, colIssueId, colDesc, colAssigned, colDue, _
                                             existingMain, existingIssue, keyMain, NormalizeKey(uniqSnip), _
                                             prefixText, pol, entityDisplay, uniqSnip, _
                                             planText, ownerText, dueVal, wsLog)
                If didAddIssue Then addedCount = addedCount + 1 Else updCount = updCount + 1
            End If

NextE:
        Next e

        If (r Mod 250) = 0 Then DoEvents

NextR:
    Next r

    LogEvent wsLog, "INFO", "", "", "", "Run complete. Added: " & addedCount & ", Updated: " & updCount
    MsgBox "Done! Added: " & addedCount & " | Updated: " & updCount, vbInformation

    ' Save safely
    Call SaveWorkbookSafe(wbD)

CleanExit:
    On Error Resume Next
    If Not wbS Is Nothing Then wbS.Close SaveChanges:=False

    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
    Application.EnableEvents = True
    Application.Calculation = oldCalc
    Exit Sub

FailFast:
    On Error Resume Next
    LogEvent wsLog, "ERROR", "", "", "", "Fatal error: " & Err.Number & " - " & Err.Description
    MsgBox "Error: " & Err.Number & vbCrLf & Err.Description, vbCritical
    Resume CleanExit

End Sub


'============================================================
' UPSERTS
' Return True if ADDED, False if UPDATED
'============================================================
Private Function UpsertMainRow(ByVal wsD As Worksheet, ByVal hdrRowD As Long, _
    ByVal colTaskName As Long, ByVal colIssueId As Long, ByVal colDesc As Long, ByVal colAssigned As Long, ByVal colDue As Long, _
    ByVal existingMain As Object, ByVal keyMain As String, _
    ByVal prefixText As String, ByVal pol As String, ByVal entityDisplay As String, _
    ByVal planText As String, ByVal ownerText As String, ByVal dueVal As Variant, _
    ByVal wsLog As Worksheet) As Boolean

    Dim rowNum As Long, action As String

    If existingMain.Exists(keyMain) Then
        rowNum = CLng(existingMain(keyMain))
        action = "UPDATED"
        UpsertMainRow = False
    Else
        rowNum = AppendNewDestRow(wsD, hdrRowD, colTaskName)
        wsD.Cells(rowNum, colTaskName).Value = prefixText & pol & " (" & entityDisplay & ")"
        existingMain.Add keyMain, rowNum
        action = "ADDED"
        UpsertMainRow = True
    End If

    wsD.Cells(rowNum, colDesc).Value = planText
    wsD.Cells(rowNum, colAssigned).Value = ownerText
    WriteDateSmart wsD.Cells(rowNum, colDue), dueVal

    LogEvent wsLog, action, entityDisplay, pol, rowNum, "Main row written."
End Function

Private Function UpsertIssueRow(ByVal wsD As Worksheet, ByVal hdrRowD As Long, _
    ByVal colTaskName As Long, ByVal colIssueId As Long, ByVal colDesc As Long, ByVal colAssigned As Long, ByVal colDue As Long, _
    ByVal existingMain As Object, ByVal existingIssue As Object, _
    ByVal keyMain As String, ByVal snippetKeyNorm As String, _
    ByVal prefixText As String, ByVal pol As String, ByVal entityDisplay As String, ByVal snippet As String, _
    ByVal planText As String, ByVal ownerText As String, ByVal dueVal As Variant, _
    ByVal wsLog As Worksheet) As Boolean

    Dim keyIssue As String
    keyIssue = keyMain & "||" & snippetKeyNorm

    Dim rowNum As Long, action As String

    If existingIssue.Exists(keyIssue) Then
        rowNum = CLng(existingIssue(keyIssue))
        action = "UPDATED"
        UpsertIssueRow = False
    Else
        rowNum = AppendNewDestRow(wsD, hdrRowD, colTaskName)
        wsD.Cells(rowNum, colTaskName).Value = prefixText & pol & " (" & entityDisplay & ") - " & snippet
        existingIssue.Add keyIssue, rowNum
        action = "ADDED"
        UpsertIssueRow = True
    End If

    wsD.Cells(rowNum, colDesc).Value = planText
    wsD.Cells(rowNum, colAssigned).Value = ownerText
    WriteDateSmart wsD.Cells(rowNum, colDue), dueVal

    ' Copy Issue Id from main row (so extra rows correlate)
    If existingMain.Exists(keyMain) Then
        Dim mainRow As Long
        mainRow = CLng(existingMain(keyMain))

        Dim mainIssueId As String
        mainIssueId = Trim$(CStr(wsD.Cells(mainRow, colIssueId).Value))
        If Len(mainIssueId) > 0 Then wsD.Cells(rowNum, colIssueId).Value = mainIssueId
    End If

    LogEvent wsLog, action, entityDisplay, pol, rowNum, "Extra issue row written: " & snippet
End Function


'============================================================
' PREFIX FOR THIS RUN
'============================================================
Private Function DetermineRunPrefix(ByVal sourceFileName As String, ByVal wsS As Worksheet, _
                                   ByVal hdrRowS As Long, ByVal colSystems As Long) As String
    Dim t As String
    t = UCase$(sourceFileName)

    ' Strong signal: filename contains DTS or AN
    If InStr(1, t, "DTS", vbTextCompare) > 0 Then
        DetermineRunPrefix = "DTS Sweep 2 - "
        Exit Function
    End If
    If InStr(1, t, " AN", vbTextCompare) > 0 Or Left$(t, 2) = "AN" Then
        DetermineRunPrefix = "AN Sweep 2 - "
        Exit Function
    End If

    ' Weak signal: sample first 200 rows of Systems column and count markers
    Dim lastRow As Long, r As Long
    lastRow = wsS.Cells(wsS.Rows.Count, colSystems).End(xlUp).Row

    Dim maxScan As Long
    maxScan = hdrRowS + 200
    If maxScan > lastRow Then maxScan = lastRow

    Dim cntDTS As Long, cntAN As Long
    cntDTS = 0: cntAN = 0

    For r = hdrRowS + 1 To maxScan
        Dim s As String
        s = UCase$(Trim$(CStr(GetMergedValue(wsS.Cells(r, colSystems)))))
        If Len(s) > 0 Then
            If InStr(1, s, "DTS", vbTextCompare) > 0 Then cntDTS = cntDTS + 1
            If Left$(s, 2) = "AN" Or InStr(1, s, " AN_", vbTextCompare) > 0 Then cntAN = cntAN + 1
        End If
    Next r

    If cntAN > cntDTS And cntAN > 0 Then
        DetermineRunPrefix = "AN Sweep 2 - "
    ElseIf cntDTS > 0 Then
        DetermineRunPrefix = "DTS Sweep 2 - "
    Else
        DetermineRunPrefix = ""
    End If
End Function


'============================================================
' DEST INDEXING (parse existing task names)
'============================================================
Private Sub BuildDestIndexes(ByVal wsD As Worksheet, ByVal hdrRowD As Long, ByVal colTaskName As Long, _
                            ByVal existingMain As Object, ByVal existingIssue As Object, ByVal entityPrefix As Object)

    Dim lastRow As Long, r As Long
    lastRow = wsD.Cells(wsD.Rows.Count, colTaskName).End(xlUp).Row
    If lastRow <= hdrRowD Then Exit Sub

    For r = hdrRowD + 1 To lastRow

        Dim fullName As String
        fullName = Trim$(CStr(wsD.Cells(r, colTaskName).Value))
        If Len(fullName) = 0 Then GoTo NextR

        Dim ent As String, pol As String, pref As String, snip As String
        ent = ExtractEntityFromTaskName(fullName)  ' safer extraction
        pol = CanonicalPolicySubDomain(ExtractPolicyFromTaskName(fullName))
        pref = ExtractPrefixUpToSweep2Dash(fullName)
        snip = ExtractSnippetAfterEntity(fullName)

        If Len(ent) > 0 And Len(pref) > 0 Then
            Dim ek As String
            ek = NormalizeKey(ent)
            If Len(ek) > 0 Then
                If Not entityPrefix.Exists(ek) Then entityPrefix.Add ek, pref
            End If
        End If

        If Len(ent) > 0 And Len(pol) > 0 Then
            Dim keyMain As String
            keyMain = NormalizeKey(ent) & "||" & NormalizeKey(pol)

            If Len(snip) = 0 Then
                If Not existingMain.Exists(keyMain) Then existingMain.Add keyMain, r
            Else
                Dim keyIssue As String
                keyIssue = keyMain & "||" & NormalizeKey(snip)
                If Not existingIssue.Exists(keyIssue) Then existingIssue.Add keyIssue, r
            End If
        End If

NextR:
    Next r
End Sub


'============================================================
' SOURCE HEADER FINDERS
'============================================================
Private Function FindSourceHeaderRow(ByVal ws As Worksheet, ByVal maxRowsToScan As Long) As Long
    Dim r As Long
    For r = 1 To maxRowsToScan
        If FindColByKeywords(ws, r, Array("policy", "sub", "domain")) > 0 _
           And FindColByKeywords(ws, r, Array("systems", "exhibiting", "issue")) > 0 _
           And FindColByKeywords(ws, r, Array("question", "id")) > 0 _
           And FindColByKeywords(ws, r, Array("original", "question")) > 0 Then
            FindSourceHeaderRow = r
            Exit Function
        End If
    Next r
    FindSourceHeaderRow = 0
End Function

Private Function FindColByKeywords(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal keywords As Variant) As Long
    Dim lastCol As Long, c As Long
    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    For c = 1 To lastCol
        Dim v As String
        v = NormalizeKey(CStr(ws.Cells(headerRow, c).Value))
        If Len(v) > 0 Then
            If ContainsAllKeywords(v, keywords) Then
                FindColByKeywords = c
                Exit Function
            End If
        End If
    Next c
    FindColByKeywords = 0
End Function

Private Function ContainsAllKeywords(ByVal textNorm As String, ByVal keywords As Variant) As Boolean
    Dim i As Long
    For i = LBound(keywords) To UBound(keywords)
        If InStr(1, textNorm, LCase$(CStr(keywords(i))), vbTextCompare) = 0 Then
            ContainsAllKeywords = False
            Exit Function
        End If
    Next i
    ContainsAllKeywords = True
End Function


'============================================================
' DEST HEADER FINDERS
'============================================================
Private Function FindHeaderRowExact(ByVal ws As Worksheet, ByVal headers As Variant, ByVal maxRowsToScan As Long) As Long
    Dim r As Long, i As Long
    For r = 1 To maxRowsToScan
        For i = LBound(headers) To UBound(headers)
            If FindHeaderColumnExact(ws, r, CStr(headers(i))) = 0 Then GoTo NextR
        Next i
        FindHeaderRowExact = r
        Exit Function
NextR:
    Next r
    FindHeaderRowExact = 0
End Function

Private Function FindHeaderColumnExact(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal headerText As String) As Long
    Dim lastCol As Long, c As Long
    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    For c = 1 To lastCol
        If StrComp(Trim$(CStr(ws.Cells(headerRow, c).Value)), headerText, vbTextCompare) = 0 Then
            FindHeaderColumnExact = c
            Exit Function
        End If
    Next c
    FindHeaderColumnExact = 0
End Function

Private Function FindSheetByHeader(ByVal wb As Workbook, ByVal headerText As String, ByVal maxRowsToScan As Long) As Worksheet
    Dim ws As Worksheet
    For Each ws In wb.Worksheets
        If FindHeaderRowExact(ws, Array(headerText), maxRowsToScan) > 0 Then
            Set FindSheetByHeader = ws
            Exit Function
        End If
    Next ws
    Set FindSheetByHeader = Nothing
End Function


'============================================================
' ENTITY PARSING (Smart)
'============================================================
Private Function ParseEntitiesSmart(ByVal raw As String) As Collection
    Dim c As New Collection
    Dim t As String
    t = Trim$(CStr(raw))
    If Len(t) = 0 Then
        Set ParseEntitiesSmart = c
        Exit Function
    End If

    ' Normalize line breaks and separators
    t = Replace(t, vbCrLf, vbLf)
    t = Replace(t, vbCr, vbLf)

    ' Prefer splitting on newline and semicolon (NOT comma)
    t = Replace(t, ";", vbLf)
    t = Replace(t, " | ", vbLf)

    Dim parts() As String
    parts = Split(t, vbLf)

    Dim i As Long
    For i = LBound(parts) To UBound(parts)
        Dim p As String
        p = Trim$(parts(i))
        If Len(p) > 0 Then
            c.Add p
        End If
    Next i

    ' If it was a single cell with multiple entities separated by comma ONLY,
    ' we can optionally split, but only if it looks like multiple "AppID Entity" tokens.
    If c.Count = 1 Then
        Dim one As String
        one = CStr(c(1))
        If InStr(1, one, ",", vbTextCompare) > 0 And LooksLikeCommaSeparatedEntities(one) Then
            Set c = New Collection
            Dim parts2() As String, j As Long
            parts2 = Split(one, ",")
            For j = LBound(parts2) To UBound(parts2)
                Dim p2 As String
                p2 = Trim$(parts2(j))
                If Len(p2) > 0 Then c.Add p2
            Next j
        End If
    End If

    Set ParseEntitiesSmart = c
End Function

Private Function LooksLikeCommaSeparatedEntities(ByVal s As String) As Boolean
    ' Heuristic: if it contains multiple numeric AppIDs separated by commas
    Dim t As String
    t = Trim$(s)
    LooksLikeCommaSeparatedEntities = (CountChar(t, ",") >= 1 And HasMultipleNumericTokens(t))
End Function

Private Function HasMultipleNumericTokens(ByVal s As String) As Boolean
    Dim parts() As String
    parts = Split(Replace(s, ",", " "), " ")
    Dim i As Long, cnt As Long
    cnt = 0
    For i = LBound(parts) To UBound(parts)
        Dim p As String
        p = Trim$(parts(i))
        If Len(p) > 0 Then
            If IsNumeric(p) Then cnt = cnt + 1
        End If
        If cnt >= 2 Then
            HasMultipleNumericTokens = True
            Exit Function
        End If
    Next i
    HasMultipleNumericTokens = False
End Function

Private Function CountChar(ByVal s As String, ByVal ch As String) As Long
    Dim i As Long, cnt As Long
    cnt = 0
    For i = 1 To Len(s)
        If Mid$(s, i, 1) = ch Then cnt = cnt + 1
    Next i
    CountChar = cnt
End Function

Private Function CleanEntity(ByVal s As String) As String
    Dim t As String
    t = Trim$(s)

    ' Remove accidental leading bullets or weird whitespace
    t = Replace(t, ChrW(8226), "")
    t = Replace(t, ChrW(160), " ")
    Do While InStr(t, "  ") > 0
        t = Replace(t, "  ", " ")
    Loop

    CleanEntity = Trim$(t)
End Function


'============================================================
' POLICY SUBDOMAIN NORMALIZATION (ALIASES)
'============================================================
Private Function CanonicalPolicySubDomain(ByVal pol As String) As String
    Dim t As String
    t = Trim$(CStr(pol))
    Do While InStr(t, "  ") > 0
        t = Replace(t, "  ", " ")
    Loop

    Select Case LCase$(t)
        Case LCase$("Secure Authentication - MFA")
            CanonicalPolicySubDomain = "Multi-Factor Authentication"
        Case LCase$("Protection of Systems and Communications")
            CanonicalPolicySubDomain = "Protection of System and Communications"
        Case LCase$("Separate Admin Account")
            CanonicalPolicySubDomain = "Access Control - Separate Admin Account"
        Case Else
            CanonicalPolicySubDomain = t
    End Select
End Function


'============================================================
' INTENT-BASED SNIPPETS (fixes "word salad")
'============================================================
Private Function QuestionToSnippetLabel(ByVal originalQuestion As String) As String
    Dim q As String
    q = LCase$(NormalizeSpaces(originalQuestion))

    If Len(q) = 0 Then
        QuestionToSnippetLabel = ""
        Exit Function
    End If

    ' Access control / account mgmt
    If InStr(q, "formal access provisioning") > 0 Or (InStr(q, "access provisioning") > 0 And InStr(q, "approval") > 0) Then
        QuestionToSnippetLabel = "Access provisioning approvals"
        Exit Function
    End If

    If InStr(q, "disabled promptly") > 0 Or InStr(q, "notification of termination") > 0 Or InStr(q, "change in job responsibilities") > 0 Then
