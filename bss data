Option Explicit

'============================================================
' MAIN
'============================================================
Public Sub Populate_RemediationTasks_From_IssueReportListing2()

    Dim dstPath As Variant, srcPath As Variant
    Dim wbD As Workbook, wsD As Worksheet
    Dim wbS As Workbook, wsS As Worksheet
    Dim wsLog As Worksheet

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.EnableEvents = False
    Application.Calculation = xlCalculationManual

    'Pick Remediation Task file
    dstPath = Application.GetOpenFilename("Excel Files (*.xlsx;*.xlsm), *.xlsx;*.xlsm", , _
                                         "Select Remediation Task file")
    If dstPath = False Then GoTo CleanExit

    Set wbD = Workbooks.Open(CStr(dstPath))

    'Find destination sheet by header "Remediation Task Name"
    Set wsD = FindSheetByHeader(wbD, "Remediation Task Name", 300)
    If wsD Is Nothing Then
        Set wsD = wbD.Worksheets(1)
    End If

    'Pick consolidated Issue Report file
    srcPath = Application.GetOpenFilename("Excel Files (*.xlsx;*.xlsm), *.xlsx;*.xlsm", , _
                                         "Select Issue Report file")
    If srcPath = False Then GoTo CleanExit

    Set wbS = Workbooks.Open(CStr(srcPath), ReadOnly:=True)

    'Source sheet
    On Error Resume Next
    Set wsS = wbS.Worksheets("Issue Report Listing2")
    On Error GoTo 0
    If wsS Is Nothing Then
        MsgBox "Could not find sheet 'Issue Report Listing2' in the issue report file.", vbCritical
        GoTo CleanExit
    End If

    'Log
    Set wsLog = GetOrCreateLogSheet(wbD, "Run Log")
    InitLog wsLog
    LogEvent wsLog, "INFO", "", "", "", "Started run (source sheet: Issue Report Listing2)."

    '============================================================
    ' DEST HEADERS
    '============================================================
    Dim hdrRowD As Long
    Dim colTaskName As Long, colIssueId As Long, colDesc As Long, colAssigned As Long, colDue As Long

    hdrRowD = FindHeaderRowExact(wsD, Array("Remediation Task Name", "Issue Id"), 400)
    If hdrRowD = 0 Then
        MsgBox "Could not find required headers in Remediation Task sheet (need at least 'Remediation Task Name' and 'Issue Id').", vbCritical
        LogEvent wsLog, "ERROR", "", "", "", "Missing headers in destination."
        GoTo CleanExit
    End If

    colTaskName = FindHeaderColumnLoose(wsD, hdrRowD, "remediation task name")
    colIssueId = FindHeaderColumnLoose(wsD, hdrRowD, "issue id")
    colDesc = FindHeaderColumnLoose(wsD, hdrRowD, "description")
    colAssigned = FindHeaderColumnLoose(wsD, hdrRowD, "assigned")
    colDue = FindHeaderColumnLoose(wsD, hdrRowD, "due date")

    If colTaskName = 0 Or colIssueId = 0 Then
        MsgBox "Destination sheet must have at least 'Remediation Task Name' and 'Issue Id'.", vbCritical
        GoTo CleanExit
    End If

    'Format
    wsD.Columns(colTaskName).NumberFormat = "@"
    wsD.Columns(colIssueId).NumberFormat = "@"
    If colDesc > 0 Then wsD.Columns(colDesc).NumberFormat = "@"
    If colAssigned > 0 Then wsD.Columns(colAssigned).NumberFormat = "@"
    If colDue > 0 Then wsD.Columns(colDue).NumberFormat = "m/d/yyyy"

    '============================================================
    ' SOURCE HEADERS (KEYWORD BASED)
    '============================================================
    Dim hdrRowS As Long
    Dim colPolSub As Long, colSystems As Long, colQID As Long
    Dim colOrigQ As Long, colPlan As Long, colOwner As Long, colCompDate As Long

    hdrRowS = FindSourceHeaderRow(wsS, 800)
    If hdrRowS = 0 Then
        MsgBox "Could not find source header row in Issue Report Listing2.", vbCritical
        LogEvent wsLog, "ERROR", "", "", "", "Missing source headers."
        GoTo CleanExit
    End If

    colPolSub = FindColByKeywords(wsS, hdrRowS, Array("policy", "sub", "domain"))
    colSystems = FindColByKeywords(wsS, hdrRowS, Array("systems", "exhibiting", "issue"))
    colQID = FindColByKeywords(wsS, hdrRowS, Array("question", "id"))
    colOrigQ = FindColByKeywords(wsS, hdrRowS, Array("original", "question"))

    'Remediation Plan can be "Remediation Plan" OR "Suggested Remediation"
    colPlan = FindColByKeywords(wsS, hdrRowS, Array("remediation", "plan"))
    If colPlan = 0 Then colPlan = FindColByKeywords(wsS, hdrRowS, Array("suggested", "remediation"))

    colOwner = FindColByKeywords(wsS, hdrRowS, Array("remediation", "owner"))
    colCompDate = FindColByKeywords(wsS, hdrRowS, Array("remediation", "completion", "date"))

    If colPolSub = 0 Or colSystems = 0 Or colQID = 0 Or colOrigQ = 0 Or colPlan = 0 Or colOwner = 0 Or colCompDate = 0 Then
        MsgBox "Missing required columns in Issue Report Listing2." & vbCrLf & _
               "Need: Policy Sub-Domain, Systems Exhibiting the Issue, Question ID, Original Question," & vbCrLf & _
               "Remediation Plan (or Suggested Remediation), Remediation Owner, Remediation Completion Date.", vbCritical
        LogEvent wsLog, "ERROR", "", "", "", "Missing required source columns."
        GoTo CleanExit
    End If

    '============================================================
    ' BUILD DEST INDEXES + LEARN PREFIX (MOST COMMON)
    '============================================================
    Dim existingMain As Object, existingIssue As Object
    Dim entityPrefix As Object
    Set existingMain = CreateObject("Scripting.Dictionary")
    Set existingIssue = CreateObject("Scripting.Dictionary")
    Set entityPrefix = CreateObject("Scripting.Dictionary")

    Dim globalPrefix As String
    globalPrefix = ""

    BuildDestIndexes_MostCommonPrefix wsD, hdrRowD, colTaskName, existingMain, existingIssue, entityPrefix, globalPrefix
    If Len(globalPrefix) = 0 Then globalPrefix = "DTS Sweep 2 - "

    '============================================================
    ' PROCESS SOURCE ROWS
    '============================================================
    Dim lastRowS As Long, r As Long
    lastRowS = wsS.Cells(wsS.Rows.Count, colPolSub).End(xlUp).Row

    Dim seenMainInRun As Object
    Set seenMainInRun = CreateObject("Scripting.Dictionary")

    Dim snippetCounts As Object
    Set snippetCounts = CreateObject("Scripting.Dictionary")

    For r = hdrRowS + 1 To lastRowS

        Dim qid As String
        qid = Trim$(CStr(wsS.Cells(r, colQID).Value))

        'Skip only Summary or N/A variants. DO NOT skip blanks.
        If ShouldSkipQuestionId(qid) Then GoTo NextRow

        Dim pol As String
        pol = Trim$(CStr(wsS.Cells(r, colPolSub).Value))
        If Len(pol) = 0 Then GoTo NextRow
        pol = CanonicalPolicySubDomain(pol)

        Dim systemsRaw As String
        systemsRaw = Trim$(CStr(wsS.Cells(r, colSystems).Value))
        If Len(systemsRaw) = 0 Then GoTo NextRow

        Dim entities As Collection
        Set entities = ParseEntities(systemsRaw)
        If entities.Count = 0 Then GoTo NextRow

        Dim planText As String, ownerText As String
        Dim dueVal As Variant

        planText = Trim$(CStr(wsS.Cells(r, colPlan).Value))
        ownerText = Trim$(CStr(wsS.Cells(r, colOwner).Value))
        dueVal = wsS.Cells(r, colCompDate).Value

        Dim qText As String
        qText = Trim$(CStr(wsS.Cells(r, colOrigQ).Value))

        Dim snip As String
        snip = SnippetFromQuestion(qText)
        If Len(snip) = 0 Then snip = "Additional item"

        Dim e As Variant
        For Each e In entities

            Dim entityDisplay As String, entityKey As String
            entityDisplay = CStr(e)
            entityKey = NormalizeKey(entityDisplay)
            If Len(entityKey) = 0 Then GoTo NextEntity

            Dim prefixText As String
            If entityPrefix.Exists(entityKey) Then
                prefixText = CStr(entityPrefix(entityKey))
            Else
                prefixText = globalPrefix
            End If

            Dim keyMain As String
            keyMain = entityKey & "||" & NormalizeKey(pol)

            If Not seenMainInRun.Exists(keyMain) Then
                seenMainInRun.Add keyMain, True

                UpsertMainRow wsD, hdrRowD, colTaskName, colIssueId, colDesc, colAssigned, colDue, _
                             existingMain, keyMain, prefixText, pol, entityDisplay, _
                             planText, ownerText, dueVal, wsLog
            Else
                Dim uniqSnip As String, snipBaseKey As String

                snipBaseKey = keyMain & "||" & NormalizeKey(snip)
                If snippetCounts.Exists(snipBaseKey) Then
                    snippetCounts(snipBaseKey) = CLng(snippetCounts(snipBaseKey)) + 1
                    uniqSnip = snip & " " & CStr(snippetCounts(snipBaseKey))
                Else
                    snippetCounts.Add snipBaseKey, 1
                    uniqSnip = snip
                End If

                UpsertIssueRow wsD, hdrRowD, colTaskName, colIssueId, colDesc, colAssigned, colDue, _
                               existingMain, existingIssue, keyMain, NormalizeKey(uniqSnip), _
                               prefixText, pol, entityDisplay, uniqSnip, _
                               planText, ownerText, dueVal, wsLog
            End If

NextEntity:
        Next e

NextRow:
    Next r

    LogEvent wsLog, "INFO", "", "", "", "Run complete."
    MsgBox "Done! Imported from Issue Report Listing2. (No auto-save: please save the destination workbook manually.)", vbInformation

CleanExit:
    On Error Resume Next
    If Not wbS Is Nothing Then wbS.Close SaveChanges:=False

    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
    Application.EnableEvents = True
    Application.Calculation = xlCalculationAutomatic

End Sub

'============================================================
' UPSERTS
'============================================================
Private Sub UpsertMainRow(ByVal wsD As Worksheet, ByVal hdrRowD As Long, _
    ByVal colTaskName As Long, ByVal colIssueId As Long, ByVal colDesc As Long, ByVal colAssigned As Long, ByVal colDue As Long, _
    ByVal existingMain As Object, ByVal keyMain As String, _
    ByVal prefixText As String, ByVal pol As String, ByVal entityDisplay As String, _
    ByVal planText As String, ByVal ownerText As String, ByVal dueVal As Variant, _
    ByVal wsLog As Worksheet)

    Dim rowNum As Long, action As String

    If existingMain.Exists(keyMain) Then
        rowNum = CLng(existingMain(keyMain))
        action = "UPDATED"
    Else
        rowNum = AppendNewDestRow(wsD, hdrRowD, colTaskName)
        wsD.Cells(rowNum, colTaskName).Value = prefixText & pol & " (" & entityDisplay & ")"
        existingMain.Add keyMain, rowNum
        action = "ADDED"
    End If

    If colDesc > 0 Then wsD.Cells(rowNum, colDesc).Value = planText
    If colAssigned > 0 Then wsD.Cells(rowNum, colAssigned).Value = ownerText
    If colDue > 0 Then WriteDateSmart wsD.Cells(rowNum, colDue), dueVal

    LogEvent wsLog, action, entityDisplay, pol, rowNum, "Main row written."
End Sub

Private Sub UpsertIssueRow(ByVal wsD As Worksheet, ByVal hdrRowD As Long, _
    ByVal colTaskName As Long, ByVal colIssueId As Long, ByVal colDesc As Long, ByVal colAssigned As Long, ByVal colDue As Long, _
    ByVal existingMain As Object, ByVal existingIssue As Object, _
    ByVal keyMain As String, ByVal snippetKeyNorm As String, _
    ByVal prefixText As String, ByVal pol As String, ByVal entityDisplay As String, ByVal snippet As String, _
    ByVal planText As String, ByVal ownerText As String, ByVal dueVal As Variant, _
    ByVal wsLog As Worksheet)

    Dim keyIssue As String
    keyIssue = keyMain & "||" & snippetKeyNorm

    Dim rowNum As Long, action As String
    If existingIssue.Exists(keyIssue) Then
        rowNum = CLng(existingIssue(keyIssue))
        action = "UPDATED"
    Else
        rowNum = AppendNewDestRow(wsD, hdrRowD, colTaskName)
        wsD.Cells(rowNum, colTaskName).Value = prefixText & pol & " (" & entityDisplay & ") - " & snippet
        existingIssue.Add keyIssue, rowNum
        action = "ADDED"
    End If

    If colDesc > 0 Then wsD.Cells(rowNum, colDesc).Value = planText
    If colAssigned > 0 Then wsD.Cells(rowNum, colAssigned).Value = ownerText
    If colDue > 0 Then WriteDateSmart wsD.Cells(rowNum, colDue), dueVal

    'Copy Issue Id from main row (so extra rows correlate)
    If existingMain.Exists(keyMain) Then
        Dim mainRow As Long
        mainRow = CLng(existingMain(keyMain))

        Dim mainIssueId As String
        mainIssueId = Trim$(CStr(wsD.Cells(mainRow, colIssueId).Value))
        If Len(mainIssueId) > 0 Then wsD.Cells(rowNum, colIssueId).Value = mainIssueId
    End If

    LogEvent wsLog, action, entityDisplay, pol, rowNum, "Extra issue row written."
End Sub

'============================================================
' QUESTION ID SKIP RULES (DO NOT SKIP BLANKS)
'============================================================
Private Function ShouldSkipQuestionId(ByVal qid As String) As Boolean
    Dim t As String
    t = LCase$(Trim$(qid))

    t = Replace(t, " ", "")
    t = Replace(t, ".", "")

    'Skip only Summary or NA/N/A variants
    If t = "summary" Then
        ShouldSkipQuestionId = True
    ElseIf t = "na" Or t = "n/a" Or t = "n\a" Then
        ShouldSkipQuestionId = True
    Else
        ShouldSkipQuestionId = False
    End If
End Function

'============================================================
' SOURCE HEADER FINDERS
'============================================================
Private Function FindSourceHeaderRow(ByVal ws As Worksheet, ByVal maxRowsToScan As Long) As Long
    Dim r As Long
    For r = 1 To maxRowsToScan
        If FindColByKeywords(ws, r, Array("policy", "sub", "domain")) > 0 _
           And FindColByKeywords(ws, r, Array("systems", "exhibiting", "issue")) > 0 _
           And FindColByKeywords(ws, r, Array("question", "id")) > 0 _
           And FindColByKeywords(ws, r, Array("original", "question")) > 0 Then
            FindSourceHeaderRow = r
            Exit Function
        End If
    Next r
    FindSourceHeaderRow = 0
End Function

Private Function FindColByKeywords(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal keywords As Variant) As Long
    Dim lastCol As Long, c As Long
    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    For c = 1 To lastCol
        Dim v As String
        v = NormalizeKey(CStr(ws.Cells(headerRow, c).Value))
        If Len(v) > 0 Then
            If ContainsAllKeywords(v, keywords) Then
                FindColByKeywords = c
                Exit Function
            End If
        End If
    Next c
    FindColByKeywords = 0
End Function

Private Function ContainsAllKeywords(ByVal textNorm As String, ByVal keywords As Variant) As Boolean
    Dim i As Long
    For i = LBound(keywords) To UBound(keywords)
        If InStr(1, textNorm, LCase$(CStr(keywords(i))), vbTextCompare) = 0 Then
            ContainsAllKeywords = False
            Exit Function
        End If
    Next i
    ContainsAllKeywords = True
End Function

'============================================================
' DEST HEADER FINDERS
'============================================================
Private Function FindHeaderRowExact(ByVal ws As Worksheet, ByVal headers As Variant, ByVal maxRowsToScan As Long) As Long
    Dim r As Long, i As Long
    For r = 1 To maxRowsToScan
        For i = LBound(headers) To UBound(headers)
            If FindHeaderColumnExact(ws, r, CStr(headers(i))) = 0 Then GoTo NextR
        Next i
        FindHeaderRowExact = r
        Exit Function
NextR:
    Next r
    FindHeaderRowExact = 0
End Function

Private Function FindHeaderColumnExact(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal headerText As String) As Long
    Dim lastCol As Long, c As Long
    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    For c = 1 To lastCol
        If StrComp(Trim$(CStr(ws.Cells(headerRow, c).Value)), headerText, vbTextCompare) = 0 Then
            FindHeaderColumnExact = c
            Exit Function
        End If
    Next c
    FindHeaderColumnExact = 0
End Function

Private Function FindHeaderColumnLoose(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal headerNeedleNorm As String) As Long
    Dim lastCol As Long, c As Long, v As String
    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    For c = 1 To lastCol
        v = NormalizeKey(CStr(ws.Cells(headerRow, c).Value))
        If InStr(1, v, LCase$(headerNeedleNorm), vbTextCompare) > 0 Then
            FindHeaderColumnLoose = c
            Exit Function
        End If
    Next c
    FindHeaderColumnLoose = 0
End Function

Private Function FindSheetByHeader(ByVal wb As Workbook, ByVal headerText As String, ByVal maxRows As Long) As Worksheet
    Dim ws As Worksheet, r As Long
    For Each ws In wb.Worksheets
        For r = 1 To maxRows
            If FindHeaderColumnLoose(ws, r, LCase$(headerText)) > 0 Then
                Set FindSheetByHeader = ws
                Exit Function
            End If
        Next r
    Next ws
    Set FindSheetByHeader = Nothing
End Function

'============================================================
' DEST INDEX + PREFIX LEARNING
'============================================================
Private Sub BuildDestIndexes_MostCommonPrefix(ByVal wsD As Worksheet, ByVal hdrRowD As Long, ByVal colTaskName As Long, _
    ByVal existingMain As Object, ByVal existingIssue As Object, ByVal entityPrefix As Object, ByRef globalPrefix As String)

    Dim prefixCounts As Object
    Set prefixCounts = CreateObject("Scripting.Dictionary")

    Dim lastRow As Long, r As Long
    lastRow = wsD.Cells(wsD.Rows.Count, colTaskName).End(xlUp).Row

    For r = hdrRowD + 1 To lastRow

        Dim t As String
        t = Trim$(CStr(wsD.Cells(r, colTaskName).Value))
        If Len(t) = 0 Then GoTo NextR

        Dim ent As String, pol As String, pref As String, snip As String
        ent = ExtractBetweenParens(t)
        pol = CanonicalPolicySubDomain(ExtractPolicySubDomainFromTaskName(t))
        pref = ExtractPrefixUpToSweep2Dash(t)
        snip = ExtractSnippetFromTaskName(t)

        If Len(pref) > 0 And IsGoodPrefix(pref) Then
            If prefixCounts.Exists(pref) Then
                prefixCounts(pref) = CLng(prefixCounts(pref)) + 1
            Else
                prefixCounts.Add pref, 1
            End If

            If Len(ent) > 0 Then
                Dim ek As String
                ek = NormalizeKey(ent)
                If Not entityPrefix.Exists(ek) Then entityPrefix.Add ek, pref
            End If
        End If

        If Len(ent) > 0 And Len(pol) > 0 Then
            Dim keyMain As String
            keyMain = NormalizeKey(ent) & "||" & NormalizeKey(pol)

            If Len(snip) = 0 Then
                If Not existingMain.Exists(keyMain) Then existingMain.Add keyMain, r
            Else
                Dim keyIssue As String
                keyIssue = keyMain & "||" & NormalizeKey(snip)
                If Not existingIssue.Exists(keyIssue) Then existingIssue.Add keyIssue, r
            End If
        End If

NextR:
    Next r

    globalPrefix = ""
    Dim bestCnt As Long: bestCnt = 0
    Dim k As Variant
    For Each k In prefixCounts.Keys
        If CLng(prefixCounts(k)) > bestCnt Then
            bestCnt = CLng(prefixCounts(k))
            globalPrefix = CStr(k)
        End If
    Next k
End Sub

'============================================================
' ENTITY PARSING
'============================================================
Private Function ParseEntities(ByVal raw As String) As Collection
    Dim c As New Collection
    Dim t As String
    t = Trim$(CStr(raw))
    If Len(t) = 0 Then
        Set ParseEntities = c
        Exit Function
    End If

    t = Replace(t, vbCrLf, vbLf)
    t = Replace(t, vbCr, vbLf)
    t = Replace(t, ";", vbLf)
    t = Replace(t, ",", vbLf)

    Dim parts() As String
    parts = Split(t, vbLf)

    Dim i As Long
    For i = LBound(parts) To UBound(parts)
        Dim p As String
        p = Trim$(parts(i))
        If Len(p) > 0 Then c.Add p
    Next i

    Set ParseEntities = c
End Function

'============================================================
' POLICY SUBDOMAIN NORMALIZATION (ALIASES)
'============================================================
Private Function CanonicalPolicySubDomain(ByVal pol As String) As String
    Dim t As String
    t = Trim$(CStr(pol))
    Do While InStr(t, "  ") > 0
        t = Replace(t, "  ", " ")
    Loop

    Select Case LCase$(t)
        Case LCase$("Secure Authentication - MFA")
            CanonicalPolicySubDomain = "Multifactor Authentication"
        Case LCase$("Protection of Systems and Communications")
            CanonicalPolicySubDomain = "Protection of System and Communications"
        Case Else
            CanonicalPolicySubDomain = t
    End Select
End Function

'============================================================
' SNIPPET FROM ORIGINAL QUESTION (PATTERN-BASED, MEANINGFUL)
'============================================================
Private Function SnippetFromQuestion(ByVal q As String) As String
    Dim t As String
    t = LCase$(Trim$(q))
    If Len(t) = 0 Then
        SnippetFromQuestion = ""
        Exit Function
    End If

    'Access control patterns
    If InStr(t, "formal access provisioning") > 0 Or InStr(t, "access provisioning process") > 0 Then
        SnippetFromQuestion = "Access provisioning approvals"
    ElseIf InStr(t, "disabled promptly") > 0 Or InStr(t, "upon notification of termination") > 0 Then
        SnippetFromQuestion = "Deprovision on termination"
    ElseIf InStr(t, "periodic access recertification") > 0 Or InStr(t, "recertification review") > 0 Then
        SnippetFromQuestion = "Access recertification review"
    ElseIf InStr(t, "prohibit the use of shared accounts") > 0 Then
        SnippetFromQuestion = "Prohibit shared accounts"
    ElseIf InStr(t, "temporary accounts") > 0 And (InStr(t, "30 days") > 0 Or InStr(t, "31 days") > 0) Then
        SnippetFromQuestion = "Temporary account expiry"
    ElseIf InStr(t, "break glass") > 0 Then
        SnippetFromQuestion = "Break-glass password rotation"
    ElseIf InStr(t, "service accounts") > 0 And InStr(t, "manage service accounts") > 0 Then
        SnippetFromQuestion = "Service account management"
    ElseIf InStr(t, "service accounts assigned an owner") > 0 Then
        SnippetFromQuestion = "Service account ownership"
    ElseIf InStr(t, "default accounts") > 0 Then
        SnippetFromQuestion = "Default account hardening"
    ElseIf InStr(t, "separate administrator accounts") > 0 Or InStr(t, "separate admin account") > 0 Then
        SnippetFromQuestion = "Separate admin accounts"
    ElseIf InStr(t, "privileged access management") > 0 Or InStr(t, "(pam)") > 0 Then
        SnippetFromQuestion = "Privileged access management"

    'Vulnerability / testing
    ElseIf InStr(t, "static application security testing") > 0 Or InStr(t, "(sast)") > 0 Then
        SnippetFromQuestion = "SAST/SCA during development"
    ElseIf InStr(t, "penetration test") > 0 Then
        SnippetFromQuestion = "Penetration testing cadence"
    ElseIf InStr(t, "web app vulnerability scans") > 0 Then
        SnippetFromQuestion = "Web app vulnerability scanning"
    ElseIf InStr(t, "network vulnerability scans") > 0 Then
        SnippetFromQuestion = "Network vulnerability scanning"
    ElseIf InStr(t, "remediate vulnerabilities") > 0 And InStr(t, "severity") > 0 Then
        SnippetFromQuestion = "Vulnerability remediation SLAs"

    'Crypto / in-transit
    ElseIf InStr(t, "encrypt data in transit") > 0 Or InStr(t, "tls") > 0 Then
        SnippetFromQuestion = "Encrypt data in transit"
    ElseIf InStr(t, "cryptographic keys") > 0 And InStr(t, "rotation") > 0 Then
        SnippetFromQuestion = "Crypto key lifecycle"

    'Authentication sessions / concurrency
    ElseIf InStr(t, "multiple concurrent logins") > 0 Then
        SnippetFromQuestion = "Block concurrent logins"
    ElseIf InStr(t, "sessions that have been inactive") > 0 Then
        SnippetFromQuestion = "Session inactivity timeout"
    ElseIf InStr(t, "timeout after eight hours") > 0 Or InStr(t, "maximum life") > 0 Then
        SnippetFromQuestion = "Session max lifetime"
    ElseIf InStr(t, "unique accounts") > 0 Then
        SnippetFromQuestion = "Unique user accounts"
    Else
        'Fallback: short cleaned phrase (first meaningful chunk)
        SnippetFromQuestion = FallbackSnippet(q, 4)
    End If
End Function

Private Function FallbackSnippet(ByVal q As String, ByVal maxWords As Long) As String
    Dim t As String
    t = Trim$(q)
    t = Replace(t, vbCrLf, " ")
    t = Replace(t, vbCr, " ")
    t = Replace(t, vbLf, " ")

    Dim arr() As String
    arr = Split(t, " ")

    Dim out As String, i As Long, cnt As Long
    out = "": cnt = 0

    For i = LBound(arr) To UBound(arr)
        Dim w As String
        w = Trim$(arr(i))
        If Len(w) = 0 Then GoTo NextI
        w = Replace(w, "?", "")
        w = Replace(w, ".", "")
        w = Replace(w, ",", "")
        w = Replace(w, ";", "")
        w = Replace(w, ":", "")
        w = Replace(w, "(", "")
        w = Replace(w, ")", "")

        If Len(w) <= 2 Then GoTo NextI
        If LCase$(w) = "the" Or LCase$(w) = "and" Or LCase$(w) = "to" Or LCase$(w) = "of" Or LCase$(w) = "in" Or LCase$(w) = "for" Then GoTo NextI

        cnt = cnt + 1
        If out = "" Then out = w Else out = out & " " & w
        If cnt >= maxWords Then Exit For
NextI:
    Next i

    FallbackSnippet = Trim$(out)
End Function

'============================================================
' TASK NAME PARSING (DEST)
'============================================================
Private Function ExtractBetweenParens(ByVal s As String) As String
    Dim p1 As Long, p2 As Long
    p1 = InStrRev(s, "(")
    p2 = InStrRev(s, ")")
    If p1 > 0 And p2 > p1 Then
        ExtractBetweenParens = Trim$(Mid$(s, p1 + 1, p2 - p1 - 1))
    Else
        ExtractBetweenParens = ""
    End If
End Function

Private Function ExtractPolicySubDomainFromTaskName(ByVal s As String) As String
    Dim lowerS As String
    lowerS = LCase$(s)

    Dim pSweep As Long: pSweep = InStr(1, lowerS, "sweep", vbTextCompare)
    If pSweep = 0 Then ExtractPolicySubDomainFromTaskName = "": Exit Function

    Dim p2 As Long: p2 = InStr(pSweep, lowerS, "2", vbTextCompare)
    If p2 = 0 Then ExtractPolicySubDomainFromTaskName = "": Exit Function

    Dim pDash As Long: pDash = InStr(p2, lowerS, "-", vbTextCompare)
    If pDash = 0 Then ExtractPolicySubDomainFromTaskName = "": Exit Function

    Dim startPos As Long: startPos = pDash + 1
    Do While startPos <= Len(s) And Mid$(s, startPos, 1) = " "
        startPos = startPos + 1
    Loop

    Dim pParen As Long: pParen = InStrRev(s, "(")

    Dim pol As String
    If pParen > 0 And pParen > startPos Then
        pol = Mid$(s, startPos, pParen - startPos)
    Else
        pol = Mid$(s, startPos)
    End If

    ExtractPolicySubDomainFromTaskName = Trim$(pol)
End Function

Private Function ExtractPrefixUpToSweep2Dash(ByVal s As String) As String
    Dim lowerS As String
    lowerS = LCase$(s)

    Dim pSweep As Long: pSweep = InStr(1, lowerS, "sweep", vbTextCompare)
    If pSweep = 0 Then ExtractPrefixUpToSweep2Dash = "": Exit Function

    Dim p2 As Long: p2 = InStr(pSweep, lowerS, "2", vbTextCompare)
    If p2 = 0 Then ExtractPrefixUpToSweep2Dash = "": Exit Function

    Dim pDash As Long: pDash = InStr(p2, lowerS, "-", vbTextCompare)
    If pDash = 0 Then ExtractPrefixUpToSweep2Dash = "": Exit Function

    Dim endPos As Long: endPos = pDash
    Do While endPos < Len(s) And Mid$(s, endPos + 1, 1) = " "
        endPos = endPos + 1
    Loop

    ExtractPrefixUpToSweep2Dash = Left$(s, endPos)
End Function

Private Function ExtractSnippetFromTaskName(ByVal fullName As String) As String
    Dim pClose As Long: pClose = InStrRev(fullName, ")")
    If pClose = 0 Then ExtractSnippetFromTaskName = "": Exit Function

    Dim afterParen As String
    afterParen = Trim$(Mid$(fullName, pClose + 1))
    If Len(afterParen) = 0 Then ExtractSnippetFromTaskName = "": Exit Function

    If Left$(afterParen, 1) = "-" Then
        ExtractSnippetFromTaskName = Trim$(Mid$(afterParen, 2))
    ElseIf Left$(afterParen, 2) = "- " Then
        ExtractSnippetFromTaskName = Trim$(Mid$(afterParen, 3))
    Else
        ExtractSnippetFromTaskName = ""
    End If
End Function

Private Function IsGoodPrefix(ByVal pref As String) As Boolean
    Dim t As String: t = LCase$(pref)
    If InStr(1, t, "sweep", vbTextCompare) = 0 Then IsGoodPrefix = False: Exit Function
    If InStr(1, t, "2", vbTextCompare) = 0 Then IsGoodPrefix = False: Exit Function
    If InStr(1, t, "-", vbTextCompare) = 0 Then IsGoodPrefix = False: Exit Function
    IsGoodPrefix = True
End Function

