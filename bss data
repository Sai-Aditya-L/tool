Option Explicit

Public Sub Populate_RemediationTasks_From_IssueReportListing2_DEBUG_FIXED()

    Dim dstPath As Variant, srcPath As Variant
    Dim wbD As Workbook, wbS As Workbook
    Dim wsD As Worksheet, wsS As Worksheet
    Dim wsLog As Worksheet, wsDbg As Worksheet

    Dim hdrRowD As Long, hdrRowS As Long
    Dim colTaskName As Long, colIssueId As Long, colDesc As Long, colAssigned As Long, colDue As Long

    Dim colPolSub As Long, colSystems As Long, colQID As Long, colOrigQ As Long
    Dim colPlan As Long, colOwner As Long, colRemDate As Long

    Dim existingMain As Object, existingIssue As Object
    Dim snippetCounts As Object

    Dim wroteCount As Long
    wroteCount = 0

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.EnableEvents = False
    Application.Calculation = xlCalculationManual

    On Error GoTo FailHandler

    'Pick destination file
    dstPath = Application.GetOpenFilename("Excel Files (*.xlsx;*.xlsm), *.xlsx;*.xlsm", , _
                                         "Select Remediation Task file")
    If dstPath = False Then GoTo CleanExit

    Set wbD = Workbooks.Open(CStr(dstPath))
    Set wsD = FindDestSheetByHeader(wbD, "Remediation Task Name")
    If wsD Is Nothing Then Set wsD = wbD.Worksheets(1)

    Set wsLog = GetOrCreateSheet(wbD, "Run Log")
    InitRunLog wsLog

    Set wsDbg = GetOrCreateSheet(wbD, "Debug Sample")
    InitDebugSheet wsDbg

    LogMsg wsLog, "INFO", "START", "Destination sheet: " & wsD.Name

    'Pick source file
    srcPath = Application.GetOpenFilename("Excel Files (*.xlsx;*.xlsm), *.xlsx;*.xlsm", , _
                                         "Select Issue Report file (sheet: Issue Report Listing2)")
    If srcPath = False Then GoTo CleanExit

    Set wbS = Workbooks.Open(CStr(srcPath), ReadOnly:=True)

    On Error Resume Next
    Set wsS = wbS.Worksheets("Issue Report Listing2")
    On Error GoTo FailHandler

    If wsS Is Nothing Then
        MsgBox "Could not find source sheet 'Issue Report Listing2'.", vbCritical
        LogMsg wsLog, "ERROR", "SOURCE", "Missing sheet Issue Report Listing2"
        GoTo CleanExit
    End If

    LogMsg wsLog, "INFO", "SOURCE", "Source sheet: " & wsS.Name

    'DEST headers
    hdrRowD = FindHeaderRowExact(wsD, Array("Remediation Task Name", "Issue Id", "Description", "Assigned to", "Due Date"), 500)
    If hdrRowD = 0 Then
        MsgBox "Destination headers not found.", vbCritical
        LogMsg wsLog, "ERROR", "DEST", "Missing destination headers."
        GoTo CleanExit
    End If

    colTaskName = FindHeaderColumnExact(wsD, hdrRowD, "Remediation Task Name")
    colIssueId = FindHeaderColumnExact(wsD, hdrRowD, "Issue Id")
    colDesc = FindHeaderColumnExact(wsD, hdrRowD, "Description")
    colAssigned = FindHeaderColumnExact(wsD, hdrRowD, "Assigned to")
    colDue = FindHeaderColumnExact(wsD, hdrRowD, "Due Date")

    'SOURCE header row
    hdrRowS = FindBestHeaderRow(wsS, 800)
    If hdrRowS = 0 Then
        MsgBox "Could not detect source header row.", vbCritical
        LogMsg wsLog, "ERROR", "SOURCE", "Header row detection failed."
        GoTo CleanExit
    End If

    colPolSub = FindColByHeaderFuzzy(wsS, hdrRowS, Array("policy sub-domain", "policy sub domain"))
    colSystems = FindColByHeaderFuzzy(wsS, hdrRowS, Array("systems exhibiting the issue"))
    colQID = FindColByHeaderFuzzy(wsS, hdrRowS, Array("question id", "questionid"))
    colOrigQ = FindColByHeaderFuzzy(wsS, hdrRowS, Array("original question"))
    colPlan = FindColByHeaderFuzzy(wsS, hdrRowS, Array("remediation plan"))
    colOwner = FindColByHeaderFuzzy(wsS, hdrRowS, Array("remediation owner"))
    colRemDate = FindColByHeaderFuzzy(wsS, hdrRowS, Array("remediation completion date"))

    If colPolSub = 0 Or colSystems = 0 Or colQID = 0 Or colOrigQ = 0 Or colPlan = 0 Then
        MsgBox "Missing required source columns. Need: Policy Sub-Domain, Systems Exhibiting the Issue, Question ID, Original Question, Remediation Plan.", vbCritical
        LogMsg wsLog, "ERROR", "SOURCE", "Missing required columns."
        GoTo CleanExit
    End If

    LogMsg wsLog, "INFO", "MAP", "hdrRowS=" & hdrRowS & _
        " PolSub=" & ColLetter(colPolSub) & _
        " Systems=" & ColLetter(colSystems) & _
        " QID=" & ColLetter(colQID) & _
        " OrigQ=" & ColLetter(colOrigQ) & _
        " Plan=" & ColLetter(colPlan) & _
        " Owner=" & IIf(colOwner = 0, "NA", ColLetter(colOwner)) & _
        " RemDate=" & IIf(colRemDate = 0, "NA", ColLetter(colRemDate))

    'DEST indexes
    Set existingMain = CreateObject("Scripting.Dictionary")
    Set existingIssue = CreateObject("Scripting.Dictionary")
    BuildDestIndexes wsD, hdrRowD, colTaskName, existingMain, existingIssue

    Set snippetCounts = CreateObject("Scripting.Dictionary")

    Dim lastRowS As Long
    lastRowS = wsS.UsedRange.Row + wsS.UsedRange.Rows.Count - 1

    Dim prefixText As String
    prefixText = "BSS Sweep 2 - "

    'Carry-forward values
    Dim currentPol As String, currentQ As String
    Dim currentPlan As String, currentOwner As String
    Dim currentDue As Variant

    currentPol = ""
    currentQ = ""
    currentPlan = ""
    currentOwner = ""
    currentDue = Empty

    Dim r As Long, dbgRow As Long
    dbgRow = 2

    For r = hdrRowS + 1 To lastRowS

        '--- ALWAYS read/carry first (critical fix) ---
        Dim polCell As String, qCell As String, planCell As String, sysCell As String
        Dim ownerCell As String, dueCell As Variant

        polCell = Trim$(CStr(GetMergedValue(wsS.Cells(r, colPolSub))))
        If Len(polCell) > 0 Then
            currentPol = CanonicalPolicySubDomain(polCell)
            'Optional: reset question/plan when a new policy section starts
            currentQ = ""
            currentPlan = ""
            currentOwner = ""
            currentDue = Empty
        End If

        qCell = Trim$(CStr(GetMergedValue(wsS.Cells(r, colOrigQ))))
        If Len(qCell) > 0 Then currentQ = qCell

        planCell = Trim$(CStr(GetMergedValue(wsS.Cells(r, colPlan))))
        If Len(planCell) > 0 Then currentPlan = planCell

        If colOwner > 0 Then
            ownerCell = Trim$(CStr(GetMergedValue(wsS.Cells(r, colOwner))))
            If Len(ownerCell) > 0 Then currentOwner = ownerCell
        End If

        If colRemDate > 0 Then
            dueCell = GetMergedValue(wsS.Cells(r, colRemDate))
            If Len(Trim$(CStr(dueCell))) > 0 Then currentDue = dueCell
        End If

        '--- NOW evaluate row for writing ---
        Dim qid As String
        qid = Trim$(CStr(GetMergedValue(wsS.Cells(r, colQID))))

        'Skip writing for these, BUT we already carried policy/question/etc
        If LCase$(qid) = "summary" Or LCase$(qid) = "n/a" Or LCase$(qid) = "na" Then
            WriteDebug wsDbg, dbgRow, r, qid, currentPol, LeftSafe(currentQ, 70), "", LeftSafe(currentPlan, 70), "CARRY ONLY: QID=" & qid
            dbgRow = dbgRow + 1
            GoTo NextRow
        End If

        sysCell = Trim$(CStr(GetMergedValue(wsS.Cells(r, colSystems))))

        If Len(sysCell) = 0 Then
            WriteDebug wsDbg, dbgRow, r, qid, currentPol, LeftSafe(currentQ, 70), "", LeftSafe(currentPlan, 70), "SKIP: No Systems/Entity"
            dbgRow = dbgRow + 1
            GoTo NextRow
        End If

        If Len(Trim$(currentPol)) = 0 Then
            WriteDebug wsDbg, dbgRow, r, qid, "", LeftSafe(currentQ, 70), LeftSafe(sysCell, 70), LeftSafe(currentPlan, 70), "SKIP: No Policy (carry failed)"
            dbgRow = dbgRow + 1
            GoTo NextRow
        End If

        If Len(Trim$(currentQ)) = 0 Then
            WriteDebug wsDbg, dbgRow, r, qid, currentPol, "", LeftSafe(sysCell, 70), LeftSafe(currentPlan, 70), "SKIP: No Original Question (carry failed)"
            dbgRow = dbgRow + 1
            GoTo NextRow
        End If

        If Len(Trim$(currentPlan)) = 0 Then
            WriteDebug wsDbg, dbgRow, r, qid, currentPol, LeftSafe(currentQ, 70), LeftSafe(sysCell, 70), "", "SKIP: No Remediation Plan (carry failed)"
            dbgRow = dbgRow + 1
            GoTo NextRow
        End If

        Dim entities As Collection, e As Variant
        Set entities = ParseEntities(sysCell)

        If entities.Count = 0 Then
            WriteDebug wsDbg, dbgRow, r, qid, currentPol, LeftSafe(currentQ, 70), LeftSafe(sysCell, 70), LeftSafe(currentPlan, 70), "SKIP: ParseEntities=0"
            dbgRow = dbgRow + 1
            GoTo NextRow
        End If

        For Each e In entities
            Dim entityDisplay As String, entityKey As String
            entityDisplay = CleanEntity(CStr(e))
            entityKey = NormalizeKey(entityDisplay)
            If Len(entityKey) = 0 Then GoTo NextEntity

            Dim keyMain As String
            keyMain = entityKey & "||" & NormalizeKey(currentPol)

            If Not existingMain.Exists(keyMain) Then
                UpsertMainRow wsD, hdrRowD, colTaskName, colIssueId, colDesc, colAssigned, colDue, _
                              existingMain, keyMain, prefixText, currentPol, entityDisplay, _
                              currentPlan, currentOwner, currentDue
                wroteCount = wroteCount + 1
                WriteDebug wsDbg, dbgRow, r, qid, currentPol, LeftSafe(currentQ, 70), entityDisplay, LeftSafe(currentPlan, 70), "WRITE: Main"
                dbgRow = dbgRow + 1
            Else
                Dim snip As String, baseKey As String, uniqSnip As String
                snip = MakeIntentSnippet(currentQ)
                If Len(snip) = 0 Then snip = "Additional"

                baseKey = keyMain & "||" & NormalizeKey(snip)
                If snippetCounts.Exists(baseKey) Then
                    snippetCounts(baseKey) = CLng(snippetCounts(baseKey)) + 1
                    uniqSnip = snip & " " & CStr(snippetCounts(baseKey))
                Else
                    snippetCounts.Add baseKey, 1
                    uniqSnip = snip
                End If

                UpsertIssueRow wsD, hdrRowD, colTaskName, colIssueId, colDesc, colAssigned, colDue, _
                               existingMain, existingIssue, keyMain, NormalizeKey(uniqSnip), _
                               prefixText, currentPol, entityDisplay, uniqSnip, _
                               currentPlan, currentOwner, currentDue
                wroteCount = wroteCount + 1
                WriteDebug wsDbg, dbgRow, r, qid, currentPol, LeftSafe(currentQ, 70), entityDisplay, LeftSafe(currentPlan, 70), "WRITE: Extra"
                dbgRow = dbgRow + 1
            End If

NextEntity:
        Next e

NextRow:
        If dbgRow > 400 Then Exit For
    Next r

    LogMsg wsLog, "INFO", "END", "Run complete. Rows written=" & wroteCount

    If wroteCount = 0 Then
        MsgBox "Run complete, but 0 rows were written." & vbCrLf & _
               "Check 'Debug Sample' actions. This version should now carry Policy even when QID=N/A.", vbExclamation
    Else
        MsgBox "Done! Rows written: " & wroteCount, vbInformation
    End If

CleanExit:
    On Error Resume Next
    If Not wbS Is Nothing Then wbS.Close SaveChanges:=False

    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
    Application.EnableEvents = True
    Application.Calculation = xlCalculationAutomatic
    Exit Sub

FailHandler:
    LogMsg wsLog, "ERROR", "VBA", "Error " & Err.Number & ": " & Err.Description
    MsgBox "Error " & Err.Number & vbCrLf & Err.Description, vbCritical
    Resume CleanExit
End Sub

