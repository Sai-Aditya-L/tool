Private Function GetOrCreateLogSheet(ByVal wb As Workbook, ByVal sheetName As String) As Worksheet
    On Error Resume Next
    Set GetOrCreateLogSheet = wb.Worksheets(sheetName)
    On Error GoTo 0
    If GetOrCreateLogSheet Is Nothing Then
        Set GetOrCreateLogSheet = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))
        GetOrCreateLogSheet.Name = sheetName
    End If
End Function

Private Sub InitLog(ByVal wsLog As Worksheet)
    wsLog.Cells.Clear
    wsLog.Range("A1:E1").Value = Array("Timestamp", "Status", "Entity", "Policy Sub-Domain", "Message")
    wsLog.Columns("A:E").EntireColumn.AutoFit
End Sub

Private Sub LogEvent(ByVal wsLog As Worksheet, ByVal status As String, ByVal entity As String, _
                     ByVal policySub As String, ByVal rowNum As Variant, ByVal message As String)
    Dim nextRow As Long
    nextRow = wsLog.Cells(wsLog.Rows.Count, 1).End(xlUp).Row + 1
    If nextRow < 2 Then nextRow = 2
    wsLog.Cells(nextRow, 1).Value = Now
    wsLog.Cells(nextRow, 2).Value = status
    wsLog.Cells(nextRow, 3).Value = entity
    wsLog.Cells(nextRow, 4).Value = policySub
    wsLog.Cells(nextRow, 5).Value = message
End Sub