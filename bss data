Private Function GetMergedValue(ByVal cell As Range) As Variant
    If cell.MergeCells Then
        GetMergedValue = cell.MergeArea.Cells(1, 1).Value
    Else
        GetMergedValue = cell.Value
    End If
End Function

Private Function NormalizeKey(ByVal s As String) As String
    Dim t As String
    t = LCase$(Trim$(CStr(s)))
    t = Replace(t, vbCrLf, " ")
    t = Replace(t, vbCr, " ")
    t = Replace(t, vbLf, " ")
    t = Replace(t, ChrW(160), " ")
    Do While InStr(t, "  ") > 0
        t = Replace(t, "  ", " ")
    Loop
    NormalizeKey = t
End Function

Private Function NormalizeSpaces(ByVal s As String) As String
    Dim t As String
    t = Trim$(CStr(s))
    t = Replace(t, vbCrLf, " ")
    t = Replace(t, vbCr, " ")
    t = Replace(t, vbLf, " ")
    t = Replace(t, ChrW(160), " ")

    ' Strip punctuation that breaks tokens but keep meaning
    Dim ch As Variant
    For Each ch In Array("?", ".", ",", ";", ":", "(", ")", "[", "]", "{", "}", """")
        t = Replace(t, CStr(ch), " ")
    Next ch

    Do While InStr(t, "  ") > 0
        t = Replace(t, "  ", " ")
    Loop

    NormalizeSpaces = Trim$(t)
End Function

Private Function AppendNewDestRow(ByVal ws As Worksheet, ByVal hdrRow As Long, ByVal colAnchor As Long) As Long
    Dim outRow As Long
    outRow = ws.Cells(ws.Rows.Count, colAnchor).End(xlUp).Row + 1
    If outRow <= hdrRow Then outRow = hdrRow + 1
    AppendNewDestRow = outRow
End Function

Private Sub WriteDateSmart(ByVal targetCell As Range, ByVal v As Variant)
    If Len(Trim$(CStr(v))) = 0 Then
        targetCell.Value = ""
    ElseIf IsDate(v) Then
        targetCell.Value = CDate(v)
    Else
        targetCell.Value = CStr(v)
    End If
End Sub

Private Function FindLastRowMulti(ByVal ws As Worksheet, ByVal cols As Variant) As Long
    Dim i As Long, c As Long, lastR As Long
    lastR = 0
    For i = LBound(cols) To UBound(cols)
        c = CLng(cols(i))
        If c > 0 Then
            Dim r As Long
            r = ws.Cells(ws.Rows.Count, c).End(xlUp).Row
            If r > lastR Then lastR = r
        End If
    Next i
    FindLastRowMulti = lastR
End Function


'============================================================
' SAVE SAFELY (fixes Error 1004 Save failures)
'============================================================
Private Function SaveWorkbookSafe(ByVal wb As Workbook) As Boolean
    On Error GoTo SaveFail

    If wb.ReadOnly Then GoTo SaveFail

    wb.Save
    SaveWorkbookSafe = True
    Exit Function

SaveFail:
    On Error Resume Next

    Dim basePath As String, baseName As String, ext As String
    baseName = wb.Name

    If InStrRev(baseName, ".") > 0 Then
        ext = Mid$(baseName, InStrRev(baseName, "."))
        baseName = Left$(baseName, InStrRev(baseName, ".") - 1)
    Else
        ext = ".xlsx"
    End If

    basePath = CreateObject("WScript.Shell").SpecialFolders("Desktop")

    Dim copyPath As String
    copyPath = basePath & "\" & baseName & "_autosave_" & Format(Now, "yyyymmdd_hhnnss") & ext

    wb.SaveCopyAs copyPath
    MsgBox "Excel couldn't overwrite the original file, so I saved a copy here:" & vbCrLf & copyPath, vbExclamation

    SaveWorkbookSafe = False
End Function


