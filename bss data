Private Function FindBestHeaderRow(ByVal ws As Worksheet, ByVal maxRowsToScan As Long) As Long
    Dim r As Long, bestR As Long, bestScore As Long
    bestR = 0: bestScore = 0

    For r = 1 To maxRowsToScan
        Dim score As Long: score = 0
        If FindColByHeaderFuzzy(ws, r, Array("policy sub-domain", "policy sub domain")) > 0 Then score = score + 2
        If FindColByHeaderFuzzy(ws, r, Array("systems exhibiting the issue")) > 0 Then score = score + 3
        If FindColByHeaderFuzzy(ws, r, Array("question id", "questionid")) > 0 Then score = score + 2
        If FindColByHeaderFuzzy(ws, r, Array("original question")) > 0 Then score = score + 2
        If FindColByHeaderFuzzy(ws, r, Array("remediation plan")) > 0 Then score = score + 3
        If FindColByHeaderFuzzy(ws, r, Array("remediation owner")) > 0 Then score = score + 1
        If FindColByHeaderFuzzy(ws, r, Array("remediation completion date")) > 0 Then score = score + 1

        If score > bestScore Then
            bestScore = score
            bestR = r
            If bestScore >= 12 Then Exit For
        End If
    Next r

    If bestScore >= 10 Then FindBestHeaderRow = bestR Else FindBestHeaderRow = 0
End Function

Private Function FindColByHeaderFuzzy(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal headerCandidates As Variant) As Long
    Dim lastCol As Long, c As Long
    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column

    For c = 1 To lastCol
        Dim hv As String
        hv = NormalizeKey(CStr(ws.Cells(headerRow, c).Value))
        If Len(hv) > 0 Then
            Dim i As Long
            For i = LBound(headerCandidates) To UBound(headerCandidates)
                If hv = NormalizeKey(CStr(headerCandidates(i))) Then
                    FindColByHeaderFuzzy = c
                    Exit Function
                End If
            Next i
        End If
    Next c
    FindColByHeaderFuzzy = 0
End Function

Private Function CanonicalPolicySubDomain(ByVal pol As String) As String
    Dim t As String: t = Trim$(CStr(pol))
    Do While InStr(t, "  ") > 0: t = Replace(t, "  ", " "): Loop
    If LCase$(t) = LCase$("Secure Authentication - MFA") Then
        CanonicalPolicySubDomain = "Multifactor Authentication"
    Else
        CanonicalPolicySubDomain = t
    End If
End Function

Private Function ParseEntities(ByVal raw As String) As Collection
    Dim c As New Collection
    Dim t As String: t = Trim$(CStr(raw))
    If Len(t) = 0 Then Set ParseEntities = c: Exit Function

    t = Replace(t, vbCrLf, vbLf)
    t = Replace(t, vbCr, vbLf)
    t = Replace(t, ";", vbLf)

    Dim parts() As String: parts = Split(t, vbLf)
    Dim i As Long
    For i = LBound(parts) To UBound(parts)
        Dim p As String: p = CleanEntity(Trim$(parts(i)))
        If Len(p) > 0 Then c.Add p
    Next i
    Set ParseEntities = c
End Function

Private Function CleanEntity(ByVal s As String) As String
    Dim t As String: t = Trim$(s)
    If Len(t) = 0 Then CleanEntity = "": Exit Function
    t = Replace(t, ChrW(9679), "")
    t = Replace(t, "•", "")
    t = Replace(t, "·", "")
    t = Trim$(t)
    Do While Left$(t, 1) = "-" Or Left$(t, 1) = "–" Or Left$(t, 1) = "—"
        t = Trim$(Mid$(t, 2))
    Loop
    CleanEntity = t
End Function

Private Function MakeIntentSnippet(ByVal q As String) As String
    Dim t As String: t = LCase$(Trim$(q))
    If InStr(t, "sast") > 0 Or InStr(t, "static application security") > 0 Then MakeIntentSnippet = "SAST testing": Exit Function
    If InStr(t, "sca") > 0 Or InStr(t, "software composition") > 0 Then MakeIntentSnippet = "SCA scanning": Exit Function
    If InStr(t, "penetration") > 0 Or InStr(t, "pen test") > 0 Then MakeIntentSnippet = "Penetration testing": Exit Function
    If InStr(t, "vulnerability") > 0 Or InStr(t, "scan") > 0 Then MakeIntentSnippet = "Vulnerability scanning": Exit Function
    If InStr(t, "recert") > 0 Or (InStr(t, "periodic") > 0 And InStr(t, "review") > 0) Then MakeIntentSnippet = "Access recertification": Exit Function
    If InStr(t, "service account") > 0 Then MakeIntentSnippet = "Service account lifecycle": Exit Function
    If InStr(t, "separate") > 0 And InStr(t, "admin") > 0 Then MakeIntentSnippet = "Separate admin accounts": Exit Function
    MakeIntentSnippet = LeftSafe(q, 70)
End Function

Private Function GetMergedValue(ByVal cell As Range) As Variant
    If cell.MergeCells Then GetMergedValue = cell.MergeArea.Cells(1, 1).Value Else GetMergedValue = cell.Value
End Function

Private Function NormalizeKey(ByVal s As String) As String
    Dim t As String
    t = LCase$(Trim$(CStr(s)))
    t = Replace(t, vbCrLf, " ")
    t = Replace(t, vbCr, " ")
    t = Replace(t, vbLf, " ")
    Do While InStr(t, "  ") > 0: t = Replace(t, "  ", " "): Loop
    NormalizeKey = t
End Function

Private Function LeftSafe(ByVal s As String, ByVal n As Long) As String
    s = Trim$(CStr(s))
    If Len(s) <= n Then LeftSafe = s Else LeftSafe = Left$(s, n) & "…"
End Function

Private Function ColLetter(ByVal colNum As Long) As String
    ColLetter = Split(Cells(1, colNum).Address(True, False), "$")(0)
End Function

'--- DEST sheet finding + headers ---
Private Function FindDestSheetByHeader(ByVal wb As Workbook, ByVal headerText As String) As Worksheet
    Dim ws As Worksheet
    For Each ws In wb.Worksheets
        If SheetHasHeader(ws, headerText, 600) Then
            Set FindDestSheetByHeader = ws
            Exit Function
        End If
    Next ws
    Set FindDestSheetByHeader = Nothing
End Function

Private Function SheetHasHeader(ByVal ws As Worksheet, ByVal headerText As String, ByVal maxRows As Long) As Boolean
    Dim r As Long, c As Long, lastCol As Long
    For r = 1 To maxRows
        lastCol = ws.Cells(r, ws.Columns.Count).End(xlToLeft).Column
        For c = 1 To lastCol
            If StrComp(Trim$(CStr(ws.Cells(r, c).Value)), headerText, vbTextCompare) = 0 Then
                SheetHasHeader = True
                Exit Function
            End If
        Next c
    Next r
    SheetHasHeader = False
End Function

Private Function FindHeaderRowExact(ByVal ws As Worksheet, ByVal headers As Variant, ByVal maxRowsToScan As Long) As Long
    Dim r As Long, i As Long
    For r = 1 To maxRowsToScan
        For i = LBound(headers) To UBound(headers)
            If FindHeaderColumnExact(ws, r, CStr(headers(i))) = 0 Then GoTo NextR
        Next i
        FindHeaderRowExact = r
        Exit Function
NextR:
    Next r
    FindHeaderRowExact = 0
End Function

Private Function FindHeaderColumnExact(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal headerText As String) As Long
    Dim lastCol As Long, c As Long
    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    For c = 1 To lastCol
        If StrComp(Trim$(CStr(ws.Cells(headerRow, c).Value)), headerText, vbTextCompare) = 0 Then
            FindHeaderColumnExact = c
            Exit Function
        End If
    Next c
    FindHeaderColumnExact = 0
End Function

'--- DEST indexing + upserts ---
Private Sub BuildDestIndexes(ByVal wsD As Worksheet, ByVal hdrRowD As Long, ByVal colTaskName As Long, _
                            ByVal existingMain As Object, ByVal existingIssue As Object)
    Dim lastRow As Long, r As Long
    lastRow = wsD.Cells(wsD.Rows.Count, colTaskName).End(xlUp).Row
    For r = hdrRowD + 1 To lastRow
        Dim t As String: t = Trim$(CStr(wsD.Cells(r, colTaskName).Value))
        If Len(t) = 0 Then GoTo NextR
        Dim ent As String: ent = ExtractBetweenParens(t)
        Dim pol As String: pol = CanonicalPolicySubDomain(ExtractPolicySubDomainFromTaskName(t))
        Dim snip As String: snip = ExtractSnippetFromTaskName(t)

        If Len(ent) > 0 And Len(pol) > 0 Then
            Dim keyMain As String: keyMain = NormalizeKey(ent) & "||" & NormalizeKey(pol)
            If Len(snip) = 0 Then
                If Not existingMain.Exists(keyMain) Then existingMain.Add keyMain, r
            Else
                Dim keyIssue As String: keyIssue = keyMain & "||" & NormalizeKey(snip)
                If Not existingIssue.Exists(keyIssue) Then existingIssue.Add keyIssue, r
            End If
        End If
NextR:
    Next r
End Sub

Private Sub UpsertMainRow(ByVal wsD As Worksheet, ByVal hdrRowD As Long, _
    ByVal colTaskName As Long, ByVal colIssueId As Long, ByVal colDesc As Long, ByVal colAssigned As Long, ByVal colDue As Long, _
    ByVal existingMain As Object, ByVal keyMain As String, _
    ByVal prefixText As String, ByVal pol As String, ByVal entityDisplay As String, _
    ByVal planText As String, ByVal ownerText As String, ByVal dueVal As Variant)

    Dim rowNum As Long
    If existingMain.Exists(keyMain) Then
        rowNum = CLng(existingMain(keyMain))
    Else
        rowNum = AppendNewDestRow(wsD, hdrRowD, colTaskName)
        wsD.Cells(rowNum, colTaskName).Value = prefixText & pol & " (" & entityDisplay & ")"
        existingMain.Add keyMain, rowNum
    End If

    wsD.Cells(rowNum, colDesc).Value = planText
    wsD.Cells(rowNum, colAssigned).Value = ownerText
    WriteDateSmart wsD.Cells(rowNum, colDue), dueVal
End Sub

Private Sub UpsertIssueRow(ByVal wsD As Worksheet, ByVal hdrRowD As Long, _
    ByVal colTaskName As Long, ByVal colIssueId As Long, ByVal colDesc As Long, ByVal colAssigned As Long, ByVal colDue As Long, _
    ByVal existingMain As Object, ByVal existingIssue As Object, _
    ByVal keyMain As String, ByVal snippetKeyNorm As String, _
    ByVal prefixText As String, ByVal pol As String, ByVal entityDisplay As String, ByVal snippet As String, _
    ByVal planText As String, ByVal ownerText As String, ByVal dueVal As Variant)

    Dim keyIssue As String: keyIssue = keyMain & "||" & snippetKeyNorm

    Dim rowNum As Long
    If existingIssue.Exists(keyIssue) Then
        rowNum = CLng(existingIssue(keyIssue))
    Else
        rowNum = AppendNewDestRow(wsD, hdrRowD, colTaskName)
        wsD.Cells(rowNum, colTaskName).Value = prefixText & pol & " (" & entityDisplay & ") - " & snippet
        existingIssue.Add keyIssue, rowNum
    End If

    wsD.Cells(rowNum, colDesc).Value = planText
    wsD.Cells(rowNum, colAssigned).Value = ownerText
    WriteDateSmart wsD.Cells(rowNum, colDue), dueVal

    If existingMain.Exists(keyMain) Then
        Dim mainRow As Long: mainRow = CLng(existingMain(keyMain))
        Dim mainIssueId As String: mainIssueId = Trim$(CStr(wsD.Cells(mainRow, colIssueId).Value))
        If Len(mainIssueId) > 0 Then wsD.Cells(rowNum, colIssueId).Value = mainIssueId
    End If
End Sub

Private Function AppendNewDestRow(ByVal ws As Worksheet, ByVal hdrRow As Long, ByVal colAnchor As Long) As Long
    Dim outRow As Long
    outRow = ws.Cells(ws.Rows.Count, colAnchor).End(xlUp).Row + 1
    If outRow <= hdrRow Then outRow = hdrRow + 1
    AppendNewDestRow = outRow
End Function

Private Sub WriteDateSmart(ByVal targetCell As Range, ByVal v As Variant)
    If Len(Trim$(CStr(v))) = 0 Then
        targetCell.Value = ""
    ElseIf IsDate(v) Then
        targetCell.Value = CDate(v)
    Else
        targetCell.Value = CStr(v)
    End If
End Sub

'--- Task name parsing ---
Private Function ExtractBetweenParens(ByVal s As String) As String
    Dim p1 As Long, p2 As Long
    p1 = InStrRev(s, "("): p2 = InStrRev(s, ")")
    If p1 > 0 And p2 > p1 Then ExtractBetweenParens = Trim$(Mid$(s, p1 + 1, p2 - p1 - 1)) Else ExtractBetweenParens = ""
End Function

Private Function ExtractPolicySubDomainFromTaskName(ByVal s As String) As String
    Dim lowerS As String: lowerS = LCase$(s)
    Dim pDash As Long: pDash = InStr(1, lowerS, "-", vbTextCompare)
    If pDash = 0 Then ExtractPolicySubDomainFromTaskName = "": Exit Function
    Dim pParen As Long: pParen = InStrRev(s, "(")
    If pParen = 0 Then
        ExtractPolicySubDomainFromTaskName = Trim$(Mid$(s, pDash + 1))
    Else
        ExtractPolicySubDomainFromTaskName = Trim$(Mid$(s, pDash + 1, pParen - (pDash + 1)))
    End If
End Function

Private Function ExtractSnippetFromTaskName(ByVal fullName As String) As String
    Dim pClose As Long: pClose = InStrRev(fullName, ")")
    If pClose = 0 Then ExtractSnippetFromTaskName = "": Exit Function
    Dim afterParen As String: afterParen = Trim$(Mid$(fullName, pClose + 1))
    If Len(afterParen) = 0 Then ExtractSnippetFromTaskName = "": Exit Function
    If Left$(afterParen, 1) = "-" Then ExtractSnippetFromTaskName = Trim$(Mid$(afterParen, 2)) Else ExtractSnippetFromTaskName = ""
End Function

'--- Log + Debug sheets ---
Private Function GetOrCreateSheet(ByVal wb As Workbook, ByVal sheetName As String) As Worksheet
    On Error Resume Next
    Set GetOrCreateSheet = wb.Worksheets(sheetName)
    On Error GoTo 0
    If GetOrCreateSheet Is Nothing Then
        Set GetOrCreateSheet = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))
        GetOrCreateSheet.Name = sheetName
    End If
End Function

Private Sub InitRunLog(ByVal ws As Worksheet)
    ws.Cells.Clear
    ws.Range("A1:D1").Value = Array("Timestamp", "Level", "Step", "Message")
    ws.Columns("A:D").EntireColumn.AutoFit
End Sub

Private Sub LogMsg(ByVal ws As Worksheet, ByVal level As String, ByVal stepName As String, ByVal msg As String)
    Dim nr As Long
    nr = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row + 1
    If nr < 2 Then nr = 2
    ws.Cells(nr, 1).Value = Now
    ws.Cells(nr, 2).Value = level
    ws.Cells(nr, 3).Value = stepName
    ws.Cells(nr, 4).Value = msg
End Sub

Private Sub InitDebugSheet(ByVal ws As Worksheet)
    ws.Cells.Clear
    ws.Range("A1:I1").Value = Array("Row#", "QID", "Policy (carried)", "Question (carried)", "Entity/Systems", "Plan (carried)", "Action", "Notes", "Raw Systems Preview")
    ws.Columns("A:I").ColumnWidth = 28
    ws.Columns("A:A").ColumnWidth = 8
    ws.Rows(1).Font.Bold = True
End Sub

Private Sub WriteDebug(ByVal ws As Worksheet, ByVal outRow As Long, ByVal srcRow As Long, _
                       ByVal qid As String, ByVal pol As String, ByVal q As String, _
                       ByVal sys As String, ByVal plan As String, ByVal action As String)
    ws.Cells(outRow, 1).Value = srcRow
    ws.Cells(outRow, 2).Value = qid
    ws.Cells(outRow, 3).Value = pol
    ws.Cells(outRow, 4).Value = q
    ws.Cells(outRow, 5).Value = sys
    ws.Cells(outRow, 6).Value = plan
    ws.Cells(outRow, 7).Value = action
    ws.Cells(outRow, 8).Value = ""
    ws.Cells(outRow, 9).Value = sys
End Sub