Private Function FallbackSnippet(ByVal s As String) As String
    Dim t As String
    t = NormalizeSpaces(s)
    t = StripCommonQuestionLead(t)

    Dim words() As String
    words = Split(t, " ")

    Dim out As String, i As Long, cnt As Long
    out = "": cnt = 0
    For i = LBound(words) To UBound(words)
        Dim w As String
        w = Trim$(words(i))
        If Len(w) > 0 Then
            If Not IsStopWord(LCase$(w)) Then
                If out = "" Then out = w Else out = out & " " & w
                cnt = cnt + 1
                If cnt >= 4 Then Exit For
            End If
        End If
    Next i

    If Len(out) = 0 Then out = Left$(t, 40)
    FallbackSnippet = ProperWords(out)
End Function

Private Function StripCommonQuestionLead(ByVal s As String) As String
    Dim t As String
    t = Trim$(s)

    ' remove common leading phrases
    Dim leads As Variant, i As Long
    leads = Array("Do you ", "Is there ", "Are there ", "Are you ", "Have you ", "Does ", "Is ", "Are ", "If yes,", "If yes, ")
    For i = LBound(leads) To UBound(leads)
        If LCase$(Left$(t, Len(CStr(leads(i))))) = LCase$(CStr(leads(i))) Then
            t = Mid$(t, Len(CStr(leads(i))) + 1)
            Exit For
        End If
    Next i

    StripCommonQuestionLead = Trim$(t)
End Function

Private Function IsStopWord(ByVal w As String) As Boolean
    Select Case w
        Case "the", "a", "an", "and", "or", "to", "of", "in", "on", "for", "with", "without", _
             "is", "are", "was", "were", "be", "been", "being", _
             "do", "does", "did", "can", "could", "should", "would", "will", _
             "have", "has", "had", "may", "might", "must", _
             "you", "your", "we", "our", "they", "their", "it", "this", "that", "these", "those", _
             "when", "where", "what", "which", "who", "whom", "why", "how", _
             "if", "then", "than", "as", "at", "by", "from", "into", "up", "down", _
             "not", "no", "yes", "n/a", "na"
            IsStopWord = True
        Case Else
            IsStopWord = False
    End Select
End Function


'============================================================
' TASK NAME PARSING (DEST) - safer to avoid "question inside ()"
'============================================================
Private Function ExtractEntityFromTaskName(ByVal s As String) As String
    ' Entity is the LAST (...) before the optional " - snippet"
    ' Example: "DTS Sweep 2 - Access Control (1724 Bynder_...) - Access provisioning approvals"
    Dim pClose As Long, pOpen As Long
    pClose = InStrRev(s, ")")
    If pClose = 0 Then
        ExtractEntityFromTaskName = ""
        Exit Function
    End If

    pOpen = InStrRev(s, "(", pClose)
    If pOpen = 0 Then
        ExtractEntityFromTaskName = ""
        Exit Function
    End If

    ExtractEntityFromTaskName = Trim$(Mid$(s, pOpen + 1, pClose - pOpen - 1))
End Function

Private Function ExtractPolicyFromTaskName(ByVal s As String) As String
    ' Extract between "Sweep 2 - " and " (entity"
    Dim lowerS As String
    lowerS = LCase$(s)

    Dim pSweep As Long: pSweep = InStr(1, lowerS, "sweep", vbTextCompare)
    If pSweep = 0 Then ExtractPolicyFromTaskName = "": Exit Function

    Dim p2 As Long: p2 = InStr(pSweep, lowerS, "2", vbTextCompare)
    If p2 = 0 Then ExtractPolicyFromTaskName = "": Exit Function

    Dim pDash As Long: pDash = InStr(p2, lowerS, "-", vbTextCompare)
    If pDash = 0 Then ExtractPolicyFromTaskName = "": Exit Function

    Dim startPos As Long: startPos = pDash + 1
    Do While startPos <= Len(s) And Mid$(s, startPos, 1) = " "
        startPos = startPos + 1
    Loop

    Dim pParen As Long
    pParen = InStrRev(s, "(")
    If pParen <= startPos Then
        ExtractPolicyFromTaskName = Trim$(Mid$(s, startPos))
        Exit Function
    End If

    ExtractPolicyFromTaskName = Trim$(Mid$(s, startPos, pParen - startPos))
End Function

Private Function ExtractPrefixUpToSweep2Dash(ByVal s As String) As String
    Dim lowerS As String
    lowerS = LCase$(s)

    Dim pSweep As Long: pSweep = InStr(1, lowerS, "sweep", vbTextCompare)
    If pSweep = 0 Then ExtractPrefixUpToSweep2Dash = "": Exit Function

    Dim p2 As Long: p2 = InStr(pSweep, lowerS, "2", vbTextCompare)
    If p2 = 0 Then ExtractPrefixUpToSweep2Dash = "": Exit Function

    Dim pDash As Long: pDash = InStr(p2, lowerS, "-", vbTextCompare)
    If pDash = 0 Then ExtractPrefixUpToSweep2Dash = "": Exit Function

    Dim endPos As Long: endPos = pDash
    Do While endPos < Len(s) And Mid$(s, endPos + 1, 1) = " "
        endPos = endPos + 1
    Loop

    ExtractPrefixUpToSweep2Dash = Left$(s, endPos)
End Function

Private Function ExtractSnippetAfterEntity(ByVal fullName As String) As String
    Dim pClose As Long: pClose = InStrRev(fullName, ")")
    If pClose = 0 Then ExtractSnippetAfterEntity = "": Exit Function

    Dim afterParen As String
    afterParen = Trim$(Mid$(fullName, pClose + 1))
    If Len(afterParen) = 0 Then ExtractSnippetAfterEntity = "": Exit Function

    If Left$(afterParen, 1) = "-" Then
        ExtractSnippetAfterEntity = Trim$(Mid$(afterParen, 2))
    ElseIf Left$(afterParen, 2) = "- " Then
        ExtractSnippetAfterEntity = Trim$(Mid$(afterParen, 3))
    Else
        ExtractSnippetAfterEntity = ""
    End If
End Function


