Option Explicit

'============================================================
' MAIN ENTRY
'============================================================
Public Sub Populate_RemediationTasks_From_IssueReportListing2()

    Dim dstPath As Variant, srcPath As Variant
    Dim wbD As Workbook, wsD As Worksheet
    Dim wbS As Workbook, wsS As Worksheet
    Dim wsLog As Worksheet

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.EnableEvents = False
    Application.Calculation = xlCalculationManual

    On Error GoTo FailHandler

    '--------------------------
    ' Pick destination file
    '--------------------------
    dstPath = Application.GetOpenFilename("Excel Files (*.xlsx;*.xlsm), *.xlsx;*.xlsm", , _
                                         "Select Remediation Task file")
    If dstPath = False Then GoTo CleanExit

    Set wbD = Workbooks.Open(CStr(dstPath))

    Set wsD = FindDestSheetByHeader(wbD, "Remediation Task Name")
    If wsD Is Nothing Then Set wsD = wbD.Worksheets(1)

    '--------------------------
    ' Pick source file
    '--------------------------
    srcPath = Application.GetOpenFilename("Excel Files (*.xlsx;*.xlsm), *.xlsx;*.xlsm", , _
                                         "Select Issue Report file (Issue Report Listing2)")
    If srcPath = False Then GoTo CleanExit

    Set wbS = Workbooks.Open(CStr(srcPath), ReadOnly:=True)

    On Error Resume Next
    Set wsS = wbS.Worksheets("Issue Report Listing2")
    On Error GoTo FailHandler

    If wsS Is Nothing Then
        MsgBox "Could not find source sheet 'Issue Report Listing2' in the Issue Report workbook.", vbCritical
        GoTo CleanExit
    End If

    '--------------------------
    ' Logging
    '--------------------------
    Set wsLog = GetOrCreateLogSheet(wbD, "Run Log")
    InitLog wsLog
    LogEvent wsLog, "INFO", "", "", "", "Started run (source sheet: Issue Report Listing2)."

    '============================================================
    ' DEST HEADERS
    '============================================================
    Dim hdrRowD As Long
    Dim colTaskName As Long, colIssueId As Long, colDesc As Long, colAssigned As Long, colDue As Long

    hdrRowD = FindHeaderRowExact(wsD, Array("Remediation Task Name", "Issue Id", "Description", "Assigned to", "Due Date"), 400)
    If hdrRowD = 0 Then
        MsgBox "Could not find required headers in destination Remediation Task sheet.", vbCritical
        LogEvent wsLog, "ERROR", "", "", "", "Missing destination headers."
        GoTo CleanExit
    End If

    colTaskName = FindHeaderColumnExact(wsD, hdrRowD, "Remediation Task Name")
    colIssueId = FindHeaderColumnExact(wsD, hdrRowD, "Issue Id")
    colDesc = FindHeaderColumnExact(wsD, hdrRowD, "Description")
    colAssigned = FindHeaderColumnExact(wsD, hdrRowD, "Assigned to")
    colDue = FindHeaderColumnExact(wsD, hdrRowD, "Due Date")

    wsD.Columns(colTaskName).NumberFormat = "@"
    wsD.Columns(colIssueId).NumberFormat = "@"
    wsD.Columns(colDesc).NumberFormat = "@"
    wsD.Columns(colAssigned).NumberFormat = "@"
    wsD.Columns(colDue).NumberFormat = "m/d/yyyy"

    '============================================================
    ' SOURCE HEADERS
    '============================================================
    Dim hdrRowS As Long
    hdrRowS = FindSourceHeaderRow(wsS, 800)
    If hdrRowS = 0 Then
        MsgBox "Could not find header row in 'Issue Report Listing2'.", vbCritical
        LogEvent wsLog, "ERROR", "", "", "", "Missing source headers."
        GoTo CleanExit
    End If

    Dim colPolSub As Long, colSystems As Long, colQID As Long, colOrigQ As Long
    Dim colPlan As Long, colOwner As Long, colRemDate As Long

    colPolSub = FindColByKeywords(wsS, hdrRowS, Array("policy", "sub", "domain"))
    colSystems = FindColByKeywords(wsS, hdrRowS, Array("systems", "exhibiting", "issue"))
    colQID = FindColByKeywords(wsS, hdrRowS, Array("question", "id"))
    colOrigQ = FindColByKeywords(wsS, hdrRowS, Array("original", "question"))
    colPlan = FindColByKeywords(wsS, hdrRowS, Array("remediation", "plan"))
    colOwner = FindColByKeywords(wsS, hdrRowS, Array("remediation", "owner"))
    colRemDate = FindColByKeywords(wsS, hdrRowS, Array("remediation", "completion", "date"))

    If colPolSub = 0 Or colSystems = 0 Or colQID = 0 Or colOrigQ = 0 Or colPlan = 0 Or colOwner = 0 Or colRemDate = 0 Then
        MsgBox "Missing required columns in Issue Report Listing2." & vbCrLf & _
               "Need: Policy Sub-Domain, Systems Exhibiting the Issue, Question ID, Original Question," & vbCrLf & _
               "Remediation Plan, Remediation Owner, Remediation Completion Date.", vbCritical
        LogEvent wsLog, "ERROR", "", "", "", "Missing required source columns."
        GoTo CleanExit
    End If

    '============================================================
    ' INDEX DEST EXISTING (so we can upsert instead of duplicates)
    '============================================================
    Dim existingMain As Object, existingIssue As Object
    Set existingMain = CreateObject("Scripting.Dictionary")
    Set existingIssue = CreateObject("Scripting.Dictionary")

    BuildDestIndexes wsD, hdrRowD, colTaskName, existingMain, existingIssue

    '============================================================
    ' PROCESS SOURCE ROWS (carry-forward merged headers)
    '============================================================
    Dim lastRowS As Long, r As Long
    lastRowS = wsS.Cells(wsS.Rows.Count, colPolSub).End(xlUp).Row
    If lastRowS < hdrRowS + 1 Then
        LogEvent wsLog, "WARN", "", "", "", "No data rows found under header."
        GoTo CleanExit
    End If

    Dim currentPol As String
    Dim currentQ As String
    currentPol = ""
    currentQ = ""

    Dim snippetCounts As Object
    Set snippetCounts = CreateObject("Scripting.Dictionary")

    Dim prefixText As String
    prefixText = "BSS Sweep 2 - "

    Dim keyMain As String, entityDisplay As String, entityKey As String
    Dim planText As String, ownerText As String, dueVal As Variant
    Dim qid As String, polCell As String, qCell As String, sysCell As String

    For r = hdrRowS + 1 To lastRowS

        '--- Question ID (skip only Summary or N/A)
        qid = Trim$(CStr(GetMergedValue(wsS.Cells(r, colQID))))
        If LCase$(qid) = "summary" Then GoTo NextRow
        If LCase$(qid) = "n/a" Or LCase$(qid) = "na" Then GoTo NextRow

        '--- Carry-forward policy subdomain
        polCell = Trim$(CStr(GetMergedValue(wsS.Cells(r, colPolSub))))
        If Len(polCell) > 0 Then currentPol = CanonicalPolicySubDomain(polCell)

        '--- Carry-forward question text (Original Question)
        qCell = Trim$(CStr(GetMergedValue(wsS.Cells(r, colOrigQ))))
        If Len(qCell) > 0 Then currentQ = qCell

        '--- Entity + plan typically appear in the rows under a question
        sysCell = Trim$(CStr(GetMergedValue(wsS.Cells(r, colSystems))))
        planText = Trim$(CStr(GetMergedValue(wsS.Cells(r, colPlan))))

        'Do NOT skip blanks globally.
        'We only write a task row when we actually have an entity and remediation plan.
        If Len(sysCell) = 0 Then GoTo NextRow
        If Len(planText) = 0 Then GoTo NextRow
        If Len(currentPol) = 0 Then GoTo NextRow
        If Len(currentQ) = 0 Then GoTo NextRow

        ownerText = Trim$(CStr(GetMergedValue(wsS.Cells(r, colOwner))))
        dueVal = GetMergedValue(wsS.Cells(r, colRemDate))

        'Parse entities (supports multiple separated by comma/semicolon/newline)
        Dim entities As Collection, e As Variant
        Set entities = ParseEntities(sysCell)
        If entities.Count = 0 Then GoTo NextRow

        For Each e In entities
            entityDisplay = CStr(e)
            entityKey = NormalizeKey(entityDisplay)
            If Len(entityKey) = 0 Then GoTo NextEntity

            keyMain = entityKey & "||" & NormalizeKey(currentPol)

            'If main exists, create extra issue row (snippet)
            If existingMain.Exists(keyMain) Then
                Dim snip As String, snipKeyBase As String, uniqSnip As String

                snip = MakeIntentSnippet(currentQ)
                If Len(snip) = 0 Then snip = "Additional"

                snipKeyBase = keyMain & "||" & NormalizeKey(snip)
                If snippetCounts.Exists(snipKeyBase) Then
                    snippetCounts(snipKeyBase) = CLng(snippetCounts(snipKeyBase)) + 1
                    uniqSnip = snip & " " & CStr(snippetCounts(snipKeyBase))
                Else
                    snippetCounts.Add snipKeyBase, 1
                    uniqSnip = snip
                End If

                UpsertIssueRow wsD, hdrRowD, colTaskName, colIssueId, colDesc, colAssigned, colDue, _
                               existingMain, existingIssue, keyMain, NormalizeKey(uniqSnip), _
                               prefixText, currentPol, entityDisplay, uniqSnip, _
                               planText, ownerText, dueVal, wsLog

            Else
                'Create main row first time we see this entity+policy
                UpsertMainRow wsD, hdrRowD, colTaskName, colIssueId, colDesc, colAssigned, colDue, _
                              existingMain, keyMain, prefixText, currentPol, entityDisplay, _
                              planText, ownerText, dueVal, wsLog
            End If

NextEntity:
        Next e

NextRow:
    Next r

    LogEvent wsLog, "INFO", "", "", "", "Run complete."
    MsgBox "Done! Imported remediation tasks from Issue Report Listing2.", vbInformation

CleanExit:
    On Error Resume Next
    If Not wbS Is Nothing Then wbS.Close SaveChanges:=False

    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
    Application.EnableEvents = True
    Application.Calculation = xlCalculationAutomatic
    Exit Sub

FailHandler:
    LogEvent wsLog, "ERROR", "", "", "", "VBA Error: " & Err.Number & " - " & Err.Description
    MsgBox "Error: " & Err.Number & vbCrLf & Err.Description, vbCritical
    Resume CleanExit
End Sub

'============================================================
' UPSERTS
'============================================================
Private Sub UpsertMainRow(ByVal wsD As Worksheet, ByVal hdrRowD As Long, _
    ByVal colTaskName As Long, ByVal colIssueId As Long, ByVal colDesc As Long, ByVal colAssigned As Long, ByVal colDue As Long, _
    ByVal existingMain As Object, ByVal keyMain As String, _
    ByVal prefixText As String, ByVal pol As String, ByVal entityDisplay As String, _
    ByVal planText As String, ByVal ownerText As String, ByVal dueVal As Variant, _
    ByVal wsLog As Worksheet)

    Dim rowNum As Long, action As String

    If existingMain.Exists(keyMain) Then
        rowNum = CLng(existingMain(keyMain))
        action = "UPDATED"
    Else
        rowNum = AppendNewDestRow(wsD, hdrRowD, colTaskName)
        wsD.Cells(rowNum, colTaskName).Value = prefixText & pol & " (" & entityDisplay & ")"
        existingMain.Add keyMain, rowNum
        action = "ADDED"
    End If

    wsD.Cells(rowNum, colDesc).Value = planText
    wsD.Cells(rowNum, colAssigned).Value = ownerText
    WriteDateSmart wsD.Cells(rowNum, colDue), dueVal

    LogEvent wsLog, action, entityDisplay, pol, rowNum, "Main row written."
End Sub

Private Sub UpsertIssueRow(ByVal wsD As Worksheet, ByVal hdrRowD As Long, _
    ByVal colTaskName As Long, ByVal colIssueId As Long, ByVal colDesc As Long, ByVal colAssigned As Long, ByVal colDue As Long, _
    ByVal existingMain As Object, ByVal existingIssue As Object, _
    ByVal keyMain As String, ByVal snippetKeyNorm As String, _
    ByVal prefixText As String, ByVal pol As String, ByVal entityDisplay As String, ByVal snippet As String, _
    ByVal planText As String, ByVal ownerText As String, ByVal dueVal As Variant, _
    ByVal wsLog As Worksheet)

    Dim keyIssue As String
    keyIssue = keyMain & "||" & snippetKeyNorm

    Dim rowNum As Long, action As String
    If existingIssue.Exists(keyIssue) Then
        rowNum = CLng(existingIssue(keyIssue))
        action = "UPDATED"
    Else
        rowNum = AppendNewDestRow(wsD, hdrRowD, colTaskName)
        wsD.Cells(rowNum, colTaskName).Value = prefixText & pol & " (" & entityDisplay & ") - " & snippet
        existingIssue.Add keyIssue, rowNum
        action = "ADDED"
    End If

    wsD.Cells(rowNum, colDesc).Value = planText
    wsD.Cells(rowNum, colAssigned).Value = ownerText
    WriteDateSmart wsD.Cells(rowNum, colDue), dueVal

    'Copy Issue Id from main row so they correlate
    If existingMain.Exists(keyMain) Then
        Dim mainRow As Long: mainRow = CLng(existingMain(keyMain))
        Dim mainIssueId As String: mainIssueId = Trim$(CStr(wsD.Cells(mainRow, colIssueId).Value))
        If Len(mainIssueId) > 0 Then wsD.Cells(rowNum, colIssueId).Value = mainIssueId
    End If

    LogEvent wsLog, action, entityDisplay, pol, rowNum, "Extra issue row written."
End Sub

'============================================================
' DEST INDEX
'============================================================
Private Sub BuildDestIndexes(ByVal wsD As Worksheet, ByVal hdrRowD As Long, ByVal colTaskName As Long, _
                            ByVal existingMain As Object, ByVal existingIssue As Object)

    Dim lastRow As Long, r As Long
    lastRow = wsD.Cells(wsD.Rows.Count, colTaskName).End(xlUp).Row

    For r = hdrRowD + 1 To lastRow
        Dim t As String: t = Trim$(CStr(wsD.Cells(r, colTaskName).Value))
        If Len(t) = 0 Then GoTo NextR

        Dim ent As String, pol As String, snip As String
        ent = ExtractBetweenParens(t)
        pol = CanonicalPolicySubDomain(ExtractPolicySubDomainFromTaskName(t))
        snip = ExtractSnippetFromTaskName(t)

        If Len(ent) > 0 And Len(pol) > 0 Then
            Dim keyMain As String
            keyMain = NormalizeKey(ent) & "||" & NormalizeKey(pol)

            If Len(snip) = 0 Then
                If Not existingMain.Exists(keyMain) Then existingMain.Add keyMain, r
            Else
                Dim keyIssue As String
                keyIssue = keyMain & "||" & NormalizeKey(snip)
                If Not existingIssue.Exists(keyIssue) Then existingIssue.Add keyIssue, r
            End If
        End If

NextR:
    Next r
End Sub

'============================================================
' SOURCE HEADER FINDERS
'============================================================
Private Function FindSourceHeaderRow(ByVal ws As Worksheet, ByVal maxRowsToScan As Long) As Long
    Dim r As Long
    For r = 1 To maxRowsToScan
        If FindColByKeywords(ws, r, Array("policy", "sub", "domain")) > 0 _
           And FindColByKeywords(ws, r, Array("systems", "exhibiting", "issue")) > 0 _
           And FindColByKeywords(ws, r, Array("question", "id")) > 0 _
           And FindColByKeywords(ws, r, Array("original", "question")) > 0 Then
            FindSourceHeaderRow = r
            Exit Function
        End If
    Next r
    FindSourceHeaderRow = 0
End Function

Private Function FindColByKeywords(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal keywords As Variant) As Long
    Dim lastCol As Long, c As Long
    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column

    For c = 1 To lastCol
        Dim v As String
        v = NormalizeKey(CStr(ws.Cells(headerRow, c).Value))
        If Len(v) > 0 Then
            If ContainsAllKeywords(v, keywords) Then
                FindColByKeywords = c
                Exit Function
            End If
        End If
    Next c

    FindColByKeywords = 0
End Function

Private Function ContainsAllKeywords(ByVal textNorm As String, ByVal keywords As Variant) As Boolean
    Dim i As Long
    For i = LBound(keywords) To UBound(keywords)
        If InStr(1, textNorm, LCase$(CStr(keywords(i))), vbTextCompare) = 0 Then
            ContainsAllKeywords = False
            Exit Function
        End If
    Next i
    ContainsAllKeywords = True
End Function

'============================================================
' DEST HEADER FINDERS
'============================================================
Private Function FindHeaderRowExact(ByVal ws As Worksheet, ByVal headers As Variant, ByVal maxRowsToScan As Long) As Long
    Dim r As Long, i As Long
    For r = 1 To maxRowsToScan
        For i = LBound(headers) To UBound(headers)
            If FindHeaderColumnExact(ws, r, CStr(headers(i))) = 0 Then GoTo NextR
        Next i
        FindHeaderRowExact = r
        Exit Function
NextR:
    Next r
    FindHeaderRowExact = 0
End Function

Private Function FindHeaderColumnExact(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal headerText As String) As Long
    Dim lastCol As Long, c As Long
    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    For c = 1 To lastCol
        If StrComp(Trim$(CStr(ws.Cells(headerRow, c).Value)), headerText, vbTextCompare) = 0 Then
            FindHeaderColumnExact = c
            Exit Function
        End If
    Next c
    FindHeaderColumnExact = 0
End Function

'============================================================
' ENTITY PARSE
'============================================================
Private Function ParseEntities(ByVal raw As String) As Collection
    Dim c As New Collection
    Dim t As String: t = Trim$(CStr(raw))
    If Len(t) = 0 Then Set ParseEntities = c: Exit Function

    t = Replace(t, vbCrLf, vbLf)
    t = Replace(t, vbCr, vbLf)
    t = Replace(t, ";", vbLf)
    t = Replace(t, ",", vbLf)

    Dim parts() As String: parts = Split(t, vbLf)
    Dim i As Long
    For i = LBound(parts) To UBound(parts)
        Dim p As String: p = Trim$(parts(i))
        If Len(p) > 0 Then c.Add p
    Next i

    Set ParseEntities = c
End Function

'============================================================
' POLICY NORMALIZATION
'============================================================
Private Function CanonicalPolicySubDomain(ByVal pol As String) As String
    Dim t As String: t = Trim$(CStr(pol))
    Do While InStr(t, "  ") > 0
        t = Replace(t, "  ", " ")
    Loop

    'Your required mapping:
    If LCase$(t) = LCase$("Secure Authentication - MFA") Then
        CanonicalPolicySubDomain = "Multifactor Authentication"
        Exit Function
    End If

    CanonicalPolicySubDomain = t
End Function

'============================================================
' SNIPPET: intent-based labels (meaningful)
'============================================================
Private Function MakeIntentSnippet(ByVal q As String) As String
    Dim t As String
    t = LCase$(Trim$(q))

    'Light cleanup
    t = Replace(t, vbCrLf, " ")
    t = Replace(t, vbCr, " ")
    t = Replace(t, vbLf, " ")

    If InStr(t, "shared account") > 0 Then MakeIntentSnippet = "Shared accounts prohibited": Exit Function
    If InStr(t, "default account") > 0 Then MakeIntentSnippet = "Default accounts disabled": Exit Function
    If InStr(t, "periodic") > 0 And (InStr(t, "recert") > 0 Or InStr(t, "review") > 0) Then MakeIntentSnippet = "Access recertification review": Exit Function
    If InStr(t, "break glass") > 0 Then MakeIntentSnippet = "Break-glass access controls": Exit Function
    If InStr(t, "service account") > 0 Then MakeIntentSnippet = "Service account management": Exit Function
    If InStr(t, "provision") > 0 And InStr(t, "approval") > 0 Then MakeIntentSnippet = "Access provisioning approvals": Exit Function
    If InStr(t, "terminate") > 0 Or InStr(t, "termination") > 0 Then MakeIntentSnippet = "Access removed on termination": Exit Function
    If InStr(t, "remove") > 0 And InStr(t, "customer") > 0 Then MakeIntentSnippet = "Remove customer access": Exit Function
    If InStr(t, "separate") > 0 And InStr(t, "admin") > 0 Then MakeIntentSnippet = "Separate admin accounts": Exit Function
    If InStr(t, "pam") > 0 Or InStr(t, "privileged access management") > 0 Then MakeIntentSnippet = "Privileged access managed": Exit Function
    If InStr(t, "tls") > 0 Or InStr(t, "encrypt") > 0 Or InStr(t, "encryption") > 0 Then MakeIntentSnippet = "Encryption in transit": Exit Function
    If InStr(t, "vulnerability") > 0 Or InStr(t, "scan") > 0 Then MakeIntentSnippet = "Vulnerability scanning": Exit Function
    If InStr(t, "penetration test") > 0 Or InStr(t, "pen test") > 0 Then MakeIntentSnippet = "Penetration testing": Exit Function
    If InStr(t, "sast") > 0 Or InStr(t, "sca") > 0 Then MakeIntentSnippet = "App security testing": Exit Function
    If InStr(t, "session") > 0 And (InStr(t, "timeout") > 0 Or InStr(t, "inactive") > 0) Then MakeIntentSnippet = "Session timeout controls": Exit Function
    If InStr(t, "concurrent logins") > 0 Then MakeIntentSnippet = "Concurrent logins restricted": Exit Function
    If InStr(t, "password") > 0 Then MakeIntentSnippet = "Password controls": Exit Function
    If InStr(t, "log") > 0 Or InStr(t, "logging") > 0 Then MakeIntentSnippet = "Logging requirements": Exit Function

    'Fallback: use first meaningful 5 words (clean)
    MakeIntentSnippet = FallbackSnippet(q, 5)
End Function

Private Function FallbackSnippet(ByVal s As String, ByVal maxWords As Long) As String
    Dim t As String: t = Trim$(s)
    t = Replace(t, vbCrLf, " ")
    t = Replace(t, vbCr, " ")
    t = Replace(t, vbLf, " ")
    t = Replace(t, "?", "")
    t = Replace(t, ".", "")
    t = Replace(t, ",", "")

    Do While InStr(t, "  ") > 0
        t = Replace(t, "  ", " ")
    Loop

    Dim parts() As String: parts = Split(t, " ")
    Dim out As String: out = ""
    Dim i As Long, cnt As Long: cnt = 0

    For i = LBound(parts) To UBound(parts)
        If Len(Trim$(parts(i))) > 0 Then
            cnt = cnt + 1
            If out = "" Then out = parts(i) Else out = out & " " & parts(i)
            If cnt >= maxWords Then Exit For
        End If
    Next i

    FallbackSnippet = Trim$(out)
End Function

'============================================================
' TASK NAME PARSERS (dest)
'============================================================
Private Function ExtractBetweenParens(ByVal s As String) As String
    Dim p1 As Long, p2 As Long
    p1 = InStrRev(s, "(")
    p2 = InStrRev(s, ")")
    If p1 > 0 And p2 > p1 Then
        ExtractBetweenParens = Trim$(Mid$(s, p1 + 1, p2 - p1 - 1))
    Else
        ExtractBetweenParens = ""
    End If
End Function

Private Function ExtractPolicySubDomainFromTaskName(ByVal s As String) As String
    Dim lowerS As String: lowerS = LCase$(s)

    Dim pSweep As Long: pSweep = InStr(1, lowerS, "sweep", vbTextCompare)
    If pSweep = 0 Then ExtractPolicySubDomainFromTaskName = "": Exit Function

    Dim p2 As Long: p2 = InStr(pSweep, lowerS, "2", vbTextCompare)
    If p2 = 0 Then ExtractPolicySubDomainFromTaskName = "": Exit Function

    Dim pDash As Long: pDash = InStr(p2, lowerS, "-", vbTextCompare)
    If pDash = 0 Then ExtractPolicySubDomainFromTaskName = "": Exit Function

    Dim startPos As Long: startPos = pDash + 1
    Do While startPos <= Len(s) And Mid$(s, startPos, 1) = " "
        startPos = startPos + 1
    Loop

    Dim pParen As Long: pParen = InStrRev(s, "(")
    Dim pol As String

    If pParen > 0 And pParen > startPos Then
        pol = Mid$(s, startPos, pParen - startPos)
    Else
        pol = Mid$(s, startPos)
    End If

    ExtractPolicySubDomainFromTaskName = Trim$(pol)
End Function

Private Function ExtractSnippetFromTaskName(ByVal fullName As String) As String
    Dim pClose As Long: pClose = InStrRev(fullName, ")")
    If pClose = 0 Then ExtractSnippetFromTaskName = "": Exit Function

    Dim afterParen As String: afterParen = Trim$(Mid$(fullName, pClose + 1))
    If Len(afterParen) = 0 Then ExtractSnippetFromTaskName = "": Exit Function

    If Left$(afterParen, 1) = "-" Then
        ExtractSnippetFromTaskName = Trim$(Mid$(afterParen, 2))
    ElseIf Left$(afterParen, 2) = "- " Then
        ExtractSnippetFromTaskName = Trim$(Mid$(afterParen, 3))
    Else
        ExtractSnippetFromTaskName = ""
    End If
End Function

'============================================================
' UTILITIES
'============================================================
Private Function GetMergedValue(ByVal cell As Range) As Variant
    If cell.MergeCells Then
        GetMergedValue = cell.MergeArea.Cells(1, 1).Value
    Else
        GetMergedValue = cell.Value
    End If
End Function

Private Function NormalizeKey(ByVal s As String) As String
    Dim t As String
    t = LCase$(Trim$(CStr(s)))
    t = Replace(t, vbCrLf, " ")
    t = Replace(t, vbCr, " ")
    t = Replace(t, vbLf, " ")
    t = Replace(t, ChrW(160), " ")
    Do While InStr(t, "  ") > 0
        t = Replace(t, "  ", " ")
    Loop
    NormalizeKey = t
End Function

Private Function AppendNewDestRow(ByVal ws As Worksheet, ByVal hdrRow As Long, ByVal colAnchor As Long) As Long
    Dim outRow As Long
    outRow = ws.Cells(ws.Rows.Count, colAnchor).End(xlUp).Row + 1
    If outRow <= hdrRow Then outRow = hdrRow + 1
    AppendNewDestRow = outRow
End Function

Private Sub WriteDateSmart(ByVal targetCell As Range, ByVal v As Variant)
    If Len(Trim$(CStr(v))) = 0 Then
        targetCell.Value = ""
    ElseIf IsDate(v) Then
        targetCell.Value = CDate(v)
    Else
        targetCell.Value = CStr(v)
    End If
End Sub

'============================================================
' DEST SHEET FINDER
'============================================================
Private Function FindDestSheetByHeader(ByVal wb As Workbook, ByVal headerText As String) As Worksheet
    Dim ws As Worksheet
    For Each ws In wb.Worksheets
        If SheetHasHeader(ws, headerText, 400) Then
            Set FindDestSheetByHeader = ws
            Exit Function
        End If
    Next ws
    Set FindDestSheetByHeader = Nothing
End Function

Private Function SheetHasHeader(ByVal ws As Worksheet, ByVal headerText As String, ByVal maxRows As Long) As Boolean
    Dim r As Long, c As Long, lastCol As Long
    For r = 1 To maxRows
        lastCol = ws.Cells(r, ws.Columns.Count).End(xlToLeft).Column
        For c = 1 To lastCol
            If StrComp(Trim$(CStr(ws.Cells(r, c).Value)), headerText, vbTextCompare) = 0 Then
                SheetHasHeader = True
                Exit Function
            End If
        Next c
    Next r
    SheetHasHeader = False
End Function

'============================================================
' LOGGING
'============================================================
Private Function GetOrCreateLogSheet(ByVal wb As Workbook, ByVal sheetName As String) As Worksheet
    On Error Resume Next
    Set GetOrCreateLogSheet = wb.Worksheets(sheetName)
    On Error GoTo 0
    If GetOrCreateLogSheet Is Nothing Then
        Set GetOrCreateLogSheet = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))
        GetOrCreateLogSheet.Name = sheetName
    End If
End Function

Private Sub InitLog(ByVal wsLog As Worksheet)
    wsLog.Cells.Clear
    wsLog.Range("A1:E1").Value = Array("Timestamp", "Status", "Entity", "Policy Sub-Domain", "Message")
    wsLog.Columns("A:E").EntireColumn.AutoFit
End Sub

Private Sub LogEvent(ByVal wsLog As Worksheet, ByVal status As String, ByVal entity As String, _
                     ByVal policySub As String, ByVal rowNum As Variant, ByVal message As String)
    Dim nextRow As Long
    nextRow = wsLog.Cells(wsLog.Rows.Count, 1).End(xlUp).Row + 1
    If nextRow < 2 Then nextRow = 2
    wsLog.Cells(nextRow, 1).Value = Now
    wsLog.Cells(nextRow, 2).Value = status
    wsLog.Cells(nextRow, 3).Value = entity
    wsLog.Cells(nextRow, 4).Value = policySub
    wsLog.Cells(nextRow, 5).Value = message
End Sub