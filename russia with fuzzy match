Option Explicit

' ============================================================
' MAIN
' Same flow as original:
' - open destination + source
' - find destination sheet by headers
' - read Issue Report Listing2 with carry-down
' - one main row per entity + policy pair
' - extra rows for additional questions
' - reuse existing Issue IDs already present in destination
' - final FillIssueIdsFromMainRows pass
'
' Requested changes:
' - match existing manually-worded question rows to source Original Question
' - write Remediation Plan into Description
' - fill Assigned + Due
' - DO NOT use Question ID as Issue ID
' - DO NOT use Suggested Remediation column
' ============================================================

Public Sub Populate_RemediationTasks_From_IssueReportListing2()

    Dim dstPath As Variant, srcPath As Variant
    Dim wbD As Workbook, wsD As Worksheet
    Dim wbS As Workbook, wsS As Worksheet
    Dim wsLog As Worksheet

    Dim oldSU As Boolean, oldDA As Boolean, oldCalc As XlCalculation
    oldSU = Application.ScreenUpdating
    oldDA = Application.DisplayAlerts
    oldCalc = Application.Calculation

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.Calculation = xlCalculationManual

    On Error GoTo FailHard

    ' ------------------------------------------------------------
    ' Pick Remediation Task file
    ' ------------------------------------------------------------
    dstPath = Application.GetOpenFilename("Excel Files (*.xlsx;*.xlsm), *.xlsx;*.xlsm", , _
                                          "Select Remediation Task file")
    If dstPath = False Then GoTo CleanExit

    Set wbD = Workbooks.Open(CStr(dstPath))

    Set wsD = FindSheetByHeaderLoose(wbD, "Remediation Task Name", 50)
    If wsD Is Nothing Then
        MsgBox "Could not find destination sheet with header 'Remediation Task Name'.", vbCritical
        GoTo CleanExit
    End If

    ' ------------------------------------------------------------
    ' Pick Issue Report file
    ' ------------------------------------------------------------
    srcPath = Application.GetOpenFilename("Excel Files (*.xlsx;*.xlsm), *.xlsx;*.xlsm", , _
                                          "Select Issue Report file")
    If srcPath = False Then GoTo CleanExit

    Set wbS = Workbooks.Open(CStr(srcPath), ReadOnly:=True)

    On Error Resume Next
    Set wsS = wbS.Worksheets("Issue Report Listing2")
    On Error GoTo 0

    If wsS Is Nothing Then
        MsgBox "Could not find sheet 'Issue Report Listing2' in the issue report file.", vbCritical
        GoTo CleanExit
    End If

    ' ------------------------------------------------------------
    ' Log
    ' ------------------------------------------------------------
    Set wsLog = GetOrCreateLogSheet(wbD, "Run Log")
    InitLog wsLog
    LogEvent wsLog, "INFO", "", "", "", "Started run."

    ' ============================================================
    ' DEST HEADERS
    ' ============================================================
    Dim hdrRowD As Long
    Dim colTaskName As Long, colIssueId As Long, colDesc As Long
    Dim colAssigned As Long, colDue As Long

    hdrRowD = FindHeaderRowContains(wsD, Array("Remediation Task Name", "Issue"), 200)
    If hdrRowD = 0 Then
        MsgBox "Could not find required headers in destination sheet.", vbCritical
        GoTo CleanExit
    End If

    colTaskName = FindHeaderColumnContains(wsD, hdrRowD, "Remediation Task Name")
    colIssueId = FindHeaderColumnContains(wsD, hdrRowD, "Issue")
    colDesc = FindHeaderColumnContains(wsD, hdrRowD, "Description")
    colAssigned = FindHeaderColumnContains(wsD, hdrRowD, "Assigned")
    colDue = FindHeaderColumnContains(wsD, hdrRowD, "Due")

    If colTaskName = 0 Or colIssueId = 0 Or colDesc = 0 Then
        MsgBox "Destination sheet is missing one of: Remediation Task Name / Issue / Description.", vbCritical
        GoTo CleanExit
    End If

    wsD.Columns(colTaskName).NumberFormat = "@"
    wsD.Columns(colIssueId).NumberFormat = "@"
    wsD.Columns(colDesc).NumberFormat = "@"
    If colAssigned > 0 Then wsD.Columns(colAssigned).NumberFormat = "@"
    If colDue > 0 Then wsD.Columns(colDue).NumberFormat = "m/d/yyyy"

    Dim originalLastRow As Long
    originalLastRow = GetLastUsedRow(wsD)

    ' ============================================================
    ' SOURCE HEADERS
    ' ============================================================
    Dim hdrRowS As Long
    Dim colPolSub As Long, colQID As Long, colOrigQ As Long
    Dim colSystems As Long, colPlan As Long, colOwner As Long, colDueSrc As Long

    hdrRowS = FindSourceHeaderRow_IssueReport(wsS, 800)
    If hdrRowS = 0 Then
        MsgBox "Could not find header row in Issue Report Listing2.", vbCritical
        GoTo CleanExit
    End If

    colPolSub = FindColByKeywords(wsS, hdrRowS, Array("policy", "sub", "domain"))
    colQID = FindColByKeywords(wsS, hdrRowS, Array("question", "id"))
    colOrigQ = FindColByKeywords(wsS, hdrRowS, Array("original", "question"))
    colSystems = FindColByKeywords(wsS, hdrRowS, Array("systems", "exhibiting", "issue"))
    colPlan = FindColByKeywords(wsS, hdrRowS, Array("remediation", "plan"))
    colOwner = FindColByKeywords(wsS, hdrRowS, Array("remediation", "owner"))
    colDueSrc = FindColByKeywords(wsS, hdrRowS, Array("remediation", "completion", "date"))

    If colPolSub = 0 Or colOrigQ = 0 Or colSystems = 0 Or colPlan = 0 Or colDueSrc = 0 Then
        MsgBox "Missing required source columns." & vbCrLf & _
               "Need at least: Policy Sub-Domain, Original Question, Systems Exhibiting the Issue, Remediation Plan, Remediation Completion Date.", vbCritical
        GoTo CleanExit
    End If

    ' ============================================================
    ' EXISTING DEST INDEXES
    ' ============================================================
    Dim existingMain As Object
    Set existingMain = CreateObject("Scripting.Dictionary")

    Dim globalPrefix As String
    globalPrefix = GuessMostCommonPrefix(wsD, hdrRowD, colTaskName)
    If Len(globalPrefix) = 0 Then globalPrefix = "Russia Sweep 2 - "

    BuildExistingMainIndex wsD, hdrRowD, originalLastRow, colTaskName, colIssueId, existingMain

    ' ============================================================
    ' PROCESS SOURCE ROWS (WITH CARRY-DOWN)
    ' ============================================================
    Dim lastRowS As Long, r As Long
    lastRowS = wsS.Cells(wsS.Rows.Count, colSystems).End(xlUp).Row
    If lastRowS < hdrRowS + 1 Then lastRowS = wsS.UsedRange.Rows(wsS.UsedRange.Rows.Count).Row

    Dim curPolicy As String, curQID As String, curQuestion As String
    curPolicy = ""
    curQID = ""
    curQuestion = ""

    Dim scanned As Long, added As Long, reused As Long
    scanned = 0
    added = 0
    reused = 0

    Dim seenMainInRun As Object, seenIssueInRun As Object
    Set seenMainInRun = CreateObject("Scripting.Dictionary")
    Set seenIssueInRun = CreateObject("Scripting.Dictionary")

    For r = hdrRowS + 1 To lastRowS
        scanned = scanned + 1

        Dim vPol As String, vQID As String, vQ As String
        vPol = Trim$(CStr(GetMergedValue(wsS.Cells(r, colPolSub))))
        vQID = ""
        If colQID > 0 Then vQID = Trim$(CStr(GetMergedValue(wsS.Cells(r, colQID))))
        vQ = Trim$(CStr(GetMergedValue(wsS.Cells(r, colOrigQ))))

        If Len(vPol) > 0 Then curPolicy = CanonicalPolicySubDomain(vPol)
        If Len(vQID) > 0 Then curQID = vQID
        If Len(vQ) > 0 Then curQuestion = vQ

        If LCase$(NormalizeKey(curQID)) = "n/a" Then GoTo NextR
        If LCase$(NormalizeKey(curQID)) = "summary" Then GoTo NextR

        Dim systemsRaw As String, planText As String, ownerText As String
        Dim dueVal As Variant

        systemsRaw = Trim$(CStr(GetMergedValue(wsS.Cells(r, colSystems))))
        planText = Trim$(CStr(GetMergedValue(wsS.Cells(r, colPlan))))
        ownerText = ""
        If colOwner > 0 Then ownerText = Trim$(CStr(GetMergedValue(wsS.Cells(r, colOwner))))
        dueVal = Empty
        If colDueSrc > 0 Then dueVal = GetMergedValue(wsS.Cells(r, colDueSrc))

        If Len(Trim$(systemsRaw)) = 0 Then GoTo NextR
        If Len(Trim$(planText)) = 0 Then GoTo NextR
        If Len(Trim$(curPolicy)) = 0 Or Len(Trim$(curQuestion)) = 0 Then GoTo NextR

        Dim entities As Collection
        Set entities = ParseEntities(systemsRaw)
        If entities Is Nothing Then GoTo NextR
        If entities.Count = 0 Then GoTo NextR

        Dim e As Variant
        For Each e In entities

            Dim entityDisplay As String
            Dim mainKey As String
            Dim taskName As String
            Dim issueKey As String
            Dim inheritedIssueId As String
            Dim matchedRow As Long

            entityDisplay = Trim$(CStr(e))
            If Len(entityDisplay) = 0 Then GoTo NextE

            mainKey = NormalizeKey(entityDisplay) & "||" & NormalizeKey(curPolicy)
            taskName = BuildTaskNameFromPrefix(globalPrefix, curPolicy, entityDisplay)

            If Not seenMainInRun.Exists(mainKey) Then
                seenMainInRun.Add mainKey, True

                matchedRow = FindBestExistingRowForQuestion( _
                                wsD, hdrRowD + 1, originalLastRow, _
                                colTaskName, colDesc, _
                                taskName, curQuestion, planText)

                If matchedRow > 0 Then
                    UpdateExistingRow wsD, matchedRow, colDesc, colAssigned, colDue, _
                                      planText, ownerText, dueVal
                    reused = reused + 1
                    LogEvent wsLog, "INFO", taskName, entityDisplay, curPolicy, _
                             "Matched existing main row " & matchedRow
                Else
                    inheritedIssueId = GetExistingIssueIdForTaskKey(existingMain, mainKey)

                    AppendDestRow wsD, hdrRowD, _
                                  colTaskName, colIssueId, colDesc, colAssigned, colDue, _
                                  taskName, inheritedIssueId, planText, ownerText, dueVal

                    added = added + 1
                    LogEvent wsLog, "INFO", taskName, entityDisplay, curPolicy, _
                             "Added new main row"
                End If

            Else
                issueKey = mainKey & "||" & NormalizeKey(curQuestion)

                If Not seenIssueInRun.Exists(issueKey) Then
                    seenIssueInRun.Add issueKey, True

                    matchedRow = FindBestExistingRowForQuestion( _
                                    wsD, hdrRowD + 1, originalLastRow, _
                                    colTaskName, colDesc, _
                                    taskName, curQuestion, planText)

                    If matchedRow > 0 Then
                        UpdateExistingRow wsD, matchedRow, colDesc, colAssigned, colDue, _
                                          planText, ownerText, dueVal
                        reused = reused + 1
                        LogEvent wsLog, "INFO", taskName, entityDisplay, curPolicy, _
                                 "Matched existing extra row " & matchedRow
                    Else
                        inheritedIssueId = GetExistingIssueIdForTaskKey(existingMain, mainKey)

                        AppendDestRow wsD, hdrRowD, _
                                      colTaskName, colIssueId, colDesc, colAssigned, colDue, _
                                      taskName, inheritedIssueId, planText, ownerText, dueVal

                        added = added + 1
                        LogEvent wsLog, "INFO", taskName, entityDisplay, curPolicy, _
                                 "Added new extra row"
                    End If
                End If
            End If

NextE:
        Next e

NextR:
    Next r

    ' ============================================================
    ' FINAL ISSUE ID FILL
    ' ============================================================
    Application.Calculation = xlCalculationAutomatic
    Application.Calculate

    FillIssueIdsFromMainRows wsD, hdrRowD, colTaskName, colIssueId

    LogEvent wsLog, "INFO", "", "", "", _
             "Run complete. Scanned=" & scanned & ", Added=" & added & ", Reused=" & reused

    MsgBox "Complete." & vbCrLf & _
           "Scanned rows: " & scanned & vbCrLf & _
           "New rows added: " & added & vbCrLf & _
           "Existing rows reused: " & reused, vbInformation

CleanExit:
    On Error Resume Next
    If Not wbS Is Nothing Then wbS.Close SaveChanges:=False
    If Not wbD Is Nothing Then wbD.Save
    Application.ScreenUpdating = oldSU
    Application.DisplayAlerts = oldDA
    Application.Calculation = oldCalc
    Exit Sub

FailHard:
    On Error Resume Next
    If Not wsLog Is Nothing Then
        LogEvent wsLog, "ERROR", "", "", "", "Error " & Err.Number & ": " & Err.Description
    End If
    MsgBox "Error " & Err.Number & ": " & Err.Description, vbCritical
    Resume CleanExit

End Sub

' ============================================================
' DEST WRITE / UPDATE
' ============================================================

Private Sub AppendDestRow( _
    ByVal ws As Worksheet, ByVal hdrRow As Long, _
    ByVal colTaskName As Long, ByVal colIssueId As Long, _
    ByVal colDesc As Long, ByVal colAssigned As Long, ByVal colDue As Long, _
    ByVal taskName As String, ByVal inheritedIssueId As String, _
    ByVal remediationPlan As String, ByVal ownerText As String, ByVal dueVal As Variant)

    Dim newRow As Long
    newRow = GetLastUsedRow(ws) + 1
    If newRow <= hdrRow Then newRow = hdrRow + 1

    ws.Cells(newRow, colTaskName).Value = taskName

    ' IMPORTANT:
    ' Reuse only existing Issue ID if already known for this task.
    ' Never write Question ID here.
    If colIssueId > 0 Then
        If Len(Trim$(inheritedIssueId)) > 0 Then
            ws.Cells(newRow, colIssueId).Value = inheritedIssueId
        Else
            ws.Cells(newRow, colIssueId).Value = ""
        End If
    End If

    ' Requested change:
    ' Write remediation plan into Description
    ws.Cells(newRow, colDesc).Value = remediationPlan

    If colAssigned > 0 Then ws.Cells(newRow, colAssigned).Value = ownerText

    If colDue > 0 Then
        If IsDate(dueVal) Then
            ws.Cells(newRow, colDue).Value = CDate(dueVal)
        ElseIf Len(Trim$(CStr(dueVal))) > 0 Then
            ws.Cells(newRow, colDue).Value = dueVal
        End If
    End If
End Sub

Private Sub UpdateExistingRow( _
    ByVal ws As Worksheet, ByVal targetRow As Long, _
    ByVal colDesc As Long, ByVal colAssigned As Long, ByVal colDue As Long, _
    ByVal remediationPlan As String, ByVal ownerText As String, ByVal dueVal As Variant)

    ' Requested change:
    ' put remediation plan into Description
    If colDesc > 0 Then
        ws.Cells(targetRow, colDesc).Value = remediationPlan
    End If

    If colAssigned > 0 Then
        ws.Cells(targetRow, colAssigned).Value = ownerText
    End If

    If colDue > 0 Then
        If IsDate(dueVal) Then
            ws.Cells(targetRow, colDue).Value = CDate(dueVal)
        ElseIf Len(Trim$(CStr(dueVal))) > 0 Then
            ws.Cells(targetRow, colDue).Value = dueVal
        End If
    End If
End Sub

' ============================================================
' MATCH EXISTING MANUAL QUESTION WORDING TO SOURCE QUESTION
' We compare existing Description text to:
' - Original Question
' - Remediation Plan
' This allows matching rows that still contain manual question wording,
' and also rows already updated with remediation plan on a prior run.
' ============================================================

Private Function FindBestExistingRowForQuestion( _
    ByVal ws As Worksheet, _
    ByVal firstDataRow As Long, _
    ByVal lastRow As Long, _
    ByVal colTaskName As Long, _
    ByVal colDesc As Long, _
    ByVal taskName As String, _
    ByVal sourceQuestion As String, _
    ByVal sourcePlan As String) As Long

    Dim r As Long
    Dim existingTask As String, existingDesc As String
    Dim scoreQ As Double, scorePlan As Double, score As Double
    Dim bestScore As Double, bestRow As Long

    bestScore = 0
    bestRow = 0

    If lastRow < firstDataRow Then
        FindBestExistingRowForQuestion = 0
        Exit Function
    End If

    For r = firstDataRow To lastRow
        existingTask = Trim$(CStr(ws.Cells(r, colTaskName).Value))
        If Len(existingTask) = 0 Then GoTo ContinueR

        If NormalizeKey(existingTask) = NormalizeKey(taskName) Then
            existingDesc = Trim$(CStr(ws.Cells(r, colDesc).Value))

            scoreQ = TokenSimilarity(existingDesc, sourceQuestion)
            scorePlan = TokenSimilarity(existingDesc, sourcePlan)
            score = scoreQ
            If scorePlan > score Then score = scorePlan

            If score >= 0.72 Then
                If score > bestScore Then
                    bestScore = score
                    bestRow = r
                End If
            End If
        End If

ContinueR:
    Next r

    FindBestExistingRowForQuestion = bestRow
End Function

Private Function TokenSimilarity(ByVal s1 As String, ByVal s2 As String) As Double
    Dim d1 As Object, d2 As Object
    Dim arr1 As Variant, arr2 As Variant
    Dim i As Long
    Dim token As Variant
    Dim interCnt As Long, unionCnt As Long

    s1 = NormalizeForMatch(s1)
    s2 = NormalizeForMatch(s2)

    If Len(s1) = 0 Or Len(s2) = 0 Then
        TokenSimilarity = 0
        Exit Function
    End If

    Set d1 = CreateObject("Scripting.Dictionary")
    Set d2 = CreateObject("Scripting.Dictionary")

    arr1 = Split(s1, " ")
    arr2 = Split(s2, " ")

    For i = LBound(arr1) To UBound(arr1)
        If Len(Trim$(CStr(arr1(i)))) > 2 Then
            If Not d1.Exists(Trim$(CStr(arr1(i)))) Then d1.Add Trim$(CStr(arr1(i))), True
        End If
    Next i

    For i = LBound(arr2) To UBound(arr2)
        If Len(Trim$(CStr(arr2(i)))) > 2 Then
            If Not d2.Exists(Trim$(CStr(arr2(i)))) Then d2.Add Trim$(CStr(arr2(i))), True
        End If
    Next i

    interCnt = 0
    unionCnt = d1.Count

    For Each token In d2.Keys
        If d1.Exists(CStr(token)) Then
            interCnt = interCnt + 1
        Else
            unionCnt = unionCnt + 1
        End If
    Next token

    If unionCnt = 0 Then
        TokenSimilarity = 0
    Else
        TokenSimilarity = interCnt / unionCnt
    End If
End Function

Private Function NormalizeForMatch(ByVal s As String) As String
    Dim t As String
    Dim arrPunct As Variant
    Dim i As Long

    t = LCase$(Trim$(s))
    If Len(t) = 0 Then
        NormalizeForMatch = ""
        Exit Function
    End If

    t = Replace(t, vbCr, " ")
    t = Replace(t, vbLf, " ")
    t = Replace(t, vbTab, " ")

    arrPunct = Array(".", ",", ";", ":", "(", ")", "[", "]", "{", "}", "-", "_", "/", "\", "&", "?", "!", "'", """")
    For i = LBound(arrPunct) To UBound(arrPunct)
        t = Replace(t, arrPunct(i), " ")
    Next i

    t = Replace(t, "has the application ever been subjected to", "application subjected to")
    t = Replace(t, "been subjected to", "subjected to")
    t = Replace(t, "penetration test", "pentest")
    t = Replace(t, "penetration testing", "pentest")
    t = Replace(t, "static application security testing", "sast")
    t = Replace(t, "web application firewall", "waf")
    t = Replace(t, "multi factor authentication", "mfa")
    t = Replace(t, "identity and access management", "iam")
    t = Replace(t, "de commissioning", "decommissioning")
    t = Replace(t, "de commission", "decommission")

    Do While InStr(t, "  ") > 0
        t = Replace(t, "  ", " ")
    Loop

    NormalizeForMatch = Trim$(t)
End Function

' ============================================================
' EXISTING ISSUE ID / MAIN INDEX
' ============================================================

Private Sub BuildExistingMainIndex( _
    ByVal ws As Worksheet, ByVal hdrRow As Long, ByVal lastRow As Long, _
    ByVal colTaskName As Long, ByVal colIssueId As Long, _
    ByRef existingMain As Object)

    Dim r As Long
    For r = hdrRow + 1 To lastRow
        Dim taskText As String, policyText As String, entityText As String
        Dim mainKey As String, issueVal As String

        taskText = Trim$(CStr(ws.Cells(r, colTaskName).Value))
        If Len(taskText) = 0 Then GoTo ContinueR

        policyText = ExtractPolicyFromTaskName(taskText)
        entityText = ExtractEntityFromTaskName(taskText)

        If Len(policyText) > 0 And Len(entityText) > 0 Then
            mainKey = NormalizeKey(entityText) & "||" & NormalizeKey(policyText)
            issueVal = Trim$(CStr(ws.Cells(r, colIssueId).Value))

            If Not existingMain.Exists(mainKey) Then
                existingMain.Add mainKey, issueVal
            Else
                If Len(Trim$(existingMain(mainKey))) = 0 And Len(issueVal) > 0 Then
                    existingMain(mainKey) = issueVal
                End If
            End If
        End If

ContinueR:
    Next r
End Sub

Private Function GetExistingIssueIdForTaskKey(ByVal existingMain As Object, ByVal mainKey As String) As String
    If existingMain.Exists(mainKey) Then
        GetExistingIssueIdForTaskKey = Trim$(CStr(existingMain(mainKey)))
    Else
        GetExistingIssueIdForTaskKey = ""
    End If
End Function

Private Sub FillIssueIdsFromMainRows(ByVal ws As Worksheet, ByVal hdrRow As Long, ByVal colTaskName As Long, ByVal colIssueId As Long)
    Dim lastRow As Long, r As Long
    Dim d As Object
    Dim taskKey As String, issueVal As String

    Set d = CreateObject("Scripting.Dictionary")
    lastRow = GetLastUsedRow(ws)

    For r = hdrRow + 1 To lastRow
        taskKey = NormalizeKey(CStr(ws.Cells(r, colTaskName).Value))
        issueVal = Trim$(CStr(ws.Cells(r, colIssueId).Value))

        If Len(taskKey) > 0 And Len(issueVal) > 0 Then
            If Not d.Exists(taskKey) Then d.Add taskKey, issueVal
        End If
    Next r

    For r = hdrRow + 1 To lastRow
        taskKey = NormalizeKey(CStr(ws.Cells(r, colTaskName).Value))
        issueVal = Trim$(CStr(ws.Cells(r, colIssueId).Value))

        If Len(taskKey) > 0 And Len(issueVal) = 0 Then
            If d.Exists(taskKey) Then
                ws.Cells(r, colIssueId).Value = d(taskKey)
            End If
        End If
    Next r
End Sub

' ============================================================
' TASK NAME PARSING / BUILDING
' ============================================================

Private Function BuildTaskNameFromPrefix(ByVal prefixText As String, ByVal policyText As String, ByVal entityText As String) As String
    BuildTaskNameFromPrefix = prefixText & policyText & " (" & entityText & ")"
End Function

Private Function GuessMostCommonPrefix(ByVal ws As Worksheet, ByVal hdrRow As Long, ByVal colTaskName As Long) As String
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")

    Dim lastRow As Long, r As Long
    Dim txt As String, p As String

    lastRow = GetLastUsedRow(ws)

    For r = hdrRow + 1 To lastRow
        txt = Trim$(CStr(ws.Cells(r, colTaskName).Value))
        If Len(txt) > 0 Then
            p = ExtractPrefixFromTaskName(txt)
            If Len(p) > 0 Then
                If d.Exists(p) Then
                    d(p) = CLng(d(p)) + 1
                Else
                    d.Add p, 1
                End If
            End If
        End If
    Next r

    Dim k As Variant, bestCount As Long, bestPrefix As String
    bestCount = 0
    bestPrefix = ""

    For Each k In d.Keys
        If CLng(d(k)) > bestCount Then
            bestCount = CLng(d(k))
            bestPrefix = CStr(k)
        End If
    Next k

    GuessMostCommonPrefix = bestPrefix
End Function

Private Function ExtractPrefixFromTaskName(ByVal taskName As String) As String
    Dim posDash As Long
    posDash = InStr(taskName, " - ")
    If posDash > 0 Then
        ExtractPrefixFromTaskName = Left$(taskName, posDash + 2)
    Else
        ExtractPrefixFromTaskName = ""
    End If
End Function

Private Function ExtractEntityFromTaskName(ByVal taskName As String) As String
    Dim p1 As Long, p2 As Long
    p1 = InStrRev(taskName, "(")
    p2 = InStrRev(taskName, ")")

    If p1 > 0 And p2 > p1 Then
        ExtractEntityFromTaskName = Trim$(Mid$(taskName, p1 + 1, p2 - p1 - 1))
    Else
        ExtractEntityFromTaskName = ""
    End If
End Function

Private Function ExtractPolicyFromTaskName(ByVal taskName As String) As String
    Dim posDash As Long, p1 As Long
    posDash = InStr(taskName, " - ")
    p1 = InStrRev(taskName, "(")

    If posDash > 0 Then
        If p1 > posDash Then
            ExtractPolicyFromTaskName = Trim$(Mid$(taskName, posDash + 3, p1 - (posDash + 3)))
        Else
            ExtractPolicyFromTaskName = Trim$(Mid$(taskName, posDash + 3))
        End If
    Else
        ExtractPolicyFromTaskName = ""
    End If
End Function

' ============================================================
' SOURCE ROW HELPERS
' ============================================================

Private Function ParseEntities(ByVal systemsRaw As String) As Collection
    Dim col As New Collection
    Dim txt As String, arr As Variant, i As Long
    Dim piece As String

    txt = Trim$(systemsRaw)
    txt = Replace(txt, vbCrLf, "|")
    txt = Replace(txt, vbCr, "|")
    txt = Replace(txt, vbLf, "|")
    txt = Replace(txt, ";", "|")

    If InStr(txt, "|") = 0 Then
        piece = CleanEntityName(txt)
        If Len(piece) > 0 Then col.Add piece
        Set ParseEntities = col
        Exit Function
    End If

    arr = Split(txt, "|")
    For i = LBound(arr) To UBound(arr)
        piece = CleanEntityName(CStr(arr(i)))
        If Len(piece) > 0 Then col.Add piece
    Next i

    Set ParseEntities = col
End Function

Private Function CleanEntityName(ByVal s As String) As String
    Dim t As String
    t = Trim$(s)
    Do While InStr(t, "  ") > 0
        t = Replace(t, "  ", " ")
    Loop
    CleanEntityName = t
End Function

Private Function CanonicalPolicySubDomain(ByVal s As String) As String
    Dim t As String
    t = Trim$(s)
    If Len(t) = 0 Then
        CanonicalPolicySubDomain = ""
        Exit Function
    End If

    t = Replace(t, vbCr, " ")
    t = Replace(t, vbLf, " ")
    Do While InStr(t, "  ") > 0
        t = Replace(t, "  ", " ")
    Loop

    CanonicalPolicySubDomain = t
End Function

' ============================================================
' HEADER FINDERS
' ============================================================

Private Function FindSheetByHeaderLoose(ByVal wb As Workbook, ByVal headerText As String, ByVal searchRows As Long) As Worksheet
    Dim ws As Worksheet
    For Each ws In wb.Worksheets
        If FindHeaderColumnContains(ws, FindHeaderRowContains(ws, Array(headerText), searchRows), headerText) > 0 Then
            Set FindSheetByHeaderLoose = ws
            Exit Function
        End If
    Next ws
End Function

Private Function FindHeaderRowContains(ByVal ws As Worksheet, ByVal headerTexts As Variant, ByVal maxRows As Long) As Long
    Dim r As Long, i As Long, ok As Boolean

    For r = 1 To Application.Min(maxRows, ws.UsedRange.Row + ws.UsedRange.Rows.Count + 50)
        ok = True
        For i = LBound(headerTexts) To UBound(headerTexts)
            If FindHeaderColumnContains(ws, r, CStr(headerTexts(i))) = 0 Then
                ok = False
                Exit For
            End If
        Next i
        If ok Then
            FindHeaderRowContains = r
            Exit Function
        End If
    Next r
End Function

Private Function FindHeaderColumnContains(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal findText As String) As Long
    Dim lastCol As Long, c As Long, v As String

    If headerRow <= 0 Then Exit Function

    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    For c = 1 To lastCol
        v = LCase$(Trim$(CStr(ws.Cells(headerRow, c).Value)))
        If InStr(1, v, LCase$(findText), vbTextCompare) > 0 Then
            FindHeaderColumnContains = c
            Exit Function
        End If
    Next c
End Function

Private Function FindSourceHeaderRow_IssueReport(ByVal ws As Worksheet, ByVal maxRows As Long) As Long
    Dim r As Long
    For r = 1 To maxRows
        If FindColByKeywords(ws, r, Array("policy", "sub", "domain")) > 0 _
           And FindColByKeywords(ws, r, Array("original", "question")) > 0 _
           And FindColByKeywords(ws, r, Array("systems", "exhibiting", "issue")) > 0 Then
            FindSourceHeaderRow_IssueReport = r
            Exit Function
        End If
    Next r
End Function

Private Function FindColByKeywords(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal keywords As Variant) As Long
    Dim lastCol As Long, c As Long, txt As String
    Dim i As Long, ok As Boolean

    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column

    For c = 1 To lastCol
        txt = LCase$(Trim$(CStr(ws.Cells(headerRow, c).Value)))
        txt = Replace(txt, vbCr, " ")
        txt = Replace(txt, vbLf, " ")
        ok = True

        For i = LBound(keywords) To UBound(keywords)
            If InStr(1, txt, LCase$(CStr(keywords(i))), vbTextCompare) = 0 Then
                ok = False
                Exit For
            End If
        Next i

        If ok Then
            FindColByKeywords = c
            Exit Function
        End If
    Next c
End Function

