Private Function GetOrCreateLogSheet(ByVal wb As Workbook, ByVal sheetName As String) As Worksheet
    On Error Resume Next
    Set GetOrCreateLogSheet = wb.Worksheets(sheetName)
    On Error GoTo 0

    If GetOrCreateLogSheet Is Nothing Then
        Set GetOrCreateLogSheet = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))
        GetOrCreateLogSheet.Name = sheetName
    End If
End Function

Private Sub InitLog(ByVal ws As Worksheet)
    If Len(Trim$(CStr(ws.Cells(1, 1).Value))) = 0 Then
        ws.Cells(1, 1).Value = "Timestamp"
        ws.Cells(1, 2).Value = "Level"
        ws.Cells(1, 3).Value = "Task Name"
        ws.Cells(1, 4).Value = "Entity"
        ws.Cells(1, 5).Value = "Policy"
        ws.Cells(1, 6).Value = "Message"
    End If
End Sub

Private Sub LogEvent(ByVal ws As Worksheet, ByVal level As String, ByVal taskName As String, _
                     ByVal entityName As String, ByVal policy As String, ByVal message As String)

    Dim r As Long
    r = GetLastUsedRow(ws) + 1
    If r < 2 Then r = 2

    ws.Cells(r, 1).Value = Now
    ws.Cells(r, 2).Value = level
    ws.Cells(r, 3).Value = taskName
    ws.Cells(r, 4).Value = entityName
    ws.Cells(r, 5).Value = policy
    ws.Cells(r, 6).Value = message
End Sub