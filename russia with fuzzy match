Private Function BuildTaskName(ByVal globalPrefix As String, ByVal issueName As String, ByVal entityName As String) As String
    Dim t As String
    t = Trim$(globalPrefix)
    If Len(Trim$(issueName)) > 0 Then
        t = t & " - " & Trim$(issueName)
    End If
    If Len(Trim$(entityName)) > 0 Then
        t = t & " (" & Trim$(entityName) & ")"
    End If
    BuildTaskName = t
End Function

Private Function GuessMostCommonPrefix(ByVal ws As Worksheet, ByVal hdrRow As Long, ByVal colTaskName As Long) As String
    Dim lastRow As Long, r As Long
    Dim d As Object
    Dim taskText As String, prefixText As String
    Dim bestKey As String, bestCount As Long

    Set d = CreateObject("Scripting.Dictionary")
    lastRow = GetLastUsedRow(ws)

    For r = hdrRow + 1 To lastRow
        taskText = Trim$(CStr(ws.Cells(r, colTaskName).Value))
        If Len(taskText) = 0 Then GoTo ContinueR

        prefixText = ExtractPrefixBeforeDash(taskText)
        If Len(prefixText) > 0 Then
            If d.Exists(prefixText) Then
                d(prefixText) = CLng(d(prefixText)) + 1
            Else
                d.Add prefixText, 1
            End If
        End If

ContinueR:
    Next r

    bestKey = ""
    bestCount = 0

    Dim k As Variant
    For Each k In d.Keys
        If CLng(d(k)) > bestCount Then
            bestCount = CLng(d(k))
            bestKey = CStr(k)
        End If
    Next k

    GuessMostCommonPrefix = bestKey
End Function

Private Function ExtractPrefixBeforeDash(ByVal taskText As String) As String
    Dim p As Long
    p = InStr(1, taskText, " - ", vbTextCompare)
    If p > 0 Then
        ExtractPrefixBeforeDash = Trim$(Left$(taskText, p - 1))
    Else
        ExtractPrefixBeforeDash = ""
    End If
End Function

Private Function ExtractTextInsideLastParen(ByVal s As String) As String
    Dim p1 As Long, p2 As Long
    p2 = InStrRev(s, ")")
    p1 = InStrRev(s, "(")
    If p1 > 0 And p2 > p1 Then
        ExtractTextInsideLastParen = Trim$(Mid$(s, p1 + 1, p2 - p1 - 1))
    Else
        ExtractTextInsideLastParen = ""
    End If
End Function

Private Function ExtractPolicyBetweenPrefixAndLastParen(ByVal taskText As String) As String
    Dim pDash As Long, pOpen As Long
    pDash = InStr(1, taskText, " - ", vbTextCompare)
    pOpen = InStrRev(taskText, "(")

    If pDash > 0 And pOpen > pDash Then
        ExtractPolicyBetweenPrefixAndLastParen = Trim$(Mid$(taskText, pDash + 3, pOpen - (pDash + 3)))
    Else
        ExtractPolicyBetweenPrefixAndLastParen = ""
    End If
End Function

Private Function ParseEntities(ByVal systemsRaw As String) As Collection
    Dim col As New Collection
    Dim txt As String, arr As Variant, i As Long
    Dim piece As String

    txt = Trim$(systemsRaw)
    txt = Replace(txt, vbCrLf, "|")
    txt = Replace(txt, vbCr, "|")
    txt = Replace(txt, vbLf, "|")
    txt = Replace(txt, ";", "|")

    If InStr(txt, "|") = 0 Then
        piece = CleanEntityName(txt)
        If Len(piece) > 0 Then col.Add piece
        Set ParseEntities = col
        Exit Function
    End If

    arr = Split(txt, "|")
    For i = LBound(arr) To UBound(arr)
        piece = CleanEntityName(CStr(arr(i)))
        If Len(piece) > 0 Then col.Add piece
    Next i

    Set ParseEntities = col
End Function

Private Function CleanEntityName(ByVal s As String) As String
    Dim t As String
    t = Trim$(s)

    Do While InStr(t, "  ") > 0
        t = Replace(t, "  ", " ")
    Loop

    CleanEntityName = t
End Function

Private Function CanonicalPolicySubDomain(ByVal s As String) As String
    Dim t As String
    t = Trim$(s)

    If Len(t) = 0 Then
        CanonicalPolicySubDomain = ""
        Exit Function
    End If

    t = Replace(t, vbCr, " ")
    t = Replace(t, vbLf, " ")
    Do While InStr(t, "  ") > 0
        t = Replace(t, "  ", " ")
    Loop

    CanonicalPolicySubDomain = t
End Function

Private Function MakeMeaningfulSnippetPhrase(ByVal s As String, ByVal minWords As Long, ByVal maxWords As Long) As String
    Dim cleaned As String, arr As Variant
    Dim i As Long, cnt As Long, piece As String

    cleaned = NormalizeSentence(s)
    If Len(cleaned) = 0 Then Exit Function

    arr = Split(cleaned, " ")
    For i = LBound(arr) To UBound(arr)
        If Len(Trim$(CStr(arr(i)))) > 0 Then
            If Len(piece) > 0 Then piece = piece & " "
            piece = piece & CStr(arr(i))
            cnt = cnt + 1
            If cnt >= maxWords Then Exit For
        End If
    Next i

    If cnt < minWords Then
        MakeMeaningfulSnippetPhrase = cleaned
    Else
        MakeMeaningfulSnippetPhrase = piece
    End If
End Function

Private Function NormalizeSentence(ByVal s As String) As String
    Dim t As String
    t = Trim$(s)
    t = Replace(t, vbCr, " ")
    t = Replace(t, vbLf, " ")
    t = Replace(t, "?", "")
    t = Replace(t, ".", "")
    Do While InStr(t, "  ") > 0
        t = Replace(t, "  ", " ")
    Loop
    NormalizeSentence = Trim$(t)
End Function

Private Function NormalizeKey(ByVal s As String) As String
    Dim t As String
    t = LCase$(Trim$(s))
    t = Replace(t, vbCr, " ")
    t = Replace(t, vbLf, " ")
    t = Replace(t, vbTab, " ")
    t = Replace(t, "(", " ")
    t = Replace(t, ")", " ")
    t = Replace(t, "[", " ")
    t = Replace(t, "]", " ")
    t = Replace(t, "-", " ")
    t = Replace(t, "_", " ")
    t = Replace(t, "/", " ")
    t = Replace(t, "\", " ")
    t = Replace(t, ".", " ")
    t = Replace(t, ",", " ")
    t = Replace(t, ";", " ")
    t = Replace(t, ":", " ")

    Do While InStr(t, "  ") > 0
        t = Replace(t, "  ", " ")
    Loop

    NormalizeKey = Trim$(t)
End Function

Private Function GetMergedValue(ByVal cell As Range) As Variant
    If cell.MergeCells Then
        GetMergedValue = cell.MergeArea.Cells(1, 1).Value
    Else
        GetMergedValue = cell.Value
    End If
End Function

Private Function GetLastUsedRow(ByVal ws As Worksheet) As Long
    Dim lastCell As Range
    On Error Resume Next
    Set lastCell = ws.Cells.Find(What:="*", After:=ws.Cells(1, 1), LookIn:=xlFormulas, _
                                 LookAt:=xlPart, SearchOrder:=xlByRows, SearchDirection:=xlPrevious)
    On Error GoTo 0

    If lastCell Is Nothing Then
        GetLastUsedRow = 1
    Else
        GetLastUsedRow = lastCell.Row
    End If
End Function

' ============================================================
' ISSUE ID BACKFILL
' Preserves original idea:
' extra rows inherit Issue ID from task's main row
' ============================================================

Private Sub FillIssueIdsFromMainRows(ByVal ws As Worksheet, ByVal hdrRow As Long, ByVal colTaskName As Long, ByVal colIssueId As Long)
    Dim lastRow As Long, r As Long
    Dim d As Object
    Set d = CreateObject("Scripting.Dictionary")

    lastRow = GetLastUsedRow(ws)

    ' First pass: remember first nonblank Issue ID for each task name
    For r = hdrRow + 1 To lastRow
        Dim taskKey As String, issueVal As String
        taskKey = NormalizeKey(CStr(ws.Cells(r, colTaskName).Value))
        issueVal = Trim$(CStr(ws.Cells(r, colIssueId).Value))

        If Len(taskKey) > 0 And Len(issueVal) > 0 Then
            If Not d.Exists(taskKey) Then d.Add taskKey, issueVal
        End If
    Next r

    ' Second pass: fill blanks from remembered task Issue ID
    For r = hdrRow + 1 To lastRow
        taskKey = NormalizeKey(CStr(ws.Cells(r, colTaskName).Value))
        issueVal = Trim$(CStr(ws.Cells(r, colIssueId).Value))

        If Len(taskKey) > 0 And Len(issueVal) = 0 Then
            If d.Exists(taskKey) Then
                ws.Cells(r, colIssueId).Value = d(taskKey)
            End If
        End If
    Next r
End Sub

