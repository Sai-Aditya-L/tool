Option Explicit

Public Sub Populate_And_Append_RemediationTasks_From_IssueReports_WithLog()

    Dim dstPath As Variant, folderPath As String
    Dim wbD As Workbook, wsD As Worksheet, wsLog As Worksheet
    Dim hdrRowD As Long
    Dim colTaskName As Long, colDesc As Long, colAssigned As Long, colDue As Long

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False

    'Pick Remediation Task file
    dstPath = Application.GetOpenFilename("Excel Files (*.xlsx;*.xlsm), *.xlsx;*.xlsm", , _
                                         "Select Remediation Task file")
    If dstPath = False Then GoTo CleanExit

    Set wbD = Workbooks.Open(CStr(dstPath))
    Set wsD = wbD.Worksheets(1) 'change if needed

    'Create/clear log sheet
    Set wsLog = GetOrCreateLogSheet(wbD, "Run Log")
    InitLog wsLog
    LogEvent wsLog, "INFO", "", "", "", "", "Started run."

    'Pick folder with Issue Report files
    folderPath = PickFolder("Select folder containing Issue Report - <EntityName> files")
    If Len(folderPath) = 0 Then
        LogEvent wsLog, "WARN", "", "", "", "", "No folder selected. Exiting."
        GoTo CleanExit
    End If
    LogEvent wsLog, "INFO", "", "", "", "", "Issue Report folder: " & folderPath

    'Find destination headers
    hdrRowD = FindHeaderRow(wsD, Array("Remediation Task Name", "Description", "Assigned to", "Due Date"), 80)
    If hdrRowD = 0 Then
        LogEvent wsLog, "ERROR", "", "", "", "", "Missing required headers in Remediation Task sheet."
        MsgBox "Could not find required headers in Remediation Task sheet:" & vbCrLf & _
               "Remediation Task Name, Description, Assigned to, Due Date", vbCritical
        GoTo CleanExit
    End If

    colTaskName = FindHeaderColumn(wsD, hdrRowD, "Remediation Task Name")
    colDesc = FindHeaderColumn(wsD, hdrRowD, "Description")
    colAssigned = FindHeaderColumn(wsD, hdrRowD, "Assigned to")
    colDue = FindHeaderColumn(wsD, hdrRowD, "Due Date")

    wsD.Columns(colTaskName).NumberFormat = "@"
    wsD.Columns(colDesc).NumberFormat = "@"
    wsD.Columns(colAssigned).NumberFormat = "@"
    wsD.Columns(colDue).NumberFormat = "m/d/yyyy"

    LogEvent wsLog, "INFO", "", "", "", "", "Detected destination headers on row " & hdrRowD & "."

    'Map entity -> file path from folder
    Dim entityToFile As Object
    Set entityToFile = BuildEntityFileMap(folderPath)
    If entityToFile.Count = 0 Then
        LogEvent wsLog, "ERROR", "", "", "", "", "No files found matching: Issue Report - *.xls*"
        MsgBox "No Issue Report files found in the selected folder.", vbCritical
        GoTo CleanExit
    End If
    LogEvent wsLog, "INFO", "", "", "", "", "Found " & entityToFile.Count & " Issue Report file(s)."

    'Existing row index: (entity + policySubDomain) -> row number
    Dim existing As Object
    Set existing = CreateObject("Scripting.Dictionary")

    'Prefix per entity: entityKey -> prefix (e.g. "Russia Sweep 2 - ")
    Dim entityPrefix As Object
    Set entityPrefix = CreateObject("Scripting.Dictionary")

    Dim globalPrefix As String
    globalPrefix = ""

    Dim lastRowD As Long, r As Long
    lastRowD = wsD.Cells(wsD.Rows.Count, colTaskName).End(xlUp).Row

    'Scan remediation task sheet to build existing map + prefixes
    For r = hdrRowD + 1 To lastRowD
        Dim t As String, ent As String, polSub As String, pref As String
        t = Trim(CStr(wsD.Cells(r, colTaskName).Value))
        If Len(t) = 0 Then GoTo NextR1

        ent = ExtractBetweenParens(t)
        polSub = ExtractPolicySubDomainFromTaskName(t)
        pref = ExtractPrefixUpToSweep2Dash(t)

        If Len(pref) > 0 And IsGoodPrefix(pref) Then
            If Len(globalPrefix) = 0 Then globalPrefix = pref

            If Len(ent) > 0 Then
                Dim eKey As String
                eKey = NormalizeKey(ent)
                If Not entityPrefix.Exists(eKey) Then
                    entityPrefix.Add eKey, pref
                End If
            End If
        End If

        If Len(ent) > 0 And Len(polSub) > 0 Then
            Dim k As String
            k = NormalizeKey(ent) & "||" & NormalizeKey(polSub)
            If Not existing.Exists(k) Then existing.Add k, r
        End If

NextR1:
    Next r

    If Len(globalPrefix) = 0 Then globalPrefix = "Sweep 2 - "
    LogEvent wsLog, "INFO", "", "", "", "", "Global prefix fallback: [" & globalPrefix & "]"
    LogEvent wsLog, "INFO", "", "", "", "", "Entity prefixes learned: " & entityPrefix.Count

    'Cache lookups per entity file
    Dim lookupCache As Object
    Set lookupCache = CreateObject("Scripting.Dictionary")

    Dim entKey As Variant
    For Each entKey In entityToFile.Keys

        Dim srcFile As String
        srcFile = entityToFile(entKey)
        LogEvent wsLog, "INFO", DenormalizeForLog(entKey), "", "", "", "Opening Issue Report: " & srcFile

        Dim polLookup As Object
        If Not lookupCache.Exists(entKey) Then
            Set polLookup = BuildIssueReportPolicySubLookup(srcFile, wsLog)
            lookupCache.Add entKey, polLookup
        Else
            Set polLookup = lookupCache(entKey)
        End If

        If polLookup.Count = 0 Then
            LogEvent wsLog, "WARN", DenormalizeForLog(entKey), "", "", "", "No Policy Sub-Domain records loaded from report."
            GoTo NextEntity
        End If

        'Pick prefix for this entity (best: learned from existing rows; else global)
        Dim usePrefix As String
        If entityPrefix.Exists(entKey) Then
            usePrefix = CStr(entityPrefix(entKey))
        Else
            usePrefix = globalPrefix
        End If

        Dim polKey As Variant
        For Each polKey In polLookup.Keys

            Dim rec As Variant
            rec = polLookup(polKey) '0 plan, 1 owner, 2 date, 3 policy subdomain text, 4 entity display

            Dim key2 As String
            key2 = entKey & "||" & polKey

            If existing.Exists(key2) Then
                'Update existing row
                Dim rowNum As Long
                rowNum = CLng(existing(key2))

                wsD.Cells(rowNum, colDesc).Value = CStr(rec(0))
                wsD.Cells(rowNum, colAssigned).Value = CStr(rec(1))

                If IsDate(rec(2)) Then
                    wsD.Cells(rowNum, colDue).Value = CDate(rec(2))
                Else
                    wsD.Cells(rowNum, colDue).Value = CStr(rec(2))
                End If

                LogEvent wsLog, "UPDATED", CStr(rec(4)), CStr(rec(3)), rowNum, "", "Updated existing row."

            Else
                'Append new row with correct format
                Dim outRow As Long
                outRow = wsD.Cells(wsD.Rows.Count, colTaskName).End(xlUp).Row + 1
                If outRow <= hdrRowD Then outRow = hdrRowD + 1

                Dim policySubText As String
                policySubText = CStr(rec(3))

                Dim entityDisplay As String
                entityDisplay = CStr(rec(4))

                'Make it look like existing rows: Prefix + PolicySub + " (" + Entity + ")"
                wsD.Cells(outRow, colTaskName).Value = usePrefix & policySubText & " (" & entityDisplay & ")"
                wsD.Cells(outRow, colDesc).Value = CStr(rec(0))
                wsD.Cells(outRow, colAssigned).Value = CStr(rec(1))

                If IsDate(rec(2)) Then
                    wsD.Cells(outRow, colDue).Value = CDate(rec(2))
                Else
                    wsD.Cells(outRow, colDue).Value = CStr(rec(2))
                End If

                existing.Add key2, outRow

                LogEvent wsLog, "ADDED", entityDisplay, policySubText, outRow, "", _
                         "Added missing row using prefix: [" & usePrefix & "]"
            End If
        Next polKey

NextEntity:
    Next entKey

    LogEvent wsLog, "INFO", "", "", "", "", "Run complete."
    MsgBox "Done! Updated existing rows and added missing Policy Sub-Domains per entity." & vbCrLf & _
           "See the 'Run Log' sheet for details.", vbInformation

CleanExit:
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
End Sub

'==========================================================
' IMPORTANT: Reject template/example prefixes like "[Division/Country] ..."
'==========================================================
Private Function IsGoodPrefix(ByVal pref As String) As Boolean
    Dim t As String
    t = LCase$(pref)

    If InStr(1, pref, "[", vbTextCompare) > 0 Or InStr(1, pref, "]", vbTextCompare) > 0 Then
        IsGoodPrefix = False
        Exit Function
    End If

    If InStr(1, t, "issue name", vbTextCompare) > 0 Or InStr(1, t, "entity name", vbTextCompare) > 0 Then
        IsGoodPrefix = False
        Exit Function
    End If

    'Must contain "sweep" and "2" and "-"
    If InStr(1, t, "sweep", vbTextCompare) = 0 Then
        IsGoodPrefix = False
        Exit Function
    End If
    If InStr(1, t, "2", vbTextCompare) = 0 Then
        IsGoodPrefix = False
        Exit Function
    End If
    If InStr(1, t, "-", vbTextCompare) = 0 Then
        IsGoodPrefix = False
        Exit Function
    End If

    IsGoodPrefix = True
End Function

'==========================================================
' Build lookup: policySubDomain -> remediation fields
'==========================================================
Private Function BuildIssueReportPolicySubLookup(ByVal srcFile As String, ByVal wsLog As Worksheet) As Object
    Dim wbS As Workbook, wsS As Worksheet
    Dim hdrRowS As Long
    Dim colPolSub As Long, colPlan As Long, colOwner As Long, colDate As Long

    Dim entityDisplay As String
    entityDisplay = ExtractEntityFromFilename(Dir(srcFile))

    Set BuildIssueReportPolicySubLookup = CreateObject("Scripting.Dictionary")

    On Error GoTo FailOpen
    Set wbS = Workbooks.Open(srcFile, ReadOnly:=True)
    On Error GoTo 0

    On Error Resume Next
    Set wsS = wbS.Worksheets("Issue Report Listing2")
    On Error GoTo 0
    If wsS Is Nothing Then Set wsS = wbS.Worksheets(1)

    hdrRowS = FindHeaderRowLoose(wsS, Array("Policy Sub-Domain", "Remediation Plan", "Remediation Owner", "Remediation Completion Date"), 200)
    If hdrRowS = 0 Then
        LogEvent wsLog, "ERROR", entityDisplay, "", "", "", _
                 "Missing headers in Issue Report Listing2 (Policy Sub-Domain/Remediation fields)."
        wbS.Close SaveChanges:=False
        Exit Function
    End If

    colPolSub = FindHeaderColumnLoose(wsS, hdrRowS, "Policy Sub-Domain")
    colPlan = FindHeaderColumnLoose(wsS, hdrRowS, "Remediation Plan")
    colOwner = FindHeaderColumnLoose(wsS, hdrRowS, "Remediation Owner")
    colDate = FindHeaderColumnLoose(wsS, hdrRowS, "Remediation Completion Date")

    Dim lastRow As Long
    lastRow = wsS.UsedRange.Rows(wsS.UsedRange.Rows.Count).Row

    Dim r As Long
    For r = hdrRowS + 1 To lastRow
        Dim polSub As String
        polSub = Trim(CStr(GetMergedValue(wsS.Cells(r, colPolSub))))
        If Len(polSub) = 0 Then GoTo NextRow

        Dim polKey As String
        polKey = NormalizeKey(polSub)

        If Not BuildIssueReportPolicySubLookup.Exists(polKey) Then
            Dim plan As String, owner As String, dt As Variant
            plan = CStr(GetMergedValue(wsS.Cells(r, colPlan)))
            owner = CStr(GetMergedValue(wsS.Cells(r, colOwner)))
            dt = GetMergedValue(wsS.Cells(r, colDate))

            Dim rec(4) As Variant
            rec(0) = plan
            rec(1) = owner
            rec(2) = dt
            rec(3) = polSub
            rec(4) = entityDisplay

            BuildIssueReportPolicySubLookup.Add polKey, rec
        End If

NextRow:
    Next r

    wbS.Close SaveChanges:=False
    Exit Function

FailOpen:
    LogEvent wsLog, "ERROR", entityDisplay, "", "", "", "Failed to open Issue Report file."
End Function

'==========================================================
' Entity -> file map
'==========================================================
Private Function BuildEntityFileMap(ByVal folderPath As String) As Object
    Dim dict As Object
    Set dict = CreateObject("Scripting.Dictionary")

    If Right$(folderPath, 1) <> "\" Then folderPath = folderPath & "\"

    Dim f As String
    f = Dir(folderPath & "Issue Report - *.xls*")
    Do While Len(f) > 0
        Dim entity As String, key As String
        entity = ExtractEntityFromFilename(f)
        key = NormalizeKey(entity)
        If Len(key) > 0 Then
            If Not dict.Exists(key) Then dict.Add key, folderPath & f
        End If
        f = Dir()
    Loop

    Set BuildEntityFileMap = dict
End Function

Private Function ExtractEntityFromFilename(ByVal fileName As String) As String
    Dim base As String, prefix As String
    base = fileName

    If InStrRev(base, ".") > 0 Then base = Left$(base, InStrRev(base, ".") - 1)

    prefix = "Issue Report - "
    If LCase$(Left$(base, Len(prefix))) = LCase$(prefix) Then
        base = Mid$(base, Len(prefix) + 1)
    End If

    ExtractEntityFromFilename = Trim(base)
End Function

'==========================================================
' Parsing: supports "EPD Sweep 2 - X (Entity)" and similar
'==========================================================
Private Function ExtractBetweenParens(ByVal s As String) As String
    Dim p1 As Long, p2 As Long
    p1 = InStrRev(s, "(")
    p2 = InStrRev(s, ")")
    If p1 > 0 And p2 > p1 Then
        ExtractBetweenParens = Trim(Mid$(s, p1 + 1, p2 - p1 - 1))
    Else
        ExtractBetweenParens = ""
    End If
End Function

Private Function ExtractPolicySubDomainFromTaskName(ByVal s As String) As String
    Dim lowerS As String
    lowerS = LCase$(s)

    Dim pSweep As Long
    pSweep = InStr(1, lowerS, "sweep", vbTextCompare)
    If pSweep = 0 Then
        ExtractPolicySubDomainFromTaskName = ""
        Exit Function
    End If

    Dim p2 As Long
    p2 = InStr(pSweep, lowerS, "2", vbTextCompare)
    If p2 = 0 Then
        ExtractPolicySubDomainFromTaskName = ""
        Exit Function
    End If

    Dim pDash As Long
    pDash = InStr(p2, lowerS, "-", vbTextCompare)
    If pDash = 0 Then
        ExtractPolicySubDomainFromTaskName = ""
        Exit Function
    End If

    Dim startPos As Long
    startPos = pDash + 1
    Do While startPos <= Len(s) And Mid$(s, startPos, 1) = " "
        startPos = startPos + 1
    Loop

    Dim pParen As Long
    pParen = InStrRev(s, "(")

    Dim pol As String
    If pParen > 0 And pParen > startPos Then
        pol = Mid$(s, startPos, pParen - startPos)
    Else
        pol = Mid$(s, startPos)
    End If

    ExtractPolicySubDomainFromTaskName = Trim(pol)
End Function

Private Function ExtractPrefixUpToSweep2Dash(ByVal s As String) As String
    Dim lowerS As String
    lowerS = LCase$(s)

    Dim pSweep As Long
    pSweep = InStr(1, lowerS, "sweep", vbTextCompare)
    If pSweep = 0 Then
        ExtractPrefixUpToSweep2Dash = ""
        Exit Function
    End If

    Dim p2 As Long
    p2 = InStr(pSweep, lowerS, "2", vbTextCompare)
    If p2 = 0 Then
        ExtractPrefixUpToSweep2Dash = ""
        Exit Function
    End If

    Dim pDash As Long
    pDash = InStr(p2, lowerS, "-", vbTextCompare)
    If pDash = 0 Then
        ExtractPrefixUpToSweep2Dash = ""
        Exit Function
    End If

    Dim endPos As Long
    endPos = pDash
    Do While endPos < Len(s) And Mid$(s, endPos + 1, 1) = " "
        endPos = endPos + 1
    Loop

    ExtractPrefixUpToSweep2Dash = Left$(s, endPos)
End Function

'==========================================================
' Log helpers
'==========================================================
Private Function GetOrCreateLogSheet(ByVal wb As Workbook, ByVal sheetName As String) As Worksheet
    On Error Resume Next
    Set GetOrCreateLogSheet = wb.Worksheets(sheetName)
    On Error GoTo 0

    If GetOrCreateLogSheet Is Nothing Then
        Set GetOrCreateLogSheet = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))
        GetOrCreateLogSheet.Name = sheetName
    End If
End Function

Private Sub InitLog(ByVal wsLog As Worksheet)
    wsLog.Cells.Clear
    wsLog.Range("A1:F1").Value = Array("Timestamp", "Status", "Entity", "Policy Sub-Domain", "Row #", "Message")
    wsLog.Columns("A:F").EntireColumn.AutoFit
End Sub

Private Sub LogEvent(ByVal wsLog As Worksheet, ByVal status As String, ByVal entity As String, _
                     ByVal policySub As String, ByVal rowNum As Variant, ByVal extra As String, ByVal message As String)
    Dim nextRow As Long
    nextRow = wsLog.Cells(wsLog.Rows.Count, 1).End(xlUp).Row + 1
    If nextRow < 2 Then nextRow = 2

    wsLog.Cells(nextRow, 1).Value = Now
    wsLog.Cells(nextRow, 2).Value = status
    wsLog.Cells(nextRow, 3).Value = entity
    wsLog.Cells(nextRow, 4).Value = policySub
    If Len(CStr(rowNum)) > 0 Then wsLog.Cells(nextRow, 5).Value = rowNum
    wsLog.Cells(nextRow, 6).Value = message
End Sub

Private Function DenormalizeForLog(ByVal k As String) As String
    DenormalizeForLog = k
End Function

'==========================================================
' Header detection
'==========================================================
Private Function FindHeaderRow(ws As Worksheet, headers As Variant, maxRowsToScan As Long) As Long
    Dim r As Long, i As Long
    For r = 1 To maxRowsToScan
        For i = LBound(headers) To UBound(headers)
            If FindHeaderColumn(ws, r, CStr(headers(i))) = 0 Then GoTo NextR
        Next i
        FindHeaderRow = r
        Exit Function
NextR:
    Next r
    FindHeaderRow = 0
End Function

Private Function FindHeaderColumn(ws As Worksheet, headerRow As Long, headerText As String) As Long
    Dim lastCol As Long, c As Long, v As String
    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    For c = 1 To lastCol
        v = Trim(CStr(ws.Cells(headerRow, c).Value))
        If StrComp(v, headerText, vbTextCompare) = 0 Then
            FindHeaderColumn = c
            Exit Function
        End If
    Next c
    FindHeaderColumn = 0
End Function

Private Function FindHeaderRowLoose(ws As Worksheet, headers As Variant, maxRowsToScan As Long) As Long
    Dim r As Long, i As Long
    For r = 1 To maxRowsToScan
        For i = LBound(headers) To UBound(headers)
            If FindHeaderColumnLoose(ws, r, CStr(headers(i))) = 0 Then GoTo NextR
        Next i
        FindHeaderRowLoose = r
        Exit Function
NextR:
    Next r
    FindHeaderRowLoose = 0
End Function

Private Function FindHeaderColumnLoose(ws As Worksheet, headerRow As Long, headerText As String) As Long
    Dim lastCol As Long, c As Long
    Dim target As String, v As String
    target = NormalizeKey(headerText)

    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    For c = 1 To lastCol
        v = NormalizeKey(CStr(ws.Cells(headerRow, c).Value))
        If v = target Then
            FindHeaderColumnLoose = c
            Exit Function
        End If
        If InStr(1, v, target, vbTextCompare) > 0 Or InStr(1, target, v, vbTextCompare) > 0 Then
            FindHeaderColumnLoose = c
            Exit Function
        End If
    Next c
    FindHeaderColumnLoose = 0
End Function

'==========================================================
' Utilities
'==========================================================
Private Function GetMergedValue(ByVal cell As Range) As Variant
    If cell.MergeCells Then
        GetMergedValue = cell.MergeArea.Cells(1, 1).Value
    Else
        GetMergedValue = cell.Value
    End If
End Function

Private Function NormalizeKey(ByVal s As String) As String
    Dim t As String
    t = LCase$(Trim(CStr(s)))
    t = Replace(t, vbCrLf, " ")
    t = Replace(t, vbCr, " ")
    t = Replace(t, vbLf, " ")
    t = Replace(t, ChrW(160), " ")
    Do While InStr(t, "  ") > 0
        t = Replace(t, "  ", " ")
    Loop
    NormalizeKey = t
End Function

Private Function PickFolder(prompt As String) As String
    On Error GoTo Fail
    Dim fd As FileDialog
    Set fd = Application.FileDialog(msoFileDialogFolderPicker)
    fd.Title = prompt
    fd.AllowMultiSelect = False
    If fd.Show = -1 Then
        PickFolder = fd.SelectedItems(1)
    Else
        PickFolder = ""
    End If
    Exit Function
Fail:
    PickFolder = ""
End Function