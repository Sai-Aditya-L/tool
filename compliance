Option Explicit

Public Sub Build_CombinedMetrics_FromFolder_OutputTemplate()

    Const TARGET_SHEET As String = "outputTemplate - Power BI Upload"
    'If your sheet name is "outputTemplate -Power BI Upload" (no space), change it here.

    'These become the columns in the combined metrics sheet
    Dim metricHeaders As Variant
    metricHeaders = Array( _
        "Access Control", _
        "Configuration Management", _
        "Cryptographic Protection", _
        "Network Security", _
        "Non-Prod Environment Controls", _
        "Protection of Systems and Communications", _
        "Secure Authentication", _
        "System Logging & Monitoring", _
        "System Security Testing", _
        "Vulnerability management & Scanning", _
        "Disaster Recovery" _
    )

    Dim folderPath As String, fileName As String, fullPath As String
    Dim wb As Workbook, ws As Worksheet
    Dim outWs As Worksheet, logWs As Worksheet
    Dim outRow As Long

    Dim polSubCell As Range, polSubCol As Long, headerRow As Long, lastRow As Long
    Dim respCols As Collection, respCol As Variant

    'Label rows (optional but used when present)
    Dim rAppName As Long, rITFunc As Long, rDataClass As Long, rDAIID As Long, rAppID As Long, rNumAsset As Long

    Dim appName As String, itFunc As String, dataClass As String, daiId As String, appId As String, numAsset As String
    Dim m As Long

    folderPath = PickFolder()
    If Len(folderPath) = 0 Then Exit Sub
    If Right(folderPath, 1) <> "\" Then folderPath = folderPath & "\"

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.EnableEvents = False

    Set outWs = GetOrCreateSheet(ThisWorkbook, "Combined Metrics")
    Set logWs = GetOrCreateSheet(ThisWorkbook, "Log")

    'Output header
    If outWs.Cells(1, 1).Value = "" Then
        outWs.Cells(1, 1).Value = "IT Function"
        outWs.Cells(1, 2).Value = "Application/Site Name"
        outWs.Cells(1, 3).Value = "Data Class"
        outWs.Cells(1, 4).Value = "DAI ID"
        outWs.Cells(1, 5).Value = "App ID"
        outWs.Cells(1, 6).Value = "Number of Asset"
        For m = LBound(metricHeaders) To UBound(metricHeaders)
            outWs.Cells(1, 7 + m).Value = metricHeaders(m)
        Next m
        outWs.Cells(1, 7 + UBound(metricHeaders) + 1).Value = "Source File"
        outWs.Rows(1).Font.Bold = True
        outWs.Columns.NumberFormat = "@" 'keep IDs as text
    End If

    'Log header
    If logWs.Cells(1, 1).Value = "" Then
        logWs.Range("A1:C1").Value = Array("File", "Status", "Notes")
        logWs.Rows(1).Font.Bold = True
    End If

    fileName = Dir(folderPath & "*.xls*")
    Do While Len(fileName) > 0

        fullPath = folderPath & fileName

        If StrComp(fullPath, ThisWorkbook.FullName, vbTextCompare) <> 0 Then

            On Error GoTo FileError
            Set wb = Workbooks.Open(Filename:=fullPath, ReadOnly:=True, UpdateLinks:=False)

            Set ws = Nothing
            On Error Resume Next
            Set ws = wb.Worksheets(TARGET_SHEET)
            On Error GoTo 0

            If ws Is Nothing Then
                LogLine logWs, fileName, "Skipped", "Sheet not found: " & TARGET_SHEET
                GoTo CloseAndNext
            End If

            'Find Policy Sub-Domain header anywhere
            Set polSubCell = FindTextCell(ws, "Policy Sub-Domain")
            If polSubCell Is Nothing Then
                LogLine logWs, fileName, "Skipped", "Could not find 'Policy Sub-Domain' header."
                GoTo CloseAndNext
            End If

            polSubCol = polSubCell.Column
            headerRow = polSubCell.Row
            lastRow = ws.Cells(ws.Rows.Count, polSubCol).End(xlUp).Row
            If lastRow <= headerRow Then
                LogLine logWs, fileName, "Skipped", "No data rows under Policy Sub-Domain header."
                GoTo CloseAndNext
            End If

            'Find label rows (if they exist)
            rAppName = FindLabelRow(ws, "Application Name")
            If rAppName = 0 Then rAppName = FindLabelRow(ws, "Application/Site Name")
            rITFunc = FindLabelRow(ws, "IT Function")
            rDataClass = FindLabelRow(ws, "data class")
            rDAIID = FindLabelRow(ws, "DAI ID")
            rAppID = FindLabelRow(ws, "app id")
            rNumAsset = FindLabelRow(ws, "Number of Asset")

            'Find all response columns for applications
            Set respCols = FindResponseColumns(ws, headerRow)
            If respCols.Count = 0 Then
                LogLine logWs, fileName, "Skipped", "No 'Response Yes/No' columns found."
                GoTo CloseAndNext
            End If

            'For each application response column, compute metrics
            For Each respCol In respCols

                'App metadata from label rows (preferred). If label row not found, best-effort name from header area.
                appName = IIf(rAppName > 0, Trim$(ws.Cells(rAppName, CLng(respCol)).Text), "")
                If Len(appName) = 0 Then appName = GuessAppNameFromColumn(ws, CLng(respCol), headerRow)

                itFunc = IIf(rITFunc > 0, Trim$(ws.Cells(rITFunc, CLng(respCol)).Text), "")
                dataClass = IIf(rDataClass > 0, Trim$(ws.Cells(rDataClass, CLng(respCol)).Text), "")
                daiId = IIf(rDAIID > 0, Trim$(ws.Cells(rDAIID, CLng(respCol)).Text), "")
                appId = IIf(rAppID > 0, Trim$(ws.Cells(rAppID, CLng(respCol)).Text), "")
                numAsset = IIf(rNumAsset > 0, Trim$(ws.Cells(rNumAsset, CLng(respCol)).Text), "")

                'Skip empty columns that aren't really apps
                If Len(appName) = 0 And Len(appId) = 0 Then GoTo NextResp

                outRow = outWs.Cells(outWs.Rows.Count, "A").End(xlUp).Row + 1

                outWs.Cells(outRow, 1).Value = itFunc
                outWs.Cells(outRow, 2).Value = appName
                outWs.Cells(outRow, 3).Value = dataClass
                outWs.Cells(outRow, 4).Value = daiId
                outWs.Cells(outRow, 5).Value = appId
                outWs.Cells(outRow, 6).Value = numAsset

                For m = LBound(metricHeaders) To UBound(metricHeaders)
                    outWs.Cells(outRow, 7 + m).Value = ComputeMetricYN( _
                        ws:=ws, _
                        rStart:=headerRow + 1, _
                        rEnd:=lastRow, _
                        polSubCol:=polSubCol, _
                        appRespCol:=CLng(respCol), _
                        metricName:=CStr(metricHeaders(m)) _
                    )
                Next m

                outWs.Cells(outRow, 7 + UBound(metricHeaders) + 1).Value = fileName

NextResp:
            Next respCol

            LogLine logWs, fileName, "OK", "Imported metrics (" & respCols.Count & " app columns)."

CloseAndNext:
            On Error Resume Next
            wb.Close SaveChanges:=False
            On Error GoTo 0
            Set ws = Nothing
            Set wb = Nothing
        End If

        fileName = Dir()
        DoEvents
    Loop

Cleanup:
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    Application.EnableEvents = True

    MsgBox "Done. See 'Combined Metrics' and 'Log'.", vbInformation
    Exit Sub

FileError:
    LogLine logWs, fileName, "Error", Err.Description
    On Error Resume Next
    If Not wb Is Nothing Then wb.Close SaveChanges:=False
    On Error GoTo 0
    Resume CloseAndNext

End Sub

'========================
' Core logic helpers
'========================

'Find a row number where a label appears anywhere (used for "app id", "data class", etc.)
Private Function FindLabelRow(ByVal ws As Worksheet, ByVal labelText As String) As Long
    Dim c As Range
    Set c = FindTextCell(ws, labelText)
    If c Is Nothing Then
        FindLabelRow = 0
    Else
        FindLabelRow = c.Row
    End If
End Function

'Find all response columns that belong to applications.
'Heuristic: header rows near the Policy header contain cells with "Response" and "Yes/No"
Private Function FindResponseColumns(ByVal ws As Worksheet, ByVal policyHeaderRow As Long) As Collection
    Dim cols As New Collection
    Dim rng As Range, f As Range, firstAddr As String
    Dim topRow As Long, botRow As Long
    Dim col As Long, txt As String

    'Search a reasonable header band above/around the policy header
    topRow = Application.Max(1, policyHeaderRow - 20)
    botRow = policyHeaderRow + 5

    Set rng = ws.Range(ws.Cells(topRow, 1), ws.Cells(botRow, ws.UsedRange.Columns.Count))

    Set f = rng.Find(What:="Response", LookIn:=xlValues, LookAt:=xlPart, _
                     SearchOrder:=xlByRows, SearchDirection:=xlNext, MatchCase:=False)

    If f Is Nothing Then
        Set FindResponseColumns = cols
        Exit Function
    End If

    firstAddr = f.Address
    Do
        txt = LCase$(Trim$(CStr(f.Text)))
        'Must look like the Response header (avoid comments columns)
        If InStr(txt, "response") > 0 And (InStr(txt, "yes/no") > 0 Or InStr(txt, "yes") > 0) Then
            col = f.Column
            AddUniqueCol cols, col
        End If

        Set f = rng.FindNext(f)
    Loop While Not f Is Nothing And f.Address <> firstAddr

    Set FindResponseColumns = cols
End Function

Private Sub AddUniqueCol(ByVal cols As Collection, ByVal col As Long)
    Dim v As Variant
    For Each v In cols
        If CLng(v) = col Then Exit Sub
    Next v
    cols.Add col
End Sub

'Compute Y/N for a metric (Policy Sub-Domain bucket) for one app response column
Private Function ComputeMetricYN(ByVal ws As Worksheet, ByVal rStart As Long, ByVal rEnd As Long, _
                                 ByVal polSubCol As Long, ByVal appRespCol As Long, ByVal metricName As String) As String
    Dim r As Long
    Dim metricKey As String, subKey As String
    Dim resp As String
    Dim seenAny As Boolean
    Dim anyNo As Boolean, anyYes As Boolean

    metricKey = Canonical(metricName)
    seenAny = False: anyNo = False: anyYes = False

    For r = rStart To rEnd
        subKey = Canonical(ws.Cells(r, polSubCol).Text)
        If subKey = metricKey Then

            resp = CanonicalResp(ws.Cells(r, appRespCol).Text)
            If Len(resp) > 0 Then seenAny = True

            'Fail signals -> N
            If resp = "no" Or resp = "n" Or resp = "notanswered" Or resp = "nr" Or resp = "n/r" Then
                anyNo = True
                Exit For
            End If

            'Pass signals
            If resp = "yes" Or resp = "y" Then anyYes = True
        End If
    Next r

    If anyNo Then
        ComputeMetricYN = "N"
    ElseIf seenAny And anyYes Then
        ComputeMetricYN = "Y"
    ElseIf seenAny Then
        'Only NA/blank responses found for that metric
        ComputeMetricYN = ""
    Else
        ComputeMetricYN = ""
    End If
End Function

'If Application Name label row isn't reliable, guess app name from the column header band
Private Function GuessAppNameFromColumn(ByVal ws As Worksheet, ByVal col As Long, ByVal policyHeaderRow As Long) As String
    Dim r As Long, topRow As Long
    Dim best As String, cur As String

    topRow = Application.Max(1, policyHeaderRow - 25)
    best = ""

    For r = topRow To policyHeaderRow
        cur = Trim$(CStr(ws.Cells(r, col).Text))
        If Len(cur) > Len(best) Then
            'Avoid picking the response header itself
            If InStr(LCase$(cur), "response") = 0 And InStr(LCase$(cur), "comments") = 0 Then
                best = cur
            End If
        End If
    Next r

    GuessAppNameFromColumn = best
End Function

'========================
' Generic helpers
'========================

Private Function PickFolder() As String
    Dim fd As FileDialog
    Set fd = Application.FileDialog(msoFileDialogFolderPicker)
    fd.Title = "Select folder containing Excel files"
    If fd.Show = -1 Then PickFolder = fd.SelectedItems(1) Else PickFolder = ""
End Function

Private Function GetOrCreateSheet(ByVal wb As Workbook, ByVal sheetName As String) As Worksheet
    On Error Resume Next
    Set GetOrCreateSheet = wb.Worksheets(sheetName)
    On Error GoTo 0
    If GetOrCreateSheet Is Nothing Then
        Set GetOrCreateSheet = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))
        GetOrCreateSheet.Name = sheetName
    End If
End Function

Private Sub LogLine(ByVal logWs As Worksheet, ByVal fileName As String, ByVal status As String, ByVal notes As String)
    Dim lr As Long
    lr = logWs.Cells(logWs.Rows.Count, "A").End(xlUp).Row + 1
    logWs.Cells(lr, 1).Value = fileName
    logWs.Cells(lr, 2).Value = status
    logWs.Cells(lr, 3).Value = notes
End Sub

Private Function FindTextCell(ByVal ws As Worksheet, ByVal needle As String) As Range
    Dim r As Range
    On Error Resume Next
    Set r = ws.UsedRange.Find(What:=needle, LookIn:=xlValues, LookAt:=xlPart, _
                              SearchOrder:=xlByRows, SearchDirection:=xlNext, MatchCase:=False)
    On Error GoTo 0
    Set FindTextCell = r
End Function

Private Function Canonical(ByVal s As String) As String
    Dim i As Long, ch As String, out As String
    s = LCase$(Trim$(s))
    out = ""
    For i = 1 To Len(s)
        ch = Mid$(s, i, 1)
        If (ch >= "a" And ch <= "z") Or (ch >= "0" And ch <= "9") Then out = out & ch
    Next i
    Canonical = out
End Function

Private Function CanonicalResp(ByVal s As String) As String
    s = LCase$(Trim$(s))
    s = Replace(s, " ", "")
    s = Replace(s, vbLf, "")
    s = Replace(s, vbCr, "")

    If s = "yes" Or s = "y" Then CanonicalResp = "yes": Exit Function
    If s = "no" Or s = "n" Then CanonicalResp = "no": Exit Function
    If s = "n/a" Or s = "na" Then CanonicalResp = "na": Exit Function
    If s = "notanswered" Or s = "notanswer" Then CanonicalResp = "notanswered": Exit Function
    If s = "n/r" Or s = "nr" Then CanonicalResp = "n/r": Exit Function

    CanonicalResp = s
End Function