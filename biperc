Compliance % per App (All rows for App) :=
VAR TotalYN =
    CALCULATE(
        COUNTROWS(Questions),
        ALLEXCEPT(Questions, Questions[App Name]),
        FILTER(
            Questions,
            VAR s = UPPER(TRIM(Questions[IsCompliant]))
            RETURN s IN {"Y","N"}
        )
    )
VAR TotalY =
    CALCULATE(
        COUNTROWS(Questions),
        ALLEXCEPT(Questions, Questions[App Name]),
        FILTER(
            Questions,
            VAR s = UPPER(TRIM(Questions[IsCompliant]))
            RETURN s = "Y"
        )
    )
RETURN
DIVIDE(TotalY, TotalYN)