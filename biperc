Compliance % :=
VAR Applicable =
    CALCULATE(
        COUNTROWS(Questions),
        FILTER(
            Questions,
            UPPER(TRIM(Questions[IsCompliant])) IN {"Y","N"}
        )
    )
VAR Compliant =
    CALCULATE(
        COUNTROWS(Questions),
        FILTER(
            Questions,
            UPPER(TRIM(Questions[IsCompliant])) = "Y"
        )
    )
RETURN
DIVIDE(Compliant, Applicable)