Private Function PickExcelFile(ByVal prompt As String) As String
    Dim fd As FileDialog
    Set fd = Application.FileDialog(msoFileDialogFilePicker)
    With fd
        .Title = prompt
        .AllowMultiSelect = False
        .Filters.Clear
        .Filters.Add "Excel Files", "*.xlsx;*.xlsm;*.xls"
        If .Show <> -1 Then PickExcelFile = "" Else PickExcelFile = .SelectedItems(1)
    End With
End Function

Private Function FindSheetByHeader(ByVal wb As Workbook, ByVal headerText As String) As Worksheet
    Dim ws As Worksheet
    For Each ws In wb.Worksheets
        If FindHeaderCol(ws, 1, headerText) > 0 Then
            Set FindSheetByHeader = ws
            Exit Function
        End If
    Next ws
    Set FindSheetByHeader = Nothing
End Function

Private Function FindHeaderCol(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal headerText As String) As Long
    Dim lastCol As Long, c As Long
    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    For c = 1 To lastCol
        If LCase$(TrimFast(CStr(ws.Cells(headerRow, c).Value2))) = LCase$(Trim$(headerText)) Then
            FindHeaderCol = c
            Exit Function
        End If
    Next c
    FindHeaderCol = 0
End Function

Private Function FindHeaderColAny(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal names As Variant) As Long
    Dim i As Long
    For i = LBound(names) To UBound(names)
        Dim col As Long
        col = FindHeaderCol(ws, headerRow, CStr(names(i)))
        If col > 0 Then FindHeaderColAny = col: Exit Function
    Next i
    FindHeaderColAny = 0
End Function

Private Function EnsureLogSheet(ByVal wb As Workbook, ByVal name As String) As Worksheet
    Dim ws As Worksheet
    On Error Resume Next
    Set ws = wb.Worksheets(name)
    On Error GoTo 0
    If ws Is Nothing Then
        Set ws = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))
        ws.Name = name
    End If
    Set EnsureLogSheet = ws
End Function

Private Function NormalizeKey(ByVal s As String) As String
    s = LCase$(TrimFast(s))
    s = Replace(s, vbTab, " ")
    NormalizeKey = TrimFast(s)
End Function

Private Function SplitEntities(ByVal entRaw As String) As Collection
    Dim col As New Collection
    Dim t As String
    t = Replace(entRaw, vbCr, vbLf)
    t = Replace(t, ";", vbLf)
    t = Replace(t, ",", vbLf)

    Dim parts() As String
    parts = Split(t, vbLf)

    Dim i As Long
    For i = LBound(parts) To UBound(parts)
        Dim p As String
        p = TrimFast(parts(i))
        If Len(p) > 0 Then col.Add p
    Next i

    Set SplitEntities = col
End Function

Private Function CleanQuestionText(ByVal s As String) As String
    s = Replace(s, vbCr, " ")
    s = Replace(s, vbLf, " ")
    CleanQuestionText = TrimFast(s)
End Function

Private Function ExtractPrefixFromFilename(ByVal fullPath As String) As String
    Dim f As String, base As String
    f = Mid$(fullPath, InStrRev(fullPath, "\") + 1)
    base = f
    If InStrRev(base, ".") > 0 Then base = Left$(base, InStrRev(base, ".") - 1)

    Dim token As String
    token = base
    If InStr(token, "_") > 0 Then token = Left$(token, InStr(token, "_") - 1)
    If InStr(token, " ") > 0 Then token = Left$(token, InStr(token, " ") - 1)

    token = UCase$(Trim$(token))
    If token Like "[A-Z][A-Z]*" And Len(token) <= 6 Then ExtractPrefixFromFilename = token Else ExtractPrefixFromFilename = ""
End Function

Private Function DetectPrefixFromTasks(ByVal wsTask As Worksheet, ByVal colTaskName As Long) As String
    Dim lr As Long, r As Long
    lr = wsTask.Cells(wsTask.Rows.Count, colTaskName).End(xlUp).Row
    For r = 2 To lr
        Dim t As String
        t = TrimFast(CStr(wsTask.Cells(r, colTaskName).Value2))
        If Len(t) > 0 Then
            Dim p As String
            p = ParsePrefix(t)
            If Len(p) > 0 Then DetectPrefixFromTasks = p: Exit Function
        End If
    Next r
    DetectPrefixFromTasks = ""
End Function

Private Function ParsePrefix(ByVal taskName As String) As String
    Dim s As String
    s = Trim$(taskName)
    Dim pos As Long
    pos = InStr(1, s, "Sweep", vbTextCompare)
    If pos > 1 Then ParsePrefix = UCase$(Trim$(Left$(s, pos - 1))) Else ParsePrefix = ""
End Function

Private Sub BuildExistingIndex(ByVal wsTask As Worksheet, ByVal colTaskName As Long, ByVal dict As Object)
    Dim lr As Long, r As Long
    lr = wsTask.Cells(wsTask.Rows.Count, colTaskName).End(xlUp).Row
    For r = 2 To lr
        Dim t As String
        t = TrimFast(CStr(wsTask.Cells(r, colTaskName).Value2))
        If Len(t) = 0 Then GoTo NextR
        Dim pol As String, ent As String
        pol = ExtractPolicyFromTaskName(t)
        ent = ExtractEntityFromTaskName(t)
        If Len(pol) > 0 And Len(ent) > 0 Then
            Dim keyMain As String
            keyMain = NormalizeKey(ent) & "|" & NormalizeKey(pol)
            If Not dict.Exists(keyMain) Then dict.Add keyMain, r
        End If
NextR:
    Next r
End Sub

Private Function ExtractPolicyFromTaskName(ByVal t As String) As String
    Dim p As Long, q As Long
    p = InStr(1, t, "Sweep 2 -", vbTextCompare)
    If p = 0 Then Exit Function
    p = p + Len("Sweep 2 -")
    q = InStr(p + 1, t, "(", vbTextCompare)
    If q = 0 Then Exit Function
    ExtractPolicyFromTaskName = TrimFast(Mid$(t, p, q - p))
End Function

Private Function ExtractEntityFromTaskName(ByVal t As String) As String
    Dim p As Long, q As Long
    p = InStr(1, t, "(", vbTextCompare)
    q = InStr(1, t, ")", vbTextCompare)
    If p > 0 And q > p Then ExtractEntityFromTaskName = TrimFast(Mid$(t, p + 1, q - p - 1)) Else ExtractEntityFromTaskName = ""
End Function

Private Function RowLooksEmpty(ByVal ws As Worksheet, ByVal r As Long, ByVal cDesc As Long, ByVal cAssigned As Long, ByVal cDue As Long) As Boolean
    If Len(TrimFast(CStr(ws.Cells(r, cDesc).Value2))) > 0 Then RowLooksEmpty = False: Exit Function
    If Len(TrimFast(CStr(ws.Cells(r, cAssigned).Value2))) > 0 Then RowLooksEmpty = False: Exit Function
    If Len(TrimFast(CStr(ws.Cells(r, cDue).Value2))) > 0 Then RowLooksEmpty = False: Exit Function
    RowLooksEmpty = True
End Function

Private Sub WriteDateSmart(ByVal targetCell As Range, ByVal v As Variant)
    On Error GoTo Safe
    If IsDate(v) Then
        targetCell.Value = CDate(v)
        targetCell.NumberFormat = "m/d/yyyy"
    ElseIf IsNumeric(v) And v > 0 Then
        targetCell.Value = DateSerial(1899, 12, 30) + CDbl(v)
        targetCell.NumberFormat = "m/d/yyyy"
    Else
        If Len(TrimFast(CStr(v))) > 0 Then targetCell.Value = CStr(v)
    End If
    Exit Sub
Safe:
End Sub

Private Sub ReplicateIssueId(ByVal ws As Worksheet, ByVal fromRow As Long, ByVal toRow As Long, ByVal colIssueId As Long)
    If colIssueId <= 0 Then Exit Sub
    Dim v As String
    v = TrimFast(CStr(ws.Cells(fromRow, colIssueId).Value2))
    If Len(v) > 0 And Len(TrimFast(CStr(ws.Cells(toRow, colIssueId).Value2))) = 0 Then
        ws.Cells(toRow, colIssueId).Value2 = v
    End If
End Sub

Private Sub WriteTaskName(ByVal ws As Worksheet, ByVal rowNum As Long, ByVal colTaskName As Long, _
                          ByVal prefix As String, ByVal pol As String, ByVal entityDisplay As String, ByVal snippet As String)
    Dim nm As String
    nm = Trim$(prefix) & " Sweep 2 - " & pol & " (" & entityDisplay & ")"
    If Len(snippet) > 0 Then nm = nm & " - " & snippet
    ws.Cells(rowNum, colTaskName).Value2 = nm
End Sub

' Use the same snippet logic you already approved (kept as-is)
Private Function SnippetFromQuestionMeaningful(ByVal q As String) As String
    Dim s As String
    s = LCase$(CleanQuestionText(q))
    If Len(s) = 0 Then SnippetFromQuestionMeaningful = "": Exit Function

    If InStr(s, "formal access provisioning") > 0 Or (InStr(s, "provisioning process") > 0 And InStr(s, "approvals") > 0) Then
        SnippetFromQuestionMeaningful = "access provisioning approvals": Exit Function
    End If
    If InStr(s, "disabled promptly") > 0 Or (InStr(s, "termination") > 0 And InStr(s, "disabled") > 0) Then
        SnippetFromQuestionMeaningful = "disable access on termination": Exit Function
    End If
    If InStr(s, "recertification") > 0 Or InStr(s, "recertification review") > 0 Then
        SnippetFromQuestionMeaningful = "periodic access recertification": Exit Function
    End If
    If InStr(s, "shared accounts") > 0 And InStr(s, "prohibit") > 0 Then
        SnippetFromQuestionMeaningful = "prohibit shared accounts": Exit Function
    End If
    If InStr(s, "temporary accounts") > 0 And (InStr(s, "disabled") > 0 Or InStr(s, "inactivity") > 0) Then
        SnippetFromQuestionMeaningful = "temporary accounts auto-disable": Exit Function
    End If
    If InStr(s, "encrypt") > 0 And InStr(s, "data in transit") > 0 Then
        SnippetFromQuestionMeaningful = "encrypt data in transit": Exit Function
    End If
    If InStr(s, "cryptographic keys") > 0 And (InStr(s, "rotation") > 0 Or InStr(s, "revocation") > 0) Then
        SnippetFromQuestionMeaningful = "crypto key lifecycle": Exit Function
    End If
    If InStr(s, "penetration test") > 0 Then
        SnippetFromQuestionMeaningful = "third-party penetration test": Exit Function
    End If
    If InStr(s, "vulnerability scans") > 0 Then
        If InStr(s, "monthly") > 0 Then SnippetFromQuestionMeaningful = "monthly vulnerability scanning" Else SnippetFromQuestionMeaningful = "vulnerability scanning"
        Exit Function
    End If

    ' fallback
    SnippetFromQuestionMeaningful = Left$(LCase$(CleanQuestionText(q)), 45)
End Function