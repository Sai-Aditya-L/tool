Option Explicit

'========================================================
' FAST MAIN
'========================================================
Public Sub Build_RemediationTasks_From_CleanIssueReport_FAST()

    Dim issuePath As String, taskPath As String
    issuePath = PickExcelFile("Select the ISSUE REPORT file (contains sheet: CleanIssueReport)")
    If Len(issuePath) = 0 Then Exit Sub

    taskPath = PickExcelFile("Select the REMEDIATION TASK file (destination)")
    If Len(taskPath) = 0 Then Exit Sub

    Dim prevCalc As XlCalculation
    prevCalc = Application.Calculation

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.EnableEvents = False
    Application.Calculation = xlCalculationManual

    Dim wbIssue As Workbook, wbTask As Workbook
    Set wbIssue = Workbooks.Open(issuePath, ReadOnly:=True)
    Set wbTask = Workbooks.Open(taskPath)

    Dim wsIssue As Worksheet
    Set wsIssue = Nothing
    On Error Resume Next
    Set wsIssue = wbIssue.Worksheets("CleanIssueReport")
    On Error GoTo 0
    If wsIssue Is Nothing Then
        MsgBox "Could not find sheet 'CleanIssueReport' in Issue Report workbook.", vbCritical
        GoTo CleanExit
    End If

    Dim wsTask As Worksheet
    Set wsTask = FindSheetByHeader(wbTask, "Remediation Task Name")
    If wsTask Is Nothing Then
        MsgBox "Could not find a destination sheet with header 'Remediation Task Name'.", vbCritical
        GoTo CleanExit
    End If

    '-----------------------------
    ' Read Issue sheet into memory
    '-----------------------------
    Dim lastRow As Long, lastCol As Long
    lastRow = MaxLastRowRobust(wsIssue, Array("Policy Sub-Domain", "Systems Exhibiting the Issue", "Question ID", "Original Question"))
    lastCol = wsIssue.Cells(1, wsIssue.Columns.Count).End(xlToLeft).Column

    If lastRow < 2 Then
        MsgBox "No data rows found in CleanIssueReport.", vbExclamation
        GoTo CleanExit
    End If

    Dim issueArr As Variant
    issueArr = wsIssue.Range(wsIssue.Cells(1, 1), wsIssue.Cells(lastRow, lastCol)).Value2

    ' Build header map for issue sheet
    Dim issueHdr As Object: Set issueHdr = CreateObject("Scripting.Dictionary")
    BuildHeaderMap issueArr, issueHdr

    Dim ixPol As Long, ixEnt As Long, ixQID As Long, ixOrigQ As Long
    Dim ixPlan As Long, ixOwner As Long, ixDue As Long

    ixPol = GetIx(issueHdr, "Policy Sub-Domain")
    ixEnt = GetIx(issueHdr, "Systems Exhibiting the Issue")
    ixQID = GetIx(issueHdr, "Question ID")
    ixOrigQ = GetIx(issueHdr, "Original Question")

    ixPlan = GetIxAny(issueHdr, Array("Remediation Plan", "Suggested Remediation", "Planned Remediation", "Remediation"))
    ixOwner = GetIxAny(issueHdr, Array("Remediation Owner", "Owner", "Assignee"))
    ixDue = GetIxAny(issueHdr, Array("Planned Remediation Completion Date", "Remediation Completion Date", "Completion Date", "Due Date"))

    If ixPol = 0 Or ixEnt = 0 Or ixQID = 0 Or ixOrigQ = 0 Then
        MsgBox "Issue report missing required columns: Policy Sub-Domain / Systems Exhibiting the Issue / Question ID / Original Question.", vbCritical
        GoTo CleanExit
    End If
    If ixPlan = 0 Or ixOwner = 0 Or ixDue = 0 Then
        MsgBox "Issue report missing remediation fields: Remediation Plan / Owner / Completion Date (or equivalents).", vbCritical
        GoTo CleanExit
    End If

    '-----------------------------
    ' Destination column map
    '-----------------------------
    Dim tTaskName As Long, tDesc As Long, tAssigned As Long, tDue As Long, tIssueId As Long
    tTaskName = FindHeaderCol(wsTask, 1, "Remediation Task Name")
    tDesc = FindHeaderColAny(wsTask, 1, Array("Description", "Remediation Plan", "Details"))
    tAssigned = FindHeaderColAny(wsTask, 1, Array("Assigned To", "Assignee", "Owner", "Remediation Owner"))
    tDue = FindHeaderColAny(wsTask, 1, Array("Due Date", "Planned Completion", "Completion Date", "Planned Remediation Completion Date"))
    tIssueId = FindHeaderColAny(wsTask, 1, Array("Issue ID", "Ticket", "Task ID", "Number"))

    If tTaskName = 0 Or tDesc = 0 Or tAssigned = 0 Or tDue = 0 Then
        MsgBox "Destination sheet missing required columns: Remediation Task Name / Description / Assigned To / Due Date.", vbCritical
        GoTo CleanExit
    End If

    ' Prefix: filename -> existing tasks -> DTS
    Dim prefix As String
    prefix = ExtractPrefixFromFilename(issuePath)
    If Len(prefix) = 0 Then prefix = DetectPrefixFromTasks(wsTask, tTaskName)
    If Len(prefix) = 0 Then prefix = "DTS"

    ' Existing main index: entity|policy -> row
    Dim keyMainToRow As Object: Set keyMainToRow = CreateObject("Scripting.Dictionary")
    BuildExistingIndex wsTask, tTaskName, keyMainToRow

    ' Next row to append (compute once!)
    Dim nextDestRow As Long
    nextDestRow = wsTask.Cells(wsTask.Rows.Count, 1).End(xlUp).Row + 1
    If nextDestRow < 2 Then nextDestRow = 2

    '-----------------------------
    ' Log buffer (write at end)
    '-----------------------------
    Dim logArr() As Variant
    Dim logN As Long: logN = 0
    ReDim logArr(1 To 1, 1 To 6) ' will grow

    Dim currentPol As String: currentPol = ""

    Dim r As Long
    Dim written As Long, added As Long, skipped As Long
    written = 0: added = 0: skipped = 0

    For r = 2 To UBound(issueArr, 1)

        Dim qid As String
        qid = TrimFast(CStr(issueArr(r, ixQID)))

        If LCase$(qid) = "summary" Then
            skipped = skipped + 1
            LogBuf logArr, logN, "SKIP", CStr(r), "", "", qid, "Question ID = Summary"
            GoTo NextR
        End If

        Dim pol As String
        pol = TrimFast(CStr(issueArr(r, ixPol)))
        If Len(pol) > 0 Then
            currentPol = pol
        Else
            pol = currentPol
        End If

        If Len(pol) = 0 Then
            skipped = skipped + 1
            LogBuf logArr, logN, "SKIP", CStr(r), "", "", qid, "Blank Policy Sub-Domain"
            GoTo NextR
        End If

        Dim entRaw As String
        entRaw = TrimFast(CStr(issueArr(r, ixEnt)))
        If Len(entRaw) = 0 Then
            skipped = skipped + 1
            LogBuf logArr, logN, "SKIP", CStr(r), pol, "", qid, "Blank Systems Exhibiting the Issue"
            GoTo NextR
        End If

        Dim origQ As String
        origQ = CleanQuestionText(CStr(issueArr(r, ixOrigQ)))

        Dim snip As String
        snip = SnippetFromQuestionMeaningful(origQ)

        Dim planText As String, ownerText As String
        Dim dueVal As Variant
        planText = TrimFast(CStr(issueArr(r, ixPlan)))
        ownerText = TrimFast(CStr(issueArr(r, ixOwner)))
        dueVal = issueArr(r, ixDue)

        Dim entities As Collection
        Set entities = SplitEntities(entRaw)

        Dim i As Long
        For i = 1 To entities.Count

            Dim entityDisplay As String
            entityDisplay = TrimFast(CStr(entities(i)))
            If Len(entityDisplay) = 0 Then GoTo NextEnt

            Dim keyMain As String
            keyMain = NormalizeKey(entityDisplay) & "|" & NormalizeKey(pol)

            Dim destRow As Long, mainRow As Long
            Dim action As String

            If keyMainToRow.Exists(keyMain) Then
                mainRow = CLng(keyMainToRow(keyMain))

                If RowLooksEmpty(wsTask, mainRow, tDesc, tAssigned, tDue) Then
                    destRow = mainRow
                    action = "UPDATE_MAIN"
                Else
                    destRow = nextDestRow
                    nextDestRow = nextDestRow + 1
                    added = added + 1
                    action = "ADD_EXTRA"
                    WriteTaskName wsTask, destRow, tTaskName, prefix, pol, entityDisplay, snip
                    ReplicateIssueId wsTask, mainRow, destRow, tIssueId
                End If
            Else
                destRow = nextDestRow
                nextDestRow = nextDestRow + 1
                added = added + 1
                keyMainToRow.Add keyMain, destRow
                action = "ADD_MAIN"
                WriteTaskName wsTask, destRow, tTaskName, prefix, pol, entityDisplay, snip
            End If

            If Len(planText) > 0 Then wsTask.Cells(destRow, tDesc).Value2 = planText
            If Len(ownerText) > 0 Then wsTask.Cells(destRow, tAssigned).Value2 = ownerText
            WriteDateSmart wsTask.Cells(destRow, tDue), dueVal

            written = written + 1
            LogBuf logArr, logN, action, CStr(r), pol, entityDisplay, qid, "Snippet: " & snip

NextEnt:
        Next i

        ' keep Excel responsive during long runs
        If (r Mod 200) = 0 Then DoEvents

NextR:
    Next r

    '-----------------------------
    ' Write Run Log at end
    '-----------------------------
    Dim wsLog As Worksheet
    Set wsLog = EnsureLogSheet(wbTask, "Run Log")
    wsLog.Cells.Clear
    wsLog.Range("A1:F1").Value = Array("Action", "SourceRow", "Policy Sub-Domain", "Entity", "Question ID", "Notes")
    wsLog.Rows(1).Font.Bold = True

    If logN > 0 Then
        wsLog.Range("A2").Resize(logN, 6).Value = logArr
    End If

    wbTask.Save

    MsgBox "Done." & vbCrLf & _
           "Written/updated rows: " & written & vbCrLf & _
           "Added rows: " & added & vbCrLf & _
           "Skipped rows: " & skipped & vbCrLf & _
           "Last row processed: " & UBound(issueArr, 1), vbInformation

CleanExit:
    On Error Resume Next
    wbIssue.Close SaveChanges:=False
    wbTask.Close SaveChanges:=True
    On Error GoTo 0

    Application.Calculation = prevCalc
    Application.EnableEvents = True
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
End Sub

'========================================================
' HELPERS (FAST / SUPPORT)
'========================================================
Private Sub BuildHeaderMap(ByVal arr As Variant, ByVal dict As Object)
    Dim c As Long
    For c = 1 To UBound(arr, 2)
        Dim h As String
        h = LCase$(TrimFast(CStr(arr(1, c))))
        If Len(h) > 0 Then
            If Not dict.Exists(h) Then dict.Add h, c
        End If
    Next c
End Sub

Private Function GetIx(ByVal dict As Object, ByVal headerName As String) As Long
    Dim k As String
    k = LCase$(Trim$(headerName))
    If dict.Exists(k) Then GetIx = CLng(dict(k)) Else GetIx = 0
End Function

Private Function GetIxAny(ByVal dict As Object, ByVal headers As Variant) As Long
    Dim i As Long
    For i = LBound(headers) To UBound(headers)
        Dim ix As Long
        ix = GetIx(dict, CStr(headers(i)))
        If ix > 0 Then GetIxAny = ix: Exit Function
    Next i
    GetIxAny = 0
End Function

Private Function TrimFast(ByVal s As String) As String
    TrimFast = Replace(Replace(Trim$(s), vbCr, " "), vbLf, " ")
    TrimFast = Trim$(TrimFast)
End Function

Private Function MaxLastRowRobust(ByVal ws As Worksheet, ByVal headerNames As Variant) As Long
    ' finds columns by headers, then returns max End(xlUp) across them + UsedRange safety
    Dim maxR As Long: maxR = 0

    Dim i As Long
    For i = LBound(headerNames) To UBound(headerNames)
        Dim col As Long
        col = FindHeaderCol(ws, 1, CStr(headerNames(i)))
        If col > 0 Then
            Dim lr As Long
            lr = ws.Cells(ws.Rows.Count, col).End(xlUp).Row
            If lr > maxR Then maxR = lr
        End If
    Next i

    Dim ur As Long
    ur = ws.UsedRange.Row + ws.UsedRange.Rows.Count - 1
    If ur > maxR Then maxR = ur

    MaxLastRowRobust = maxR
End Function

Private Sub LogBuf(ByRef logArr() As Variant, ByRef n As Long, _
                   ByVal action As String, ByVal srcRow As String, ByVal pol As String, ByVal ent As String, ByVal qid As String, ByVal notes As String)
    n = n + 1
    If n = 1 Then
        ReDim logArr(1 To 1, 1 To 6)
    ElseIf n > UBound(logArr, 1) Then
        ReDim Preserve logArr(1 To UBound(logArr, 1) + 500, 1 To 6) ' grow in chunks
    End If
    logArr(n, 1) = action
    logArr(n, 2) = srcRow
    logArr(n, 3) = pol
    logArr(n, 4) = ent
    logArr(n, 5) = qid
    logArr(n, 6) = notes
End Sub

