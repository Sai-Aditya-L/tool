Option Explicit

'========================================================
' MAIN
'========================================================
Public Sub Build_RemediationTasks_From_CleanIssueReport()

    Dim issuePath As String, taskPath As String
    issuePath = PickExcelFile("Select the ISSUE REPORT file (contains sheet: CleanIssueReport)")
    If Len(issuePath) = 0 Then Exit Sub

    taskPath = PickExcelFile("Select the REMEDIATION TASK file (destination)")
    If Len(taskPath) = 0 Then Exit Sub

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.EnableEvents = False

    Dim wbIssue As Workbook, wbTask As Workbook
    Set wbIssue = Workbooks.Open(issuePath, ReadOnly:=True)
    Set wbTask = Workbooks.Open(taskPath)

    Dim wsIssue As Worksheet
    Set wsIssue = Nothing
    On Error Resume Next
    Set wsIssue = wbIssue.Worksheets("CleanIssueReport")
    On Error GoTo 0
    If wsIssue Is Nothing Then
        MsgBox "Could not find sheet 'CleanIssueReport' in Issue Report workbook.", vbCritical
        GoTo CleanExit
    End If

    Dim wsTask As Worksheet
    Set wsTask = FindSheetByHeader(wbTask, "Remediation Task Name")
    If wsTask Is Nothing Then
        MsgBox "Could not find a destination sheet that contains header 'Remediation Task Name'.", vbCritical
        GoTo CleanExit
    End If

    '---- Log sheet
    Dim wsLog As Worksheet
    Set wsLog = EnsureLogSheet(wbTask, "Run Log")
    InitLog wsLog

    '---- Issue columns (header row = 1)
    Dim cPol As Long, cEntity As Long, cOrigQ As Long, cQID As Long
    Dim cPlan As Long, cOwner As Long, cDue As Long

    cPol = FindHeaderCol(wsIssue, 1, "Policy Sub-Domain")
    cEntity = FindHeaderCol(wsIssue, 1, "Systems Exhibiting the Issue")
    cOrigQ = FindHeaderCol(wsIssue, 1, "Original Question")
    cQID = FindHeaderCol(wsIssue, 1, "Question ID")

    cPlan = FindHeaderColAny(wsIssue, 1, Array("Remediation Plan", "Suggested Remediation", "Planned Remediation", "Remediation"))
    cOwner = FindHeaderColAny(wsIssue, 1, Array("Remediation Owner", "Owner", "Assignee"))
    cDue = FindHeaderColAny(wsIssue, 1, Array("Planned Remediation Completion Date", "Remediation Completion Date", "Completion Date", "Due Date"))

    If cPol = 0 Or cEntity = 0 Or cOrigQ = 0 Or cQID = 0 Then
        MsgBox "Issue report is missing required columns: Policy Sub-Domain, Systems Exhibiting the Issue, Original Question, Question ID.", vbCritical
        GoTo CleanExit
    End If
    If cPlan = 0 Or cOwner = 0 Or cDue = 0 Then
        MsgBox "Issue report is missing remediation fields: Remediation Plan, Remediation Owner, Planned Remediation Completion Date (or equivalent).", vbCritical
        GoTo CleanExit
    End If

    '---- Task columns
    Dim tTaskName As Long, tDesc As Long, tAssigned As Long, tDue As Long, tIssueId As Long
    tTaskName = FindHeaderCol(wsTask, 1, "Remediation Task Name")
    tDesc = FindHeaderColAny(wsTask, 1, Array("Description", "Remediation Plan", "Details"))
    tAssigned = FindHeaderColAny(wsTask, 1, Array("Assigned To", "Assignee", "Owner", "Remediation Owner"))
    tDue = FindHeaderColAny(wsTask, 1, Array("Due Date", "Planned Completion", "Completion Date", "Planned Remediation Completion Date"))
    tIssueId = FindHeaderColAny(wsTask, 1, Array("Issue ID", "Ticket", "Task ID", "Number"))

    If tTaskName = 0 Or tDesc = 0 Or tAssigned = 0 Or tDue = 0 Then
        MsgBox "Destination sheet missing required columns: Remediation Task Name, Description, Assigned To, Due Date.", vbCritical
        GoTo CleanExit
    End If

    '---- Prefix: derive from filename first, fallback to existing task names, fallback DTS
    Dim prefix As String
    prefix = ExtractPrefixFromFilename(issuePath)
    If Len(prefix) = 0 Then prefix = DetectPrefixFromTasks(wsTask, tTaskName)
    If Len(prefix) = 0 Then prefix = "DTS"

    LogRow wsLog, "INFO", "", "", "", "", "Prefix chosen: " & prefix

    '---- Index existing main rows in destination:
    ' keyMain = entityKey|policyKey  -> row number
    Dim keyMainToRow As Object
    Set keyMainToRow = CreateObject("Scripting.Dictionary")
    BuildExistingIndex wsTask, tTaskName, keyMainToRow

    '---- Robust last row: max last-used among key cols (avoid missing bottom blocks like 23780)
    Dim lastRow As Long
    lastRow = MaxLastRow(wsIssue, Array(cPol, cEntity, cQID, cOrigQ))
    If lastRow < 2 Then
        MsgBox "No data rows found in CleanIssueReport.", vbExclamation
        GoTo CleanExit
    End If

    Dim r As Long
    Dim currentPol As String
    currentPol = ""

    Dim written As Long, added As Long, skipped As Long
    written = 0: added = 0: skipped = 0

    For r = 2 To lastRow

        Dim qid As String
        qid = Trim$(GetCellText(wsIssue.Cells(r, cQID)))

        If LCase$(qid) = "summary" Then
            skipped = skipped + 1
            LogRow wsLog, "SKIP", CStr(r), "", "", qid, "Question ID = Summary"
            GoTo NextR
        End If

        Dim pol As String
        pol = Trim$(GetCellText(wsIssue.Cells(r, cPol)))
        If Len(pol) > 0 Then
            currentPol = pol
        Else
            pol = currentPol ' carry forward
        End If

        If Len(pol) = 0 Then
            skipped = skipped + 1
            LogRow wsLog, "SKIP", CStr(r), "", "", qid, "Blank Policy Sub-Domain (even after carry-forward)"
            GoTo NextR
        End If

        Dim entRaw As String
        entRaw = Trim$(GetCellText(wsIssue.Cells(r, cEntity)))
        If Len(entRaw) = 0 Then
            skipped = skipped + 1
            LogRow wsLog, "SKIP", CStr(r), pol, "", qid, "Blank Systems Exhibiting the Issue"
            GoTo NextR
        End If

        Dim origQ As String
        origQ = CleanQuestionText(GetCellText(wsIssue.Cells(r, cOrigQ)))

        Dim snip As String
        snip = SnippetFromQuestionMeaningful(origQ)

        Dim planText As String, ownerText As String
        Dim dueVal As Variant
        planText = Trim$(GetCellText(wsIssue.Cells(r, cPlan)))
        ownerText = Trim$(GetCellText(wsIssue.Cells(r, cOwner)))
        dueVal = wsIssue.Cells(r, cDue).Value

        Dim entities As Collection
        Set entities = SplitEntities(entRaw)

        Dim i As Long
        For i = 1 To entities.Count

            Dim entityDisplay As String
            entityDisplay = Trim$(CStr(entities(i)))
            If Len(entityDisplay) = 0 Then GoTo NextEnt

            Dim keyMain As String
            keyMain = NormalizeKey(entityDisplay) & "|" & NormalizeKey(pol)

            Dim destRow As Long, mainRow As Long
            Dim action As String

            If keyMainToRow.Exists(keyMain) Then
                mainRow = CLng(keyMainToRow(keyMain))

                ' if main row still empty, write there; else append new row
                If RowLooksEmpty(wsTask, mainRow, tDesc, tAssigned, tDue) Then
                    destRow = mainRow
                    action = "UPDATE_MAIN"
                Else
                    destRow = AppendNewRow(wsTask)
                    added = added + 1
                    action = "ADD_EXTRA"
                    WriteTaskName wsTask, destRow, tTaskName, prefix, pol, entityDisplay, snip
                    ReplicateIssueId wsTask, mainRow, destRow, tIssueId
                End If
            Else
                destRow = AppendNewRow(wsTask)
                added = added + 1
                keyMainToRow.Add keyMain, destRow
                action = "ADD_MAIN"
                WriteTaskName wsTask, destRow, tTaskName, prefix, pol, entityDisplay, snip
            End If

            ' write remediation fields (we write blanks too? no, only if present)
            If Len(planText) > 0 Then wsTask.Cells(destRow, tDesc).Value = planText
            If Len(ownerText) > 0 Then wsTask.Cells(destRow, tAssigned).Value = ownerText
            WriteDateSmart wsTask.Cells(destRow, tDue), dueVal

            written = written + 1
            LogRow wsLog, action, CStr(r), pol, entityDisplay, qid, "Snippet: " & snip

NextEnt:
        Next i

NextR:
    Next r

    wbTask.Save

    MsgBox "Done." & vbCrLf & _
           "Written/updated rows: " & written & vbCrLf & _
           "Added rows: " & added & vbCrLf & _
           "Skipped rows: " & skipped & vbCrLf & _
           "Last row processed: " & lastRow, vbInformation

CleanExit:
    On Error Resume Next
    wbIssue.Close SaveChanges:=False
    wbTask.Close SaveChanges:=True
    On Error GoTo 0

    Application.EnableEvents = True
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
End Sub


'========================================================
' TASK NAME FORMAT
'========================================================
Private Sub WriteTaskName(ByVal ws As Worksheet, ByVal rowNum As Long, ByVal colTaskName As Long, _
                          ByVal prefix As String, ByVal pol As String, ByVal entityDisplay As String, ByVal snippet As String)

    Dim nm As String
    nm = Trim$(prefix) & " Sweep 2 - " & pol & " (" & entityDisplay & ")"
    If Len(snippet) > 0 Then nm = nm & " - " & snippet

    ws.Cells(rowNum, colTaskName).Value = nm
End Sub


'========================================================
' MEANINGFUL SNIPPETS (pattern labels that read well)
'========================================================
Private Function SnippetFromQuestionMeaningful(ByVal q As String) As String
    Dim s As String
    s = LCase$(CleanQuestionText(q))

    If Len(s) = 0 Then
        SnippetFromQuestionMeaningful = ""
        Exit Function
    End If

    ' ACCESS CONTROL / IAM
    If InStr(s, "formal access provisioning") > 0 Or (InStr(s, "provisioning process") > 0 And InStr(s, "approvals") > 0) Then
        SnippetFromQuestionMeaningful = "access provisioning approvals"
        Exit Function
    End If

    If InStr(s, "disabled promptly") > 0 Or (InStr(s, "termination") > 0 And InStr(s, "disabled") > 0) Then
        SnippetFromQuestionMeaningful = "disable access on termination"
        Exit Function
    End If

    If InStr(s, "recertification") > 0 Or InStr(s, "periodic access recertification") > 0 Or InStr(s, "recertification review") > 0 Then
        SnippetFromQuestionMeaningful = "periodic access recertification"
        Exit Function
    End If

    If InStr(s, "remove") > 0 And InStr(s, "customer") > 0 And InStr(s, "access") > 0 Then
        SnippetFromQuestionMeaningful = "remove customer access"
        Exit Function
    End If

    If InStr(s, "service accounts") > 0 And (InStr(s, "rotate") > 0 Or InStr(s, "password management") > 0 Or InStr(s, "securely storing") > 0) Then
        SnippetFromQuestionMeaningful = "service account password management"
        Exit Function
    End If

    If InStr(s, "service accounts assigned an owner") > 0 Or (InStr(s, "service accounts") > 0 And InStr(s, "assigned an owner") > 0) Then
        SnippetFromQuestionMeaningful = "service account ownership"
        Exit Function
    End If

    If InStr(s, "separate") > 0 And InStr(s, "administrator accounts") > 0 Then
        SnippetFromQuestionMeaningful = "separate admin accounts"
        Exit Function
    End If

    If InStr(s, "default accounts") > 0 And (InStr(s, "disabled") > 0 Or InStr(s, "password") > 0) Then
        SnippetFromQuestionMeaningful = "disable default accounts"
        Exit Function
    End If

    If InStr(s, "shared accounts") > 0 And InStr(s, "prohibit") > 0 Then
        SnippetFromQuestionMeaningful = "prohibit shared accounts"
        Exit Function
    End If

    If InStr(s, "temporary accounts") > 0 And (InStr(s, "owner") > 0 Or InStr(s, "disabled") > 0 Or InStr(s, "inactivity") > 0) Then
        SnippetFromQuestionMeaningful = "temporary accounts auto-disable"
        Exit Function
    End If

    If InStr(s, "break glass") > 0 Or InStr(s, "emergency") > 0 Then
        SnippetFromQuestionMeaningful = "break-glass password rotation"
        Exit Function
    End If

    If InStr(s, "privileged access management") > 0 Or InStr(s, "pam") > 0 Then
        SnippetFromQuestionMeaningful = "privileged access management"
        Exit Function
    End If

    ' CRYPTO / TLS / KEYS
    If InStr(s, "encrypt") > 0 And InStr(s, "data in transit") > 0 Then
        SnippetFromQuestionMeaningful = "encrypt data in transit"
        Exit Function
    End If

    If InStr(s, "tls") > 0 And InStr(s, "certificate") > 0 Then
        SnippetFromQuestionMeaningful = "tls certificate management"
        Exit Function
    End If

    If InStr(s, "cryptographic keys") > 0 And (InStr(s, "rotation") > 0 Or InStr(s, "revocation") > 0 Or InStr(s, "key") > 0) Then
        SnippetFromQuestionMeaningful = "crypto key lifecycle"
        Exit Function
    End If

    If InStr(s, "key vault") > 0 Or InStr(s, "kms") > 0 Or InStr(s, "azure key vault") > 0 Then
        SnippetFromQuestionMeaningful = "key vault storage"
        Exit Function
    End If

    ' VULN / SAST / PEN TEST / SCANS
    If InStr(s, "sast") > 0 Or InStr(s, "secure composition analysis") > 0 Or InStr(s, "sca") > 0 Then
        SnippetFromQuestionMeaningful = "sast or sca testing"
        Exit Function
    End If

    If InStr(s, "penetration test") > 0 Then
        SnippetFromQuestionMeaningful = "third-party penetration test"
        Exit Function
    End If

    If InStr(s, "vulnerability scans") > 0 Then
        If InStr(s, "monthly") > 0 Then
            SnippetFromQuestionMeaningful = "monthly vulnerability scanning"
        Else
            SnippetFromQuestionMeaningful = "vulnerability scanning"
        End If
        Exit Function
    End If

    If InStr(s, "remediate vulnerabilities") > 0 And InStr(s, "schedule") > 0 Then
        SnippetFromQuestionMeaningful = "vulnerability remediation schedule"
        Exit Function
    End If

    ' AUTH / MFA
    If InStr(s, "mfa") > 0 Or InStr(s, "multi-factor authentication") > 0 Then
        SnippetFromQuestionMeaningful = "multi-factor authentication"
        Exit Function
    End If

    ' FALLBACK: use first short clause (still readable)
    SnippetFromQuestionMeaningful = FallbackClauseSnippet(q)
End Function

Private Function FallbackClauseSnippet(ByVal q As String) As String
    Dim t As String
    t = CleanQuestionText(q)
    t = Replace(t, vbCr, " ")
    t = Replace(t, vbLf, " ")
    t = WorksheetFunction.Trim(t)

    ' take up to first 45 chars, cut at word boundary
    If Len(t) <= 45 Then
        FallbackClauseSnippet = LCase$(t)
        Exit Function
    End If

    Dim cut As Long
    cut = 45
    Do While cut > 20 And Mid$(t, cut, 1) <> " "
        cut = cut - 1
    Loop

    FallbackClauseSnippet = LCase$(Trim$(Left$(t, cut)))
End Function


'========================================================
' UTILITIES
'========================================================
Private Function PickExcelFile(ByVal prompt As String) As String
    Dim fd As FileDialog
    Set fd = Application.FileDialog(msoFileDialogFilePicker)
    With fd
        .Title = prompt
        .AllowMultiSelect = False
        .Filters.Clear
        .Filters.Add "Excel Files", "*.xlsx;*.xlsm;*.xls"
        If .Show <> -1 Then
            PickExcelFile = ""
        Else
            PickExcelFile = .SelectedItems(1)
        End If
    End With
End Function

Private Function FindSheetByHeader(ByVal wb As Workbook, ByVal headerText As String) As Worksheet
    Dim ws As Worksheet
    For Each ws In wb.Worksheets
        If FindHeaderCol(ws, 1, headerText) > 0 Then
            Set FindSheetByHeader = ws
            Exit Function
        End If
    Next ws
    Set FindSheetByHeader = Nothing
End Function

Private Function FindHeaderCol(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal headerText As String) As Long
    Dim lastCol As Long, c As Long
    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    For c = 1 To lastCol
        If LCase$(Trim$(CStr(ws.Cells(headerRow, c).Value))) = LCase$(Trim$(headerText)) Then
            FindHeaderCol = c
            Exit Function
        End If
    Next c
    FindHeaderCol = 0
End Function

Private Function FindHeaderColAny(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal names As Variant) As Long
    Dim i As Long
    For i = LBound(names) To UBound(names)
        Dim col As Long
        col = FindHeaderCol(ws, headerRow, CStr(names(i)))
        If col > 0 Then
            FindHeaderColAny = col
            Exit Function
        End If
    Next i
    FindHeaderColAny = 0
End Function

Private Function MaxLastRow(ByVal ws As Worksheet, ByVal cols As Variant) As Long
    Dim i As Long, mx As Long, lr As Long
    mx = 0
    For i = LBound(cols) To UBound(cols)
        lr = ws.Cells(ws.Rows.Count, CLng(cols(i))).End(xlUp).Row
        If lr > mx Then mx = lr
    Next i
    ' safety: also consider UsedRange
    If ws.UsedRange.Rows.Count + ws.UsedRange.Row - 1 > mx Then
        mx = ws.UsedRange.Rows.Count + ws.UsedRange.Row - 1
    End If
    MaxLastRow = mx
End Function

Private Function GetCellText(ByVal cell As Range) As String
    ' merged-aware: always return the visible "top-left" of merged area
    On Error GoTo Safe
    If cell.MergeCells Then
        GetCellText = CStr(cell.MergeArea.Cells(1, 1).Value)
    Else
        GetCellText = CStr(cell.Value)
    End If
    Exit Function
Safe:
    GetCellText = CStr(cell.Value)
End Function

Private Function CleanQuestionText(ByVal s As String) As String
    s = Replace(s, vbCr, " ")
    s = Replace(s, vbLf, " ")
    s = WorksheetFunction.Trim(s)
    CleanQuestionText = s
End Function

Private Function SplitEntities(ByVal entRaw As String) As Collection
    Dim col As New Collection
    Dim t As String
    t = Replace(entRaw, vbCr, vbLf)
    t = Replace(t, ";", vbLf)
    t = Replace(t, ",", vbLf)

    Dim parts() As String
    parts = Split(t, vbLf)

    Dim i As Long
    For i = LBound(parts) To UBound(parts)
        Dim p As String
        p = WorksheetFunction.Trim(parts(i))
        If Len(p) > 0 Then col.Add p
    Next i

    Set SplitEntities = col
End Function

Private Function NormalizeKey(ByVal s As String) As String
    s = LCase$(Trim$(s))
    s = Replace(s, vbTab, " ")
    s = Replace(s, vbCr, " ")
    s = Replace(s, vbLf, " ")
    s = WorksheetFunction.Trim(s)
    ' keep digits/underscores; just collapse multiple spaces
    NormalizeKey = s
End Function

Private Function AppendNewRow(ByVal ws As Worksheet) As Long
    Dim lr As Long
    lr = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row
    If lr < 2 Then lr = 1
    AppendNewRow = lr + 1
End Function

Private Function RowLooksEmpty(ByVal ws As Worksheet, ByVal r As Long, ByVal cDesc As Long, ByVal cAssigned As Long, ByVal cDue As Long) As Boolean
    If Len(Trim$(CStr(ws.Cells(r, cDesc).Value))) > 0 Then RowLooksEmpty = False: Exit Function
    If Len(Trim$(CStr(ws.Cells(r, cAssigned).Value))) > 0 Then RowLooksEmpty = False: Exit Function
    If Len(Trim$(CStr(ws.Cells(r, cDue).Value))) > 0 Then RowLooksEmpty = False: Exit Function
    RowLooksEmpty = True
End Function

Private Sub WriteDateSmart(ByVal targetCell As Range, ByVal v As Variant)
    On Error GoTo Safe
    If IsDate(v) Then
        targetCell.Value = CDate(v)
        targetCell.NumberFormat = "m/d/yyyy"
    ElseIf IsNumeric(v) And v > 0 Then
        ' Excel date serial
        targetCell.Value = DateSerial(1899, 12, 30) + CDbl(v)
        targetCell.NumberFormat = "m/d/yyyy"
    Else
        If Len(Trim$(CStr(v))) > 0 Then targetCell.Value = CStr(v)
    End If
    Exit Sub
Safe:
    ' ignore
End Sub

Private Function ExtractPrefixFromFilename(ByVal fullPath As String) As String
    Dim f As String, base As String
    f = Mid$(fullPath, InStrRev(fullPath, "\") + 1)
    base = f
    If InStrRev(base, ".") > 0 Then base = Left$(base, InStrRev(base, ".") - 1)

    ' take first token before "_" or space
    Dim token As String
    token = base
    If InStr(token, "_") > 0 Then token = Left$(token, InStr(token, "_") - 1)
    If InStr(token, " ") > 0 Then token = Left$(token, InStr(token, " ") - 1)

    token = UCase$(Trim$(token))

    ' accept short alpha prefixes like DTS / AN / EPD
    If token Like "[A-Z][A-Z]*" And Len(token) <= 6 Then
        ExtractPrefixFromFilename = token
    Else
        ExtractPrefixFromFilename = ""
    End If
End Function

Private Function DetectPrefixFromTasks(ByVal wsTask As Worksheet, ByVal colTaskName As Long) As String
    Dim lr As Long, r As Long
    lr = wsTask.Cells(wsTask.Rows.Count, colTaskName).End(xlUp).Row
    For r = 2 To lr
        Dim t As String
        t = Trim$(CStr(wsTask.Cells(r, colTaskName).Value))
        If Len(t) > 0 Then
            Dim p As String
            p = ParsePrefix(t)
            If Len(p) > 0 Then
                DetectPrefixFromTasks = p
                Exit Function
            End If
        End If
    Next r
    DetectPrefixFromTasks = ""
End Function

Private Function ParsePrefix(ByVal taskName As String) As String
    ' expects "DTS Sweep 2 - ..."
    Dim s As String
    s = Trim$(taskName)
    Dim pos As Long
    pos = InStr(1, s, "Sweep", vbTextCompare)
    If pos > 1 Then
        ParsePrefix = UCase$(Trim$(Left$(s, pos - 1)))
    Else
        ParsePrefix = ""
    End If
End Function

Private Sub ReplicateIssueId(ByVal ws As Worksheet, ByVal fromRow As Long, ByVal toRow As Long, ByVal colIssueId As Long)
    If colIssueId <= 0 Then Exit Sub
    Dim v As String
    v = Trim$(CStr(ws.Cells(fromRow, colIssueId).Value))
    If Len(v) > 0 And Len(Trim$(CStr(ws.Cells(toRow, colIssueId).Value))) = 0 Then
        ws.Cells(toRow, colIssueId).Value = v
    End If
End Sub

'========================================================
' EXISTING DESTINATION INDEX
'========================================================
Private Sub BuildExistingIndex(ByVal wsTask As Worksheet, ByVal colTaskName As Long, ByVal dict As Object)
    Dim lr As Long, r As Long
    lr = wsTask.Cells(wsTask.Rows.Count, colTaskName).End(xlUp).Row

    For r = 2 To lr
        Dim t As String
        t = Trim$(CStr(wsTask.Cells(r, colTaskName).Value))
        If Len(t) = 0 Then GoTo NextR

        Dim pol As String, ent As String
        pol = ExtractPolicyFromTaskName(t)
        ent = ExtractEntityFromTaskName(t)

        If Len(pol) > 0 And Len(ent) > 0 Then
            Dim keyMain As String
            keyMain = NormalizeKey(ent) & "|" & NormalizeKey(pol)
            If Not dict.Exists(keyMain) Then dict.Add keyMain, r
        End If

NextR:
    Next r
End Sub

Private Function ExtractPolicyFromTaskName(ByVal t As String) As String
    Dim p As Long, q As Long
    p = InStr(1, t, "Sweep 2 -", vbTextCompare)
    If p = 0 Then Exit Function
    p = p + Len("Sweep 2 -")
    q = InStr(p + 1, t, "(", vbTextCompare)
    If q = 0 Then Exit Function
    ExtractPolicyFromTaskName = Trim$(Mid$(t, p, q - p))
End Function

Private Function ExtractEntityFromTaskName(ByVal t As String) As String
    Dim p As Long, q As Long
    p = InStr(1, t, "(", vbTextCompare)
    q = InStr(1, t, ")", vbTextCompare)
    If p > 0 And q > p Then
        ExtractEntityFromTaskName = Trim$(Mid$(t, p + 1, q - p - 1))
    Else
        ExtractEntityFromTaskName = ""
    End If
End Function

'========================================================
' LOGGING
'========================================================
Private Function EnsureLogSheet(ByVal wb As Workbook, ByVal name As String) As Worksheet
    Dim ws As Worksheet
    On Error Resume Next
    Set ws = wb.Worksheets(name)
    On Error GoTo 0
    If ws Is Nothing Then
        Set ws = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))
        ws.Name = name
    End If
    Set EnsureLogSheet = ws
End Function

Private Sub InitLog(ByVal wsLog As Worksheet)
    wsLog.Cells.Clear
    wsLog.Range("A1:F1").Value = Array("Action", "SourceRow", "Policy Sub-Domain", "Entity", "Question ID", "Notes")
    wsLog.Rows(1).Font.Bold = True
End Sub

Private Sub LogRow(ByVal wsLog As Worksheet, ByVal action As String, ByVal srcRow As String, _
                   ByVal pol As String, ByVal ent As String, ByVal qid As String, ByVal notes As String)
    Dim lr As Long
    lr = wsLog.Cells(wsLog.Rows.Count, 1).End(xlUp).Row + 1
    wsLog.Cells(lr, 1).Value = action
    wsLog.Cells(lr, 2).Value = srcRow
    wsLog.Cells(lr, 3).Value = pol
    wsLog.Cells(lr, 4).Value = ent
    wsLog.Cells(lr, 5).Value = qid
    wsLog.Cells(lr, 6).Value = notes
End Sub