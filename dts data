Option Explicit

'==========================================================
' NEW FORMAT VERSION (Single consolidated Issue Report file)
' Source sheet name: CleanIssueReport
'
' - Use Policy Sub-Domain + each Entity in "Systems Exhibiting the Issue"
' - Skip rows where Question ID = "Summary" (case-insensitive)
' - Create main row per (Entity + Policy Sub-Domain)
' - Create extra rows for additional issues per same (Entity + Policy Sub-Domain),
'   using snippet from Original Question:
'      "<PREFIX><Policy Sub-Domain> (<Entity>) - <snippet>"
' - Bring:
'     Remediation Plan -> Description
'     Remediation Owner -> Assigned to
'     Planned Remediation Completion Date -> Due Date
' - NO Column S ignore logic
'==========================================================

Public Sub Populate_RemediationTasks_From_Consolidated_IssueReport()

    Dim dstPath As Variant, srcPath As Variant
    Dim wbD As Workbook, wsD As Worksheet, wbS As Workbook, wsS As Worksheet
    Dim wsLog As Worksheet

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False

    'Pick Remediation Task file
    dstPath = Application.GetOpenFilename("Excel Files (*.xlsx;*.xlsm), *.xlsx;*.xlsm", , _
                                         "Select Remediation Task file")
    If dstPath = False Then GoTo CleanExit

    Set wbD = Workbooks.Open(CStr(dstPath))
    Set wsD = Nothing
    On Error Resume Next
    Set wsD = wbD.Worksheets("Sweep 2 Remediation Tasks")
    On Error GoTo 0
    If wsD Is Nothing Then Set wsD = wbD.Worksheets(1)

    'Pick consolidated Issue Report file
    srcPath = Application.GetOpenFilename("Excel Files (*.xlsx;*.xlsm), *.xlsx;*.xlsm", , _
                                         "Select Consolidated Issue Report file")
    If srcPath = False Then GoTo CleanExit

    Set wbS = Workbooks.Open(CStr(srcPath), ReadOnly:=True)

    'Hard-set the source sheet name you provided
    On Error Resume Next
    Set wsS = wbS.Worksheets("CleanIssueReport")
    On Error GoTo 0
    If wsS Is Nothing Then
        MsgBox "Could not find sheet 'CleanIssueReport' in the consolidated issue report file.", vbCritical
        GoTo CleanExit
    End If

    'Log
    Set wsLog = GetOrCreateLogSheet(wbD, "Run Log")
    InitLog wsLog
    LogEvent wsLog, "INFO", "", "", "", "Started run (source sheet: CleanIssueReport)."

    '---- DEST headers ----
    Dim hdrRowD As Long
    Dim colTaskName As Long, colIssueId As Long, colDesc As Long, colAssigned As Long, colDue As Long

    hdrRowD = FindHeaderRow(wsD, Array("Remediation Task Name", "Issue Id", "Description", "Assigned to", "Due Date"), 300)
    If hdrRowD = 0 Then
        MsgBox "Could not find required headers in Remediation Task sheet.", vbCritical
        LogEvent wsLog, "ERROR", "", "", "", "Missing headers in destination."
        GoTo CleanExit
    End If

    colTaskName = FindHeaderColumn(wsD, hdrRowD, "Remediation Task Name")
    colIssueId = FindHeaderColumn(wsD, hdrRowD, "Issue Id")
    colDesc = FindHeaderColumn(wsD, hdrRowD, "Description")
    colAssigned = FindHeaderColumn(wsD, hdrRowD, "Assigned to")
    colDue = FindHeaderColumn(wsD, hdrRowD, "Due Date")

    wsD.Columns(colTaskName).NumberFormat = "@"
    wsD.Columns(colIssueId).NumberFormat = "@"
    wsD.Columns(colDesc).NumberFormat = "@"
    wsD.Columns(colAssigned).NumberFormat = "@"
    wsD.Columns(colDue).NumberFormat = "m/d/yyyy"

    '---- SOURCE headers ----
    Dim hdrRowS As Long
    Dim colPolSub As Long, colSystems As Long, colQID As Long, colOrigQ As Long
    Dim colPlan As Long, colOwner As Long, colPlannedDate As Long

    hdrRowS = FindHeaderRowLoose(wsS, Array( _
        "Policy Sub-Domain", _
        "Systems Exhibiting the Issue", _
        "Question ID", _
        "Original Question"), 800)

    If hdrRowS = 0 Then
        MsgBox "Could not find source headers (Policy Sub-Domain, Systems Exhibiting the Issue, Question ID, Original Question).", vbCritical
        LogEvent wsLog, "ERROR", "", "", "", "Missing key headers in source."
        GoTo CleanExit
    End If

    colPolSub = FindHeaderColumnLoose(wsS, hdrRowS, "Policy Sub-Domain")
    colSystems = FindHeaderColumnLoose(wsS, hdrRowS, "Systems Exhibiting the Issue")
    colQID = FindHeaderColumnLoose(wsS, hdrRowS, "Question ID")
    colOrigQ = FindHeaderColumnLoose(wsS, hdrRowS, "Original Question")

    'Try common variants for remediation columns
    colPlan = FindHeaderColumnLoose(wsS, hdrRowS, "Remediation Plan")
    colOwner = FindHeaderColumnLoose(wsS, hdrRowS, "Remediation Owner")

    colPlannedDate = FindHeaderColumnLoose(wsS, hdrRowS, "Planned Remediation Completion Date")
    If colPlannedDate = 0 Then colPlannedDate = FindHeaderColumnLoose(wsS, hdrRowS, "Remediation Completion Date")

    If colPlan = 0 Or colOwner = 0 Or colPlannedDate = 0 Then
        MsgBox "Could not find Remediation Plan / Remediation Owner / Planned Remediation Completion Date in the source file.", vbCritical
        LogEvent wsLog, "ERROR", "", "", "", "Missing remediation columns in source."
        GoTo CleanExit
    End If

    '---- Build destination indexes (existing rows) + learn prefixes ----
    Dim existingMain As Object, existingIssue As Object
    Dim entityPrefix As Object
    Set existingMain = CreateObject("Scripting.Dictionary")
    Set existingIssue = CreateObject("Scripting.Dictionary")
    Set entityPrefix = CreateObject("Scripting.Dictionary")

    Dim globalPrefix As String
    globalPrefix = ""

    BuildDestIndexes wsD, hdrRowD, colTaskName, existingMain, existingIssue, entityPrefix, globalPrefix
    If Len(globalPrefix) = 0 Then globalPrefix = "Sweep 2 - "

    LogEvent wsLog, "INFO", "", "", "", "Global prefix fallback: [" & globalPrefix & "]"
    LogEvent wsLog, "INFO", "", "", "", "Entity prefixes learned: " & CStr(entityPrefix.Count)

    '---- Iterate source rows ----
    Dim lastRowS As Long, r As Long
    lastRowS = wsS.UsedRange.Rows(wsS.UsedRange.Rows.Count).Row

    Dim seenMainInRun As Object
    Set seenMainInRun = CreateObject("Scripting.Dictionary") 'entity||policy -> True once first issue consumed as main

    Dim snippetCounts As Object
    Set snippetCounts = CreateObject("Scripting.Dictionary") 'entity||policy||snippetBase -> count

    For r = hdrRowS + 1 To lastRowS

        Dim qid As String
        qid = Trim(CStr(GetMergedValue(wsS.Cells(r, colQID))))
        If LCase$(qid) = "summary" Then GoTo NextRow

        Dim pol As String
        pol = Trim(CStr(GetMergedValue(wsS.Cells(r, colPolSub))))
        If Len(pol) = 0 Then GoTo NextRow
        pol = CanonicalPolicySubDomain(pol)

        Dim systemsRaw As String
        systemsRaw = Trim(CStr(GetMergedValue(wsS.Cells(r, colSystems))))
        If Len(systemsRaw) = 0 Then GoTo NextRow

        Dim entities As Collection
        Set entities = ParseEntities(systemsRaw)
        If entities.Count = 0 Then GoTo NextRow

        Dim planText As String, ownerText As String
        Dim dueVal As Variant
        planText = Trim(CStr(GetMergedValue(wsS.Cells(r, colPlan))))
        ownerText = Trim(CStr(GetMergedValue(wsS.Cells(r, colOwner))))
        dueVal = GetMergedValue(wsS.Cells(r, colPlannedDate))

        Dim origQ As String
        origQ = Trim(CStr(GetMergedValue(wsS.Cells(r, colOrigQ))))

        Dim e As Variant
        For Each e In entities

            Dim entityDisplay As String, entityKey As String
            entityDisplay = CStr(e)
            entityKey = NormalizeKey(entityDisplay)

            If Len(entityKey) = 0 Then GoTo NextEntity

            Dim prefixText As String
            If entityPrefix.Exists(entityKey) Then
                prefixText = CStr(entityPrefix(entityKey))
            Else
                prefixText = globalPrefix
            End If

            Dim keyMain As String
            keyMain = entityKey & "||" & NormalizeKey(pol)

            'Write main row for first issue we encounter (per entity+policy) in this run.
            Dim isFirstForThisRun As Boolean
            isFirstForThisRun = Not seenMainInRun.Exists(keyMain)

            If isFirstForThisRun Then
                seenMainInRun.Add keyMain, True
                UpsertMainRow wsD, hdrRowD, colTaskName, colIssueId, colDesc, colAssigned, colDue, _
                             existingMain, keyMain, prefixText, pol, entityDisplay, _
                             planText, ownerText, dueVal, wsLog
            Else
                'Extra row: include snippet from Original Question
                Dim snippet As String, snippetBaseKey As String, uniqSnippet As String
                snippet = MakeSnippet(origQ)
                If Len(snippet) = 0 Then snippet = "issue"

                snippetBaseKey = keyMain & "||" & NormalizeKey(snippet)
                If snippetCounts.Exists(snippetBaseKey) Then
                    snippetCounts(snippetBaseKey) = CLng(snippetCounts(snippetBaseKey)) + 1
                    uniqSnippet = snippet & " " & CStr(snippetCounts(snippetBaseKey))
                Else
                    snippetCounts.Add snippetBaseKey, 1
                    uniqSnippet = snippet
                End If

                UpsertIssueRow wsD, hdrRowD, colTaskName, colIssueId, colDesc, colAssigned, colDue, _
                               existingMain, existingIssue, keyMain, NormalizeKey(uniqSnippet), _
                               prefixText, pol, entityDisplay, uniqSnippet, _
                               planText, ownerText, dueVal, wsLog
            End If

NextEntity:
        Next e

NextRow:
    Next r

    LogEvent wsLog, "INFO", "", "", "", "Run complete."

    MsgBox "Done! Imported/updated remediation plan/owner/due date from CleanIssueReport." & vbCrLf & _
           "See 'Run Log' for details.", vbInformation

CleanExit:
    On Error Resume Next
    If Not wbS Is Nothing Then wbS.Close SaveChanges:=False
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
End Sub

'==========================================================
' DEST UPSERTS
'==========================================================

Private Sub UpsertMainRow( _
    ByVal wsD As Worksheet, ByVal hdrRowD As Long, _
    ByVal colTaskName As Long, ByVal colIssueId As Long, ByVal colDesc As Long, ByVal colAssigned As Long, ByVal colDue As Long, _
    ByVal existingMain As Object, _
    ByVal keyMain As String, _
    ByVal prefixText As String, ByVal pol As String, ByVal entityDisplay As String, _
    ByVal planText As String, ByVal ownerText As String, ByVal dueVal As Variant, _
    ByVal wsLog As Worksheet)

    Dim rowNum As Long, action As String

    If existingMain.Exists(keyMain) Then
        rowNum = CLng(existingMain(keyMain))
        action = "UPDATED"
    Else
        rowNum = AppendNewDestRow(wsD, hdrRowD, colTaskName)
        wsD.Cells(rowNum, colTaskName).Value = prefixText & pol & " (" & entityDisplay & ")"
        existingMain.Add keyMain, rowNum
        action = "ADDED"
    End If

    wsD.Cells(rowNum, colDesc).Value = planText
    wsD.Cells(rowNum, colAssigned).Value = ownerText
    WriteDateSmart wsD.Cells(rowNum, colDue), dueVal

    LogEvent wsLog, action, entityDisplay, pol, rowNum, "Main row written."
End Sub

Private Sub UpsertIssueRow( _
    ByVal wsD As Worksheet, ByVal hdrRowD As Long, _
    ByVal colTaskName As Long, ByVal colIssueId As Long, ByVal colDesc As Long, ByVal colAssigned As Long, ByVal colDue As Long, _
    ByVal existingMain As Object, ByVal existingIssue As Object, _
    ByVal keyMain As String, ByVal snippetKeyNorm As String, _
    ByVal prefixText As String, ByVal pol As String, ByVal entityDisplay As String, ByVal snippet As String, _
    ByVal planText As String, ByVal ownerText As String, ByVal dueVal As Variant, _
    ByVal wsLog As Worksheet)

    Dim keyIssue As String
    keyIssue = keyMain & "||" & snippetKeyNorm

    Dim rowNum As Long, action As String
    If existingIssue.Exists(keyIssue) Then
        rowNum = CLng(existingIssue(keyIssue))
        action = "UPDATED"
    Else
        rowNum = AppendNewDestRow(wsD, hdrRowD, colTaskName)
        wsD.Cells(rowNum, colTaskName).Value = prefixText & pol & " (" & entityDisplay & ") - " & snippet
        existingIssue.Add keyIssue, rowNum
        action = "ADDED"
    End If

    wsD.Cells(rowNum, colDesc).Value = planText
    wsD.Cells(rowNum, colAssigned).Value = ownerText
    WriteDateSmart wsD.Cells(rowNum, colDue), dueVal

    'Replicate Issue Id from main row if present
    If existingMain.Exists(keyMain) Then
        Dim mainRow As Long: mainRow = CLng(existingMain(keyMain))
        Dim mainIssueId As String: mainIssueId = Trim(CStr(wsD.Cells(mainRow, colIssueId).Value))
        If Len(mainIssueId) > 0 Then wsD.Cells(rowNum, colIssueId).Value = mainIssueId
    End If

    LogEvent wsLog, action, entityDisplay, pol, rowNum, "Extra issue row written: " & snippet
End Sub

'==========================================================
' DEST INDEX BUILDING + PREFIX LEARNING
'==========================================================

Private Sub BuildDestIndexes( _
    ByVal wsD As Worksheet, ByVal hdrRowD As Long, ByVal colTaskName As Long, _
    ByVal existingMain As Object, ByVal existingIssue As Object, _
    ByVal entityPrefix As Object, ByRef globalPrefix As String)

    Dim lastRow As Long, r As Long
    lastRow = wsD.Cells(wsD.Rows.Count, colTaskName).End(xlUp).Row

    For r = hdrRowD + 1 To lastRow

        Dim t As String/job
        t = Trim(CStr(wsD.Cells(r, colTaskName).Value))
        If Len(t) = 0 Then GoTo NextR

        Dim ent As String, pol As String, pref As String, snip As String
        ent = ExtractBetweenParens(t)
        pol = CanonicalPolicySubDomain(ExtractPolicySubDomainFromTaskName(t))
        pref = ExtractPrefixUpToSweep2Dash(t)
        snip = ExtractSnippetFromTaskName(t)

        If Len(pref) > 0 And IsGoodPrefix(pref) Then
            If Len(globalPrefix) = 0 Then globalPrefix = pref
            If Len(ent) > 0 Then
                Dim ek As String: ek = NormalizeKey(ent)
                If Not entityPrefix.Exists(ek) Then entityPrefix.Add ek, pref
            End If
        End If

        If Len(ent) > 0 And Len(pol) > 0 Then
            Dim keyMain As String
            keyMain = NormalizeKey(ent) & "||" & NormalizeKey(pol)

            If Len(snip) = 0 Then
                If Not existingMain.Exists(keyMain) Then existingMain.Add keyMain, r
            Else
                Dim keyIssue As String
                keyIssue = keyMain & "||" & NormalizeKey(snip)
                If Not existingIssue.Exists(keyIssue) Then existingIssue.Add keyIssue, r
            End If
        End If

NextR:
    Next r
End Sub

'==========================================================
' ENTITY PARSING (Systems Exhibiting the Issue)
' Splits by line breaks, commas, semicolons.
'==========================================================

Private Function ParseEntities(ByVal raw As String) As Collection
    Dim c As New Collection
    Dim t As String
    t = Trim(CStr(raw))
    If Len(t) = 0 Then
        Set ParseEntities = c
        Exit Function
    End If

    t = Replace(t, vbCrLf, vbLf)
    t = Replace(t, vbCr, vbLf)
    t = Replace(t, ";", vbLf)
    t = Replace(t, ",", vbLf)

    Dim parts() As String
    parts = Split(t, vbLf)

    Dim i As Long
    For i = LBound(parts) To UBound(parts)
        Dim p As String
        p = Trim(parts(i))
        If Len(p) > 0 Then
            c.Add p
        End If
    Next i

    Set ParseEntities = c
End Function

'==========================================================
' POLICY SUB-DOMAIN ALIASING
'==========================================================

Private Function CanonicalPolicySubDomain(ByVal pol As String) As String
    Dim t As String
    t = Trim(CStr(pol))
    Do While InStr(t, "  ") > 0
        t = Replace(t, "  ", " ")
    Loop

    Select Case LCase$(t)
        Case LCase$("Secure Authentication - MFA")
            CanonicalPolicySubDomain = "Multi-Factor Authentication"
        Case LCase$("Protection of Systems and Communications")
            CanonicalPolicySubDomain = "Protection of System and Communications"
        Case LCase$("Access Control - Separate Admin Account")
            CanonicalPolicySubDomain = "Separate Admin Account"
        Case Else
            CanonicalPolicySubDomain = t
    End Select
End Function

'==========================================================
' SNIPPET FROM Original Question (1-4 meaningful words)
'==========================================================

Private Function MakeSnippet(ByVal s As String) As String
    s = Trim(CStr(s))
    If Len(s) = 0 Then MakeSnippet = "": Exit Function

    Dim t As String
    t = s
    t = Replace(t, vbCr, " ")
    t = Replace(t, vbLf, " ")
    t = Replace(t, ":", " ")
    t = Replace(t, ";", " ")
    t = Replace(t, ".", " ")
    t = Replace(t, ",", " ")
    t = Replace(t, "?", " ")
    t = Replace(t, "!", " ")
    t = Replace(t, "(", " ")
    t = Replace(t, ")", " ")
    t = Replace(t, "[", " ")
    t = Replace(t, "]", " ")
    t = Replace(t, "-", " ")
    t = Replace(t, "_", " ")

    Do While InStr(t, "  ") > 0
        t = Replace(t, "  ", " ")
    Loop
    t = Trim(t)

    Dim parts() As String
    parts = Split(t, " ")

    Dim out As String, cnt As Long, i As Long
    For i = LBound(parts) To UBound(parts)
        Dim w As String
        w = Trim(parts(i))
        If Len(w) = 0 Then GoTo NextW
        If IsStopWord(w) Then GoTo NextW

        out = out & IIf(Len(out) = 0, "", " ") & w
        cnt = cnt + 1
        If cnt >= 4 Then Exit For
NextW:
    Next i

    MakeSnippet = out
End Function

Private Function IsStopWord(ByVal w As String) As Boolean
    Select Case LCase$(w)
        Case "the", "a", "an", "and", "or", "to", "of", "in", "on", "for", "with", "is", "are", "was", "were", _
             "be", "been", "being", "by", "at", "as", "it", "this", "that", "these", "those", "your", "you", _
             "shall", "should", "must", "may", "can", "could", "will", "would", "do", "does", "did", "from"
            IsStopWord = True
        Case Else
            IsStopWord = False
    End Select
End Function

'==========================================================
' HEADER FINDING
'==========================================================

Private Function FindHeaderRow(ByVal ws As Worksheet, ByVal headers As Variant, ByVal maxRowsToScan As Long) As Long
    Dim r As Long, i As Long
    For r = 1 To maxRowsToScan
        For i = LBound(headers) To UBound(headers)
            If FindHeaderColumn(ws, r, CStr(headers(i))) = 0 Then GoTo NextR
        Next i
        FindHeaderRow = r
        Exit Function
NextR:
    Next r
    FindHeaderRow = 0
End Function

Private Function FindHeaderColumn(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal headerText As String) As Long
    Dim lastCol As Long, c As Long, v As String
    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    For c = 1 To lastCol
        v = Trim(CStr(ws.Cells(headerRow, c).Value))
        If StrComp(v, headerText, vbTextCompare) = 0 Then
            FindHeaderColumn = c
            Exit Function
        End If
    Next c
    FindHeaderColumn = 0
End Function

Private Function FindHeaderRowLoose(ByVal ws As Worksheet, ByVal headers As Variant, ByVal maxRowsToScan As Long) As Long
    Dim r As Long, i As Long
    For r = 1 To maxRowsToScan
        For i = LBound(headers) To UBound(headers)
            If FindHeaderColumnLoose(ws, r, CStr(headers(i))) = 0 Then GoTo NextR
        Next i
        FindHeaderRowLoose = r
        Exit Function
NextR:
    Next r
    FindHeaderRowLoose = 0
End Function

Private Function FindHeaderColumnLoose(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal headerText As String) As Long
    Dim lastCol As Long, c As Long
    Dim target As String, v As String
    target = NormalizeKey(headerText)

    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    For c = 1 To lastCol
        v = NormalizeKey(CStr(ws.Cells(headerRow, c).Value))
        If v = target Then
            FindHeaderColumnLoose = c
            Exit Function
        End If
        If InStr(1, v, target, vbTextCompare) > 0 Or InStr(1, target, v, vbTextCompare) > 0 Then
            FindHeaderColumnLoose = c
            Exit Function
        End If
    Next c

    FindHeaderColumnLoose = 0
End Function

'==========================================================
' MERGED SAFE GET
'==========================================================

Private Function GetMergedValue(ByVal cell As Range) As Variant
    If cell.MergeCells Then
        GetMergedValue = cell.MergeArea.Cells(1, 1).Value
    Else
        GetMergedValue = cell.Value
    End If
End Function

'==========================================================
' NORMALIZATION
'==========================================================

Private Function NormalizeKey(ByVal s As String) As String
    Dim t As String
    t = LCase$(Trim(CStr(s)))
    t = Replace(t, vbCrLf, " ")
    t = Replace(t, vbCr, " ")
    t = Replace(t, vbLf, " ")
    t = Replace(t, ChrW(160), " ")
    Do While InStr(t, "  ") > 0
        t = Replace(t, "  ", " ")
    Loop
    NormalizeKey = t
End Function

'==========================================================
' DEST ROW APPEND + DATE
'==========================================================

Private Function AppendNewDestRow(ByVal ws As Worksheet, ByVal hdrRow As Long, ByVal colAnchor As Long) As Long
    Dim outRow As Long
    outRow = ws.Cells(ws.Rows.Count, colAnchor).End(xlUp).Row + 1
    If outRow <= hdrRow Then outRow = hdrRow + 1
    AppendNewDestRow = outRow
End Function

Private Sub WriteDateSmart(ByVal targetCell As Range, ByVal v As Variant)
    If Len(Trim(CStr(v))) = 0 Then
        targetCell.Value = ""
    ElseIf IsDate(v) Then
        targetCell.Value = CDate(v)
    Else
        targetCell.Value = CStr(v)
    End If
End Sub

'==========================================================
' PARSING FROM DEST TASK NAME
'==========================================================

Private Function ExtractBetweenParens(ByVal s As String) As String
    Dim p1 As Long, p2 As Long
    p1 = InStrRev(s, "(")
    p2 = InStrRev(s, ")")
    If p1 > 0 And p2 > p1 Then
        ExtractBetweenParens = Trim(Mid$(s, p1 + 1, p2 - p1 - 1))
    Else
        ExtractBetweenParens = ""
    End If
End Function

Private Function ExtractPolicySubDomainFromTaskName(ByVal s As String) As String
    Dim lowerS As String
    lowerS = LCase$(s)

    Dim pSweep As Long
    pSweep = InStr(1, lowerS, "sweep", vbTextCompare)
    If pSweep = 0 Then ExtractPolicySubDomainFromTaskName = "": Exit Function

    Dim p2 As Long
    p2 = InStr(pSweep, lowerS, "2", vbTextCompare)
    If p2 = 0 Then ExtractPolicySubDomainFromTaskName = "": Exit Function

    Dim pDash As Long
    pDash = InStr(p2, lowerS, "-", vbTextCompare)
    If pDash = 0 Then ExtractPolicySubDomainFromTaskName = "": Exit Function

    Dim startPos As Long
    startPos = pDash + 1
    Do While startPos <= Len(s) And Mid$(s, startPos, 1) = " "
        startPos = startPos + 1
    Loop

    Dim pParen As Long
    pParen = InStrRev(s, "(")

    Dim pol As String
    If pParen > 0 And pParen > startPos Then
        pol = Mid$(s, startPos, pParen - startPos)
    Else
        pol = Mid$(s, startPos)
    End If

    ExtractPolicySubDomainFromTaskName = Trim(pol)
End Function

Private Function ExtractPrefixUpToSweep2Dash(ByVal s As String) As String
    Dim lowerS As String
    lowerS = LCase$(s)

    Dim pSweep As Long
    pSweep = InStr(1, lowerS, "sweep", vbTextCompare)
    If pSweep = 0 Then ExtractPrefixUpToSweep2Dash = "": Exit Function

    Dim p2 As Long
    p2 = InStr(pSweep, lowerS, "2", vbTextCompare)
    If p2 = 0 Then ExtractPrefixUpToSweep2Dash = "": Exit Function

    Dim pDash As Long
    pDash = InStr(p2, lowerS, "-", vbTextCompare)
    If pDash = 0 Then ExtractPrefixUpToSweep2Dash = "": Exit Function

    Dim endPos As Long
    endPos = pDash
    Do While endPos < Len(s) And Mid$(s, endPos + 1, 1) = " "
        endPos = endPos + 1
    Loop

    ExtractPrefixUpToSweep2Dash = Left$(s, endPos)
End Function

Private Function ExtractSnippetFromTaskName(ByVal fullName As String) As String
    Dim pClose As Long
    pClose = InStrRev(fullName, ")")
    If pClose = 0 Then ExtractSnippetFromTaskName = "": Exit Function

    Dim afterParen As String
    afterParen = Trim(Mid$(fullName, pClose + 1))
    If Len(afterParen) = 0 Then ExtractSnippetFromTaskName = "": Exit Function

    If Left$(afterParen, 1) = "-" Then
        ExtractSnippetFromTaskName = Trim(Mid$(afterParen, 2))
    ElseIf Left$(afterParen, 2) = "- " Then
        ExtractSnippetFromTaskName = Trim(Mid$(afterParen, 3))
    Else
        ExtractSnippetFromTaskName = ""
    End If
End Function

Private Function IsGoodPrefix(ByVal pref As String) As Boolean
    Dim t As String
    t = LCase$(pref)

    If InStr(1, pref, "[", vbTextCompare) > 0 Or InStr(1, pref, "]", vbTextCompare) > 0 Then
        IsGoodPrefix = False: Exit Function
    End If
    If InStr(1, t, "issue name", vbTextCompare) > 0 Or InStr(1, t, "entity name", vbTextCompare) > 0 Then
        IsGoodPrefix = False: Exit Function
    End If
    If InStr(1, t, "sweep", vbTextCompare) = 0 Then IsGoodPrefix = False: Exit Function
    If InStr(1, t, "2", vbTextCompare) = 0 Then IsGoodPrefix = False: Exit Function
    If InStr(1, t, "-", vbTextCompare) = 0 Then IsGoodPrefix = False: Exit Function

    IsGoodPrefix = True
End Function

'==========================================================
' LOGGING
