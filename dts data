Option Explicit

'===========================================================
' MAIN
'===========================================================
Public Sub Build_RemediationTasks_From_CleanIssueReport_V2()

    Dim issuePath As String, taskPath As String
    issuePath = PickExcelFile("Select the ISSUE REPORT workbook (sheet: CleanIssueReport)")
    If Len(issuePath) = 0 Then Exit Sub

    taskPath = PickExcelFile("Select the REMEDIATION TASK workbook (destination)")
    If Len(taskPath) = 0 Then Exit Sub

    Dim prevCalc As XlCalculation
    prevCalc = Application.Calculation

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.EnableEvents = False
    Application.Calculation = xlCalculationManual

    Dim wbIssue As Workbook, wbTask As Workbook
    On Error GoTo ErrHandler
    Set wbIssue = Workbooks.Open(issuePath, ReadOnly:=True)
    Set wbTask = Workbooks.Open(taskPath)

    Dim wsIssue As Worksheet
    Set wsIssue = Nothing
    On Error Resume Next
    Set wsIssue = wbIssue.Worksheets("CleanIssueReport")
    On Error GoTo ErrHandler
    If wsIssue Is Nothing Then
        MsgBox "Sheet 'CleanIssueReport' not found in issue report workbook.", vbCritical
        GoTo CleanExit
    End If

    Dim wsTask As Worksheet
    Set wsTask = FindSheetByHeaderFuzzy(wbTask, "Remediation Task Name")
    If wsTask Is Nothing Then
        MsgBox "Could not find destination sheet with header 'Remediation Task Name' in row 1.", vbCritical
        GoTo CleanExit
    End If

    '-------------------------------------------------------
    ' ISSUE REPORT COLUMNS (STRICT FIRST, THEN FUZZY FALLBACK)
    '-------------------------------------------------------
    Dim cPol As Long, cEnt As Long, cQID As Long, cOrigQ As Long
    Dim cPlan As Long, cOwner As Long, cDue As Long

    cPol = FindHeaderColStrict(wsIssue, 1, "Policy Sub-Domain")
    If cPol = 0 Then cPol = FindHeaderColFuzzy(wsIssue, 1, "Policy Sub-Domain")

    ' FORCE entity column to Systems Exhibiting the Issue
    cEnt = FindHeaderColStrict(wsIssue, 1, "Systems Exhibiting the Issue")
    If cEnt = 0 Then cEnt = FindHeaderColFuzzy(wsIssue, 1, "Systems Exhibiting the Issue")

    cQID = FindHeaderColStrict(wsIssue, 1, "Question ID")
    If cQID = 0 Then cQID = FindHeaderColFuzzy(wsIssue, 1, "Question ID")

    cOrigQ = FindHeaderColStrict(wsIssue, 1, "Original Question")
    If cOrigQ = 0 Then cOrigQ = FindHeaderColFuzzy(wsIssue, 1, "Original Question")

    cPlan = FindHeaderColAnyFuzzy(wsIssue, 1, Array("Remediation Plan", "Planned Remediation", "Suggested Remediation", "Remediation"))
    cOwner = FindHeaderColAnyFuzzy(wsIssue, 1, Array("Remediation Owner", "Owner", "Assignee", "Assigned To"))
    cDue = FindHeaderColAnyFuzzy(wsIssue, 1, Array("Planned Remediation Completion Date", "Remediation Completion Date", "Completion Date", "Due Date"))

    If cPol = 0 Or cEnt = 0 Or cQID = 0 Or cOrigQ = 0 Or cPlan = 0 Or cOwner = 0 Or cDue = 0 Then
        MsgBox "Missing required columns on CleanIssueReport." & vbCrLf & vbCrLf & _
               "Found headers (row 1):" & vbCrLf & ListHeaders(wsIssue, 1) & vbCrLf & vbCrLf & _
               "Required headers:" & vbCrLf & _
               "- Policy Sub-Domain" & vbCrLf & _
               "- Systems Exhibiting the Issue" & vbCrLf & _
               "- Question ID" & vbCrLf & _
               "- Original Question" & vbCrLf & _
               "- Remediation Plan" & vbCrLf & _
               "- Remediation Owner" & vbCrLf & _
               "- Planned Remediation Completion Date / Due Date", vbCritical
        GoTo CleanExit
    End If

    '-------------------------------------------------------
    ' DESTINATION COLUMNS
    '-------------------------------------------------------
    Dim tTaskName As Long, tDesc As Long, tAssigned As Long, tDue As Long, tIssueId As Long

    tTaskName = FindHeaderColFuzzy(wsTask, 1, "Remediation Task Name")
    tDesc = FindHeaderColAnyFuzzy(wsTask, 1, Array("Description", "Remediation Plan", "Details"))
    tAssigned = FindHeaderColAnyFuzzy(wsTask, 1, Array("Assigned To", "Assignee", "Owner", "Remediation Owner"))
    tDue = FindHeaderColAnyFuzzy(wsTask, 1, Array("Due Date", "Planned Completion", "Completion Date", "Planned Remediation Completion Date"))
    tIssueId = FindHeaderColAnyFuzzy(wsTask, 1, Array("Issue ID", "Ticket", "Task ID", "Number"))

    If tTaskName = 0 Or tDesc = 0 Or tAssigned = 0 Or tDue = 0 Then
        MsgBox "Destination sheet is missing required columns: Remediation Task Name, Description, Assigned To, Due Date.", vbCritical
        GoTo CleanExit
    End If

    '-------------------------------------------------------
    ' PREFIX (MORE RELIABLE)
    '-------------------------------------------------------
    Dim prefix As String
    prefix = DetectPrefixFromFilenameSmart(issuePath)
    If Len(prefix) = 0 Then prefix = DetectPrefixFromTasks(wsTask, tTaskName)

    If Len(prefix) = 0 Then
        prefix = InputBox("Enter the prefix to use (e.g., DTS, EPD, AN):", "Prefix", "DTS")
        prefix = UCase$(Trim$(prefix))
        If Len(prefix) = 0 Then prefix = "DTS"
    End If

    '-------------------------------------------------------
    ' BUILD EXISTING INDEXES (ROBUST PARSING EVEN WHEN POLICY HAS ())
    '-------------------------------------------------------
    Dim mainKeyToRow As Object: Set mainKeyToRow = CreateObject("Scripting.Dictionary")   ' entity|policy -> first row
    Dim exactKeyExists As Object: Set exactKeyExists = CreateObject("Scripting.Dictionary") ' entity|policy|snippet -> exists
    BuildExistingIndexesV2 wsTask, tTaskName, mainKeyToRow, exactKeyExists

    Dim nextDestRow As Long
    nextDestRow = wsTask.Cells(wsTask.Rows.Count, 1).End(xlUp).Row + 1
    If nextDestRow < 2 Then nextDestRow = 2

    '-------------------------------------------------------
    ' READ ISSUE REPORT INTO ARRAY (FAST)
    '-------------------------------------------------------
    Dim lastRow As Long, lastCol As Long
    lastRow = wsIssue.Cells(wsIssue.Rows.Count, cPol).End(xlUp).Row
    If lastRow < 2 Then
        MsgBox "No data rows found under headers in CleanIssueReport.", vbExclamation
        GoTo CleanExit
    End If

    lastCol = wsIssue.Cells(1, wsIssue.Columns.Count).End(xlToLeft).Column

    Dim arr As Variant
    arr = wsIssue.Range(wsIssue.Cells(1, 1), wsIssue.Cells(lastRow, lastCol)).Value2

    Dim currentPol As String: currentPol = ""

    Dim r As Long
    For r = 2 To lastRow

        Dim qid As String
        qid = CleanCellText(arr(r, cQID))
        If LCase$(qid) = "summary" Then GoTo NextR

        Dim pol As String
        pol = CleanCellText(arr(r, cPol))
        If Len(pol) > 0 Then
            currentPol = pol
        Else
            pol = currentPol
        End If
        If Len(pol) = 0 Then GoTo NextR

        ' ENTITY MUST COME FROM Systems Exhibiting the Issue
        Dim entRaw As String
        entRaw = CleanCellText(arr(r, cEnt))
        If Len(entRaw) = 0 Then GoTo NextR

        Dim origQ As String
        origQ = CleanCellText(arr(r, cOrigQ))

        Dim snippet As String
        snippet = SnippetFromQuestionIntent(origQ)

        Dim planText As String, ownerText As String
        Dim dueVal As Variant
        planText = CleanCellText(arr(r, cPlan))
        ownerText = CleanCellText(arr(r, cOwner))
        dueVal = arr(r, cDue)

        Dim entities As Collection
        Set entities = SplitEntities(entRaw)

        Dim i As Long
        For i = 1 To entities.Count

            Dim entityDisplay As String
            entityDisplay = Trim$(CStr(entities(i)))
            If Len(entityDisplay) = 0 Then GoTo NextEnt

            Dim mainKey As String, exactKey As String
            mainKey = NormalizeKey(entityDisplay) & "|" & NormalizeKey(pol)
            exactKey = mainKey & "|" & NormalizeKey(snippet)

            If exactKeyExists.Exists(exactKey) Then GoTo NextEnt
            exactKeyExists.Add exactKey, True

            Dim destRow As Long, mainRow As Long

            If mainKeyToRow.Exists(mainKey) Then
                mainRow = CLng(mainKeyToRow(mainKey))

                ' Reuse main row only if it is empty
                If RowLooksEmpty(wsTask, mainRow, tDesc, tAssigned, tDue) Then
                    destRow = mainRow
                Else
                    destRow = nextDestRow
                    nextDestRow = nextDestRow + 1

                    WriteTaskNameV2 wsTask, destRow, tTaskName, prefix, pol, entityDisplay, snippet
                    ReplicateIssueId wsTask, mainRow, destRow, tIssueId
                End If

            Else
                destRow = nextDestRow
                nextDestRow = nextDestRow + 1

                mainKeyToRow.Add mainKey, destRow
                WriteTaskNameV2 wsTask, destRow, tTaskName, prefix, pol, entityDisplay, snippet
            End If

            If Len(planText) > 0 Then wsTask.Cells(destRow, tDesc).Value2 = planText
            If Len(ownerText) > 0 Then wsTask.Cells(destRow, tAssigned).Value2 = ownerText
            WriteDateSmart wsTask.Cells(destRow, tDue), dueVal

NextEnt:
        Next i

        If (r Mod 500) = 0 Then DoEvents
NextR:
    Next r

    wbTask.Save
    MsgBox "Done ✅ Remediation tasks updated. (Entity is pulled from Systems Exhibiting the Issue)", vbInformation

CleanExit:
    On Error Resume Next
    wbIssue.Close SaveChanges:=False
    wbTask.Close SaveChanges:=True
    On Error GoTo 0

    Application.Calculation = prevCalc
    Application.EnableEvents = True
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
    Exit Sub

ErrHandler:
    MsgBox "Error " & Err.Number & ": " & Err.Description, vbCritical
    Resume CleanExit

End Sub


'===========================================================
' TASK NAME FORMATTER (ALWAYS ADDS ENTITY IN ())
'===========================================================
Private Sub WriteTaskNameV2(ByVal ws As Worksheet, ByVal rowNum As Long, ByVal colTaskName As Long, _
                            ByVal prefix As String, ByVal policySub As String, ByVal entityName As String, ByVal snippet As String)

    Dim t As String
    t = UCase$(Trim$(prefix)) & " Sweep 2 - " & policySub & " (" & entityName & ")"
    If Len(snippet) > 0 Then t = t & " - " & snippet
    ws.Cells(rowNum, colTaskName).Value2 = t

End Sub


'===========================================================
' SNIPPETS (INTENT LABELS)
'===========================================================
Private Function SnippetFromQuestionIntent(ByVal q As String) As String

    Dim s As String
    s = LCase$(CleanCellText(q))
    If Len(s) = 0 Then SnippetFromQuestionIntent = "": Exit Function

    If InStr(s, "access provisioning") > 0 Or (InStr(s, "formal access") > 0 And InStr(s, "approv") > 0) Then
        SnippetFromQuestionIntent = "access provisioning approvals": Exit Function
    End If

    If InStr(s, "disabled promptly") > 0 Or InStr(s, "upon notification of termination") > 0 Or _
       (InStr(s, "termination") > 0 And InStr(s, "disabled") > 0) Or InStr(s, "job responsibilities") > 0 Then
        SnippetFromQuestionIntent = "deprovision access on termination": Exit Function
    End If

    If InStr(s, "recertification") > 0 Or InStr(s, "access recertification") > 0 Or InStr(s, "confirm access") > 0 Then
        SnippetFromQuestionIntent = "periodic access recertification": Exit Function
    End If

    If InStr(s, "removing the access of a customer") > 0 Or (InStr(s, "customer") > 0 And InStr(s, "remove") > 0) Then
        SnippetFromQuestionIntent = "remove customer access": Exit Function
    End If

    If InStr(s, "service account") > 0 And (InStr(s, "rotating") > 0 Or InStr(s, "password") > 0 Or InStr(s, "tracking") > 0) Then
        SnippetFromQuestionIntent = "service account lifecycle": Exit Function
    End If

    If InStr(s, "service accounts") > 0 And InStr(s, "assigned an owner") > 0 Then
        SnippetFromQuestionIntent = "service account owner assigned": Exit Function
    End If

    If InStr(s, "default accounts") > 0 Then
        SnippetFromQuestionIntent = "secure default accounts": Exit Function
    End If

    If InStr(s, "shared accounts for customers") > 0 Then
        SnippetFromQuestionIntent = "prohibit customer shared accounts": Exit Function
    End If

    If InStr(s, "shared accounts") > 0 Then
        SnippetFromQuestionIntent = "prohibit shared accounts": Exit Function
    End If

    If InStr(s, "temporary accounts") > 0 And (InStr(s, "disabled") > 0 Or InStr(s, "inactivity") > 0) Then
        SnippetFromQuestionIntent = "disable temporary accounts": Exit Function
    End If

    If InStr(s, "break glass") > 0 Then
        SnippetFromQuestionIntent = "break glass password rotation": Exit Function
    End If

    If InStr(s, "separate and limit") > 0 Or InStr(s, "minimum required") > 0 Or InStr(s, "job responsibilities") > 0 Then
        SnippetFromQuestionIntent = "least privilege roles": Exit Function
    End If

    If InStr(s, "separate administrator accounts") > 0 Or InStr(s, "separate admin") > 0 Then
        SnippetFromQuestionIntent = "separate admin accounts": Exit Function
    End If

    If InStr(s, "privileged access management") > 0 Or InStr(s, "pam") > 0 Then
        SnippetFromQuestionIntent = "privileged access management": Exit Function
    End If

    If InStr(s, "encrypt") > 0 And InStr(s, "transit") > 0 Then
        SnippetFromQuestionIntent = "encrypt data in transit": Exit Function
    End If

    If InStr(s, "vulnerability") > 0 And InStr(s, "scan") > 0 Then
        SnippetFromQuestionIntent = "vulnerability scanning": Exit Function
    End If

    If InStr(s, "penetration test") > 0 Then
        SnippetFromQuestionIntent = "penetration testing": Exit Function
    End If

    If InStr(s, "static application security testing") > 0 Or InStr(s, "sast") > 0 Or InStr(s, "sca") > 0 Then
        SnippetFromQuestionIntent = "sast or sca testing": Exit Function
    End If

    SnippetFromQuestionIntent = Left$(CleanCellText(q), 60)

End Function


'===========================================================
' EXISTING INDEXES (V2 PARSER)
'   Works even when policy contains parentheses like:
'   Access Control (administrators)
'===========================================================
Private Sub BuildExistingIndexesV2(ByVal ws As Worksheet, ByVal colTaskName As Long, _
                                   ByVal mainKeyToRow As Object, ByVal exactKeyExists As Object)

    Dim lastRow As Long, r As Long
    lastRow = ws.Cells(ws.Rows.Count, colTaskName).End(xlUp).Row
    If lastRow < 2 Then Exit Sub

    For r = 2 To lastRow

        Dim t As String
        t = CleanCellText(ws.Cells(r, colTaskName).Value2)
        If Len(t) = 0 Then GoTo NextR

        Dim pol As String, ent As String, snip As String
        ParseTaskNameV2 t, pol, ent, snip

        If Len(pol) = 0 Or Len(ent) = 0 Then GoTo NextR

        Dim mainKey As String, exactKey As String
        mainKey = NormalizeKey(ent) & "|" & NormalizeKey(pol)
        If Not mainKeyToRow.Exists(mainKey) Then mainKeyToRow.Add mainKey, r

        exactKey = mainKey & "|" & NormalizeKey(snip)
        If Not exactKeyExists.Exists(exactKey) Then exactKeyExists.Add exactKey, True

NextR:
    Next r
End Sub

Private Sub ParseTaskNameV2(ByVal t As String, ByRef polOut As String, ByRef entOut As String, ByRef snipOut As String)
    ' Expected:
    ' PREFIX Sweep 2 - POLICY (ENTITY) - SNIP
    ' POLICY may itself contain parentheses, so ENTITY is taken from the LAST (...) group before the final " - SNIP".

    polOut = "": entOut = "": snipOut = ""

    Dim p As Long
    p = InStr(1, t, "Sweep 2 -", vbTextCompare)
    If p = 0 Then Exit Sub

    Dim afterDash As String
    afterDash = Mid$(t, p + Len("Sweep 2 -"))
    afterDash = Trim$(afterDash)

    Dim lastClose As Long
    lastClose = InStrRev(afterDash, ")")
    If lastClose = 0 Then Exit Sub

    Dim lastOpen As Long
    lastOpen = InStrRev(Left$(afterDash, lastClose), "(")
    If lastOpen = 0 Then Exit Sub

    polOut = Trim$(Left$(afterDash, lastOpen - 1))
    entOut = Trim$(Mid$(afterDash, lastOpen + 1, lastClose - lastOpen - 1))

    Dim rest As String
    rest = Trim$(Mid$(afterDash, lastClose + 1))

    If Left$(rest, 1) = "-" Then rest = Trim$(Mid$(rest, 2))
    If Left$(rest, 1) = "-" Then rest = Trim$(Mid$(rest, 2))

    snipOut = rest
End Sub


'===========================================================
' HELPERS
'===========================================================
Private Function RowLooksEmpty(ByVal ws As Worksheet, ByVal r As Long, ByVal cDesc As Long, ByVal cOwner As Long, ByVal cDue As Long) As Boolean
    Dim a As String, b As String
    a = CleanCellText(ws.Cells(r, cDesc).Value2)
    b = CleanCellText(ws.Cells(r, cOwner).Value2)

    If Len(a) > 0 Then RowLooksEmpty = False: Exit Function
    If Len(b) > 0 Then RowLooksEmpty = False: Exit Function

    If IsDate(ws.Cells(r, cDue).Value2) Then RowLooksEmpty = False: Exit Function
    If Len(CleanCellText(ws.Cells(r, cDue).Value2)) > 0 Then RowLooksEmpty = False: Exit Function

    RowLooksEmpty = True
End Function

Private Sub ReplicateIssueId(ByVal ws As Worksheet, ByVal mainRow As Long, ByVal newRow As Long, ByVal colIssueId As Long)
    If colIssueId <= 0 Then Exit Sub
    Dim v As String
    v = CleanCellText(ws.Cells(mainRow, colIssueId).Value2)
    If Len(v) > 0 Then ws.Cells(newRow, colIssueId).Value2 = v
End Sub

Private Sub WriteDateSmart(ByVal targetCell As Range, ByVal v As Variant)
    On Error Resume Next
    If IsDate(v) Then
        targetCell.Value = CDate(v)
        Exit Sub
    End If
    Dim s As String
    s = CleanCellText(v)
    If Len(s) = 0 Then Exit Sub
    If IsDate(s) Then
        targetCell.Value = CDate(s)
    Else
        targetCell.Value = s
    End If
End Sub

Private Function SplitEntities(ByVal s As String) As Collection
    Dim c As New Collection
    Dim t As String
    t = CleanCellText(s)

    t = Replace(t, vbCr, vbLf)

    Dim parts As Variant, i As Long
    If InStr(t, vbLf) > 0 Then
        parts = Split(t, vbLf)
    ElseIf InStr(t, ",") > 0 Then
        parts = Split(t, ",")
    Else
        c.Add t
        Set SplitEntities = c
        Exit Function
    End If

    For i = LBound(parts) To UBound(parts)
        Dim one As String
        one = Trim$(CStr(parts(i)))
        If Len(one) > 0 Then c.Add one
    Next i

    Set SplitEntities = c
End Function

Private Function FindSheetByHeaderFuzzy(ByVal wb As Workbook, ByVal headerText As String) As Worksheet
    Dim ws As Worksheet
    For Each ws In wb.Worksheets
        If FindHeaderColFuzzy(ws, 1, headerText) > 0 Then
            Set FindSheetByHeaderFuzzy = ws
            Exit Function
        End If
    Next ws
    Set FindSheetByHeaderFuzzy = Nothing
End Function

Private Function FindHeaderColStrict(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal headerText As String) As Long
    Dim want As String
    want = NormHdr(headerText)

    Dim lastCol As Long, c As Long
    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column

    For c = 1 To lastCol
        Dim got As String
        got = NormHdr(CStr(ws.Cells(headerRow, c).Value2))
        If got = want Then
            FindHeaderColStrict = c
            Exit Function
        End If
    Next c
    FindHeaderColStrict = 0
End Function

Private Function FindHeaderColFuzzy(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal headerText As String) As Long
    Dim want As String
    want = NormHdr(headerText)

    Dim lastCol As Long, c As Long
    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column

    For c = 1 To lastCol
        Dim got As String
        got = NormHdr(CStr(ws.Cells(headerRow, c).Value2))
        If Len(got) > 0 Then
            If got = want Or InStr(1, got, want, vbTextCompare) > 0 Or InStr(1, want, got, vbTextCompare) > 0 Then
                FindHeaderColFuzzy = c
                Exit Function
            End If
        End If
    Next c
    FindHeaderColFuzzy = 0
End Function

Private Function FindHeaderColAnyFuzzy(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal names As Variant) As Long
    Dim i As Long
    For i = LBound(names) To UBound(names)
        Dim col As Long
        col = FindHeaderColFuzzy(ws, headerRow, CStr(names(i)))
        If col > 0 Then FindHeaderColAnyFuzzy = col: Exit Function
    Next i
    FindHeaderColAnyFuzzy = 0
End Function

Private Function NormHdr(ByVal s As String) As String
    s = LCase$(s)
    s = Replace(s, vbCr, " ")
    s = Replace(s, vbLf, " ")
    s = Replace(s, ChrW(160), " ")
    s = Replace(s, "-", " ")
    Do While InStr(s, "  ") > 0
        s = Replace(s, "  ", " ")
    Loop
    NormHdr = Trim$(s)
End Function

Private Function ListHeaders(ByVal ws As Worksheet, ByVal headerRow As Long) As String
    Dim lastCol As Long, c As Long, out As String
    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    For c = 1 To lastCol
        Dim h As String
        h = Trim$(CStr(ws.Cells(headerRow, c).Value2))
        If Len(h) > 0 Then out = out & "- " & h & vbCrLf
    Next c
    ListHeaders = out
End Function

Private Function CleanCellText(ByVal v As Variant) As String
    Dim s As String
    s = CStr(v)
    s = Replace(s, vbCr, " ")
    s = Replace(s, vbLf, " ")
    s = Replace(s, ChrW(160), " ")
    Do While InStr(s, "  ") > 0
        s = Replace(s, "  ", " ")
    Loop
    CleanCellText = Trim$(s)
End Function

Private Function NormalizeKey(ByVal s As String) As String
    s = LCase$(CleanCellText(s))
    s = Replace(s, "(", "")
    s = Replace(s, ")", "")
    s = Replace(s, "-", " ")
    Do While InStr(s, "  ") > 0
        s = Replace(s, "  ", " ")
    Loop
    NormalizeKey = Trim$(s)
End Function

Private Function DetectPrefixFromFilenameSmart(ByVal fullPath As String) As String
    Dim fn As String
    fn = Mid$(fullPath, InStrRev(fullPath, "\") + 1)
    fn = UCase$(fn)

    ' Prefer known tokens anywhere in filename
    If InStr(fn, "DTS") > 0 Then DetectPrefixFromFilenameSmart = "DTS": Exit Function
    If InStr(fn, "EPD") > 0 Then DetectPrefixFromFilenameSmart = "EPD": Exit Function
    If InStr(fn, "AN") > 0 Then DetectPrefixFromFilenameSmart = "AN": Exit Function

    DetectPrefixFromFilenameSmart = ""
End Function

Private Function DetectPrefixFromTasks(ByVal ws As Worksheet, ByVal colTaskName As Long) As String
    Dim lastRow As Long, r As Long
    lastRow = ws.Cells(ws.Rows.Count, colTaskName).End(xlUp).Row
    For r = 2 To Application.Min(lastRow, 200)
        Dim t As String
        t = CleanCellText(ws.Cells(r, colTaskName).Value2)
        If InStr(1, t, "Sweep 2 -", vbTextCompare) > 0 Then
            Dim p As Long
            p = InStr(1, t, "Sweep 2 -", vbTextCompare)
            DetectPrefixFromTasks = UCase$(Trim$(Left$(t, p - 1)))
            Exit Function
        End If
    Next r
    DetectPrefixFromTasks = ""
End Function

Private Function PickExcelFile(ByVal prompt As String) As String
    Dim fd As FileDialog
    Set fd = Application.FileDialog(msoFileDialogFilePicker)
    With fd
        .Title = prompt
        .AllowMultiSelect = False
        .Filters.Clear
        .Filters.Add "Excel Files", "*.xlsx;*.xlsm;*.xls"
        If .Show <> -1 Then
            PickExcelFile = ""
        Else
            PickExcelFile = .SelectedItems(1)
        End If
    End With
End Function