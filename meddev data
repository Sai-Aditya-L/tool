Option Explicit

'=========================================================
' MAIN
'=========================================================
Public Sub Import_MedDev_Remediation_v2()

    Dim issuePath As String, taskPath As String
    Dim wbIssue As Workbook, wbTask As Workbook
    Dim wsSrc As Worksheet, wsTgt As Worksheet, wsLog As Worksheet

    Dim hdrRowS As Long, hdrRowT As Long
    Dim cEntity As Long, cPolicy As Long, cQuestions As Long, cPlan As Long, cOwner As Long, cEnd As Long, cQID As Long
    Dim cTaskName As Long, cIssueID As Long, cDesc As Long, cAssigned As Long, cDue As Long

    Dim divisionLabel As String
    divisionLabel = "MedDev"

    Application.ScreenUpdating = False
    Application.EnableEvents = False
    Application.DisplayAlerts = False

    '--- Pick files (ALWAYS ask)
    issuePath = PickExcelFile("Select the ISSUE REPORT workbook (contains sheet: Remediation)")
    If Len(issuePath) = 0 Then GoTo CleanExit

    taskPath = PickExcelFile("Select the REMEDIATION TASK workbook (contains sheet: Sweep 2 Remediation Tasks)")
    If Len(taskPath) = 0 Then GoTo CleanExit

    '--- Open
    Set wbIssue = Workbooks.Open(issuePath, ReadOnly:=True)
    Set wbTask = Workbooks.Open(taskPath)

    '--- Source sheet MUST be Remediation
    Set wsSrc = GetSheetByNameLoose(wbIssue, "Remediation")
    If wsSrc Is Nothing Then
        MsgBox "Source sheet 'Remediation' not found in: " & wbIssue.Name, vbCritical
        GoTo CleanExit
    End If

    '--- Target sheet
    Set wsTgt = GetSheetByNameLoose(wbTask, "Sweep 2 Remediation Tasks")
    If wsTgt Is Nothing Then
        MsgBox "Target sheet 'Sweep 2 Remediation Tasks' not found in: " & wbTask.Name, vbCritical
        GoTo CleanExit
    End If

    '--- Log sheet inside TASK workbook
    Set wsLog = GetOrCreateSheet(wbTask, "Run Log")
    InitLog wsLog
    LogLine wsLog, "INFO", "", "", "Started run."
    LogLine wsLog, "INFO", "", "", "Issue Report: " & wbIssue.Name & " | Sheet: " & wsSrc.Name
    LogLine wsLog, "INFO", "", "", "Remediation Task: " & wbTask.Name & " | Sheet: " & wsTgt.Name

    '=========================================================
    ' MAP SOURCE
    '=========================================================
    hdrRowS = FindHeaderRow(wsSrc, Array("Application/Site Name", "Questions", "Remediation Plan"), 80)
    If hdrRowS = 0 Then
        MsgBox "Could not find required headers in Issue Report > Remediation sheet." & vbCrLf & _
               "Need: Application/Site Name, Questions, Remediation Plan", vbCritical
        GoTo CleanExit
    End If

    cEntity = FindColExact(wsSrc, hdrRowS, "Application/Site Name")

    cPolicy = FindColExact(wsSrc, hdrRowS, "Policy Sub-Domain")
    If cPolicy = 0 Then cPolicy = FindColExact(wsSrc, hdrRowS, "Self Assessment Section")

    cQuestions = FindColExact(wsSrc, hdrRowS, "Questions")
    cPlan = FindColExact(wsSrc, hdrRowS, "Remediation Plan")
    cOwner = FindColExact(wsSrc, hdrRowS, "Owner")
    cEnd = FindColExact(wsSrc, hdrRowS, "Remediation Timing End")
    cQID = FindColExact(wsSrc, hdrRowS, "Question id") 'optional

    If cEntity = 0 Or cPolicy = 0 Or cQuestions = 0 Or cPlan = 0 Then
        MsgBox "Issue Report is missing required columns." & vbCrLf & _
               "Need: Application/Site Name, Policy Sub-Domain (or Self Assessment Section), Questions, Remediation Plan", vbCritical
        GoTo CleanExit
    End If

    LogLine wsLog, "INFO", "", "", "Source header row: " & hdrRowS & _
                   " | Entity col=" & cEntity & ", Policy col=" & cPolicy & _
                   ", Questions col=" & cQuestions & ", Plan col=" & cPlan

    '=========================================================
    ' MAP TARGET
    '=========================================================
    hdrRowT = FindHeaderRow(wsTgt, Array("Remediation Task Name", "Description", "Assigned To"), 80)
    If hdrRowT = 0 Then
        MsgBox "Could not find required headers in Remediation Task sheet.", vbCritical
        GoTo CleanExit
    End If

    cTaskName = FindColExact(wsTgt, hdrRowT, "Remediation Task Name")
    cDesc = FindColExact(wsTgt, hdrRowT, "Description")
    cAssigned = FindColExact(wsTgt, hdrRowT, "Assigned To")

    cIssueID = FindColExact(wsTgt, hdrRowT, "Issue ID") 'optional but expected
    cDue = FindColExact(wsTgt, hdrRowT, "Due Date")
    If cDue = 0 Then cDue = FindColExact(wsTgt, hdrRowT, "Remediation Completion Date")
    If cDue = 0 Then cDue = FindColExact(wsTgt, hdrRowT, "Planned Remediation Completion Date")

    If cTaskName = 0 Or cDesc = 0 Or cAssigned = 0 Or cDue = 0 Then
        MsgBox "Target sheet missing required columns." & vbCrLf & _
               "Need: Remediation Task Name, Description, Assigned To, Due Date (or Remediation Completion Date).", vbCritical
        GoTo CleanExit
    End If

    LogLine wsLog, "INFO", "", "", "Target header row: " & hdrRowT & _
                   " | TaskName col=" & cTaskName & ", Desc col=" & cDesc & _
                   ", Assigned col=" & cAssigned & ", Due col=" & cDue & _
                   ", IssueID col=" & cIssueID

    'Detect division label from FIRST REAL row (not template)
    divisionLabel = DetectDivisionFromTarget_IgnoreTemplates(wsTgt, hdrRowT, cTaskName, divisionLabel)
    LogLine wsLog, "INFO", "", "", "Division label used: " & divisionLabel

    '=========================================================
    ' INDEX EXISTING REAL ROWS (ignore templates!)
    '=========================================================
    Dim existingTasks As Object: Set existingTasks = CreateObject("Scripting.Dictionary")
    Dim issueIdByKey As Object: Set issueIdByKey = CreateObject("Scripting.Dictionary")

    BuildTargetIndexes_IgnoreTemplates wsTgt, hdrRowT, cTaskName, cIssueID, existingTasks, issueIdByKey, wsLog

    '=========================================================
    ' CHOOSE WRITE START ROW:
    ' Prefer first TEMPLATE placeholder row to overwrite.
    ' Otherwise append after last REAL row.
    '=========================================================
    Dim outRow As Long
    outRow = FirstTemplateRow(wsTgt, hdrRowT, cTaskName, cIssueID, cDesc)
    If outRow = 0 Then
        outRow = AppendAfterLastRealRow(wsTgt, hdrRowT, cTaskName)
    End If

    LogLine wsLog, "INFO", "", "", "Writing will start at row: " & outRow

    '=========================================================
    ' PROCESS SOURCE
    '=========================================================
    Dim lastRowS As Long: lastRowS = LastUsedRow(wsSrc)

    Dim written As Long, skipped As Long, scanned As Long
    written = 0: skipped = 0: scanned = 0

    Dim firstWrittenRow As Long: firstWrittenRow = 0
    Dim lastWrittenRow As Long: lastWrittenRow = 0

    Dim r As Long
    For r = hdrRowS + 1 To lastRowS

        Dim entity As String, policy As String, qText As String, plan As String, owner As String
        Dim dueVal As Variant, qid As String

        entity = Trim$(CStr(GetMergedValue(wsSrc.Cells(r, cEntity))))
        policy = Trim$(CStr(GetMergedValue(wsSrc.Cells(r, cPolicy))))
        qText = Trim$(CStr(GetMergedValue(wsSrc.Cells(r, cQuestions))))
        plan = Trim$(CStr(GetMergedValue(wsSrc.Cells(r, cPlan))))

        owner = ""
        If cOwner > 0 Then owner = Trim$(CStr(GetMergedValue(wsSrc.Cells(r, cOwner))))

        dueVal = ""
        If cEnd > 0 Then dueVal = GetMergedValue(wsSrc.Cells(r, cEnd))

        qid = ""
        If cQID > 0 Then qid = Trim$(CStr(GetMergedValue(wsSrc.Cells(r, cQID))))

        'Count rows that look like data rows
        If Len(entity) > 0 Or Len(policy) > 0 Or Len(qText) > 0 Or Len(plan) > 0 Then scanned = scanned + 1

        'Skip empty noise
        If Len(entity) = 0 And Len(policy) = 0 And Len(qText) = 0 And Len(plan) = 0 Then
            skipped = skipped + 1
            GoTo NextR
        End If

        'Optional skip summary-ish QIDs
        If Len(qid) > 0 Then
            Dim qidLower As String: qidLower = LCase$(qid)
            If qidLower = "summary" Or qidLower = "n/a" Or qidLower = "na" Then
                skipped = skipped + 1
                LogLine wsLog, "SKIP", entity, policy, "Row " & r & " skipped due to Question id=" & qid
                GoTo NextR
            End If
        End If

        'Must have these
        If Len(entity) = 0 Or Len(policy) = 0 Or Len(plan) = 0 Then
            skipped = skipped + 1
            LogLine wsLog, "SKIP", entity, policy, "Row " & r & " missing entity/policy/plan"
            GoTo NextR
        End If

        policy = CanonicalPolicySubDomain(policy)
        Dim snippet As String: snippet = MakeQuestionSnippet(qText, 90)

        Dim taskName As String
        taskName = divisionLabel & " Sweep 2 - " & policy & " (" & entity & ")"
        If Len(snippet) > 0 Then taskName = taskName & " - " & snippet

        Dim taskKey As String: taskKey = NormalizeKey(taskName)

        'Avoid duplicates against real tasks we already have OR wrote in this run
        If existingTasks.Exists(taskKey) Then
            skipped = skipped + 1
            LogLine wsLog, "SKIP", entity, policy, "Duplicate task exists: " & Left$(taskName, 140)
            GoTo NextR
        End If

        'If we are currently sitting on template rows, we overwrite them.
        'If we landed on an occupied real row, jump to next empty row.
        outRow = NextWritableRow(wsTgt, outRow, hdrRowT, cTaskName, cIssueID, cDesc)

        'Write outputs
        wsTgt.Cells(outRow, cTaskName).Value = taskName
        wsTgt.Cells(outRow, cDesc).Value = plan                    'Description = Remediation Plan only
        wsTgt.Cells(outRow, cAssigned).Value = owner               'Assigned To = Owner
        WriteDateSmart wsTgt.Cells(outRow, cDue), dueVal            'Due Date = Remediation Timing End

        'Copy Issue ID from existing matching (Entity + Policy)
        If cIssueID > 0 Then
            Dim keyEP As String
            keyEP = NormalizeKey(entity) & "||" & NormalizeKey(policy)
            If issueIdByKey.Exists(keyEP) Then
                wsTgt.Cells(outRow, cIssueID).Value = CStr(issueIdByKey(keyEP))
            End If
        End If

        existingTasks.Add taskKey, True
        written = written + 1

        If firstWrittenRow = 0 Then firstWrittenRow = outRow
        lastWrittenRow = outRow

        LogLine wsLog, "OK", entity, policy, "Wrote row " & outRow

        outRow = outRow + 1

NextR:
    Next r

    LogLine wsLog, "INFO", "", "", "Rows scanned (data-ish): " & scanned
    LogLine wsLog, "INFO", "", "", "Rows written: " & written & " | Rows skipped: " & skipped

    If written = 0 Then
        MsgBox "Run complete, but 0 rows were written." & vbCrLf & _
               "Check 'Run Log' for skip reasons and verify headers in the Issue Report Remediation sheet.", vbExclamation
    Else
        MsgBox "Done!" & vbCrLf & _
               "Rows written: " & written & vbCrLf & _
               "Rows written range: " & firstWrittenRow & " to " & lastWrittenRow & vbCrLf & _
               "See 'Run Log' in the remediation task workbook for details.", vbInformation
    End If

CleanExit:
    On Error Resume Next
    If Not wbIssue Is Nothing Then wbIssue.Close SaveChanges:=False
    Application.DisplayAlerts = True
    Application.EnableEvents = True
    Application.ScreenUpdating = True
End Sub

'=========================================================
' TEMPLATE / REAL ROW DETECTION
'=========================================================
Private Function IsTemplateTaskName(ByVal taskName As String) As Boolean
    Dim t As String: t = LCase$(Trim$(taskName))
    If Len(t) = 0 Then
        IsTemplateTaskName = False
        Exit Function
    End If

    'common placeholders you showed
    If InStr(t, "[division/country]") > 0 Then IsTemplateTaskName = True: Exit Function
    If InStr(t, "[issue name]") > 0 Then IsTemplateTaskName = True: Exit Function
    If InStr(t, "[entity name]") > 0 Then IsTemplateTaskName = True: Exit Function

    'generic placeholder style: lots of [ ... ]
    If InStr(t, "[") > 0 And InStr(t, "]") > 0 Then
        'if it looks like a template sentence, treat as template
        If InStr(t, "sweep") > 0 Then
            IsTemplateTaskName = True
            Exit Function
        End If
    End If

    IsTemplateTaskName = False
End Function

Private Function FirstTemplateRow(ByVal ws As Worksheet, ByVal hdrRow As Long, ByVal cTask As Long, _
                                  ByVal cIssueID As Long, ByVal cDesc As Long) As Long
    Dim lastR As Long: lastR = LastUsedRow(ws)
    Dim r As Long
    For r = hdrRow + 1 To lastR
        Dim tn As String: tn = Trim$(CStr(ws.Cells(r, cTask).Value))
        If IsTemplateTaskName(tn) Then
            'Prefer overwriting template rows that don't have a real Issue ID and are basically blank besides template
            If cIssueID = 0 Or Len(Trim$(CStr(ws.Cells(r, cIssueID).Value))) = 0 Then
                FirstTemplateRow = r
                Exit Function
            End If
        End If
    Next r
    FirstTemplateRow = 0
End Function

Private Function AppendAfterLastRealRow(ByVal ws As Worksheet, ByVal hdrRow As Long, ByVal cTask As Long) As Long
    Dim lastR As Long: lastR = LastUsedRow(ws)
    Dim r As Long
    For r = lastR To hdrRow + 1 Step -1
        Dim tn As String: tn = Trim$(CStr(ws.Cells(r, cTask).Value))
        If Len(tn) > 0 And Not IsTemplateTaskName(tn) Then
            AppendAfterLastRealRow = r + 1
            Exit Function
        End If
    Next r
    AppendAfterLastRealRow = hdrRow + 1
End Function

Private Function NextWritableRow(ByVal ws As Worksheet, ByVal startRow As Long, ByVal hdrRow As Long, _
                                 ByVal cTask As Long, ByVal cIssueID As Long, ByVal cDesc As Long) As Long
    Dim r As Long: r = startRow
    If r <= hdrRow Then r = hdrRow + 1

    Do While True
        Dim tn As String: tn = Trim$(CStr(ws.Cells(r, cTask).Value))

        'Empty row is writable
        If Len(tn) = 0 Then
            NextWritableRow = r
            Exit Function
        End If

        'Template row is writable (we overwrite)
        If IsTemplateTaskName(tn) Then
            NextWritableRow = r
            Exit Function
        End If

        'Otherwise this is a real row, move down
        r = r + 1
    Loop
End Function

'=========================================================
' BUILD TARGET INDEXES (IGNORE TEMPLATES)
'=========================================================
Private Sub BuildTargetIndexes_IgnoreTemplates(ByVal wsTgt As Worksheet, ByVal hdrRowT As Long, _
                                              ByVal cTaskName As Long, ByVal cIssueID As Long, _
                                              ByVal existingTasks As Object, ByVal issueIdByKey As Object, _
                                              ByVal wsLog As Worksheet)

    Dim lastT As Long: lastT = LastUsedRow(wsTgt)
    Dim r As Long

    For r = hdrRowT + 1 To lastT

        Dim tn As String
        tn = Trim$(CStr(wsTgt.Cells(r, cTaskName).Value))
        If Len(tn) = 0 Then GoTo NextR

        'Ignore template rows completely
        If IsTemplateTaskName(tn) Then GoTo NextR

        existingTasks(NormalizeKey(tn)) = True

        If cIssueID > 0 Then
            Dim ent As String, pol As String
            ent = ExtractBetweenParens(tn)
            pol = ExtractPolicyFromTaskName(tn)

            ent = Trim$(ent)
            pol = Trim$(pol)

            If Len(ent) > 0 And Len(pol) > 0 Then
                pol = CanonicalPolicySubDomain(pol)

                Dim iid As String
                iid = Trim$(CStr(wsTgt.Cells(r, cIssueID).Value))
                If Len(iid) > 0 Then
                    Dim keyEP As String
                    keyEP = NormalizeKey(ent) & "||" & NormalizeKey(pol)
                    If Not issueIdByKey.Exists(keyEP) Then issueIdByKey.Add keyEP, iid
                End If
            End If
        End If

NextR:
    Next r

    LogLine wsLog, "INFO", "", "", "Indexed existing REAL tasks: " & existingTasks.Count
    LogLine wsLog, "INFO", "", "", "Indexed Issue IDs by (Entity+Policy): " & issueIdByKey.Count
End Sub

Private Function DetectDivisionFromTarget_IgnoreTemplates(ByVal ws As Worksheet, ByVal hdrRow As Long, _
                                                         ByVal cTask As Long, ByVal fallback As String) As String
    Dim lastR As Long: lastR = LastUsedRow(ws)
    Dim r As Long

    For r = hdrRow + 1 To lastR
        Dim s As String: s = Trim$(CStr(ws.Cells(r, cTask).Value))
        If Len(s) > 0 And Not IsTemplateTaskName(s) Then
            Dim p As Long: p = InStr(1, s, " Sweep 2 -", vbTextCompare)
            If p > 1 Then
                DetectDivisionFromTarget_IgnoreTemplates = Trim$(Left$(s, p - 1))
                Exit Function
            End If
        End If
    Next r

    DetectDivisionFromTarget_IgnoreTemplates = fallback
End Function

'=========================================================
' POLICY NORMALIZATION (MEDDEV REQUIRED CHANGE)
'=========================================================
Private Function CanonicalPolicySubDomain(ByVal pol As String) As String
    Dim t As String
    t = Trim$(CStr(pol))
    Do While InStr(t, "  ") > 0
        t = Replace(t, "  ", " ")
    Loop

    'Rule you mentioned earlier in your environment
    If StrComp(t, "Secure Authentication - MFA", vbTextCompare) = 0 Then
        CanonicalPolicySubDomain = "Multifactor Authentication"
    Else
        CanonicalPolicySubDomain = t
    End If
End Function

'=========================================================
' SNIPPET
'=========================================================
Private Function MakeQuestionSnippet(ByVal q As String, ByVal maxLen As Long) As String
    Dim s As String
    s = Replace(q, vbCrLf, " ")
    s = Replace(s, vbLf, " ")
    s = Replace(s, vbTab, " ")
    s = Application.WorksheetFunction.Trim(s)

    If Len(s) = 0 Then
        MakeQuestionSnippet = ""
    ElseIf Len(s) <= maxLen Then
        MakeQuestionSnippet = s
    Else
        MakeQuestionSnippet = Left$(s, maxLen - 3) & "..."
    End If
End Function

'=========================================================
' TASK NAME PARSING
'=========================================================
Private Function ExtractBetweenParens(ByVal s As String) As String
    Dim p1 As Long, p2 As Long
    p1 = InStrRev(s, "(")
    p2 = InStrRev(s, ")")
    If p1 > 0 And p2 > p1 Then
        ExtractBetweenParens = Mid$(s, p1 + 1, p2 - p1 - 1)
    Else
        ExtractBetweenParens = ""
    End If
End Function

Private Function ExtractPolicyFromTaskName(ByVal s As String) As String
    'expects: "<Division> Sweep 2 - <Policy> (<Entity>) ..."
    Dim lowerS As String: lowerS = LCase$(s)

    Dim p As Long: p = InStr(1, lowerS, "sweep", vbTextCompare)
    If p = 0 Then ExtractPolicyFromTaskName = "": Exit Function

    Dim dash As Long: dash = InStr(p, s, "-")
    If dash = 0 Then ExtractPolicyFromTaskName = "": Exit Function

    Dim startPos As Long: startPos = dash + 1
    Do While startPos <= Len(s) And Mid$(s, startPos, 1) = " "
        startPos = startPos + 1
    Loop

    Dim pParen As Long: pParen = InStr(startPos, s, "(")
    If pParen = 0 Then
        ExtractPolicyFromTaskName = Trim$(Mid$(s, startPos))
    Else
        ExtractPolicyFromTaskName = Trim$(Mid$(s, startPos, pParen - startPos))
    End If
End Function

'=========================================================
' FILE PICKER
'=========================================================
Private Function PickExcelFile(ByVal title As String) As String
    On Error GoTo EH
    Dim fd As FileDialog
    Set fd = Application.FileDialog(msoFileDialogFilePicker)
    With fd
        .Title = title
        .AllowMultiSelect = False
        .Filters.Clear
        .Filters.Add "Excel Files", "*.xlsx;*.xlsm;*.xlsb;*.xls"
        If .Show <> -1 Then
            PickExcelFile = ""
        Else
            PickExcelFile = .SelectedItems(1)
        End If
    End With
    Exit Function
EH:
    PickExcelFile = ""
End Function

'=========================================================
' HEADER FINDERS
'=========================================================
Private Function FindHeaderRow(ByVal ws As Worksheet, ByVal requiredHeaders As Variant, ByVal maxRows As Long) As Long
    Dim r As Long, i As Long
    For r = 1 To maxRows
        For i = LBound(requiredHeaders) To UBound(requiredHeaders)
            If FindColExact(ws, r, CStr(requiredHeaders(i))) = 0 Then GoTo NextR
        Next i
        FindHeaderRow = r
        Exit Function
NextR:
    Next r
    FindHeaderRow = 0
End Function

Private Function FindColExact(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal headerText As String) As Long
    Dim lastC As Long: lastC = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    Dim c As Long
    For c = 1 To lastC
        If StrComp(Trim$(CStr(ws.Cells(headerRow, c).Value)), headerText, vbTextCompare) = 0 Then
            FindColExact = c
            Exit Function
        End If
    Next c
    FindColExact = 0
End Function

'=========================================================
' SHEET HELPERS
'=========================================================
Private Function GetSheetByNameLoose(ByVal wb As Workbook, ByVal desired As String) As Worksheet
    Dim ws As Worksheet
    For Each ws In wb.Worksheets
        If StrComp(Trim$(ws.Name), Trim$(desired), vbTextCompare) = 0 Then
            Set GetSheetByNameLoose = ws
            Exit Function
        End If
    Next ws
    Set GetSheetByNameLoose = Nothing
End Function

Private Function LastUsedRow(ByVal ws As Worksheet) As Long
    On Error GoTo EH
    Dim f As Range
    Set f = ws.Cells.Find(What:="*", After:=ws.Cells(1, 1), LookIn:=xlFormulas, _
                          LookAt:=xlPart, SearchOrder:=xlByRows, SearchDirection:=xlPrevious, _
                          MatchCase:=False)
    If f Is Nothing Then
        LastUsedRow = 1
    Else
        LastUsedRow = f.Row
    End If
    Exit Function
EH:
    LastUsedRow = ws.UsedRange.Rows.Count
End Function

'=========================================================
' MERGED SAFE GET
'=========================================================
Private Function GetMergedValue(ByVal cell As Range) As Variant
    If cell.MergeCells Then
        GetMergedValue = cell.MergeArea.Cells(1, 1).Value
    Else
        GetMergedValue = cell.Value
    End If
End Function

'=========================================================
' NORMALIZE + DATE
'=========================================================
Private Function NormalizeKey(ByVal s As String) As String
    Dim t As String
    t = LCase$(Trim$(CStr(s)))
    t = Replace(t, vbCrLf, " ")
    t = Replace(t, vbCr, " ")
    t = Replace(t, vbLf, " ")
    t = Replace(t, ChrW(160), " ")
    Do While InStr(t, "  ") > 0
        t = Replace(t, "  ", " ")
    Loop
    NormalizeKey = t
End Function

Private Sub WriteDateSmart(ByVal targetCell As Range, ByVal v As Variant)
    If Len(Trim$(CStr(v))) = 0 Then
        targetCell.Value = ""
    ElseIf IsDate(v) Then
        targetCell.Value = CDate(v)
    Else
        targetCell.Value = CStr(v)
    End If
End Sub

'=========================================================
' LOGGING
'=========================================================
Private Function GetOrCreateSheet(ByVal wb As Workbook, ByVal sheetName As String) As Worksheet
    Dim ws As Worksheet
    On Error Resume Next
    Set ws = wb.Worksheets(sheetName)
    On Error GoTo 0
    If ws Is Nothing Then
        Set ws = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))
        ws.Name = sheetName
    End If
    Set GetOrCreateSheet = ws
End Function

Private Sub InitLog(ByVal wsLog As Worksheet)
    wsLog.Cells.Clear
    wsLog.Range("A1:E1").Value = Array("Timestamp", "Status", "Entity", "Policy Sub-Domain", "Message")
    wsLog.Rows(1).Font.Bold = True
    wsLog.Columns("A:E").ColumnWidth = 28
    wsLog.Columns("E").ColumnWidth = 90
End Sub

Private Sub LogLine(ByVal wsLog As Worksheet, ByVal status As String, ByVal entity As String, ByVal policy As String, ByVal msg As String)
    Dim nr As Long
    nr = wsLog.Cells(wsLog.Rows.Count, 1).End(xlUp).Row + 1
    If nr < 2 Then nr = 2
    wsLog.Cells(nr, 1).Value = Now
    wsLog.Cells(nr, 2).Value = status
    wsLog.Cells(nr, 3).Value = entity
    wsLog.Cells(nr, 4).Value = policy
    wsLog.Cells(nr, 5).Value = msg
End Sub