Option Explicit

'=========================================================
' MAIN
'=========================================================
Public Sub Import_MedDev_Remediation_From_IssueReport()

    Dim issuePath As String, taskPath As String
    Dim wbIssue As Workbook, wbTask As Workbook
    Dim wsSrc As Worksheet, wsTgt As Worksheet, wsLog As Worksheet

    Dim hdrRowS As Long, hdrRowT As Long
    Dim cEntity As Long, cPolicy As Long, cQuestions As Long, cPlan As Long, cOwner As Long, cEnd As Long, cQID As Long
    Dim cTaskName As Long, cIssueID As Long, cDesc As Long, cAssigned As Long, cDue As Long

    Dim divisionLabel As String
    divisionLabel = "MedDev" 'default; auto-detected if possible from target sheet

    Application.ScreenUpdating = False
    Application.EnableEvents = False
    Application.DisplayAlerts = False

    '--- Pick files
    issuePath = PickExcelFile("Select the ISSUE REPORT workbook")
    If Len(issuePath) = 0 Then GoTo CleanExit

    taskPath = PickExcelFile("Select the REMEDIATION TASK workbook")
    If Len(taskPath) = 0 Then GoTo CleanExit

    '--- Open
    Set wbIssue = Workbooks.Open(issuePath, ReadOnly:=True)
    Set wbTask = Workbooks.Open(taskPath)

    '--- Source sheet: Remediation (must exist)
    Set wsSrc = GetSheetByNameLoose(wbIssue, "Remediation")
    If wsSrc Is Nothing Then
        MsgBox "Could not find source sheet named 'Remediation' in: " & wbIssue.Name, vbCritical
        GoTo CleanExit
    End If

    '--- Target sheet: Sweep 2 Remediation Tasks (fallback: find by headers)
    Set wsTgt = GetSheetByNameLoose(wbTask, "Sweep 2 Remediation Tasks")
    If wsTgt Is Nothing Then
        Set wsTgt = FindSheetByHeaders(wbTask, Array("Remediation Task Name", "Description", "Assigned To"))
    End If
    If wsTgt Is Nothing Then
        MsgBox "Could not find the target Remediation Task sheet in: " & wbTask.Name, vbCritical
        GoTo CleanExit
    End If

    '--- Log sheet is created INSIDE the remediation task workbook
    Set wsLog = GetOrCreateSheet(wbTask, "Run Log")
    InitLog wsLog
    LogLine wsLog, "INFO", "", "", "Started run."
    LogLine wsLog, "INFO", "", "", "Issue Report: " & wbIssue.Name & " | Sheet: " & wsSrc.Name
    LogLine wsLog, "INFO", "", "", "Remediation Task: " & wbTask.Name & " | Sheet: " & wsTgt.Name

    '=========================================================
    ' FIND SOURCE HEADERS (scan first 50 rows)
    '=========================================================
    hdrRowS = FindHeaderRow(wsSrc, Array("Application/Site Name"), 50)
    If hdrRowS = 0 Then
        MsgBox "Could not find header 'Application/Site Name' in source sheet.", vbCritical
        GoTo CleanExit
    End If

    cEntity = FindColExact(wsSrc, hdrRowS, "Application/Site Name")

    'Policy Sub-Domain is preferred; fallback to Self Assessment Section
    cPolicy = FindColExact(wsSrc, hdrRowS, "Policy Sub-Domain")
    If cPolicy = 0 Then cPolicy = FindColExact(wsSrc, hdrRowS, "Self Assessment Section")

    cQuestions = FindColExact(wsSrc, hdrRowS, "Questions")
    cPlan = FindColExact(wsSrc, hdrRowS, "Remediation Plan")
    cOwner = FindColExact(wsSrc, hdrRowS, "Owner")
    cEnd = FindColExact(wsSrc, hdrRowS, "Remediation Timing End")
    cQID = FindColExact(wsSrc, hdrRowS, "Question id") 'optional

    If cEntity = 0 Or cPolicy = 0 Or cQuestions = 0 Or cPlan = 0 Then
        MsgBox "Source sheet is missing required headers." & vbCrLf & _
               "Need: Application/Site Name, Policy Sub-Domain (or Self Assessment Section), Questions, Remediation Plan.", vbCritical
        GoTo CleanExit
    End If

    '=========================================================
    ' FIND TARGET HEADERS (scan first 50 rows)
    '=========================================================
    hdrRowT = FindHeaderRow(wsTgt, Array("Remediation Task Name", "Description", "Assigned To"), 50)
    If hdrRowT = 0 Then
        MsgBox "Could not find required headers in target sheet.", vbCritical
        GoTo CleanExit
    End If

    cTaskName = FindColExact(wsTgt, hdrRowT, "Remediation Task Name")
    cDesc = FindColExact(wsTgt, hdrRowT, "Description")
    cAssigned = FindColExact(wsTgt, hdrRowT, "Assigned To")

    cIssueID = FindColExact(wsTgt, hdrRowT, "Issue ID") 'may exist
    cDue = FindColExact(wsTgt, hdrRowT, "Due Date")
    If cDue = 0 Then cDue = FindColExact(wsTgt, hdrRowT, "Remediation Completion Date")
    If cDue = 0 Then cDue = FindColExact(wsTgt, hdrRowT, "Planned Remediation Completion Date")

    If cTaskName = 0 Or cDesc = 0 Or cAssigned = 0 Or cDue = 0 Then
        MsgBox "Target sheet missing required headers." & vbCrLf & _
               "Need: Remediation Task Name, Description, Assigned To, Due Date (or Remediation Completion Date).", vbCritical
        GoTo CleanExit
    End If

    'Auto-detect division label from existing tasks if possible
    divisionLabel = DetectDivisionFromTarget(wsTgt, hdrRowT, cTaskName, divisionLabel)

    '=========================================================
    ' BUILD EXISTING INDEX:
    ' 1) Existing full task names (to prevent duplicates)
    ' 2) Existing Issue ID by (Entity + Policy)
    '=========================================================
    Dim existingTasks As Object: Set existingTasks = CreateObject("Scripting.Dictionary")
    Dim issueIdByKey As Object: Set issueIdByKey = CreateObject("Scripting.Dictionary")

    BuildTargetIndexes wsTgt, hdrRowT, cTaskName, cIssueID, existingTasks, issueIdByKey, wsLog

    '=========================================================
    ' PROCESS SOURCE ROWS (handles merged entity cells!)
    '=========================================================
    Dim lastRowS As Long: lastRowS = LastUsedRow(wsSrc)
    Dim outRow As Long: outRow = NextWriteRow(wsTgt, hdrRowT, cTaskName)

    Dim written As Long, skipped As Long, readRows As Long
    written = 0: skipped = 0: readRows = 0

    Dim r As Long
    For r = hdrRowS + 1 To lastRowS

        Dim entity As String, policy As String, qText As String, plan As String, owner As String
        Dim dueVal As Variant, qid As String

        entity = Trim$(CStr(GetMergedValue(wsSrc.Cells(r, cEntity))))
        policy = Trim$(CStr(GetMergedValue(wsSrc.Cells(r, cPolicy))))
        qText = Trim$(CStr(GetMergedValue(wsSrc.Cells(r, cQuestions))))
        plan = Trim$(CStr(GetMergedValue(wsSrc.Cells(r, cPlan))))
        owner = IIf(cOwner > 0, Trim$(CStr(GetMergedValue(wsSrc.Cells(r, cOwner)))), "")
        dueVal = IIf(cEnd > 0, GetMergedValue(wsSrc.Cells(r, cEnd)), "")

        If cQID > 0 Then qid = Trim$(CStr(GetMergedValue(wsSrc.Cells(r, cQID)))) Else qid = ""

        'Count non-empty-ish rows so you can sanity check
        If Len(entity) > 0 Or Len(policy) > 0 Or Len(qText) > 0 Or Len(plan) > 0 Or Len(owner) > 0 Or Len(Trim$(CStr(dueVal))) > 0 Then
            readRows = readRows + 1
        End If

        'Skip header repeats / empty noise
        If Len(entity) = 0 And Len(policy) = 0 And Len(qText) = 0 And Len(plan) = 0 Then
            skipped = skipped + 1
            GoTo NextR
        End If

        'Skip QID Summary/N/A if present
        If Len(qid) > 0 Then
            Dim qidLower As String: qidLower = LCase$(Trim$(qid))
            If qidLower = "summary" Or qidLower = "n/a" Or qidLower = "na" Then
                skipped = skipped + 1
                LogLine wsLog, "SKIP", entity, policy, "Skipped row " & r & " due to Question id=" & qid
                GoTo NextR
            End If
        End If

        'We need these to build task
        If Len(entity) = 0 Or Len(policy) = 0 Or Len(plan) = 0 Then
            skipped = skipped + 1
            LogLine wsLog, "SKIP", entity, policy, "Missing entity/policy/plan on row " & r
            GoTo NextR
        End If

        policy = CanonicalPolicySubDomain(policy)

        Dim snippet As String
        snippet = MakeQuestionSnippet(qText, 85) 'longer, but still readable

        Dim taskName As String
        taskName = divisionLabel & " Sweep 2 - " & policy & " (" & entity & ")"
        If Len(snippet) > 0 Then taskName = taskName & " - " & snippet

        Dim taskKey As String
        taskKey = NormalizeKey(taskName)

        If existingTasks.Exists(taskKey) Then
            skipped = skipped + 1
            LogLine wsLog, "SKIP", entity, policy, "Duplicate task already exists: " & Left$(taskName, 120)
            GoTo NextR
        End If

        'Write new row
        wsTgt.Cells(outRow, cTaskName).Value = taskName
        wsTgt.Cells(outRow, cDesc).Value = plan
        wsTgt.Cells(outRow, cAssigned).Value = owner
        WriteDateSmart wsTgt.Cells(outRow, cDue), dueVal

        'Copy Issue ID from existing matching (Entity+Policy) if available
        If cIssueID > 0 Then
            Dim keyEP As String
            keyEP = NormalizeKey(entity) & "||" & NormalizeKey(policy)

            If issueIdByKey.Exists(keyEP) Then
                wsTgt.Cells(outRow, cIssueID).Value = CStr(issueIdByKey(keyEP))
            End If
        End If

        existingTasks.Add taskKey, True
        written = written + 1
        LogLine wsLog, "OK", entity, policy, "Wrote row " & outRow

        outRow = outRow + 1

NextR:
    Next r

    LogLine wsLog, "INFO", "", "", "Rows scanned (non-empty-ish): " & readRows
    LogLine wsLog, "INFO", "", "", "Rows written: " & written & " | Rows skipped: " & skipped

    MsgBox "Done!" & vbCrLf & _
           "Rows written: " & written & vbCrLf & _
           "Rows skipped: " & skipped & vbCrLf & vbCrLf & _
           "Debug log created in: '" & wbTask.Name & "' sheet 'Run Log'", vbInformation

CleanExit:
    On Error Resume Next
    If Not wbIssue Is Nothing Then wbIssue.Close SaveChanges:=False
    Application.DisplayAlerts = True
    Application.EnableEvents = True
    Application.ScreenUpdating = True
End Sub

'=========================================================
' BUILD TARGET INDEXES
'=========================================================
Private Sub BuildTargetIndexes(ByVal wsTgt As Worksheet, ByVal hdrRowT As Long, _
                              ByVal cTaskName As Long, ByVal cIssueID As Long, _
                              ByVal existingTasks As Object, ByVal issueIdByKey As Object, _
                              ByVal wsLog As Worksheet)

    Dim lastT As Long: lastT = LastUsedRow(wsTgt)
    Dim r As Long

    For r = hdrRowT + 1 To lastT

        Dim tn As String
        tn = Trim$(CStr(wsTgt.Cells(r, cTaskName).Value))
        If Len(tn) = 0 Then GoTo NextR

        existingTasks(NormalizeKey(tn)) = True

        If cIssueID > 0 Then
            Dim ent As String, pol As String
            ent = ExtractBetweenParens(tn)
            pol = ExtractPolicyFromTaskName(tn)

            ent = Trim$(ent)
            pol = Trim$(pol)

            If Len(ent) > 0 And Len(pol) > 0 Then
                pol = CanonicalPolicySubDomain(pol)

                Dim keyEP As String
                keyEP = NormalizeKey(ent) & "||" & NormalizeKey(pol)

                Dim iid As String
                iid = Trim$(CStr(wsTgt.Cells(r, cIssueID).Value))

                If Len(iid) > 0 Then
                    If Not issueIdByKey.Exists(keyEP) Then
                        issueIdByKey.Add keyEP, iid
                    End If
                End If
            End If
        End If

NextR:
    Next r

    LogLine wsLog, "INFO", "", "", "Indexed existing tasks: " & existingTasks.Count
    LogLine wsLog, "INFO", "", "", "Indexed Issue IDs by (Entity+Policy): " & issueIdByKey.Count
End Sub

'=========================================================
' POLICY NORMALIZATION (MEDDEV REQUIRED CHANGE)
'=========================================================
Private Function CanonicalPolicySubDomain(ByVal pol As String) As String
    Dim t As String
    t = Trim$(CStr(pol))
    Do While InStr(t, "  ") > 0
        t = Replace(t, "  ", " ")
    Loop

    'MEDDEV rule: "Secure Authentication - MFA" => "Multifactor Authentication" (in remediation task sheet)
    If StrComp(t, "Secure Authentication - MFA", vbTextCompare) = 0 Then
        CanonicalPolicySubDomain = "Multifactor Authentication"
    Else
        CanonicalPolicySubDomain = t
    End If
End Function

'=========================================================
' SNIPPET
'=========================================================
Private Function MakeQuestionSnippet(ByVal q As String, ByVal maxLen As Long) As String
    Dim s As String
    s = Replace(q, vbCrLf, " ")
    s = Replace(s, vbLf, " ")
    s = Replace(s, vbTab, " ")
    s = Application.WorksheetFunction.Trim(s)

    If Len(s) = 0 Then
        MakeQuestionSnippet = ""
    ElseIf Len(s) <= maxLen Then
        MakeQuestionSnippet = s
    Else
        MakeQuestionSnippet = Left$(s, maxLen - 3) & "..."
    End If
End Function

'=========================================================
' TASK NAME PARSING (TARGET)
'=========================================================
Private Function ExtractBetweenParens(ByVal s As String) As String
    Dim p1 As Long, p2 As Long
    p1 = InStrRev(s, "(")
    p2 = InStrRev(s, ")")
    If p1 > 0 And p2 > p1 Then
        ExtractBetweenParens = Mid$(s, p1 + 1, p2 - p1 - 1)
    Else
        ExtractBetweenParens = ""
    End If
End Function

Private Function ExtractPolicyFromTaskName(ByVal s As String) As String
    'expects: "<Division> Sweep 2 - <Policy> (<Entity>) ..."
    Dim lowerS As String: lowerS = LCase$(s)

    Dim p As Long: p = InStr(1, lowerS, "sweep", vbTextCompare)
    If p = 0 Then ExtractPolicyFromTaskName = "": Exit Function

    Dim p2 As Long: p2 = InStr(p, lowerS, "2", vbTextCompare)
    If p2 = 0 Then ExtractPolicyFromTaskName = "": Exit Function

    Dim dash As Long: dash = InStr(p2, lowerS, "-", vbTextCompare)
    If dash = 0 Then ExtractPolicyFromTaskName = "": Exit Function

    Dim startPos As Long: startPos = dash + 1
    Do While startPos <= Len(s) And Mid$(s, startPos, 1) = " "
        startPos = startPos + 1
    Loop

    Dim pParen As Long: pParen = InStr(startPos, s, "(")
    If pParen = 0 Then
        ExtractPolicyFromTaskName = Trim$(Mid$(s, startPos))
    Else
        ExtractPolicyFromTaskName = Trim$(Mid$(s, startPos, pParen - startPos))
    End If
End Function

'=========================================================
' FILE PICKER
'=========================================================
Private Function PickExcelFile(ByVal title As String) As String
    On Error GoTo EH
    Dim fd As FileDialog
    Set fd = Application.FileDialog(msoFileDialogFilePicker)
    With fd
        .Title = title
        .AllowMultiSelect = False
        .Filters.Clear
        .Filters.Add "Excel Files", "*.xlsx;*.xlsm;*.xlsb;*.xls"
        If .Show <> -1 Then
            PickExcelFile = ""
        Else
            PickExcelFile = .SelectedItems(1)
        End If
    End With
    Exit Function
EH:
    PickExcelFile = ""
End Function

'=========================================================
' HEADER FINDERS
'=========================================================
Private Function FindHeaderRow(ByVal ws As Worksheet, ByVal requiredHeaders As Variant, ByVal maxRows As Long) As Long
    Dim r As Long, i As Long
    For r = 1 To maxRows
        For i = LBound(requiredHeaders) To UBound(requiredHeaders)
            If FindColExact(ws, r, CStr(requiredHeaders(i))) = 0 Then GoTo NextR
        Next i
        FindHeaderRow = r
        Exit Function
NextR:
    Next r
    FindHeaderRow = 0
End Function

Private Function FindColExact(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal headerText As String) As Long
    Dim lastC As Long: lastC = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    Dim c As Long
    For c = 1 To lastC
        If StrComp(Trim$(CStr(ws.Cells(headerRow, c).Value)), headerText, vbTextCompare) = 0 Then
            FindColExact = c
            Exit Function
        End If
    Next c
    FindColExact = 0
End Function

'=========================================================
' SHEET HELPERS
'=========================================================
Private Function GetSheetByNameLoose(ByVal wb As Workbook, ByVal desired As String) As Worksheet
    Dim ws As Worksheet
    For Each ws In wb.Worksheets
        If StrComp(Trim$(ws.Name), Trim$(desired), vbTextCompare) = 0 Then
            Set GetSheetByNameLoose = ws
            Exit Function
        End If
    Next ws
    Set GetSheetByNameLoose = Nothing
End Function

Private Function FindSheetByHeaders(ByVal wb As Workbook, ByVal headers As Variant) As Worksheet
    Dim ws As Worksheet, i As Long, ok As Boolean
    For Each ws In wb.Worksheets
        ok = True
        For i = LBound(headers) To UBound(headers)
            If FindHeaderRow(ws, Array(CStr(headers(i))), 30) = 0 Then
                ok = False
                Exit For
            End If
        Next i
        If ok Then
            Set FindSheetByHeaders = ws
            Exit Function
        End If
    Next ws
    Set FindSheetByHeaders = Nothing
End Function

Private Function NextWriteRow(ByVal ws As Worksheet, ByVal hdrRow As Long, ByVal colAnchor As Long) As Long
    Dim r As Long
    r = ws.Cells(ws.Rows.Count, colAnchor).End(xlUp).Row + 1
    If r <= hdrRow Then r = hdrRow + 1
    NextWriteRow = r
End Function

Private Function LastUsedRow(ByVal ws As Worksheet) As Long
    On Error GoTo EH
    Dim f As Range
    Set f = ws.Cells.Find(What:="*", After:=ws.Cells(1, 1), LookIn:=xlFormulas, _
                          LookAt:=xlPart, SearchOrder:=xlByRows, SearchDirection:=xlPrevious, _
                          MatchCase:=False)
    If f Is Nothing Then
        LastUsedRow = 1
    Else
        LastUsedRow = f.Row
    End If
    Exit Function
EH:
    LastUsedRow = ws.UsedRange.Rows.Count
End Function

'=========================================================
' MERGED SAFE GET
'=========================================================
Private Function GetMergedValue(ByVal cell As Range) As Variant
    If cell.MergeCells Then
        GetMergedValue = cell.MergeArea.Cells(1, 1).Value
    Else
        GetMergedValue = cell.Value
    End If
End Function

'=========================================================
' NORMALIZE + DATE
'=========================================================
Private Function NormalizeKey(ByVal s As String) As String
    Dim t As String
    t = LCase$(Trim$(CStr(s)))
    t = Replace(t, vbCrLf, " ")
    t = Replace(t, vbCr, " ")
    t = Replace(t, vbLf, " ")
    t = Replace(t, ChrW(160), " ")
    Do While InStr(t, "  ") > 0
        t = Replace(t, "  ", " ")
    Loop
    NormalizeKey = t
End Function

Private Sub WriteDateSmart(ByVal targetCell As Range, ByVal v As Variant)
    If Len(Trim$(CStr(v))) = 0 Then
        targetCell.Value = ""
    ElseIf IsDate(v) Then
        targetCell.Value = CDate(v)
    Else
        targetCell.Value = CStr(v)
    End If
End Sub

'=========================================================
' DIVISION DETECTOR
'=========================================================
Private Function DetectDivisionFromTarget(ByVal ws As Worksheet, ByVal hdrRow As Long, ByVal cTask As Long, ByVal fallback As String) As String
    Dim lastR As Long: lastR = LastUsedRow(ws)
    Dim r As Long

    For r = hdrRow + 1 To lastR
        Dim s As String: s = Trim$(CStr(ws.Cells(r, cTask).Value))
        If Len(s) > 0 Then
            Dim p As Long: p = InStr(1, s, " Sweep 2 -", vbTextCompare)
            If p > 1 Then
                DetectDivisionFromTarget = Trim$(Left$(s, p - 1))
                Exit Function
            End If
        End If
    Next r

    DetectDivisionFromTarget = fallback
End Function

'=========================================================
' LOGGING (created in Remediation Task workbook)
'=========================================================
Private Function GetOrCreateSheet(ByVal wb As Workbook, ByVal sheetName As String) As Worksheet
    Dim ws As Worksheet
    On Error Resume Next
    Set ws = wb.Worksheets(sheetName)
    On Error GoTo 0
    If ws Is Nothing Then
        Set ws = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))
        ws.Name = sheetName
    End If
    Set GetOrCreateSheet = ws
End Function

Private Sub InitLog(ByVal wsLog As Worksheet)
    wsLog.Cells.Clear
    wsLog.Range("A1:E1").Value = Array("Timestamp", "Status", "Entity", "Policy Sub-Domain", "Message")
    wsLog.Rows(1).Font.Bold = True
    wsLog.Columns("A:E").ColumnWidth = 28
    wsLog.Columns("E").ColumnWidth = 80
End Sub

Private Sub LogLine(ByVal wsLog As Worksheet, ByVal status As String, ByVal entity As String, ByVal policy As String, ByVal msg As String)
    Dim nr As Long
    nr = wsLog.Cells(wsLog.Rows.Count, 1).End(xlUp).Row + 1
    If nr < 2 Then nr = 2
    wsLog.Cells(nr, 1).Value = Now
    wsLog.Cells(nr, 2).Value = status
    wsLog.Cells(nr, 3).Value = entity
    wsLog.Cells(nr, 4).Value = policy
    wsLog.Cells(nr, 5).Value = msg
End Sub