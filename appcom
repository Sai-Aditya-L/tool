Option Explicit

'=========================================================
' MAIN
'=========================================================
Public Sub Build_QuestionID_Compliance_Matrix_FromFolder()

    Dim folderPath As String, fileName As String, fullPath As String
    Dim wb As Workbook, ws As Worksheet
    Dim outWs As Worksheet, logWs As Worksheet

    'Template layout
    Const LABEL_COL As Long = 8        'H
    Const APP_START_COL As Long = 9    'I
    Const HEADER_ROW As Long = 3       'Row 3
    Const DATA_START_ROW As Long = 7   'Row 7

    'Output layout
    Const OUT_META_COLS As Long = 5    'A:E reserved for app-level fields
    Const OUT_HDR_ROWS As Long = 5     'Row1..Row5 header area for Question metadata
                                      'Row1: Question ID
                                      'Row2: Policy Sub-Domain
                                      'Row3: Matching Control Standard
                                      'Row4: Self Assessment Section Header
                                      'Row5: Control Group
    Const OUT_FIRST_DATA_ROW As Long = 6 'Data begins at row 6

    Dim dictQ As Object, dictQCol As Object
    Dim qCount As Long

    'Pass variables
    Dim lastAppCol As Long, appCol As Long, lastRow As Long, r As Long
    Dim colQID As Long, colPolSub As Long, colMatchStd As Long, colSelfHdr As Long
    Dim colCtrlGrp As Long 'this is the "Control Group" value column (H per your description)

    Dim itFunc As String, appName As String, appId As String, dataClass As String, daiId As String
    Dim qid As String, polSub As String, matchStd As String, selfHdr As String, ctrlGrp As String
    Dim rawResp As String, yn As String

    'Pick folder (safe)
    folderPath = PickFolderSafe()
    If Len(folderPath) = 0 Then Exit Sub
    If Right$(folderPath, 1) <> "\" Then folderPath = folderPath & "\"

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.EnableEvents = False

    Set outWs = GetOrCreateSheetSafe(ThisWorkbook, "QuestionID Matrix", True)
    Set logWs = GetOrCreateSheetSafe(ThisWorkbook, "Log", True)
    InitLog logWs

    'Dictionaries
    Set dictQ = CreateObject("Scripting.Dictionary")     'qid -> Array(polSub, matchStd, selfHdr, ctrlGrp)
    Set dictQCol = CreateObject("Scripting.Dictionary")  'qid -> output column index (F=6 and onward)

    '========================
    ' PASS 1: collect all unique Question IDs + metadata
    '========================
    fileName = Dir(folderPath & "*.xls*")
    Do While Len(fileName) > 0

        fullPath = folderPath & fileName

        If StrComp(fullPath, ThisWorkbook.FullName, vbTextCompare) <> 0 Then

            On Error GoTo Pass1Error
            Set wb = Workbooks.Open(Filename:=fullPath, ReadOnly:=True, UpdateLinks:=False)

            Set ws = GetTemplateSheetAnyName(wb)
            If ws Is Nothing Then
                LogLine logWs, fileName, "Skipped", "Template sheet not found."
                GoTo Pass1Close
            End If

            'Find headers within A3:G3 (A..G = 1..7)
            colQID = FindHeaderInRow(ws, HEADER_ROW, "Question ID", 1, 7)
            If colQID = 0 Then colQID = FindHeaderInRow(ws, HEADER_ROW, "QuestionID", 1, 7)

            colPolSub = FindHeaderInRow(ws, HEADER_ROW, "Policy Sub-Domain", 1, 7)
            colMatchStd = FindHeaderInRow(ws, HEADER_ROW, "Matching Control Standard", 1, 7)
            colSelfHdr = FindHeaderInRow(ws, HEADER_ROW, "Self Assessment Section Header", 1, 7)

            colCtrlGrp = LABEL_COL 'H column contains control group values starting H7 down (your rule)

            If colQID = 0 Then
                LogLine logWs, fileName, "Skipped", "Could not find 'Question ID' in A3:G3."
                GoTo Pass1Close
            End If

            lastRow = ws.Cells(ws.Rows.Count, colQID).End(xlUp).Row
            If lastRow < DATA_START_ROW Then
                LogLine logWs, fileName, "Skipped", "No question rows found (expected row 7+)."
                GoTo Pass1Close
            End If

            For r = DATA_START_ROW To lastRow
                qid = Trim$(ws.Cells(r, colQID).Text)
                If Len(qid) = 0 Then GoTo NextR1

                polSub = IIf(colPolSub = 0, "", Trim$(ws.Cells(r, colPolSub).Text))
                matchStd = IIf(colMatchStd = 0, "", Trim$(ws.Cells(r, colMatchStd).Text))
                selfHdr = IIf(colSelfHdr = 0, "", Trim$(ws.Cells(r, colSelfHdr).Text))
                ctrlGrp = Trim$(ws.Cells(r, colCtrlGrp).Text)

                If Not dictQ.Exists(qid) Then
                    dictQ.Add qid, Array(polSub, matchStd, selfHdr, ctrlGrp)
                End If

NextR1:
            Next r

Pass1Close:
            On Error Resume Next
            wb.Close SaveChanges:=False
            On Error GoTo 0
            Set ws = Nothing
            Set wb = Nothing
        End If

        fileName = Dir()
        DoEvents
    Loop

    If dictQ.Count = 0 Then
        MsgBox "No Question IDs found. Check that files contain the expected sheet/layout.", vbExclamation
        GoTo SafeExit
    End If

    '========================
    ' Write output headers (matrix)
    '========================
    outWs.Cells.Clear

    'App-level columns A:E
    outWs.Cells(1, 1).Value = "IT Function"
    outWs.Cells(1, 2).Value = "Application/Site Name"
    outWs.Cells(1, 3).Value = "App ID"
    outWs.Cells(1, 4).Value = "Data Class"
    outWs.Cells(1, 5).Value = "DAI ID"

    'Sub headers labels on left (optional)
    outWs.Cells(2, 1).Value = ""
    outWs.Cells(3, 1).Value = ""
    outWs.Cells(4, 1).Value = ""
    outWs.Cells(5, 1).Value = ""

    'Question columns start at F
    Dim qKeys As Variant, i As Long, outCol As Long, meta As Variant
    qKeys = dictQ.Keys

    'Sort question IDs (optional, stable output)
    QuickSortStrings qKeys, LBound(qKeys), UBound(qKeys)

    outCol = OUT_META_COLS + 1 'F
    For i = LBound(qKeys) To UBound(qKeys)
        qid = CStr(qKeys(i))
        meta = dictQ(qid)

        dictQCol(qid) = outCol

        outWs.Cells(1, outCol).Value = qid                 'Row1: Question ID
        outWs.Cells(2, outCol).Value = meta(0)             'Row2: Policy Sub-Domain
        outWs.Cells(3, outCol).Value = meta(1)             'Row3: Matching Control Standard
        outWs.Cells(4, outCol).Value = meta(2)             'Row4: Self Assessment Section Header
        outWs.Cells(5, outCol).Value = meta(3)             'Row5: Control Group

        outCol = outCol + 1
    Next i

    'Format header rows
    With outWs.Range(outWs.Cells(1, 1), outWs.Cells(OUT_HDR_ROWS, outCol - 1))
        .Font.Bold = True
        .WrapText = True
        .VerticalAlignment = xlVAlignTop
    End With

    'Freeze panes below header
    outWs.Activate
    outWs.Range("A6").Select
    ActiveWindow.FreezePanes = True

    '========================
    ' PASS 2: write app rows + Y/N matrix by Question ID
    '========================
    Dim outRow As Long
    outRow = OUT_FIRST_DATA_ROW

    fileName = Dir(folderPath & "*.xls*")
    Do While Len(fileName) > 0

        fullPath = folderPath & fileName

        If StrComp(fullPath, ThisWorkbook.FullName, vbTextCompare) <> 0 Then

            On Error GoTo Pass2Error
            Set wb = Workbooks.Open(Filename:=fullPath, ReadOnly:=True, UpdateLinks:=False)

            Set ws = GetTemplateSheetAnyName(wb)
            If ws Is Nothing Then
                LogLine logWs, fileName, "Skipped", "Template sheet not found."
                GoTo Pass2Close
            End If

            'Find columns again
            colQID = FindHeaderInRow(ws, HEADER_ROW, "Question ID", 1, 7)
            If colQID = 0 Then colQID = FindHeaderInRow(ws, HEADER_ROW, "QuestionID", 1, 7)
            colPolSub = FindHeaderInRow(ws, HEADER_ROW, "Policy Sub-Domain", 1, 7)
            colMatchStd = FindHeaderInRow(ws, HEADER_ROW, "Matching Control Standard", 1, 7)
            colSelfHdr = FindHeaderInRow(ws, HEADER_ROW, "Self Assessment Section Header", 1, 7)
            colCtrlGrp = LABEL_COL

            If colQID = 0 Then
                LogLine logWs, fileName, "Skipped", "Could not find 'Question ID' in A3:G3."
                GoTo Pass2Close
            End If

            lastRow = ws.Cells(ws.Rows.Count, colQID).End(xlUp).Row
            If lastRow < DATA_START_ROW Then
                LogLine logWs, fileName, "Skipped", "No question rows found (expected row 7+)."
                GoTo Pass2Close
            End If

            lastAppCol = ws.Cells(2, ws.Columns.Count).End(xlToLeft).Column
            If lastAppCol < APP_START_COL Then
                LogLine logWs, fileName, "Skipped", "No app columns found to the right of H."
                GoTo Pass2Close
            End If

            For appCol = APP_START_COL To lastAppCol

                appName = Trim$(ws.Cells(2, appCol).Text)
                itFunc = Trim$(ws.Cells(1, appCol).Text)
                If Len(appName) = 0 And Len(itFunc) = 0 Then GoTo NextApp2

                appId = Trim$(ws.Cells(4, appCol).Text)
                dataClass = Trim$(ws.Cells(5, appCol).Text)
                daiId = Trim$(ws.Cells(6, appCol).Text)

                'Write app row metadata
                outWs.Cells(outRow, 1).Value = itFunc
                outWs.Cells(outRow, 2).Value = appName
                outWs.Cells(outRow, 3).Value = appId
                outWs.Cells(outRow, 4).Value = dataClass
                outWs.Cells(outRow, 5).Value = daiId

                'Fill Y/N for question ids that exist in this file
                For r = DATA_START_ROW To lastRow
                    qid = Trim$(ws.Cells(r, colQID).Text)
                    If Len(qid) = 0 Then GoTo NextR2
                    If Not dictQCol.Exists(qid) Then GoTo NextR2

                    rawResp = Trim$(ws.Cells(r, appCol).Text)
                    yn = Normalize_YNRNA_to_Y_BlankToN(rawResp)

                    outWs.Cells(outRow, CLng(dictQCol(qid))).Value = yn
NextR2:
                Next r

                outRow = outRow + 1
NextApp2:
            Next appCol

            LogLine logWs, fileName, "OK", "Processed."

Pass2Close:
            On Error Resume Next
            wb.Close SaveChanges:=False
            On Error GoTo 0
            Set ws = Nothing
            Set wb = Nothing
        End If

        fileName = Dir()
        DoEvents
    Loop

    '========================
    ' Formatting to match your image (green Y)
    '========================
    ApplyYNFormatting outWs, OUT_FIRST_DATA_ROW, outRow - 1, OUT_META_COLS + 1, outCol - 1

    outWs.Columns.AutoFit

    MsgBox "Done. Output is in 'QuestionID Matrix'.", vbInformation

SafeExit:
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    Application.EnableEvents = True
    Exit Sub

'---- Error handlers
Pass1Error:
    LogLine logWs, fileName, "Error", "Pass1: " & Err.Description
    On Error Resume Next
    If Not wb Is Nothing Then wb.Close SaveChanges:=False
    On Error GoTo 0
    Resume Next

Pass2Error:
    LogLine logWs, fileName, "Error", "Pass2: " & Err.Description
    On Error Resume Next
    If Not wb Is Nothing Then wb.Close SaveChanges:=False
    On Error GoTo 0
    Resume Next

End Sub


'=========================================================
' Normalization:
' Any Y, N/A, N/R => Y
' Any N, blank, Not Answered => N
'=========================================================
Private Function Normalize_YNRNA_to_Y_BlankToN(ByVal raw As String) As String
    Dim s As String
    s = LCase$(Trim$(raw))
    s = Replace(s, vbCr, "")
    s = Replace(s, vbLf, "")
    s = Replace(s, " ", "")

    If Len(s) = 0 Then Normalize_YNRNA_to_Y_BlankToN = "N": Exit Function
    If s = "notanswered" Or s = "notanswer" Then Normalize_YNRNA_to_Y_BlankToN = "N": Exit Function

    If s = "y" Or s = "yes" Then Normalize_YNRNA_to_Y_BlankToN = "Y": Exit Function
    If s = "n" Or s = "no" Then Normalize_YNRNA_to_Y_BlankToN = "N": Exit Function

    If s = "na" Or s = "n/a" Or s = "n-a" Then Normalize_YNRNA_to_Y_BlankToN = "Y": Exit Function
    If s = "nr" Or s = "n/r" Or s = "n-r" Then Normalize_YNRNA_to_Y_BlankToN = "Y": Exit Function

    'Anything unknown -> N (safe)
    Normalize_YNRNA_to_Y_BlankToN = "N"
End Function


'=========================================================
' Find the template sheet (tries common variants)
'=========================================================
Private Function GetTemplateSheetAnyName(ByVal wb As Workbook) As Worksheet
    Dim nm As Variant
    For Each nm In Array( _
        "OutputTemplate- Power BI Upload", _
        "OutputTemplate-Power BI Upload", _
        "outputTemplate-Power BI Upload", _
        "outputTemplate- Power BI Upload", _
        "outputTemplate -Power BI Upload", _
        "outputTemplate - Power BI Upload" _
    )
        On Error Resume Next
        Set GetTemplateSheetAnyName = wb.Worksheets(CStr(nm))
        On Error GoTo 0
        If Not GetTemplateSheetAnyName Is Nothing Then Exit Function
    Next nm
    Set GetTemplateSheetAnyName = Nothing
End Function


'=========================================================
' Header finder (row 3, columns A..G)
'=========================================================
Private Function FindHeaderInRow(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal headerText As String, _
                                 ByVal startCol As Long, ByVal endCol As Long) As Long
    Dim c As Long
    For c = startCol To endCol
        If Canonical(ws.Cells(headerRow, c).Text) = Canonical(headerText) Then
            FindHeaderInRow = c
            Exit Function
        End If
    Next c
    FindHeaderInRow = 0
End Function

Private Function Canonical(ByVal s As String) As String
    Dim i As Long, ch As String, out As String
    s = LCase$(Trim$(s))
    out = ""
    For i = 1 To Len(s)
        ch = Mid$(s, i, 1)
        If (ch >= "a" And ch <= "z") Or (ch >= "0" And ch <= "9") Then out = out & ch
    Next i
    Canonical = out
End Function


'=========================================================
' Folder picker (safe): FileDialog fallback to InputBox
'=========================================================
Private Function PickFolderSafe() As String
    On Error GoTo Fallback
    Dim fd As FileDialog
    Set fd = Application.FileDialog(msoFileDialogFolderPicker)
    fd.Title = "Select folder containing Excel files"
    If fd.Show = -1 Then
        PickFolderSafe = fd.SelectedItems(1)
    Else
        PickFolderSafe = ""
    End If
    Exit Function
Fallback:
    PickFolderSafe = InputBox("Paste the full folder path that contains the Excel files:", "Folder Path")
End Function


'=========================================================
' Output sheet creator (safe)
'=========================================================
Private Function GetOrCreateSheetSafe(ByVal wb As Workbook, ByVal sheetName As String, ByVal clearIfExists As Boolean) As Worksheet
    Dim ws As Worksheet
    On Error Resume Next
    Set ws = wb.Worksheets(sheetName)
    On Error GoTo 0

    If ws Is Nothing Then
        Set ws = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))
        ws.Name = sheetName
    ElseIf clearIfExists Then
        On Error Resume Next
        ws.Cells.Clear
        If Err.Number <> 0 Then
            Err.Clear
            Set ws = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))
            ws.Name = sheetName & " " & Format(Now, "hhmmss")
        End If
        On Error GoTo 0
    End If

    Set GetOrCreateSheetSafe = ws
End Function


'=========================================================
' Logging
'=========================================================
Private Sub InitLog(ByVal logWs As Worksheet)
    logWs.Cells.Clear
    logWs.Cells(1, 1).Value = "File"
    logWs.Cells(1, 2).Value = "Status"
    logWs.Cells(1, 3).Value = "Notes"
    logWs.Rows(1).Font.Bold = True
End Sub

Private Sub LogLine(ByVal logWs As Worksheet, ByVal fileName As String, ByVal status As String, ByVal notes As String)
    Dim lr As Long
    lr = logWs.Cells(logWs.Rows.Count, "A").End(xlUp).Row + 1
    logWs.Cells(lr, 1).Value = fileName
    logWs.Cells(lr, 2).Value = status
    logWs.Cells(lr, 3).Value = notes
End Sub


'=========================================================
' Conditional formatting for Y/N matrix (green Y like your image)
'=========================================================
Private Sub ApplyYNFormatting(ByVal ws As Worksheet, ByVal firstRow As Long, ByVal lastRow As Long, _
                             ByVal firstCol As Long, ByVal lastCol As Long)

    If lastRow < firstRow Or lastCol < firstCol Then Exit Sub

    Dim rng As Range
    Set rng = ws.Range(ws.Cells(firstRow, firstCol), ws.Cells(lastRow, lastCol))
    rng.FormatConditions.Delete

    'Y => green
    With rng.FormatConditions.Add(Type:=xlCellValue, Operator:=xlEqual, Formula1:="=""Y""")
        .Interior.Color = RGB(0, 176, 80)
        .Font.Color = RGB(255, 255, 255)
        .Font.Bold = True
    End With

    'N => white (no fill)
    With rng.FormatConditions.Add(Type:=xlCellValue, Operator:=xlEqual, Formula1:="=""N""")
        .Interior.Color = RGB(255, 255, 255)
        .Font.Color = RGB(0, 0, 0)
    End With

End Sub


'=========================================================
' QuickSort for string array (Question IDs)
'=========================================================
Private Sub QuickSortStrings(arr As Variant, ByVal first As Long, ByVal last As Long)
    Dim i As Long, j As Long
    Dim pivot As String, tmp As Variant

    i = first
    j = last
    pivot = CStr(arr((first + last) \ 2))

    Do While i <= j
        Do While CStr(arr(i)) < pivot
            i = i + 1
        Loop
        Do While CStr(arr(j)) > pivot
            j = j - 1
        Loop
        If i <= j Then
            tmp = arr(i)
            arr(i) = arr(j)
            arr(j) = tmp
            i = i + 1
            j = j - 1
        End If
    Loop

    If first < j Then QuickSortStrings arr, first, j
    If i < last Then QuickSortStrings arr, i, last
End Sub