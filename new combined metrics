Option Explicit

'=========================================================
' Main
'=========================================================
Public Sub Build_CombinedMetrics_FromFolder_NoComments()

    Const TARGET_SHEET As String = "OutputTemplate- Power BI Upload"
    Const HEADER_ROW As Long = 3
    Const QUESTION_START_ROW As Long = 7
    Const APP_FIRST_COL As Long = 8 'H

    Dim metricHeaders As Variant
    metricHeaders = Array( _
        "Access Control", _
        "Configuration Management", _
        "Cryptographic Protection", _
        "Network Security", _
        "Non-Prod Environment Controls", _
        "Protection of Systems and Communications", _
        "Secure Authentication", _
        "System Logging & Monitoring", _
        "System Security Testing", _
        "Vulnerability management & Scanning", _
        "Disaster Recovery" _
    )

    Dim folderPath As String, fileName As String, fullPath As String
    Dim wb As Workbook, ws As Worksheet
    Dim outWs As Worksheet, logWs As Worksheet
    Dim outRow As Long

    Dim polSubCol As Long, qidCol As Long, lastRow As Long
    Dim respCol As Long, lastCol As Long
    Dim m As Long

    Dim itFunc As String, appName As String, dataClass As String
    Dim appId As String, daiId As String, numAsset As String

    'Pick folder
    folderPath = PickFolder()
    If Len(folderPath) = 0 Then Exit Sub
    If Right$(folderPath, 1) <> "\" Then folderPath = folderPath & "\"

    'App settings
    Dim prevScreenUpdating As Boolean, prevAlerts As Boolean, prevEvents As Boolean
    prevScreenUpdating = Application.ScreenUpdating
    prevAlerts = Application.DisplayAlerts
    prevEvents = Application.EnableEvents

    On Error GoTo FatalError
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.EnableEvents = False

    'Output sheets
    Set outWs = GetOrCreateSheet(ThisWorkbook, "Combined Metrics")
    Set logWs = GetOrCreateSheet(ThisWorkbook, "Log")
    outWs.Cells.Clear
    logWs.Cells.Clear

    'Headers
    outWs.Cells(1, 1).Value = "IT Function"
    outWs.Cells(1, 2).Value = "Application/Site Name"
    outWs.Cells(1, 3).Value = "data class"
    outWs.Cells(1, 4).Value = "Number of Asset"

    For m = LBound(metricHeaders) To UBound(metricHeaders)
        outWs.Cells(1, 5 + m).Value = metricHeaders(m)
    Next m

    'Hidden helper cols
    Dim hiddenStartCol As Long
    hiddenStartCol = 5 + UBound(metricHeaders) + 1
    outWs.Cells(1, hiddenStartCol).Value = "App ID"
    outWs.Cells(1, hiddenStartCol + 1).Value = "DAI ID"
    outWs.Cells(1, hiddenStartCol + 2).Value = "Source File"

    outWs.Rows(1).Font.Bold = True
    outWs.Columns.NumberFormat = "@"
    outRow = 1

    'Log header
    logWs.Range("A1:C1").Value = Array("File", "Status", "Notes")
    logWs.Rows(1).Font.Bold = True

    'Process files
    fileName = Dir(folderPath & "*.xls*")
    Do While Len(fileName) > 0
        fullPath = folderPath & fileName

        If StrComp(fullPath, ThisWorkbook.FullName, vbTextCompare) <> 0 Then
            Set wb = Nothing
            Set ws = Nothing

            On Error GoTo FileError
            Set wb = Workbooks.Open(Filename:=fullPath, ReadOnly:=True, UpdateLinks:=False)

            On Error Resume Next
            Set ws = wb.Worksheets(TARGET_SHEET)
            On Error GoTo FileError

            If ws Is Nothing Then
                LogLine logWs, fileName, "Skipped", "Sheet not found: " & TARGET_SHEET
                GoTo CloseAndNext
            End If

            'Find required columns in A3:G3
            polSubCol = FindHeaderInRow(ws, HEADER_ROW, "Policy Sub-Domain", 1, 7)
            If polSubCol = 0 Then
                LogLine logWs, fileName, "Skipped", "Could not find 'Policy Sub-Domain' in A3:G3."
                GoTo CloseAndNext
            End If

            qidCol = FindHeaderInRow(ws, HEADER_ROW, "Question ID", 1, 7)
            If qidCol = 0 Then
                LogLine logWs, fileName, "Warning", "Could not find 'Question ID' in A3:G3. SA.010.033 special mapping will NOT apply."
            End If

            'Find last question row
            lastRow = ws.Cells(ws.Rows.Count, polSubCol).End(xlUp).Row
            If lastRow < QUESTION_START_ROW Then
                LogLine logWs, fileName, "Skipped", "No question rows found (expected start around row 7)."
                GoTo CloseAndNext
            End If

            'Find last used column based on row 2 (app names typically here)
            lastCol = ws.Cells(2, ws.Columns.Count).End(xlToLeft).Column
            If lastCol < APP_FIRST_COL Then
                LogLine logWs, fileName, "Skipped", "No application columns found to the right of H2."
                GoTo CloseAndNext
            End If

            'Loop each app column
            For respCol = APP_FIRST_COL To lastCol

                '*** NEW: Ignore any column where row 3 says Comments ***
                If IsCommentsColumn(ws, respCol) Then
                    GoTo NextAppCol
                End If

                appName = Trim$(CStr(ws.Cells(2, respCol).Value2))
                If Len(appName) = 0 Then GoTo NextAppCol 'skip non-app cols

                itFunc = Trim$(CStr(ws.Cells(1, respCol).Value2))
                appId = Trim$(CStr(ws.Cells(4, respCol).Value2))
                dataClass = Trim$(CStr(ws.Cells(5, respCol).Value2))
                daiId = Trim$(CStr(ws.Cells(6, respCol).Value2))

                'Label "Number of Asset" is typically in column H (8), somewhere near top
                numAsset = GetValueForLabel(ws, "Number of Asset", respCol, 1, 30, 8)

                outRow = outRow + 1
                outWs.Cells(outRow, 1).Value = itFunc
                outWs.Cells(outRow, 2).Value = appName
                outWs.Cells(outRow, 3).Value = dataClass
                outWs.Cells(outRow, 4).Value = numAsset

                'Compute per metric
                For m = LBound(metricHeaders) To UBound(metricHeaders)
                    outWs.Cells(outRow, 5 + m).Value = ComputeMetricYN_Mapped( _
                        ws:=ws, rStart:=QUESTION_START_ROW, rEnd:=lastRow, _
                        polSubCol:=polSubCol, qidCol:=qidCol, respCol:=respCol, _
                        metricName:=CStr(metricHeaders(m)) _
                    )
                Next m

                outWs.Cells(outRow, hiddenStartCol).Value = appId
                outWs.Cells(outRow, hiddenStartCol + 1).Value = daiId
                outWs.Cells(outRow, hiddenStartCol + 2).Value = fileName

NextAppCol:
            Next respCol

            LogLine logWs, fileName, "OK", "Imported."

CloseAndNext:
            On Error Resume Next
            If Not wb Is Nothing Then wb.Close SaveChanges:=False
            On Error GoTo 0
            Set ws = Nothing
            Set wb = Nothing
        End If

        fileName = Dir()
        DoEvents
    Loop

    'Format output
    ApplyMetricsFormatting outWs, 1, outRow, 5, 5 + UBound(metricHeaders)

    'Hide helper cols
    outWs.Columns(hiddenStartCol).Hidden = True
    outWs.Columns(hiddenStartCol + 1).Hidden = True
    outWs.Columns(hiddenStartCol + 2).Hidden = True

    outWs.Columns.AutoFit

SafeExit:
    Application.ScreenUpdating = prevScreenUpdating
    Application.DisplayAlerts = prevAlerts
    Application.EnableEvents = prevEvents

    MsgBox "Done. Output is in 'Combined Metrics'.", vbInformation
    Exit Sub

FileError:
    LogLine logWs, fileName, "Error", Err.Description
    On Error Resume Next
    If Not wb Is Nothing Then wb.Close SaveChanges:=False
    On Error GoTo 0
    Resume CloseAndNext

FatalError:
    'restore then show error
    Resume SafeExit
End Sub

'=========================================================
' Skip columns where row 3 indicates Comments
'=========================================================
Private Function IsCommentsColumn(ByVal ws As Worksheet, ByVal col As Long) As Boolean
    Dim hdr As String
    hdr = Canonical(CStr(ws.Cells(3, col).Value2)) 'Row 3 per your request
    'Catches "comments", "comment", "commentsoptional", etc.
    IsCommentsColumn = (InStr(1, hdr, "comment", vbTextCompare) > 0)
End Function

'=========================================================
' Metric computation:
' - Filters rows where Policy Sub-Domain matches metric header
' - Uses NormalizeToYN mapping (incl. SA.010.033 special rule)
' - Rollup: any N => N, else any Y => Y, else blank
'=========================================================
Private Function ComputeMetricYN_Mapped(ByVal ws As Worksheet, ByVal rStart As Long, ByVal rEnd As Long, _
                                        ByVal polSubCol As Long, ByVal qidCol As Long, ByVal respCol As Long, _
                                        ByVal metricName As String) As String
    Dim r As Long
    Dim keyMetric As String, keySub As String
    Dim yn As String
    Dim anyY As Boolean, anyN As Boolean
    Dim qid As String

    keyMetric = Canonical(metricName)
    anyY = False: anyN = False

    For r = rStart To rEnd
        keySub = Canonical(CStr(ws.Cells(r, polSubCol).Value2))
        If keySub = keyMetric Then

            If qidCol > 0 Then
                qid = CStr(ws.Cells(r, qidCol).Value2)
            Else
                qid = ""
            End If

            yn = NormalizeToYN(CStr(ws.Cells(r, respCol).Value2), qid)

            If yn = "N" Then
                anyN = True
                Exit For
            ElseIf yn = "Y" Then
                anyY = True
            End If
        End If
    Next r

    If anyN Then
        ComputeMetricYN_Mapped = "N"
    ElseIf anyY Then
        ComputeMetricYN_Mapped = "Y"
    Else
        ComputeMetricYN_Mapped = ""
    End If
End Function

'=========================================================
' Mapping rules (default):
'   Yes/Y -> Y
'   N/A -> Y
'   N/R -> Y
'   No/N -> N
'   Not Answered -> N
'
' Special ONLY for Question ID SA.010.033:
'   N or No or N/A or N/R => Y
'   Y or Yes => N
'   Not Answered => N
'=========================================================
Private Function NormalizeToYN(ByVal raw As String, Optional ByVal questionId As String = "") As String
    Dim tok As String
    Dim q As String
    Dim isSpecial As Boolean

    q = Canonical(CStr(questionId))
    'Catches SA.010.033 and variants like SA.010.033a
    isSpecial = (Left$(q, 8) = "sa010033")

    tok = Canonical(CStr(raw))

    If tok = "" Then
        NormalizeToYN = ""
        Exit Function
    End If

    If tok = "notanswered" Or tok = "notanswer" Then
        NormalizeToYN = "N"
        Exit Function
    End If

    If isSpecial Then
        Select Case tok
            Case "y", "yes"
                NormalizeToYN = "N"
            Case "n", "no", "na", "nr"
                NormalizeToYN = "Y"
            Case Else
                NormalizeToYN = ""
        End Select
        Exit Function
    End If

    Select Case tok
        Case "y", "yes", "na", "nr"
            NormalizeToYN = "Y"
        Case "n", "no", "notanswered", "notanswer"
            NormalizeToYN = "N"
        Case Else
            NormalizeToYN = ""
    End Select
End Function

'=========================================================
' Helpers
'=========================================================
Private Function FindHeaderInRow(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal headerText As String, _
                                 ByVal startCol As Long, ByVal endCol As Long) As Long
    Dim c As Long
    For c = startCol To endCol
        If Canonical(CStr(ws.Cells(headerRow, c).Value2)) = Canonical(headerText) Then
            FindHeaderInRow = c
            Exit Function
        End If
    Next c
    FindHeaderInRow = 0
End Function

Private Function GetValueForLabel(ByVal ws As Worksheet, ByVal labelText As String, ByVal appCol As Long, _
                                  ByVal rowStart As Long, ByVal rowEnd As Long, ByVal labelCol As Long) As String
    Dim r As Long
    For r = rowStart To rowEnd
        If Canonical(CStr(ws.Cells(r, labelCol).Value2)) = Canonical(labelText) Then
            GetValueForLabel = Trim$(CStr(ws.Cells(r, appCol).Value2))
            Exit Function
        End If
    Next r
    GetValueForLabel = ""
End Function

Private Sub ApplyMetricsFormatting(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal lastDataRow As Long, _
                                  ByVal metricsStartCol As Long, ByVal metricsEndCol As Long)
    If lastDataRow < headerRow + 1 Then Exit Sub

    With ws.Range(ws.Cells(headerRow, 1), ws.Cells(headerRow, metricsEndCol))
        .Interior.Color = RGB(0, 51, 102)
        .Font.Color = RGB(255, 255, 255)
        .Font.Bold = True
        .HorizontalAlignment = xlCenter
    End With

    With ws.Range(ws.Cells(headerRow, 1), ws.Cells(lastDataRow, metricsEndCol))
        .Borders.LineStyle = xlContinuous
        .Borders.Weight = xlThin
    End With

    Dim rng As Range
    Set rng = ws.Range(ws.Cells(headerRow + 1, metricsStartCol), ws.Cells(lastDataRow, metricsEndCol))
    rng.FormatConditions.Delete

    With rng.FormatConditions.Add(Type:=xlCellValue, Operator:=xlEqual, Formula1:="=""Y""")
        .Interior.Color = RGB(0, 176, 80)
        .Font.Color = RGB(255, 255, 255)
        .Font.Bold = True
    End With

    With rng.FormatConditions.Add(Type:=xlCellValue, Operator:=xlEqual, Formula1:="=""N""")
        .Interior.Color = RGB(255, 255, 255)
        .Font.Color = RGB(0, 0, 0)
        .Font.Bold = True
    End With

    rng.HorizontalAlignment = xlCenter
End Sub

Private Function PickFolder() As String
    Dim fd As FileDialog
    Set fd = Application.FileDialog(msoFileDialogFolderPicker)
    fd.Title = "Select folder containing Excel files"
    If fd.Show = -1 Then PickFolder = fd.SelectedItems(1) Else PickFolder = ""
End Function

Private Function GetOrCreateSheet(ByVal wb As Workbook, ByVal sheetName As String) As Worksheet
    On Error Resume Next
    Set GetOrCreateSheet = wb.Worksheets(sheetName)
    On Error GoTo 0
    If GetOrCreateSheet Is Nothing Then
        Set GetOrCreateSheet = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))
        GetOrCreateSheet.Name = sheetName
    End If
End Function

Private Sub LogLine(ByVal logWs As Worksheet, ByVal fileName As String, ByVal status As String, ByVal notes As String)
    Dim lr As Long
    lr = logWs.Cells(logWs.Rows.Count, "A").End(xlUp).Row + 1
    logWs.Cells(lr, 1).Value = fileName
    logWs.Cells(lr, 2).Value = status
    logWs.Cells(lr, 3).Value = notes
End Sub

'Canonical: lowercases and keeps only [a-z0-9]
Private Function Canonical(ByVal s As String) As String
    Dim i As Long, ch As String, out As String
    s = LCase$(Trim$(s))
    out = ""
    For i = 1 To Len(s)
        ch = Mid$(s, i, 1)
        If (ch >= "a" And ch <= "z") Or (ch >= "0" And ch <= "9") Then out = out & ch
    Next i
    Canonical = out
End Function