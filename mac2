Option Explicit

Public Sub Consolidate_OutputTemplate_WideMatrix()

    Const TARGET_SHEET As String = "outputTemplate -Power BI Upload"

    Dim folderPath As String, fileName As String, fullPath As String
    Dim wb As Workbook, ws As Worksheet
    Dim dest As Worksheet, logWs As Worksheet
    Dim destRow As Long

    Dim cellAppNameLbl As Range, cellITFuncLbl As Range
    Dim cellAppIdLbl As Range, cellDataClassLbl As Range, cellDaiIdLbl As Range

    Dim rowAppName As Long, rowITFunc As Long, rowAppId As Long, rowDataClass As Long, rowDaiId As Long
    Dim labelCol As Long, startCol As Long, endCol As Long, c As Long

    Dim appName As String, itFunc As String, appId As String, dataClass As String, daiId As String

    folderPath = PickFolder()
    If Len(folderPath) = 0 Then Exit Sub
    If Right(folderPath, 1) <> "\" Then folderPath = folderPath & "\"

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.EnableEvents = False

    Set dest = GetOrCreateSheet(ThisWorkbook, "Consolidated")
    Set logWs = GetOrCreateSheet(ThisWorkbook, "Log")

    'Output headers
    If dest.Cells(1, 1).Value = "" Then
        dest.Range("A1:F1").Value = Array("App ID", "App Name", "DAI ID", "Data Class", "IT Function", "Source File")
        dest.Rows(1).Font.Bold = True
        dest.Columns("A:F").NumberFormat = "@" 'keep IDs as text (avoid scientific notation)
    End If

    'Log headers
    If logWs.Cells(1, 1).Value = "" Then
        logWs.Range("A1:C1").Value = Array("File", "Status", "Notes")
        logWs.Rows(1).Font.Bold = True
    End If

    fileName = Dir(folderPath & "*.xls*")
    Do While Len(fileName) > 0

        fullPath = folderPath & fileName

        If StrComp(fullPath, ThisWorkbook.FullName, vbTextCompare) <> 0 Then

            On Error GoTo FileError
            Set wb = Workbooks.Open(Filename:=fullPath, ReadOnly:=True, UpdateLinks:=False)

            'Get sheet
            On Error Resume Next
            Set ws = wb.Worksheets(TARGET_SHEET)
            On Error GoTo 0

            If ws Is Nothing Then
                LogLine logWs, fileName, "Skipped", "Sheet not found: " & TARGET_SHEET
                GoTo CloseAndNext
            End If

            'Find label cells anywhere (case-insensitive, partial match)
            Set cellAppNameLbl = FindTextCell(ws, "Application Name")
            Set cellITFuncLbl = FindTextCell(ws, "IT Function")
            Set cellAppIdLbl = FindTextCell(ws, "app id")
            Set cellDataClassLbl = FindTextCell(ws, "data class")
            Set cellDaiIdLbl = FindTextCell(ws, "DAI ID")

            If cellAppNameLbl Is Nothing Then
                LogLine logWs, fileName, "Skipped", "Could not find label: Application Name"
                GoTo CloseAndNext
            End If
            If cellAppIdLbl Is Nothing Then
                LogLine logWs, fileName, "Skipped", "Could not find label: app id"
                GoTo CloseAndNext
            End If

            'Row numbers where values live (same row as label)
            rowAppName = cellAppNameLbl.Row
            rowITFunc = IIf(cellITFuncLbl Is Nothing, 0, cellITFuncLbl.Row)
            rowAppId = cellAppIdLbl.Row
            rowDataClass = IIf(cellDataClassLbl Is Nothing, 0, cellDataClassLbl.Row)
            rowDaiId = IIf(cellDaiIdLbl Is Nothing, 0, cellDaiIdLbl.Row)

            'Label column (usually the left label column)
            labelCol = MinColNonZero(Array( _
                        cellAppNameLbl.Column, _
                        IIf(cellITFuncLbl Is Nothing, 0, cellITFuncLbl.Column), _
                        cellAppIdLbl.Column, _
                        IIf(cellDataClassLbl Is Nothing, 0, cellDataClassLbl.Column), _
                        IIf(cellDaiIdLbl Is Nothing, 0, cellDaiIdLbl.Column) _
                      ))

            startCol = labelCol + 1

            'Last column based on Application Name row
            endCol = ws.Cells(rowAppName, ws.Columns.Count).End(xlToLeft).Column
            If endCol < startCol Then
                LogLine logWs, fileName, "Skipped", "No application columns found to the right of labels."
                GoTo CloseAndNext
            End If

            'Loop each application column (only where Application Name has a value)
            For c = startCol To endCol

                appName = Trim$(ws.Cells(rowAppName, c).Text)
                If Len(appName) = 0 Then
                    'skip blank application columns
                    GoTo NextCol
                End If

                itFunc = IIf(rowITFunc = 0, "", Trim$(ws.Cells(rowITFunc, c).Text))
                appId = Trim$(ws.Cells(rowAppId, c).Text)
                dataClass = IIf(rowDataClass = 0, "", Trim$(ws.Cells(rowDataClass, c).Text))
                daiId = IIf(rowDaiId = 0, "", Trim$(ws.Cells(rowDaiId, c).Text))

                destRow = dest.Cells(dest.Rows.Count, "A").End(xlUp).Row + 1
                dest.Cells(destRow, 1).Value = appId
                dest.Cells(destRow, 2).Value = appName
                dest.Cells(destRow, 3).Value = daiId
                dest.Cells(destRow, 4).Value = dataClass
                dest.Cells(destRow, 5).Value = itFunc
                dest.Cells(destRow, 6).Value = fileName

NextCol:
            Next c

            LogLine logWs, fileName, "OK", "Imported from " & TARGET_SHEET & " (AppName row " & rowAppName & ")"

CloseAndNext:
            On Error Resume Next
            wb.Close SaveChanges:=False
            On Error GoTo 0
            Set ws = Nothing
            Set wb = Nothing
        End If

        fileName = Dir()
        DoEvents
    Loop

Cleanup:
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    Application.EnableEvents = True

    MsgBox "Done. Check 'Consolidated' and 'Log'.", vbInformation
    Exit Sub

FileError:
    LogLine logWs, fileName, "Error", Err.Description
    On Error Resume Next
    If Not wb Is Nothing Then wb.Close SaveChanges:=False
    On Error GoTo 0
    Resume CloseAndNext

End Sub

'========================
' Helpers
'========================

Private Function PickFolder() As String
    Dim fd As FileDialog
    Set fd = Application.FileDialog(msoFileDialogFolderPicker)
    fd.Title = "Select folder containing Excel files"
    If fd.Show = -1 Then PickFolder = fd.SelectedItems(1) Else PickFolder = ""
End Function

Private Function GetOrCreateSheet(ByVal wb As Workbook, ByVal sheetName As String) As Worksheet
    On Error Resume Next
    Set GetOrCreateSheet = wb.Worksheets(sheetName)
    On Error GoTo 0
    If GetOrCreateSheet Is Nothing Then
        Set GetOrCreateSheet = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))
        GetOrCreateSheet.Name = sheetName
    End If
End Function

Private Sub LogLine(ByVal logWs As Worksheet, ByVal fileName As String, ByVal status As String, ByVal notes As String)
    Dim lr As Long
    lr = logWs.Cells(logWs.Rows.Count, "A").End(xlUp).Row + 1
    logWs.Cells(lr, 1).Value = fileName
    logWs.Cells(lr, 2).Value = status
    logWs.Cells(lr, 3).Value = notes
End Sub

'Find a cell containing text anywhere in UsedRange (partial match, case-insensitive)
Private Function FindTextCell(ByVal ws As Worksheet, ByVal needle As String) As Range
    Dim r As Range
    On Error Resume Next
    Set r = ws.UsedRange.Find(What:=needle, LookIn:=xlValues, LookAt:=xlPart, _
                              SearchOrder:=xlByRows, SearchDirection:=xlNext, MatchCase:=False)
    On Error GoTo 0
    Set FindTextCell = r
End Function

Private Function MinColNonZero(ByVal cols As Variant) As Long
    Dim i As Long, v As Long, m As Long
    m = 0
    For i = LBound(cols) To UBound(cols)
        v = CLng(cols(i))
        If v > 0 Then
            If m = 0 Or v < m Then m = v
        End If
    Next i
    MinColNonZero = m
End Function