Option Explicit

Public Sub Build_ComplianceByQuestionID_FromFolder_FIXED()

    Dim folderPath As String, fileName As String, fullPath As String
    Dim wb As Workbook, ws As Worksheet
    Dim outWs As Worksheet, logWs As Worksheet
    Dim outRow As Long

    Dim labelCol As Long, appStartCol As Long, lastAppCol As Long
    Dim qidCol As Long, polSubCol As Long, qTextCol As Long, controlGroupCol As Long
    Dim dataStartRow As Long, lastRow As Long

    Dim appCol As Long, r As Long
    Dim itFunc As String, appName As String, appId As String, dataClass As String, daiId As String, numAsset As String
    Dim qid As String, polSub As String, qText As String, ctrlGrp As String
    Dim rawResp As String, respYN As String

    folderPath = PickFolder()
    If Len(folderPath) = 0 Then Exit Sub
    If Right(folderPath, 1) <> "\" Then folderPath = folderPath & "\"

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.EnableEvents = False

    Set outWs = GetOrCreateSheet(ThisWorkbook, "QuestionID Metrics")
    Set logWs = GetOrCreateSheet(ThisWorkbook, "Log")
    outWs.Cells.Clear
    logWs.Cells.Clear

    'Output headers
    outWs.Range("A1:M1").Value = Array( _
        "IT Function", _
        "Application/Site Name", _
        "App ID", _
        "Data Class", _
        "DAI ID", _
        "Number of Asset", _
        "Question ID", _
        "Policy Sub-Domain", _
        "Control Group", _
        "Question Text", _
        "Compliance (Y/N)", _
        "Raw Response", _
        "Source File" _
    )
    outWs.Rows(1).Font.Bold = True
    outWs.Columns.NumberFormat = "@"

    logWs.Range("A1:C1").Value = Array("File", "Status", "Notes")
    logWs.Rows(1).Font.Bold = True

    outRow = 1
    dataStartRow = 7

    fileName = Dir(folderPath & "*.xls*")
    Do While Len(fileName) > 0

        fullPath = folderPath & fileName

        If StrComp(fullPath, ThisWorkbook.FullName, vbTextCompare) <> 0 Then

            On Error GoTo FileError
            Set wb = Workbooks.Open(Filename:=fullPath, ReadOnly:=True, UpdateLinks:=False)

            'Get the template sheet safely (tries both names)
            Set ws = GetTemplateSheet(wb)
            If ws Is Nothing Then
                LogLine logWs, fileName, "Skipped", "Template sheet not found (tried both name variants)."
                GoTo CloseAndNext
            End If

            'Find label column using "Application Name" label near top; fallback to H (=8)
            labelCol = FindLabelColSafe(ws)
            If labelCol = 0 Then labelCol = 8 'fallback to column H if not found

            appStartCol = labelCol + 1
            lastAppCol = ws.Cells(2, ws.Columns.Count).End(xlToLeft).Column
            If lastAppCol < appStartCol Then
                LogLine logWs, fileName, "Skipped", "No application columns found to the right of label column."
                GoTo CloseAndNext
            End If

            'Headers row (A3:G3 normally)
            qidCol = FindHeaderInRow(ws, 3, "Question ID", 1, 40)
            If qidCol = 0 Then qidCol = FindHeaderInRow(ws, 3, "QuestionID", 1, 40)

            polSubCol = FindHeaderInRow(ws, 3, "Policy Sub-Domain", 1, 40)
            qTextCol = FindHeaderInRow(ws, 3, "Question", 1, 40)

            'Control Group can be missing; find it safely (row 3 first, then top band)
            controlGroupCol = FindHeaderInRow(ws, 3, "Control Group", 1, 60)
            If controlGroupCol = 0 Then
                Dim cgCell As Range
                Set cgCell = FindHeaderAnywhere(ws, "Control Group", 1, 15, 1, 80)
                If Not cgCell Is Nothing Then controlGroupCol = cgCell.Column
            End If

            If qidCol = 0 Then
                LogLine logWs, fileName, "Skipped", "Could not find 'Question ID' header in row 3."
                GoTo CloseAndNext
            End If

            lastRow = ws.Cells(ws.Rows.Count, qidCol).End(xlUp).Row
            If lastRow < dataStartRow Then
                LogLine logWs, fileName, "Skipped", "No question rows found under Question ID."
                GoTo CloseAndNext
            End If

            'Loop apps
            For appCol = appStartCol To lastAppCol

                appName = Trim$(ws.Cells(2, appCol).Text)
                If Len(appName) = 0 Then GoTo NextAppCol

                itFunc = Trim$(ws.Cells(1, appCol).Text)

                appId = Trim$(ws.Cells(4, appCol).Text)
                dataClass = Trim$(ws.Cells(5, appCol).Text)
                daiId = Trim$(ws.Cells(6, appCol).Text)

                numAsset = GetValueForLabel(ws, "Number of Asset", appCol, 1, 30, labelCol)

                'Loop questions
                For r = dataStartRow To lastRow

                    qid = Trim$(ws.Cells(r, qidCol).Text)
                    If Len(qid) = 0 Then GoTo NextQuestionRow

                    polSub = IIf(polSubCol = 0, "", Trim$(ws.Cells(r, polSubCol).Text))
                    qText = IIf(qTextCol = 0, "", Trim$(ws.Cells(r, qTextCol).Text))
                    ctrlGrp = IIf(controlGroupCol = 0, "", Trim$(ws.Cells(r, controlGroupCol).Text))

                    rawResp = Trim$(ws.Cells(r, appCol).Text)
                    respYN = NormalizeToYN(rawResp)

                    outRow = outRow + 1
                    outWs.Cells(outRow, 1).Value = itFunc
                    outWs.Cells(outRow, 2).Value = appName
                    outWs.Cells(outRow, 3).Value = appId
                    outWs.Cells(outRow, 4).Value = dataClass
                    outWs.Cells(outRow, 5).Value = daiId
                    outWs.Cells(outRow, 6).Value = numAsset
                    outWs.Cells(outRow, 7).Value = qid
                    outWs.Cells(outRow, 8).Value = polSub
                    outWs.Cells(outRow, 9).Value = ctrlGrp
                    outWs.Cells(outRow, 10).Value = qText
                    outWs.Cells(outRow, 11).Value = respYN
                    outWs.Cells(outRow, 12).Value = rawResp
                    outWs.Cells(outRow, 13).Value = fileName

NextQuestionRow:
                Next r

NextAppCol:
            Next appCol

            LogLine logWs, fileName, "OK", "Imported per-question compliance."

CloseAndNext:
            On Error Resume Next
            wb.Close SaveChanges:=False
            On Error GoTo 0
            Set ws = Nothing
            Set wb = Nothing
        End If

        fileName = Dir()
        DoEvents
    Loop

    outWs.Columns.AutoFit

    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    Application.EnableEvents = True

    MsgBox "Done. Output is in 'QuestionID Metrics'.", vbInformation
    Exit Sub

FileError:
    LogLine logWs, fileName, "Error", Err.Description
    On Error Resume Next
    If Not wb Is Nothing Then wb.Close SaveChanges:=False
    On Error GoTo 0
    Resume CloseAndNext

End Sub

'--- Sheet getter: tries both common tab name variants
Private Function GetTemplateSheet(ByVal wb As Workbook) As Worksheet
    On Error Resume Next
    Set GetTemplateSheet = wb.Worksheets("OutputTemplate- Power BI Upload")
    If GetTemplateSheet Is Nothing Then
        Set GetTemplateSheet = wb.Worksheets("OutputTemplate-Power BI Upload")
    End If
    On Error GoTo 0
End Function

'--- Compliance mapping requested:
' Yes/Y -> Y
' N/A -> Y
' N/R -> Y
' No/N -> N
' Not Answered -> N
Private Function NormalizeToYN(ByVal raw As String) As String
    Dim s As String
    s = LCase$(Trim$(raw))
    s = Replace(s, vbCr, "")
    s = Replace(s, vbLf, "")
    s = Replace(s, " ", "")

    If s = "yes" Or s = "y" Then NormalizeToYN = "Y": Exit Function
    If s = "no" Or s = "n" Then NormalizeToYN = "N": Exit Function
    If s = "na" Or s = "n/a" Then NormalizeToYN = "Y": Exit Function
    If s = "nr" Or s = "n/r" Then NormalizeToYN = "Y": Exit Function
    If s = "notanswered" Or s = "notanswer" Then NormalizeToYN = "N": Exit Function

    NormalizeToYN = ""
End Function

'--- Find label col safely (returns 0 if not found)
Private Function FindLabelColSafe(ByVal ws As Worksheet) As Long
    Dim c As Range
    Set c = FindHeaderAnywhere(ws, "Application Name", 1, 8, 1, 60)
    If c Is Nothing Then Set c = FindHeaderAnywhere(ws, "Application/Site Name", 1, 8, 1, 60)

    If c Is Nothing Then
        FindLabelColSafe = 0
    Else
        FindLabelColSafe = c.Column
    End If
End Function

Private Function FindHeaderInRow(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal headerText As String, _
                                 ByVal startCol As Long, ByVal endCol As Long) As Long
    Dim c As Long
    For c = startCol To endCol
        If Canonical(ws.Cells(headerRow, c).Text) = Canonical(headerText) Then
            FindHeaderInRow = c
            Exit Function
        End If
    Next c
    FindHeaderInRow = 0
End Function

Private Function FindHeaderAnywhere(ByVal ws As Worksheet, ByVal headerText As String, _
                                    ByVal rowStart As Long, ByVal rowEnd As Long, _
                                    ByVal colStart As Long, ByVal colEnd As Long) As Range
    Dim r As Long, c As Long
    For r = rowStart To rowEnd
        For c = colStart To colEnd
            If Canonical(ws.Cells(r, c).Text) = Canonical(headerText) Then
                Set FindHeaderAnywhere = ws.Cells(r, c)
                Exit Function
            End If
        Next c
    Next r
    Set FindHeaderAnywhere = Nothing
End Function

Private Function GetValueForLabel(ByVal ws As Worksheet, ByVal labelText As String, ByVal appCol As Long, _
                                  ByVal rowStart As Long, ByVal rowEnd As Long, ByVal labelCol As Long) As String
    Dim r As Long
    For r = rowStart To rowEnd
        If Canonical(ws.Cells(r, labelCol).Text) = Canonical(labelText) Then
            GetValueForLabel = Trim$(ws.Cells(r, appCol).Text)
            Exit Function
        End If
    Next r
    GetValueForLabel = ""
End Function

'--- Generic helpers
Private Function PickFolder() As String
    Dim fd As FileDialog
    Set fd = Application.FileDialog(msoFileDialogFolderPicker)
    fd.Title = "Select folder containing Excel files"
    If fd.Show = -1 Then PickFolder = fd.SelectedItems(1) Else PickFolder = ""
End Function

Private Function GetOrCreateSheet(ByVal wb As Workbook, ByVal sheetName As String) As Worksheet
    On Error Resume Next
    Set GetOrCreateSheet = wb.Worksheets(sheetName)
    On Error GoTo 0
    If GetOrCreateSheet Is Nothing Then
        Set GetOrCreateSheet = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))
        GetOrCreateSheet.Name = sheetName
    End If
End Function

Private Sub LogLine(ByVal logWs As Worksheet, ByVal fileName As String, ByVal status As String, ByVal notes As String)
    Dim lr As Long
    lr = logWs.Cells(logWs.Rows.Count, "A").End(xlUp).Row + 1
    logWs.Cells(lr, 1).Value = fileName
    logWs.Cells(lr, 2).Value = status
    logWs.Cells(lr, 3).Value = notes
End Sub

Private Function Canonical(ByVal s As String) As String
    Dim i As Long, ch As String, out As String
    s = LCase$(Trim$(s))
    out = ""
    For i = 1 To Len(s)
        ch = Mid$(s, i, 1)
        If (ch >= "a" And ch <= "z") Or (ch >= "0" And ch <= "9") Then out = out & ch
    Next i
    Canonical = out
End Function