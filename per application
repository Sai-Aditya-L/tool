Option Explicit

Public Sub Build_ComplianceByQuestionID_FromFolder_WithPolicyDomain()

    '==== SETTINGS (your exact sheet/layout) ====
    Const TARGET_SHEET As String = "outputTemplate-Power BI Upload"

    Const LABEL_COL As Long = 8        'H column holds labels like "IT Function", "Application Name", etc.
    Const APP_START_COL As Long = 9    'I column is the first app column
    Const HEADER_ROW As Long = 3       'A3:H3 headers
    Const DATA_START_ROW As Long = 7   'questions start at row 7

    '==== Variables ====
    Dim folderPath As String, fileName As String, fullPath As String
    Dim wb As Workbook, ws As Worksheet
    Dim outWs As Worksheet, logWs As Worksheet
    Dim outRow As Long

    Dim lastAppCol As Long, appCol As Long
    Dim lastRow As Long, r As Long

    'Columns within A3:H3
    Dim polDomainCol As Long, polSubDomainCol As Long
    Dim qidCol As Long, qTextCol As Long, ctrlGrpCol As Long

    'Per-app metadata
    Dim itFunc As String, appName As String, appId As String, dataClass As String, daiId As String

    'Per-row values
    Dim polDomain As String, polSubDomain As String
    Dim qid As String, qText As String, ctrlGrp As String
    Dim rawResp As String, compYN As String

    '==== Pick folder ====
    folderPath = PickFolder()
    If Len(folderPath) = 0 Then Exit Sub
    If Right$(folderPath, 1) <> "\" Then folderPath = folderPath & "\"

    '==== Prep output sheets ====
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.EnableEvents = False

    Set outWs = GetOrCreateSheet(ThisWorkbook, "QuestionID Metrics")
    Set logWs = GetOrCreateSheet(ThisWorkbook, "Log")
    outWs.Cells.Clear
    logWs.Cells.Clear

    'Output headers
    outWs.Range("A1:N1").Value = Array( _
        "IT Function", _
        "Application/Site Name", _
        "App ID", _
        "Data Class", _
        "DAI ID", _
        "Policy Domain", _
        "Policy Sub-Domain", _
        "Question ID", _
        "Control Group", _
        "Question Text", _
        "Compliance (Y/N)", _
        "Raw Response", _
        "Source File", _
        "Source Row" _
    )
    outWs.Rows(1).Font.Bold = True
    outWs.Columns.NumberFormat = "@"
    outRow = 1

    'Log headers
    logWs.Range("A1:C1").Value = Array("File", "Status", "Notes")
    logWs.Rows(1).Font.Bold = True

    '==== Iterate files in folder ====
    fileName = Dir(folderPath & "*.xls*")
    Do While Len(fileName) > 0

        fullPath = folderPath & fileName

        'Skip the workbook containing the macro itself (if it happens to be in the same folder)
        If StrComp(fullPath, ThisWorkbook.FullName, vbTextCompare) <> 0 Then

            On Error GoTo FileError
            Set wb = Workbooks.Open(Filename:=fullPath, ReadOnly:=True, UpdateLinks:=False)

            'Get the sheet
            Set ws = Nothing
            On Error Resume Next
            Set ws = wb.Worksheets(TARGET_SHEET)
            On Error GoTo 0

            If ws Is Nothing Then
                LogLine logWs, fileName, "Skipped", "Sheet not found: " & TARGET_SHEET
                GoTo CloseAndNext
            End If

            'Find required headers in A3:H3
            polDomainCol = FindHeaderInRow(ws, HEADER_ROW, "Policy Domain", 1, LABEL_COL)
            polSubDomainCol = FindHeaderInRow(ws, HEADER_ROW, "Policy Sub-Domain", 1, LABEL_COL)

            qidCol = FindHeaderInRow(ws, HEADER_ROW, "Question ID", 1, LABEL_COL)
            If qidCol = 0 Then qidCol = FindHeaderInRow(ws, HEADER_ROW, "QuestionID", 1, LABEL_COL)

            qTextCol = FindHeaderInRow(ws, HEADER_ROW, "Question Text", 1, LABEL_COL)
            If qTextCol = 0 Then qTextCol = FindHeaderInRow(ws, HEADER_ROW, "Question", 1, LABEL_COL)

            ctrlGrpCol = FindHeaderInRow(ws, HEADER_ROW, "Control Group", 1, LABEL_COL)

            If qidCol = 0 Then
                LogLine logWs, fileName, "Skipped", "Could not find 'Question ID' in A3:H3."
                GoTo CloseAndNext
            End If

            'Find last question row
            lastRow = ws.Cells(ws.Rows.Count, qidCol).End(xlUp).Row
            If lastRow < DATA_START_ROW Then
                LogLine logWs, fileName, "Skipped", "No question rows found (expected from row 7)."
                GoTo CloseAndNext
            End If

            'Find last app column (application names row is row 2)
            lastAppCol = ws.Cells(2, ws.Columns.Count).End(xlToLeft).Column
            If lastAppCol < APP_START_COL Then
                LogLine logWs, fileName, "Skipped", "No app columns found to the right of H."
                GoTo CloseAndNext
            End If

            '==== Loop apps ====
            For appCol = APP_START_COL To lastAppCol

                appName = Trim$(ws.Cells(2, appCol).Text)
                itFunc = Trim$(ws.Cells(1, appCol).Text)

                'Skip empty columns
                If Len(appName) = 0 And Len(itFunc) = 0 Then GoTo NextApp

                'Metadata rows (H4:H6 labels, values in same app column)
                appId = Trim$(ws.Cells(4, appCol).Text)
                dataClass = Trim$(ws.Cells(5, appCol).Text)
                daiId = Trim$(ws.Cells(6, appCol).Text)

                '==== Loop question rows ====
                For r = DATA_START_ROW To lastRow

                    qid = Trim$(ws.Cells(r, qidCol).Text)
                    If Len(qid) = 0 Then GoTo NextRow

                    polDomain = IIf(polDomainCol = 0, "", Trim$(ws.Cells(r, polDomainCol).Text))
                    polSubDomain = IIf(polSubDomainCol = 0, "", Trim$(ws.Cells(r, polSubDomainCol).Text))
                    ctrlGrp = IIf(ctrlGrpCol = 0, "", Trim$(ws.Cells(r, ctrlGrpCol).Text))
                    qText = IIf(qTextCol = 0, "", Trim$(ws.Cells(r, qTextCol).Text))

                    rawResp = Trim$(ws.Cells(r, appCol).Text)
                    compYN = NormalizeToYN_BlankIsN(rawResp)

                    outRow = outRow + 1
                    outWs.Cells(outRow, 1).Value = itFunc
                    outWs.Cells(outRow, 2).Value = appName
                    outWs.Cells(outRow, 3).Value = appId
                    outWs.Cells(outRow, 4).Value = dataClass
                    outWs.Cells(outRow, 5).Value = daiId
                    outWs.Cells(outRow, 6).Value = polDomain
                    outWs.Cells(outRow, 7).Value = polSubDomain
                    outWs.Cells(outRow, 8).Value = qid
                    outWs.Cells(outRow, 9).Value = ctrlGrp
                    outWs.Cells(outRow, 10).Value = qText
                    outWs.Cells(outRow, 11).Value = compYN
                    outWs.Cells(outRow, 12).Value = rawResp
                    outWs.Cells(outRow, 13).Value = fileName
                    outWs.Cells(outRow, 14).Value = r

NextRow:
                Next r

NextApp:
            Next appCol

            LogLine logWs, fileName, "OK", "Imported per-question compliance."

CloseAndNext:
            On Error Resume Next
            wb.Close SaveChanges:=False
            On Error GoTo 0
            Set ws = Nothing
            Set wb = Nothing
        End If

        fileName = Dir()
        DoEvents
    Loop

    outWs.Columns.AutoFit

    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    Application.EnableEvents = True

    MsgBox "Done. Output is in 'QuestionID Metrics'.", vbInformation
    Exit Sub

FileError:
    LogLine logWs, fileName, "Error", Err.Description
    On Error Resume Next
    If Not wb Is Nothing Then wb.Close SaveChanges:=False
    On Error GoTo 0
    Resume CloseAndNext

End Sub

'=========================================================
' Compliance mapping (your latest rule)
'  Y/Yes/N/A/N/R => Y
'  N/No/Not Answered/Blank => N
'=========================================================
Private Function NormalizeToYN_BlankIsN(ByVal raw As String) As String
    Dim s As String
    s = LCase$(Trim$(raw))
    s = Replace(s, vbCr, "")
    s = Replace(s, vbLf, "")
    s = Replace(s, " ", "")

    If Len(s) = 0 Then NormalizeToYN_BlankIsN = "N": Exit Function

    If s = "y" Or s = "yes" Then NormalizeToYN_BlankIsN = "Y": Exit Function
    If s = "n" Or s = "no" Then NormalizeToYN_BlankIsN = "N": Exit Function

    If s = "na" Or s = "n/a" Or s = "n-a" Then NormalizeToYN_BlankIsN = "Y": Exit Function
    If s = "nr" Or s = "n/r" Or s = "n-r" Then NormalizeToYN_BlankIsN = "Y": Exit Function

    If s = "notanswered" Or s = "notanswer" Then NormalizeToYN_BlankIsN = "N": Exit Function

    'Unknown values -> treat as N
    NormalizeToYN_BlankIsN = "N"
End Function

'=========================================================
' Find header in specific row range
'=========================================================
Private Function FindHeaderInRow(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal headerText As String, _
                                 ByVal startCol As Long, ByVal endCol As Long) As Long
    Dim c As Long
    For c = startCol To endCol
        If Canonical(ws.Cells(headerRow, c).Text) = Canonical(headerText) Then
            FindHeaderInRow = c
            Exit Function
        End If
    Next c
    FindHeaderInRow = 0
End Function

Private Function Canonical(ByVal s As String) As String
    Dim i As Long, ch As String, out As String
    s = LCase$(Trim$(s))
    out = ""
    For i = 1 To Len(s)
        ch = Mid$(s, i, 1)
        If (ch >= "a" And ch <= "z") Or (ch >= "0" And ch <= "9") Then out = out & ch
    Next i
    Canonical = out
End Function

'=========================================================
' Folder picker
'=========================================================
Private Function PickFolder() As String
    Dim fd As FileDialog
    Set fd = Application.FileDialog(msoFileDialogFolderPicker)
    fd.Title = "Select folder containing Excel files"
    If fd.Show = -1 Then
        PickFolder = fd.SelectedItems(1)
    Else
        PickFolder = ""
    End If
End Function

'=========================================================
' Get or create worksheet
'=========================================================
Private Function GetOrCreateSheet(ByVal wb As Workbook, ByVal sheetName As String) As Worksheet
    On Error Resume Next
    Set GetOrCreateSheet = wb.Worksheets(sheetName)
    On Error GoTo 0
    If GetOrCreateSheet Is Nothing Then
        Set GetOrCreateSheet = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))
        GetOrCreateSheet.Name = sheetName
    End If
End Function

'=========================================================
' Log helper
'=========================================================
Private Sub LogLine(ByVal logWs As Worksheet, ByVal fileName As String, ByVal status As String, ByVal notes As String)
    Dim lr As Long
    lr = logWs.Cells(logWs.Rows.Count, "A").End(xlUp).Row + 1
    logWs.Cells(lr, 1).Value = fileName
    logWs.Cells(lr, 2).Value = status
    logWs.Cells(lr, 3).Value = notes
End Sub