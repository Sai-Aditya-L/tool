Option Explicit

'===========================================================
' SINGLE-RUN MASTER VBA (ONE MODULE) - COMPILE-SAFE
'
' What this does, in ONE RUN:
' 1) Build Consolidated Apps List (inventory)  -> Sheet: Consolidated
' 1.1) FIX Consolidated: remove rows where App ID (col A) is blank
' 2) Build Combined Metrics                    -> Sheet: Combined Metrics
' 2.1) Clean Combined Metrics (remove junk rows)
' 3) Build Simple Compliance                   -> Sheet: Simple Compliance
' 3.1) Clean Simple Compliance (remove junk rows BEFORE summaries)
' 4) Build Summaries from Simple Compliance:
'    - App-SubDomain Compliance (IT Function FIRST column)
'    - App Compliance Summary
'    - IT-Policy Compliance Summary
' 5) Export ALL required tables to Access (NO DROPS):
'    - Creates tables once (if missing)
'    - Each run: DELETE rows then INSERT fresh rows (keeps relationships/indexes)
'    - Pulls additional tables from external workbooks in the selected folder
'
' NOTE:
' - Uses late-binding for ADO/ADOX (no reference required).
' - If your machine doesn't have the ACE provider, install "Microsoft Access Database Engine".
'===========================================================

'=========================
' CONFIG: UPDATE THIS PATH
'=========================
Private Const ACCESS_DB_PATH As String = "C:\Path\YourDatabase.accdb" '<< CHANGE THIS

'===========================================================
' MAIN: ONE-CLICK RUN
'===========================================================
Public Sub Run_All_PowerBI_Builds()
    Const DEBUG_MODE As Boolean = True

    Dim folderPath As String
    folderPath = PickFolderSafe()
    If Len(folderPath) = 0 Then Exit Sub
    If Right$(folderPath, 1) <> "\" Then folderPath = folderPath & "\"

    Dim logWs As Worksheet
    Set logWs = GetOrCreateSheet(ThisWorkbook, "Log")
    EnsureLogHeader logWs
    LogLine logWs, "Run_All_PowerBI_Builds", "Start", "Folder: " & folderPath

    Dim oldSU As Boolean, oldDA As Boolean, oldEE As Boolean
    oldSU = Application.ScreenUpdating
    oldDA = Application.DisplayAlerts
    oldEE = Application.EnableEvents

    On Error GoTo CleanFail
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.EnableEvents = False

    '0) Consolidated Apps List (inventory)
    Build_ConsolidatedAppsList_FromFolder folderPath, logWs

    '0.5) CONSOLIDATED FIX: remove rows where App ID is blank/empty
    Clean_Consolidated_RemoveBlankAppID logWs

    '1) Combined Metrics
    Build_CombinedMetrics_FromFolder folderPath, DEBUG_MODE, logWs

    '1.5) Clean Combined Metrics
    Clean_Combined_Metrics logWs

    '2) Simple Compliance
    Build_SimpleCompliance_FromFolder folderPath, logWs

    '2.5) Clean Simple Compliance BEFORE summaries
    Clean_Simple_Compliance logWs

    '3) Summaries
    Build_AppAndSubdomain_Summaries_FromSimpleCompliance logWs
    Build_ITPolicy_Summary_FromSimpleCompliance logWs

    '4) Export everything to Access (create once, refresh data each run)
    Export_All_To_Access_NoDrops ACCESS_DB_PATH, folderPath, logWs

    LogLine logWs, "Run_All_PowerBI_Builds", "OK", "Completed successfully."
    MsgBox "All done ✅" & vbCrLf & _
           "Excel sheets built and Access tables refreshed (no drops).", vbInformation

CleanExit:
    Application.ScreenUpdating = oldSU
    Application.DisplayAlerts = oldDA
    Application.EnableEvents = oldEE
    Exit Sub

CleanFail:
    Dim msg As String
    msg = "Error " & Err.Number & ": " & Err.Description
    LogLine logWs, "Run_All_PowerBI_Builds", "Error", msg
    MsgBox msg, vbCritical, "Macro failed"
    Resume CleanExit
End Sub

'===========================================================
' PART 0: CONSOLIDATED APPS LIST (inventory)
' Output: Sheet "Consolidated"
' Columns: App ID | App Name | DAI ID | Data Class | IT Function | Source File
'===========================================================
Private Sub Build_ConsolidatedAppsList_FromFolder(ByVal folderPath As String, ByVal logWs As Worksheet)
    On Error GoTo Fail

    Dim dest As Worksheet
    Set dest = GetOrCreateSheet(ThisWorkbook, "Consolidated")
    dest.Cells.Clear
    dest.Range("A1:F1").Value = Array("App ID", "App Name", "DAI ID", "Data Class", "IT Function", "Source File")
    dest.Rows(1).Font.Bold = True
    dest.Columns("A:F").NumberFormat = "@"

    Dim destRow As Long: destRow = 1

    Dim fileName As String, fullPath As String
    Dim wb As Workbook, ws As Worksheet

    fileName = Dir(folderPath & "*.xls*")
    Do While Len(fileName) > 0
        fullPath = folderPath & fileName

        'Do not open the macro workbook itself if it's in the folder
        If StrComp(fullPath, ThisWorkbook.FullName, vbTextCompare) <> 0 Then
            On Error GoTo FileError
            Set wb = Workbooks.Open(fileName:=fullPath, ReadOnly:=True, UpdateLinks:=False)

            Set ws = GetTemplateSheet(wb)
            If ws Is Nothing Then
                LogLine logWs, fileName, "Skipped", "Consolidated: Template sheet not found."
                GoTo CloseAndNext
            End If

            Dim cellAppNameLbl As Range, cellITFuncLbl As Range
            Dim cellAppIdLbl As Range, cellDataClassLbl As Range, cellDaiIdLbl As Range

            Set cellAppNameLbl = FindTextCell(ws, "Application Name")
            Set cellITFuncLbl = FindTextCell(ws, "IT Function")
            Set cellAppIdLbl = FindTextCell(ws, "app id")
            Set cellDataClassLbl = FindTextCell(ws, "data class")
            Set cellDaiIdLbl = FindTextCell(ws, "DAI ID")

            If cellAppNameLbl Is Nothing Or cellAppIdLbl Is Nothing Then
                LogLine logWs, fileName, "Skipped", "Consolidated: Missing required labels (Application Name / app id)."
                GoTo CloseAndNext
            End If

            Dim rowAppName As Long, rowITFunc As Long, rowAppId As Long, rowDataClass As Long, rowDaiId As Long
            rowAppName = cellAppNameLbl.Row
            rowITFunc = IIf(cellITFuncLbl Is Nothing, 0, cellITFuncLbl.Row)
            rowAppId = cellAppIdLbl.Row
            rowDataClass = IIf(cellDataClassLbl Is Nothing, 0, cellDataClassLbl.Row)
            rowDaiId = IIf(cellDaiIdLbl Is Nothing, 0, cellDaiIdLbl.Row)

            Dim labelCol As Long, startCol As Long, endCol As Long, c As Long
            labelCol = MinColNonZero(Array( _
                        cellAppNameLbl.Column, _
                        IIf(cellITFuncLbl Is Nothing, 0, cellITFuncLbl.Column), _
                        cellAppIdLbl.Column, _
                        IIf(cellDataClassLbl Is Nothing, 0, cellDataClassLbl.Column), _
                        IIf(cellDaiIdLbl Is Nothing, 0, cellDaiIdLbl.Column) _
                      ))
            startCol = labelCol + 1
            endCol = ws.Cells(rowAppName, ws.Columns.Count).End(xlToLeft).Column
            If endCol < startCol Then
                LogLine logWs, fileName, "Skipped", "Consolidated: No app columns found."
                GoTo CloseAndNext
            End If

            For c = startCol To endCol
                Dim appName As String, itFunc As String, appId As String, dataClass As String, daiId As String
                appName = Trim$(ws.Cells(rowAppName, c).Text)
                If Len(appName) = 0 Then GoTo NextCol

                itFunc = IIf(rowITFunc = 0, "", Trim$(ws.Cells(rowITFunc, c).Text))
                appId = Trim$(ws.Cells(rowAppId, c).Text)
                dataClass = IIf(rowDataClass = 0, "", Trim$(ws.Cells(rowDataClass, c).Text))
                daiId = IIf(rowDaiId = 0, "", Trim$(ws.Cells(rowDaiId, c).Text))

                destRow = destRow + 1
                dest.Cells(destRow, 1).Value = appId
                dest.Cells(destRow, 2).Value = appName
                dest.Cells(destRow, 3).Value = daiId
                dest.Cells(destRow, 4).Value = dataClass
                dest.Cells(destRow, 5).Value = itFunc
                dest.Cells(destRow, 6).Value = fileName

NextCol:
            Next c

            LogLine logWs, fileName, "OK", "Consolidated imported."
CloseAndNext:
            On Error Resume Next
            wb.Close SaveChanges:=False
            On Error GoTo 0
            Set wb = Nothing
            Set ws = Nothing
        End If

        fileName = Dir()
        DoEvents
    Loop

    dest.Columns.AutoFit
    Exit Sub

FileError:
    LogLine logWs, fileName, "Error", "Consolidated: " & Err.Number & " - " & Err.Description
    On Error Resume Next
    If Not wb Is Nothing Then wb.Close SaveChanges:=False
    On Error GoTo 0
    Resume CloseAndNext

Fail:
    LogLine logWs, "Build_ConsolidatedAppsList_FromFolder", "Error", Err.Number & " - " & Err.Description
End Sub

'===========================================================
' CONSOLIDATED FIX:
' Remove rows where App ID (Col A) is blank/empty
' (this matches your screenshot where every other row had blank App ID)
'===========================================================
Private Sub Clean_Consolidated_RemoveBlankAppID(ByVal logWs As Worksheet)
    On Error GoTo Fail

    Dim ws As Worksheet
    Set ws = ThisWorkbook.Worksheets("Consolidated")

    Dim lastRow As Long
    lastRow = ws.Cells(ws.Rows.Count, "A").End(xlUp).Row
    If lastRow < 2 Then
        LogLine logWs, "Clean_Consolidated", "Skipped", "No rows."
        Exit Sub
    End If

    Dim r As Long, removed As Long
    removed = 0

    For r = lastRow To 2 Step -1
        If Len(Trim$(CStr(ws.Cells(r, 1).Value))) = 0 Then
            ws.Rows(r).Delete
            removed = removed + 1
        End If
    Next r

    LogLine logWs, "Clean_Consolidated", "OK", "Removed blank App ID rows: " & removed
    Exit Sub

Fail:
    LogLine logWs, "Clean_Consolidated", "Error", Err.Number & " - " & Err.Description
End Sub

'===========================================================
' PART 1: COMBINED METRICS
'===========================================================
Private Sub Build_CombinedMetrics_FromFolder(ByVal folderPath As String, ByVal DEBUG_MODE As Boolean, ByVal logWs As Worksheet)
    Dim metricHeaders As Variant
    metricHeaders = Array( _
        "Access Control", _
        "Configuration Management", _
        "Cryptographic Protection", _
        "Network Security", _
        "Non-Prod Environment Controls", _
        "Protection of Systems and Communications", _
        "Secure Authentication", _
        "System Logging & Monitoring", _
        "System Security Testing", _
        "Vulnerability management & Scanning", _
        "Disaster Recovery" _
    )

    Dim outWs As Worksheet
    Set outWs = GetOrCreateSheet(ThisWorkbook, "Combined Metrics")
    outWs.Cells.Clear

    Dim dbgWs As Worksheet
    If DEBUG_MODE Then
        Set dbgWs = GetOrCreateSheet(ThisWorkbook, "Debug_N_Triggers")
        dbgWs.Cells.Clear
        dbgWs.Range("A1:I1").Value = Array("Source File", "IT Function", "App Name", "Metric", "Trigger Question ID", "Raw Response", "Normalized", "Template Row", "Notes")
        dbgWs.Rows(1).Font.Bold = True
    End If

    outWs.Range("A1:D1").Value = Array("IT Function", "Application/Site Name", "Data Class", "Number of Asset")

    Dim m As Long
    For m = LBound(metricHeaders) To UBound(metricHeaders)
        outWs.Cells(1, 5 + m).Value = metricHeaders(m)
    Next m

    Dim hiddenStartCol As Long
    hiddenStartCol = 5 + (UBound(metricHeaders) + 1)
    outWs.Cells(1, hiddenStartCol).Value = "App ID"
    outWs.Cells(1, hiddenStartCol + 1).Value = "DAI ID"
    outWs.Cells(1, hiddenStartCol + 2).Value = "Source File"

    outWs.Rows(1).Font.Bold = True
    outWs.Columns.NumberFormat = "@"

    Dim fileName As String, fullPath As String
    Dim wb As Workbook, ws As Worksheet
    Dim outRow As Long: outRow = 1

    fileName = Dir(folderPath & "*.xls*")
    Do While Len(fileName) > 0
        fullPath = folderPath & fileName

        If StrComp(fullPath, ThisWorkbook.FullName, vbTextCompare) <> 0 Then
            On Error GoTo FileError
            Set wb = Workbooks.Open(fileName:=fullPath, ReadOnly:=True, UpdateLinks:=False)

            Set ws = GetTemplateSheet(wb)
            If ws Is Nothing Then
                LogLine logWs, fileName, "Skipped", "Combined: Template sheet not found."
                GoTo CloseAndNext
            End If

            Dim polSubCol As Long, qidCol As Long, lastRow As Long
            polSubCol = FindHeaderInRow(ws, 3, "Policy Sub-Domain", 1, 60)
            If polSubCol = 0 Then
                LogLine logWs, fileName, "Skipped", "Combined: Could not find 'Policy Sub-Domain' in row 3."
                GoTo CloseAndNext
            End If

            qidCol = FindHeaderInRow(ws, 3, "Question ID", 1, 60)
            If qidCol = 0 Then qidCol = FindHeaderInRow(ws, 3, "QuestionID", 1, 60)

            lastRow = ws.Cells(ws.Rows.Count, polSubCol).End(xlUp).Row
            If lastRow < 7 Then
                LogLine logWs, fileName, "Skipped", "Combined: No data rows found (expected from row 7)."
                GoTo CloseAndNext
            End If

            Dim firstAppCol As Long, lastAppCol As Long, respCol As Long
            firstAppCol = 8
            lastAppCol = ws.Cells(2, ws.Columns.Count).End(xlToLeft).Column
            If lastAppCol < firstAppCol Then
                LogLine logWs, fileName, "Skipped", "Combined: No app columns found."
                GoTo CloseAndNext
            End If

            For respCol = firstAppCol To lastAppCol
                If IsCommentsColumn(ws, respCol) Then GoTo NextApp

                Dim appName As String, itFunc As String, dataClass As String
                Dim appId As String, daiId As String, numAsset As String

                appName = Trim$(ws.Cells(2, respCol).Text)
                If Len(appName) = 0 Then GoTo NextApp

                itFunc = Trim$(ws.Cells(1, respCol).Text)
                dataClass = Trim$(ws.Cells(5, respCol).Text)
                appId = Trim$(ws.Cells(4, respCol).Text)
                daiId = Trim$(ws.Cells(6, respCol).Text)
                numAsset = GetValueForLabel(ws, "Number of Asset", respCol, 1, 200, 8)

                outRow = outRow + 1
                outWs.Cells(outRow, 1).Value = itFunc
                outWs.Cells(outRow, 2).Value = appName
                outWs.Cells(outRow, 3).Value = dataClass
                outWs.Cells(outRow, 4).Value = numAsset

                For m = LBound(metricHeaders) To UBound(metricHeaders)
                    Dim trigQid As String, trigRaw As String, trigNorm As String, trigRow As Long
                    Dim yn As String

                    yn = ComputeMetricYN(ws, 7, lastRow, polSubCol, qidCol, respCol, CStr(metricHeaders(m)), _
                                        trigQid, trigRaw, trigNorm, trigRow)

                    outWs.Cells(outRow, 5 + m).Value = yn

                    If DEBUG_MODE Then
                        If yn = "N" Then
                            LogDebug dbgWs, fileName, itFunc, appName, CStr(metricHeaders(m)), trigQid, trigRaw, trigNorm, trigRow
                        End If
                    End If
                Next m

                outWs.Cells(outRow, hiddenStartCol).Value = appId
                outWs.Cells(outRow, hiddenStartCol + 1).Value = daiId
                outWs.Cells(outRow, hiddenStartCol + 2).Value = fileName

NextApp:
            Next respCol

            LogLine logWs, fileName, "OK", "Combined updated."

CloseAndNext:
            On Error Resume Next
            wb.Close SaveChanges:=False
            On Error GoTo 0
            Set wb = Nothing
            Set ws = Nothing
        End If

        fileName = Dir()
        DoEvents
    Loop

    ApplyMetricsFormatting outWs, 1, outRow, 5, 5 + UBound(metricHeaders)
    outWs.Columns(hiddenStartCol).Hidden = True
    outWs.Columns(hiddenStartCol + 1).Hidden = True
    outWs.Columns(hiddenStartCol + 2).Hidden = True
    outWs.Columns.AutoFit
    Exit Sub

FileError:
    LogLine logWs, fileName, "Error", "Combined: " & Err.Number & " - " & Err.Description
    On Error Resume Next
    If Not wb Is Nothing Then wb.Close SaveChanges:=False
    On Error GoTo 0
    Resume CloseAndNext
End Sub

Private Function ComputeMetricYN(ByVal ws As Worksheet, ByVal rStart As Long, ByVal rEnd As Long, _
                                 ByVal polSubCol As Long, ByVal qidCol As Long, ByVal respCol As Long, _
                                 ByVal metricName As String, _
                                 ByRef outTriggerQid As String, ByRef outTriggerRaw As String, _
                                 ByRef outTriggerNorm As String, ByRef outTriggerRow As Long) As String
    Dim r As Long, anyY As Boolean
    anyY = False
    outTriggerQid = "": outTriggerRaw = "": outTriggerNorm = "": outTriggerRow = 0

    For r = rStart To rEnd
        If Canonical(ws.Cells(r, polSubCol).Text) = Canonical(metricName) Then
            Dim qid As String, raw As String, yn As String
            qid = IIf(qidCol > 0, Trim$(CStr(ws.Cells(r, qidCol).Text)), "")
            raw = CStr(ws.Cells(r, respCol).Text)

            yn = NormalizeToYN_WithFlip(raw, qid)

            If yn = "N" Then
                outTriggerQid = qid
                outTriggerRaw = Trim$(raw)
                outTriggerNorm = "N"
                outTriggerRow = r
                ComputeMetricYN = "N"
                Exit Function
            ElseIf yn = "Y" Then
                anyY = True
            End If
        End If
    Next r

    If anyY Then
        ComputeMetricYN = "Y"
    Else
        ComputeMetricYN = ""
    End If
End Function

'===========================================================
' CLEAN: COMBINED METRICS
' removes extra header/separator rows like row 2/16/23 etc.
'===========================================================
Private Sub Clean_Combined_Metrics(ByVal logWs As Worksheet)
    On Error GoTo Fail

    Dim ws As Worksheet
    Set ws = ThisWorkbook.Worksheets("Combined Metrics")

    Dim lastRow As Long
    lastRow = ws.Cells(ws.Rows.Count, "B").End(xlUp).Row
    If lastRow < 2 Then
        LogLine logWs, "Clean_Combined_Metrics", "Skipped", "No rows."
        Exit Sub
    End If

    Dim r As Long, removed As Long
    removed = 0

    For r = lastRow To 2 Step -1
        Dim a As String, b As String, c As String
        a = LCase$(Trim$(CStr(ws.Cells(r, 1).Value)))
        b = LCase$(Trim$(CStr(ws.Cells(r, 2).Value)))
        c = LCase$(Trim$(CStr(ws.Cells(r, 3).Value)))

        If a = "it function" Then ws.Rows(r).Delete: removed = removed + 1: GoTo NextR
        If b = "application name" Or b = "application/site name" Or b = "application/site" Then ws.Rows(r).Delete: removed = removed + 1: GoTo NextR
        If c = "data class" Or c = "dataclass" Then ws.Rows(r).Delete: removed = removed + 1: GoTo NextR
        If Len(b) = 0 Then ws.Rows(r).Delete: removed = removed + 1: GoTo NextR

NextR:
    Next r

    LogLine logWs, "Clean_Combined_Metrics", "OK", "Removed rows: " & removed
    Exit Sub

Fail:
    LogLine logWs, "Clean_Combined_Metrics", "Error", Err.Number & " - " & Err.Description
End Sub

'===========================================================
' PART 2: SIMPLE COMPLIANCE (row-level)
'===========================================================
Private Sub Build_SimpleCompliance_FromFolder(ByVal folderPath As String, ByVal logWs As Worksheet)
    Dim outWs As Worksheet
    Set outWs = GetOrCreateSheet(ThisWorkbook, "Simple Compliance")
    outWs.Cells.Clear

    outWs.Range("A1:F1").Value = Array("IT Function", "App Name", "Data Class", "Question ID", "Policy Sub-Domain", "Compliance")
    outWs.Rows(1).Font.Bold = True
    outWs.Columns.NumberFormat = "@"

    Dim outRow As Long: outRow = 1

    Dim fileName As String, fullPath As String
    Dim wb As Workbook, ws As Worksheet

    fileName = Dir(folderPath & "*.xls*")
    Do While Len(fileName) > 0
        fullPath = folderPath & fileName

        If StrComp(fullPath, ThisWorkbook.FullName, vbTextCompare) <> 0 Then
            On Error GoTo FileError
            Set wb = Workbooks.Open(fileName:=fullPath, ReadOnly:=True, UpdateLinks:=False)

            Set ws = GetTemplateSheet(wb)
            If ws Is Nothing Then
                LogLine logWs, fileName, "Skipped", "Simple: Template sheet not found."
                GoTo CloseAndNext
            End If

            Dim qidCol As Long, polSubCol As Long, lastRow As Long
            qidCol = FindHeaderInRow(ws, 3, "Question ID", 1, 60)
            If qidCol = 0 Then qidCol = FindHeaderInRow(ws, 3, "QuestionID", 1, 60)
            polSubCol = FindHeaderInRow(ws, 3, "Policy Sub-Domain", 1, 60)

            If qidCol = 0 Then
                LogLine logWs, fileName, "Skipped", "Simple: Could not find 'Question ID' in row 3."
                GoTo CloseAndNext
            End If

            lastRow = ws.Cells(ws.Rows.Count, qidCol).End(xlUp).Row
            If lastRow < 7 Then
                LogLine logWs, fileName, "Skipped", "Simple: No data rows found (expected from row 7)."
                GoTo CloseAndNext
            End If

            Dim lastAppCol As Long, appCol As Long, r As Long
            lastAppCol = ws.Cells(2, ws.Columns.Count).End(xlToLeft).Column

            Dim firstAppCol As Long
            firstAppCol = 9
            If lastAppCol < firstAppCol Then firstAppCol = 8
            If lastAppCol < firstAppCol Then
                LogLine logWs, fileName, "Skipped", "Simple: No app columns found."
                GoTo CloseAndNext
            End If

            For appCol = firstAppCol To lastAppCol
                Dim itFunc As String, appName As String, dataClass As String
                itFunc = Trim$(ws.Cells(1, appCol).Text)
                appName = Trim$(ws.Cells(2, appCol).Text)
                dataClass = Trim$(ws.Cells(5, appCol).Text)
                If Len(appName) = 0 Then GoTo NextApp

                For r = 7 To lastRow
                    Dim qid As String, polSub As String, raw As String, comp As String
                    qid = Trim$(ws.Cells(r, qidCol).Text)
                    If Len(qid) = 0 Then GoTo NextRow

                    polSub = IIf(polSubCol > 0, Trim$(ws.Cells(r, polSubCol).Text), "")
                    raw = Trim$(ws.Cells(r, appCol).Text)
                    comp = NormalizeToYN_WithFlip(raw, qid)

                    outRow = outRow + 1
                    outWs.Cells(outRow, 1).Value = itFunc
                    outWs.Cells(outRow, 2).Value = appName
                    outWs.Cells(outRow, 3).Value = dataClass
                    outWs.Cells(outRow, 4).Value = qid
                    outWs.Cells(outRow, 5).Value = polSub
                    outWs.Cells(outRow, 6).Value = comp
NextRow:
                Next r
NextApp:
            Next appCol

            LogLine logWs, fileName, "OK", "Simple updated."

CloseAndNext:
            On Error Resume Next
            wb.Close SaveChanges:=False
            On Error GoTo 0
            Set wb = Nothing
            Set ws = Nothing
        End If

        fileName = Dir()
        DoEvents
    Loop

    outWs.Columns.AutoFit
    Exit Sub

FileError:
    LogLine logWs, fileName, "Error", "Simple: " & Err.Number & " - " & Err.Description
    On Error Resume Next
    If Not wb Is Nothing Then wb.Close SaveChanges:=False
    On Error GoTo 0
    Resume CloseAndNext
End Sub

'===========================================================
' CLEAN: SIMPLE COMPLIANCE BEFORE SUMMARIES
'===========================================================
Private Sub Clean_Simple_Compliance(ByVal logWs As Worksheet)
    On Error GoTo Fail

    Dim ws As Worksheet
    Set ws = ThisWorkbook.Worksheets("Simple Compliance")

    Dim lastRow As Long
    lastRow = ws.Cells(ws.Rows.Count, "A").End(xlUp).Row
    If lastRow < 2 Then
        LogLine logWs, "Clean_Simple_Compliance", "Skipped", "No rows."
        Exit Sub
    End If

    Dim r As Long, removed As Long
    removed = 0

    For r = lastRow To 2 Step -1
        Dim itf As String, app As String, dc As String, qid As String, psd As String
        itf = LCase$(Trim$(CStr(ws.Cells(r, 1).Value)))
        app = LCase$(Trim$(CStr(ws.Cells(r, 2).Value)))
        dc = Trim$(CStr(ws.Cells(r, 3).Value))
        qid = Trim$(CStr(ws.Cells(r, 4).Value))
        psd = Trim$(CStr(ws.Cells(r, 5).Value))

        If itf = "it function" Then ws.Rows(r).Delete: removed = removed + 1: GoTo NextR
