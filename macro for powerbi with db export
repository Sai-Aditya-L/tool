'===========================================================
' PART 4: EXPORT TO ACCESS (CREATE ONCE, REFRESH DATA EACH RUN)
'
' External workbook layout (your mapping):
' - Control Group/Questions -> File: All Template Questions One Tab v2.0*  Sheet: outputTemplate -Power BI Upload
' - Categories1             -> File: Question ID and Risk Rating Mapping*    Sheet: outputTemplate -Power BI Upload
' - Riskid                  -> File: Riskid*                                Sheet: Riskid
' - Russia,BSS,AN,CDS,China,Core_dx,DTS,EPD,RMDx -> File: Macros* sheets same names
'===========================================================
Private Sub Export_All_To_Access_NoDrops(ByVal accdbPath As String, ByVal folderPath As String, ByVal logWs As Worksheet)
    On Error GoTo Fail

    If Right$(folderPath, 1) <> "\" Then folderPath = folderPath & "\"

    If Len(Trim$(accdbPath)) = 0 Then Err.Raise vbObjectError + 1, , "ACCESS_DB_PATH is blank."
    If Dir(accdbPath) = "" Then Err.Raise vbObjectError + 2, , "Access DB not found at: " & accdbPath

    Dim cnn As Object
    Set cnn = CreateObject("ADODB.Connection")

    Dim connStr As String
    connStr = "Provider=Microsoft.ACE.OLEDB.12.0;" & _
              "Data Source=" & accdbPath & ";" & _
              "Persist Security Info=False;"
    cnn.Open connStr

    'Use a transaction for speed + safety
    On Error Resume Next
    cnn.BeginTrans
    On Error GoTo Fail

    'A) This workbook outputs
    Access_RefreshTableFromSheet cnn, ThisWorkbook.Worksheets("Consolidated"), "t_Consolidated", True
    Access_RefreshTableFromSheet cnn, ThisWorkbook.Worksheets("Combined Metrics"), "t_CombinedMetrics", False
    Access_RefreshTableFromSheet cnn, ThisWorkbook.Worksheets("Simple Compliance"), "t_SimpleCompliance", False
    Access_RefreshTableFromSheet cnn, ThisWorkbook.Worksheets("App Compliance Summary"), "t_AppComplianceSummary", False
    Access_RefreshTableFromSheet cnn, ThisWorkbook.Worksheets("App-SubDomain Compliance"), "t_AppSubDomainCompliance", False
    Access_RefreshTableFromSheet cnn, ThisWorkbook.Worksheets("IT-Policy Compliance Summary"), "t_ITPolicyComplianceSummary", False

    LogLine logWs, "Export", "OK", "Local tables refreshed."

    'B) External workbooks in selected folder
    Dim p1 As String, p2 As String, p3 As String, p4 As String

    p1 = FindWorkbookByNameInFolder(folderPath, "All Template Questions One Tab v2.0")
    If Len(p1) > 0 Then
        Upsert_FromExternalWorkbook_NoDrops cnn, p1, "outputTemplate -Power BI Upload", "t_ControlGroupQuestions", logWs
    Else
        LogLine logWs, "Export", "Skipped", "Missing file: All Template Questions One Tab v2.0"
    End If

    p2 = FindWorkbookByNameInFolder(folderPath, "Question ID and Risk Rating Mapping")
    If Len(p2) > 0 Then
        Upsert_FromExternalWorkbook_NoDrops cnn, p2, "outputTemplate -Power BI Upload", "t_Categories1", logWs
    Else
        LogLine logWs, "Export", "Skipped", "Missing file: Question ID and Risk Rating Mapping"
    End If

    p3 = FindWorkbookByNameInFolder(folderPath, "Riskid")
    If Len(p3) > 0 Then
        Upsert_FromExternalWorkbook_NoDrops cnn, p3, "Riskid", "t_Riskid", logWs
    Else
        LogLine logWs, "Export", "Skipped", "Missing file: Riskid"
    End If

    p4 = FindWorkbookByNameInFolder(folderPath, "Macros")
    If Len(p4) > 0 Then
        Upsert_FromExternalWorkbook_NoDrops cnn, p4, "Russia", "t_Russia", logWs
        Upsert_FromExternalWorkbook_NoDrops cnn, p4, "BSS", "t_BSS", logWs
        Upsert_FromExternalWorkbook_NoDrops cnn, p4, "AN", "t_AN", logWs
        Upsert_FromExternalWorkbook_NoDrops cnn, p4, "CDS", "t_CDS", logWs
        Upsert_FromExternalWorkbook_NoDrops cnn, p4, "China", "t_China", logWs
        Upsert_FromExternalWorkbook_NoDrops cnn, p4, "Core_dx", "t_Core_dx", logWs
        Upsert_FromExternalWorkbook_NoDrops cnn, p4, "DTS", "t_DTS", logWs
        Upsert_FromExternalWorkbook_NoDrops cnn, p4, "EPD", "t_EPD", logWs
        Upsert_FromExternalWorkbook_NoDrops cnn, p4, "RMDx", "t_RMDx", logWs
    Else
        LogLine logWs, "Export", "Skipped", "Missing file: Macros"
    End If

    cnn.CommitTrans
    cnn.Close
    Set cnn = Nothing

    LogLine logWs, "Export_All_To_Access_NoDrops", "OK", "Access refresh completed: " & accdbPath
    Exit Sub

Fail:
    On Error Resume Next
    If Not cnn Is Nothing Then
        cnn.RollbackTrans
        cnn.Close
    End If
    On Error GoTo 0
    LogLine logWs, "Export_All_To_Access_NoDrops", "Error", Err.Number & " - " & Err.Description
    Err.Raise Err.Number, Err.Source, Err.Description
End Sub

Private Sub Upsert_FromExternalWorkbook_NoDrops(ByVal cnn As Object, ByVal fullPath As String, ByVal sheetName As String, ByVal tableName As String, ByVal logWs As Worksheet)
    Dim wb As Workbook, ws As Worksheet
    On Error GoTo Fail

    Set wb = Workbooks.Open(fileName:=fullPath, ReadOnly:=True, UpdateLinks:=False)
    Set ws = GetSheetByNameLoose(wb, sheetName)

    If ws Is Nothing Then
        LogLine logWs, wb.Name, "Skipped", "Sheet not found: " & sheetName
        GoTo CleanExit
    End If

    Access_RefreshTableFromSheet cnn, ws, tableName, False
    LogLine logWs, wb.Name, "OK", "Refreshed " & sheetName & " -> " & tableName

CleanExit:
    On Error Resume Next
    wb.Close SaveChanges:=False
    On Error GoTo 0
    Exit Sub

Fail:
    LogLine logWs, fullPath, "Error", "External refresh failed (" & sheetName & "): " & Err.Number & " - " & Err.Description
    On Error Resume Next
    If Not wb Is Nothing Then wb.Close SaveChanges:=False
End Sub

'===========================================================
' ACCESS REFRESH CORE (NO DROPS) - COMPILE-SAFE
'
' - Create table once (TEXT fields) if missing
' - Ensure columns exist
' - DELETE rows
' - INSERT fresh rows
'
' skipBlankFirstColRows:
'   True  -> ignores rows where column A is blank (useful for Consolidated)
'   False -> inserts all rows
'===========================================================
Private Sub Access_RefreshTableFromSheet(ByVal cnn As Object, ByVal ws As Worksheet, ByVal tableName As String, _
                                        Optional ByVal skipBlankFirstColRows As Boolean = False)

    Dim lastRow As Long, lastCol As Long
    lastCol = ws.Cells(1, ws.Columns.Count).End(xlToLeft).Column
    If lastCol < 1 Then Exit Sub

    lastRow = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row
    If lastRow < 1 Then Exit Sub

    Dim headers() As String
    headers = GetUniqueCleanHeaders(ws, lastCol)  '1..lastCol

    If Not Access_TableExists(cnn, tableName) Then
        Access_CreateTable cnn, tableName, headers
    Else
        Access_EnsureColumnsExist cnn, tableName, headers
    End If

    'Refresh rows (keep table/relationships/indexes)
    cnn.Execute "DELETE FROM [" & tableName & "];"

    If lastRow >= 2 Then
        Access_InsertAllRows cnn, ws, tableName, headers, lastRow, lastCol, skipBlankFirstColRows
    End If
End Sub

Private Function Access_TableExists(ByVal cnn As Object, ByVal tableName As String) As Boolean
    On Error GoTo Nope

    'ADOX Catalog works well even for brand-new empty DBs
    Dim cat As Object, t As Object
    Set cat = CreateObject("ADOX.Catalog")
    Set cat.ActiveConnection = cnn

    For Each t In cat.Tables
        If LCase$(t.Name) = LCase$(tableName) Then
            Access_TableExists = True
            Exit Function
        End If
    Next t

    Access_TableExists = False
    Exit Function

Nope:
    'Fallback: try open
    On Error Resume Next
    Dim rs As Object
    Set rs = CreateObject("ADODB.Recordset")
    rs.Open "SELECT * FROM [" & tableName & "] WHERE 1=0;", cnn, 0, 1
    Access_TableExists = (Err.Number = 0)
    Err.Clear
    On Error GoTo 0
    If Not rs Is Nothing Then
        On Error Resume Next
        rs.Close
        Set rs = Nothing
        On Error GoTo 0
    End If
End Function

Private Sub Access_CreateTable(ByVal cnn As Object, ByVal tableName As String, ByVal headers() As String)
    Dim sql As String, c As Long
    sql = "CREATE TABLE [" & tableName & "] ("
    For c = LBound(headers) To UBound(headers)
        sql = sql & "[" & headers(c) & "] TEXT(255),"
    Next c
    sql = Left$(sql, Len(sql) - 1) & ");"
    cnn.Execute sql
End Sub

Private Sub Access_EnsureColumnsExist(ByVal cnn As Object, ByVal tableName As String, ByVal headers() As String)
    Dim existing As Object
    Set existing = CreateObject("Scripting.Dictionary")

    Dim rs As Object, i As Long
    Set rs = CreateObject("ADODB.Recordset")
    rs.Open "SELECT * FROM [" & tableName & "] WHERE 1=0;", cnn, 0, 1

    For i = 0 To rs.Fields.Count - 1
        existing(LCase$(rs.Fields(i).Name)) = True
    Next i
    rs.Close
    Set rs = Nothing

    Dim c As Long, colName As String
    For c = LBound(headers) To UBound(headers)
        colName = headers(c)
        If Not existing.Exists(LCase$(colName)) Then
            cnn.Execute "ALTER TABLE [" & tableName & "] ADD COLUMN [" & colName & "] TEXT(255);"
        End If
    Next c
End Sub

Private Sub Access_InsertAllRows(ByVal cnn As Object, ByVal ws As Worksheet, ByVal tableName As String, _
                                ByVal headers() As String, ByVal lastRow As Long, ByVal lastCol As Long, _
                                ByVal skipBlankFirstColRows As Boolean)

    Dim colList As String, c As Long
    colList = ""
    For c = 1 To lastCol
        colList = colList & "[" & headers(c) & "],"
    Next c
    colList = Left$(colList, Len(colList) - 1)

    Dim r As Long
    For r = 2 To lastRow
        If skipBlankFirstColRows Then
            If Len(Trim$(CStr(ws.Cells(r, 1).Value))) = 0 Then GoTo NextR
        End If

        Dim valList As String
        valList = ""

        For c = 1 To lastCol
            Dim v As String
            v = CStr(ws.Cells(r, c).Value)
            v = Replace(v, "'", "''")
            valList = valList & "'" & v & "',"
        Next c
        valList = Left$(valList, Len(valList) - 1)

        cnn.Execute "INSERT INTO [" & tableName & "] (" & colList & ") VALUES (" & valList & ");"

NextR:
    Next r
End Sub

'===========================================================
' NORMALIZATION RULES
' - NA/NR -> Y
' - Blank/Not Answered -> N
' - Flip for SA.010.033 and SA.010.028
'===========================================================
Private Function NormalizeToYN_WithFlip(ByVal raw As String, Optional ByVal questionId As String = "") As String
    Dim s As String
    s = LCase$(Trim$(CStr(raw)))
    s = Replace(s, vbCr, "")
    s = Replace(s, vbLf, "")
    s = Replace(s, " ", "")

    If Len(s) = 0 Then NormalizeToYN_WithFlip = "N": Exit Function
    If s = "notanswered" Or s = "notanswer" Then NormalizeToYN_WithFlip = "N": Exit Function
    If s = "na" Or s = "n/a" Or s = "n-a" Then NormalizeToYN_WithFlip = "Y": Exit Function
    If s = "nr" Or s = "n/r" Or s = "n-r" Then NormalizeToYN_WithFlip = "Y": Exit Function

    Dim q As String
    q = Canonical(questionId)
    Dim isFlip As Boolean
    isFlip = (q = "sa010033" Or q = "sa010028")

    If s = "y" Or s = "yes" Then
        NormalizeToYN_WithFlip = IIf(isFlip, "N", "Y")
        Exit Function
    End If

    If s = "n" Or s = "no" Then
        NormalizeToYN_WithFlip = IIf(isFlip, "Y", "N")
        Exit Function
    End If

    NormalizeToYN_WithFlip = "N"
End Function

