'===========================================================
Private Sub ApplyMetricsFormatting(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal lastDataRow As Long, _
                                  ByVal metricsStartCol As Long, ByVal metricsEndCol As Long)
    If lastDataRow < headerRow + 1 Then Exit Sub

    With ws.Range(ws.Cells(headerRow, 1), ws.Cells(headerRow, metricsEndCol))
        .Interior.Color = RGB(0, 51, 102)
        .Font.Color = RGB(255, 255, 255)
        .Font.Bold = True
        .HorizontalAlignment = xlCenter
    End With

    Dim rng As Range
    Set rng = ws.Range(ws.Cells(headerRow + 1, metricsStartCol), ws.Cells(lastDataRow, metricsEndCol))
    rng.FormatConditions.Delete
    rng.HorizontalAlignment = xlCenter

    With rng.FormatConditions.Add(Type:=xlCellValue, Operator:=xlEqual, Formula1:="=""Y""")
        .Interior.Color = RGB(0, 176, 80)
        .Font.Color = RGB(255, 255, 255)
        .Font.Bold = True
    End With

    With rng.FormatConditions.Add(Type:=xlCellValue, Operator:=xlEqual, Formula1:="=""N""")
        .Interior.Color = RGB(255, 255, 255)
        .Font.Color = RGB(0, 0, 0)
        .Font.Bold = True
    End With

    ws.Range(ws.Cells(headerRow, 1), ws.Cells(lastDataRow, metricsEndCol)).Borders.LineStyle = xlContinuous
End Sub

