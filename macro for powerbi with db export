        If LCase$(dc) = "data class" Or LCase$(dc) = "dataclass" Then ws.Rows(r).Delete: removed = removed + 1: GoTo NextR

        If InStr(1, LCase$(qid), "row", vbTextCompare) > 0 Then ws.Rows(r).Delete: removed = removed + 1: GoTo NextR
        If Len(Trim$(dc)) = 0 Then ws.Rows(r).Delete: removed = removed + 1: GoTo NextR
