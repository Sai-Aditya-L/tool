    GetValueForLabel = ""
End Function

Private Function NzLong(ByVal dict As Object, ByVal key As Variant) As Long
    If dict Is Nothing Then
        NzLong = 0
    ElseIf dict.Exists(key) Then
        NzLong = CLng(dict(key))
    Else
        NzLong = 0
    End If
End Function

Private Function FindTextCell(ByVal ws As Worksheet, ByVal needle As String) As Range
    Dim r As Range
    On Error Resume Next
    Set r = ws.UsedRange.Find(What:=needle, LookIn:=xlValues, LookAt:=xlPart, _
                              SearchOrder:=xlByRows, SearchDirection:=xlNext, MatchCase:=False)
    On Error GoTo 0
    Set FindTextCell = r
End Function

Private Function MinColNonZero(ByVal cols As Variant) As Long
    Dim i As Long, v As Long, m As Long
    m = 0
    For i = LBound(cols) To UBound(cols)
        v = CLng(cols(i))
        If v > 0 Then
            If m = 0 Or v < m Then m = v
        End If
    Next i
    MinColNonZero = m
End Function

Private Function GetUniqueCleanHeaders(ByVal ws As Worksheet, ByVal lastCol As Long) As String()
    Dim used As Object
    Set used = CreateObject("Scripting.Dictionary")

    Dim arr() As String
    ReDim arr(1 To lastCol)

    Dim c As Long
    For c = 1 To lastCol
        Dim baseName As String, finalName As String, k As String, n As Long
        baseName = CleanAccessFieldName(CStr(ws.Cells(1, c).Value))
        If Len(baseName) = 0 Then baseName = "Col" & c

        'Access field names can't start with a number safely in some cases
        If Len(baseName) > 0 Then
            If Mid$(baseName, 1, 1) Like "#" Then baseName = "F_" & baseName
        End If

        'keep names reasonably short
        If Len(baseName) > 60 Then baseName = Left$(baseName, 60)

        k = LCase$(baseName)
        If Not used.Exists(k) Then
            used.Add k, 1
            finalName = baseName
        Else
            n = CLng(used(k)) + 1
            used(k) = n
            finalName = baseName & "_" & n
        End If
        arr(c) = finalName
    Next c

    GetUniqueCleanHeaders = arr
End Function

Private Function CleanAccessFieldName(ByVal s As String) As String
    Dim t As String
    t = Trim$(s)
    t = Replace(t, vbCr, " ")
    t = Replace(t, vbLf, " ")
    t = Replace(t, ".", "")
    t = Replace(t, "/", "_")
    t = Replace(t, "\", "_")
    t = Replace(t, "-", "_")
    t = Replace(t, "&", "and")
    t = Replace(t, "(", "")
    t = Replace(t, ")", "")
    t = Replace(t, "%", "pct")
    t = Replace(t, "#", "num")
    t = Application.WorksheetFunction.Trim(t)
    CleanAccessFieldName = t
End Function