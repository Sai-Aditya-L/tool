Option Explicit

'===========================================================
' MAIN: RUN EVERYTHING (Single macro)
'===========================================================
Public Sub Run_All_PowerBI_Builds()
    Const DEBUG_MODE As Boolean = True

    Dim folderPath As String
    folderPath = PickFolderSafe()
    If Len(folderPath) = 0 Then Exit Sub
    If Right$(folderPath, 1) <> "\" Then folderPath = folderPath & "\"

    Dim logWs As Worksheet
    Set logWs = GetOrCreateSheet(ThisWorkbook, "Log")
    EnsureLogHeader logWs
    LogLine logWs, "Run_All_PowerBI_Builds", "Start", "Folder: " & folderPath

    Dim oldSU As Boolean, oldDA As Boolean, oldEE As Boolean
    oldSU = Application.ScreenUpdating
    oldDA = Application.DisplayAlerts
    oldEE = Application.EnableEvents

    On Error GoTo CleanFail
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.EnableEvents = False

    '1) Combined Metrics
    Build_CombinedMetrics_FromFolder folderPath, DEBUG_MODE, logWs

    '2) Simple Compliance
    Build_SimpleCompliance_FromFolder folderPath, logWs

    '2.5) CLEAN Simple Compliance BEFORE summaries
    Clean_Simple_Compliance logWs

    '3) Summaries based on CLEANED Simple Compliance
    Build_AppAndSubdomain_Summaries_FromSimpleCompliance logWs
    Build_ITPolicy_Summary_FromSimpleCompliance logWs

    LogLine logWs, "Run_All_PowerBI_Builds", "OK", "Completed successfully."
    MsgBox "All done ✅" & vbCrLf & _
           "Built: Combined Metrics, Simple Compliance (cleaned)," & vbCrLf & _
           "App-SubDomain Compliance, App Compliance Summary," & vbCrLf & _
           "IT-Policy Compliance Summary.", vbInformation

CleanExit:
    Application.ScreenUpdating = oldSU
    Application.DisplayAlerts = oldDA
    Application.EnableEvents = oldEE
    Exit Sub

CleanFail:
    Dim msg As String
    msg = "Error " & Err.Number & ": " & Err.Description
    LogLine logWs, "Run_All_PowerBI_Builds", "Error", msg
    MsgBox msg, vbCritical, "Macro failed"
    Resume CleanExit
End Sub

'===========================================================
' PART 1: COMBINED METRICS
'===========================================================
Private Sub Build_CombinedMetrics_FromFolder(ByVal folderPath As String, ByVal DEBUG_MODE As Boolean, ByVal logWs As Worksheet)
    Dim metricHeaders As Variant
    metricHeaders = Array( _
        "Access Control", _
        "Configuration Management", _
        "Cryptographic Protection", _
        "Network Security", _
        "Non-Prod Environment Controls", _
        "Protection of Systems and Communications", _
        "Secure Authentication", _
        "System Logging & Monitoring", _
        "System Security Testing", _
        "Vulnerability management & Scanning", _
        "Disaster Recovery" _
    )

    Dim outWs As Worksheet
    Set outWs = GetOrCreateSheet(ThisWorkbook, "Combined Metrics")
    outWs.Cells.Clear

    Dim dbgWs As Worksheet
    If DEBUG_MODE Then
        Set dbgWs = GetOrCreateSheet(ThisWorkbook, "Debug_N_Triggers")
        dbgWs.Cells.Clear
        dbgWs.Range("A1:I1").Value = Array("Source File", "IT Function", "App Name", "Metric", "Trigger Question ID", "Raw Response", "Normalized", "Template Row", "Notes")
        dbgWs.Rows(1).Font.Bold = True
    End If

    outWs.Range("A1:D1").Value = Array("IT Function", "Application/Site Name", "Data Class", "Number of Asset")

    Dim m As Long
    For m = LBound(metricHeaders) To UBound(metricHeaders)
        outWs.Cells(1, 5 + m).Value = metricHeaders(m)
    Next m

    Dim hiddenStartCol As Long
    hiddenStartCol = 5 + (UBound(metricHeaders) + 1)
    outWs.Cells(1, hiddenStartCol).Value = "App ID"
    outWs.Cells(1, hiddenStartCol + 1).Value = "DAI ID"
    outWs.Cells(1, hiddenStartCol + 2).Value = "Source File"

    outWs.Rows(1).Font.Bold = True
    outWs.Columns.NumberFormat = "@"

    Dim fileName As String, fullPath As String
    Dim wb As Workbook, ws As Worksheet
    Dim outRow As Long: outRow = 1

    fileName = Dir(folderPath & "*.xls*")
    Do While Len(fileName) > 0
        fullPath = folderPath & fileName
        If StrComp(fullPath, ThisWorkbook.FullName, vbTextCompare) <> 0 Then
            On Error GoTo FileError

            Set wb = Workbooks.Open(fileName:=fullPath, ReadOnly:=True, UpdateLinks:=False)

            Set ws = GetTemplateSheet(wb)
            If ws Is Nothing Then
                LogLine logWs, fileName, "Skipped", "Template sheet not found."
                GoTo CloseAndNext
            End If

            Dim polSubCol As Long, qidCol As Long, lastRow As Long
            polSubCol = FindHeaderInRow(ws, 3, "Policy Sub-Domain", 1, 20)
            If polSubCol = 0 Then
                LogLine logWs, fileName, "Skipped", "Could not find 'Policy Sub-Domain' in row 3."
                GoTo CloseAndNext
            End If

            qidCol = FindHeaderInRow(ws, 3, "Question ID", 1, 20)
            If qidCol = 0 Then qidCol = FindHeaderInRow(ws, 3, "QuestionID", 1, 20)

            lastRow = ws.Cells(ws.Rows.Count, polSubCol).End(xlUp).Row
            If lastRow < 7 Then
                LogLine logWs, fileName, "Skipped", "No data rows found (expected from row 7)."
                GoTo CloseAndNext
            End If

            Dim firstAppCol As Long, lastAppCol As Long, respCol As Long
            firstAppCol = 8
            lastAppCol = ws.Cells(2, ws.Columns.Count).End(xlToLeft).Column
            If lastAppCol < firstAppCol Then
                LogLine logWs, fileName, "Skipped", "No app columns found."
                GoTo CloseAndNext
            End If

            For respCol = firstAppCol To lastAppCol
                If IsCommentsColumn(ws, respCol) Then GoTo NextApp

                Dim appName As String, itFunc As String, dataClass As String
                Dim appId As String, daiId As String, numAsset As String

                appName = Trim$(ws.Cells(2, respCol).Text)
                If Len(appName) = 0 Then GoTo NextApp

                itFunc = Trim$(ws.Cells(1, respCol).Text)
                dataClass = Trim$(ws.Cells(5, respCol).Text)
                appId = Trim$(ws.Cells(4, respCol).Text)
                daiId = Trim$(ws.Cells(6, respCol).Text)
                numAsset = GetValueForLabel(ws, "Number of Asset", respCol, 1, 40, 8)

                outRow = outRow + 1
                outWs.Cells(outRow, 1).Value = itFunc
                outWs.Cells(outRow, 2).Value = appName
                outWs.Cells(outRow, 3).Value = dataClass
                outWs.Cells(outRow, 4).Value = numAsset

                For m = LBound(metricHeaders) To UBound(metricHeaders)
                    Dim trigQid As String, trigRaw As String, trigNorm As String, trigRow As Long
                    Dim yn As String

                    yn = ComputeMetricYN(ws, 7, lastRow, polSubCol, qidCol, respCol, CStr(metricHeaders(m)), _
                                        trigQid, trigRaw, trigNorm, trigRow)

                    outWs.Cells(outRow, 5 + m).Value = yn

                    If DEBUG_MODE Then
                        If yn = "N" Then
                            LogDebug dbgWs, fileName, itFunc, appName, CStr(metricHeaders(m)), trigQid, trigRaw, trigNorm, trigRow
                        End If
                    End If
                Next m

                outWs.Cells(outRow, hiddenStartCol).Value = appId
                outWs.Cells(outRow, hiddenStartCol + 1).Value = daiId
                outWs.Cells(outRow, hiddenStartCol + 2).Value = fileName

NextApp:
            Next respCol

            LogLine logWs, fileName, "OK", "Combined Metrics updated."

CloseAndNext:
            On Error Resume Next
            wb.Close SaveChanges:=False
            On Error GoTo 0
            Set wb = Nothing
            Set ws = Nothing
        End If

        fileName = Dir()
        DoEvents
    Loop

    ApplyMetricsFormatting outWs, 1, outRow, 5, 5 + UBound(metricHeaders)
    outWs.Columns(hiddenStartCol).Hidden = True
    outWs.Columns(hiddenStartCol + 1).Hidden = True
    outWs.Columns(hiddenStartCol + 2).Hidden = True
    outWs.Columns.AutoFit

    If DEBUG_MODE Then dbgWs.Columns.AutoFit
    Exit Sub

FileError:
    LogLine logWs, fileName, "Error", "Error " & Err.Number & ": " & Err.Description
    On Error Resume Next
    If Not wb Is Nothing Then wb.Close SaveChanges:=False
    On Error GoTo 0
    Resume CloseAndNext
End Sub

Private Function ComputeMetricYN(ByVal ws As Worksheet, ByVal rStart As Long, ByVal rEnd As Long, _
                                 ByVal polSubCol As Long, ByVal qidCol As Long, ByVal respCol As Long, _
                                 ByVal metricName As String, _
                                 ByRef outTriggerQid As String, ByRef outTriggerRaw As String, _
                                 ByRef outTriggerNorm As String, ByRef outTriggerRow As Long) As String
    Dim r As Long, anyY As Boolean
    anyY = False

    outTriggerQid = "": outTriggerRaw = "": outTriggerNorm = "": outTriggerRow = 0

    For r = rStart To rEnd
        If Canonical(ws.Cells(r, polSubCol).Text) = Canonical(metricName) Then
            Dim qid As String, raw As String, yn As String
            qid = IIf(qidCol > 0, Trim$(CStr(ws.Cells(r, qidCol).Text)), "")
            raw = CStr(ws.Cells(r, respCol).Text)

            yn = NormalizeToYN_WithFlip(raw, qid)

            If yn = "N" Then
                outTriggerQid = qid
                outTriggerRaw = Trim$(raw)
                outTriggerNorm = "N"
                outTriggerRow = r
                ComputeMetricYN = "N"
                Exit Function
            ElseIf yn = "Y" Then
                anyY = True
            End If
        End If
    Next r

    If anyY Then
        ComputeMetricYN = "Y"
    Else
        ComputeMetricYN = ""
    End If
End Function

'===========================================================
' PART 2: SIMPLE COMPLIANCE (ROW LEVEL)
'===========================================================
Private Sub Build_SimpleCompliance_FromFolder(ByVal folderPath As String, ByVal logWs As Worksheet)
    Dim outWs As Worksheet
    Set outWs = GetOrCreateSheet(ThisWorkbook, "Simple Compliance")
    outWs.Cells.Clear

    outWs.Range("A1:F1").Value = Array("IT Function", "App Name", "Data Class", "Question ID", "Policy Sub-Domain", "Compliance")
    outWs.Rows(1).Font.Bold = True
    outWs.Columns.NumberFormat = "@"

    Dim outRow As Long: outRow = 1

    Dim fileName As String, fullPath As String
    Dim wb As Workbook, ws As Worksheet

    fileName = Dir(folderPath & "*.xls*")
    Do While Len(fileName) > 0
        fullPath = folderPath & fileName
        If StrComp(fullPath, ThisWorkbook.FullName, vbTextCompare) <> 0 Then
            On Error GoTo FileError

            Set wb = Workbooks.Open(fileName:=fullPath, ReadOnly:=True, UpdateLinks:=False)

            Set ws = GetTemplateSheet(wb)
            If ws Is Nothing Then
                LogLine logWs, fileName, "Skipped", "Template sheet not found."
                GoTo CloseAndNext
            End If

            Dim qidCol As Long, polSubCol As Long, lastRow As Long
            qidCol = FindHeaderInRow(ws, 3, "Question ID", 1, 20)
            If qidCol = 0 Then qidCol = FindHeaderInRow(ws, 3, "QuestionID", 1, 20)
            polSubCol = FindHeaderInRow(ws, 3, "Policy Sub-Domain", 1, 20)

            If qidCol = 0 Then
                LogLine logWs, fileName, "Skipped", "Could not find 'Question ID' in row 3."
                GoTo CloseAndNext
            End If

            lastRow = ws.Cells(ws.Rows.Count, qidCol).End(xlUp).Row
            If lastRow < 7 Then
                LogLine logWs, fileName, "Skipped", "No data rows found (expected from row 7)."
                GoTo CloseAndNext
            End If

            Dim lastAppCol As Long, appCol As Long, r As Long
            lastAppCol = ws.Cells(2, ws.Columns.Count).End(xlToLeft).Column

            Dim firstAppCol As Long
            firstAppCol = 9
            If lastAppCol < firstAppCol Then firstAppCol = 8

            If lastAppCol < firstAppCol Then
                LogLine logWs, fileName, "Skipped", "No app columns found."
                GoTo CloseAndNext
            End If

            For appCol = firstAppCol To lastAppCol
                Dim itFunc As String, appName As String, dataClass As String
                itFunc = Trim$(ws.Cells(1, appCol).Text)
                appName = Trim$(ws.Cells(2, appCol).Text)
                dataClass = Trim$(ws.Cells(5, appCol).Text)

                If Len(appName) = 0 Then GoTo NextApp

                For r = 7 To lastRow
                    Dim qid As String, polSub As String, raw As String, comp As String
                    qid = Trim$(ws.Cells(r, qidCol).Text)
                    If Len(qid) = 0 Then GoTo NextRow

                    polSub = IIf(polSubCol > 0, Trim$(ws.Cells(r, polSubCol).Text), "")
                    raw = Trim$(ws.Cells(r, appCol).Text)
                    comp = Normalize_YNRNA_to_Y_BlankToN(raw, qid)

                    outRow = outRow + 1
                    outWs.Cells(outRow, 1).Value = itFunc
                    outWs.Cells(outRow, 2).Value = appName
                    outWs.Cells(outRow, 3).Value = dataClass
                    outWs.Cells(outRow, 4).Value = qid
                    outWs.Cells(outRow, 5).Value = polSub
                    outWs.Cells(outRow, 6).Value = comp
NextRow:
                Next r
NextApp:
            Next appCol

            LogLine logWs, fileName, "OK", "Simple Compliance updated."

CloseAndNext:
            On Error Resume Next
            wb.Close SaveChanges:=False
            On Error GoTo 0
            Set wb = Nothing
            Set ws = Nothing
        End If

        fileName = Dir()
        DoEvents
    Loop

    outWs.Columns.AutoFit
    Exit Sub

FileError:
    LogLine logWs, fileName, "Error", "Error " & Err.Number & ": " & Err.Description
    On Error Resume Next
    If Not wb Is Nothing Then wb.Close SaveChanges:=False
    On Error GoTo 0
    Resume CloseAndNext
End Sub

'===========================================================
' NEW STEP: CLEAN SIMPLE COMPLIANCE BEFORE SUMMARIES
' Deletes rows where:
'  - Question ID contains "row" (3.Row.14A etc.)
'  - Data Class blank
'  - Policy Sub-Domain blank
'===========================================================
Private Sub Clean_Simple_Compliance(ByVal logWs As Worksheet)
    On Error GoTo Fail

    Dim ws As Worksheet
    Set ws = ThisWorkbook.Worksheets("Simple Compliance")

    Dim lastRow As Long
    lastRow = ws.Cells(ws.Rows.Count, "A").End(xlUp).Row
    If lastRow < 2 Then
        LogLine logWs, "Clean_Simple_Compliance", "Skipped", "No rows to clean."
        Exit Sub
    End If

    Dim r As Long, removed As Long
    removed = 0

    For r = lastRow To 2 Step -1
        Dim dataClass As String, qid As String, polSub As String
        dataClass = Trim$(CStr(ws.Cells(r, 3).Value))
        qid = Trim$(CStr(ws.Cells(r, 4).Value))
        polSub = Trim$(CStr(ws.Cells(r, 5).Value))

        If InStr(1, LCase$(qid), "row", vbTextCompare) > 0 Then
            ws.Rows(r).Delete
            removed = removed + 1
            GoTo NextR
        End If

        If Len(dataClass) = 0 Then
            ws.Rows(r).Delete
            removed = removed + 1
            GoTo NextR
        End If

        If Len(polSub) = 0 Then
            ws.Rows(r).Delete
            removed = removed + 1
            GoTo NextR
        End If

NextR:
    Next r

    LogLine logWs, "Clean_Simple_Compliance", "OK", "Removed rows: " & removed
    Exit Sub

Fail:
    LogLine logWs, "Clean_Simple_Compliance", "Error", "Error " & Err.Number & ": " & Err.Description
End Sub

'===========================================================
' PART 3: APP + SUBDOMAIN & APP SUMMARY (FROM CLEAN SIMPLE COMPLIANCE)
'===========================================================
Private Sub Build_AppAndSubdomain_Summaries_FromSimpleCompliance(ByVal logWs As Worksheet)
    On Error GoTo Fail

    Dim wsSrc As Worksheet
    Set wsSrc = ThisWorkbook.Worksheets("Simple Compliance")

    Dim wsOut1 As Worksheet, wsOut2 As Worksheet
    Set wsOut1 = GetOrCreateSheet(ThisWorkbook, "App-SubDomain Compliance")
    Set wsOut2 = GetOrCreateSheet(ThisWorkbook, "App Compliance Summary")
    wsOut1.Cells.Clear
    wsOut2.Cells.Clear

    Dim lastRow As Long
    lastRow = wsSrc.Cells(wsSrc.Rows.Count, "B").End(xlUp).Row
    If lastRow < 2 Then
        LogLine logWs, "Build_AppAndSubdomain_Summaries", "Skipped", "No data in Simple Compliance."
        Exit Sub
    End If

    'Now group by: IT Function + App Name + Policy Sub-Domain
    Dim dictY_AppSub As Object, dictN_AppSub As Object
    Dim dictY_App As Object, dictN_App As Object
    Set dictY_AppSub = CreateObject("Scripting.Dictionary")
    Set dictN_AppSub = CreateObject("Scripting.Dictionary")
    Set dictY_App = CreateObject("Scripting.Dictionary")
    Set dictN_App = CreateObject("Scripting.Dictionary")

    Dim r As Long
    For r = 2 To lastRow
        Dim itFunc As String, appName As String, subD As String, v As String
        itFunc = Trim$(CStr(wsSrc.Cells(r, 1).Value)) 'IT Function
        appName = Trim$(CStr(wsSrc.Cells(r, 2).Value)) 'App Name
        subD = Trim$(CStr(wsSrc.Cells(r, 5).Value))    'Policy Sub-Domain
        v = UCase$(Trim$(CStr(wsSrc.Cells(r, 6).Value))) 'Compliance (Y/N)

        If Len(itFunc) = 0 Or Len(appName) = 0 Or Len(subD) = 0 Then GoTo NextR
        If v <> "Y" And v <> "N" Then GoTo NextR

        'App-only summary still by App Name (unchanged)
        If Not dictY_App.Exists(appName) Then
            dictY_App(appName) = 0
            dictN_App(appName) = 0
        End If
        If v = "Y" Then
            dictY_App(appName) = CLng(dictY_App(appName)) + 1
        Else
            dictN_App(appName) = CLng(dictN_App(appName)) + 1
        End If

        'App-SubDomain now keyed by IT Function + App Name + SubDomain
        Dim key As String
        key = itFunc & "||" & appName & "||" & subD

        If Not dictY_AppSub.Exists(key) Then
            dictY_AppSub(key) = 0
            dictN_AppSub(key) = 0
        End If

        If v = "Y" Then
            dictY_AppSub(key) = CLng(dictY_AppSub(key)) + 1
        Else
            dictN_AppSub(key) = CLng(dictN_AppSub(key)) + 1
        End If

NextR:
    Next r

    'Output App-SubDomain Compliance with IT Function first
    wsOut1.Range("A1:G1").Value = Array("IT Function", "App Name", "Policy Sub-Domain", "Total Y", "Total N", "Total Answered", "Compliance %")
    wsOut1.Rows(1).Font.Bold = True

    Dim outRow As Long: outRow = 2
    Dim k As Variant, parts() As String
    For Each k In dictY_AppSub.Keys
        parts = Split(CStr(k), "||")

        Dim yCnt As Long, nCnt As Long, total As Long
        yCnt = CLng(dictY_AppSub(k))
        nCnt = CLng(dictN_AppSub(k))
        total = yCnt + nCnt

        wsOut1.Cells(outRow, 1).Value = parts(0) 'IT Function
        wsOut1.Cells(outRow, 2).Value = parts(1) 'App Name
        wsOut1.Cells(outRow, 3).Value = parts(2) 'Policy Sub-Domain
        wsOut1.Cells(outRow, 4).Value = yCnt
        wsOut1.Cells(outRow, 5).Value = nCnt
        wsOut1.Cells(outRow, 6).Value = total
        wsOut1.Cells(outRow, 7).Value = IIf(total > 0, yCnt / total, 0)

        outRow = outRow + 1
    Next k

    wsOut1.Columns("A:G").AutoFit
    wsOut1.Columns("G").NumberFormat = "0.00%"

    'Optional: sort for readability (IT Function, App, SubDomain)
    With wsOut1.Sort
        .SortFields.Clear
        .SortFields.Add Key:=wsOut1.Range("A2:A" & outRow - 1), Order:=xlAscending
        .SortFields.Add Key:=wsOut1.Range("B2:B" & outRow - 1), Order:=xlAscending
        .SortFields.Add Key:=wsOut1.Range("C2:C" & outRow - 1), Order:=xlAscending
        .SetRange wsOut1.Range("A1:G" & outRow - 1)
        .Header = xlYes
        .Apply
    End With

    'App-only summary (unchanged)
    wsOut2.Range("A1:E1").Value = Array("App Name", "Total Y", "Total N", "Total Answered", "Compliance %")
    wsOut2.Rows(1).Font.Bold = True

    outRow = 2
    For Each k In dictY_App.Keys
        Dim yA As Long, nA As Long, tA As Long
        yA = CLng(dictY_App(k))
        nA = CLng(dictN_App(k))
        tA = yA + nA

        wsOut2.Cells(outRow, 1).Value = CStr(k)
        wsOut2.Cells(outRow, 2).Value = yA
        wsOut2.Cells(outRow, 3).Value = nA
        wsOut2.Cells(outRow, 4).Value = tA
        wsOut2.Cells(outRow, 5).Value = IIf(tA > 0, yA / tA, 0)

        outRow = outRow + 1
    Next k

    wsOut2.Columns("A:E").AutoFit
    wsOut2.Columns("E").NumberFormat = "0.00%"

    LogLine logWs, "Build_AppAndSubdomain_Summaries", "OK", "App-SubDomain now includes IT Function."
    Exit Sub

Fail:
    LogLine logWs, "Build_AppAndSubdomain_Summaries", "Error", "Error " & Err.Number & ": " & Err.Description
End Sub

'===========================================================
' PART 4: IT FUNCTION + POLICY SUBDOMAIN SUMMARY
'===========================================================
Private Sub Build_ITPolicy_Summary_FromSimpleCompliance(ByVal logWs As Worksheet)
    On Error GoTo Fail

    Dim wsSrc As Worksheet
    Set wsSrc = ThisWorkbook.Worksheets("Simple Compliance")

    Dim wsOut As Worksheet
    Set wsOut = GetOrCreateSheet(ThisWorkbook, "IT-Policy Compliance Summary")
    wsOut.Cells.Clear

    wsOut.Range("A1:F1").Value = Array("IT Function", "Policy Sub-Domain", "Total Y", "Total N", "Total Answered", "Compliance %")
    wsOut.Rows(1).Font.Bold = True

    Dim lastRow As Long
    lastRow = wsSrc.Cells(wsSrc.Rows.Count, "A").End(xlUp).Row
    If lastRow < 2 Then
        LogLine logWs, "Build_ITPolicy_Summary", "Skipped", "No data in Simple Compliance."
        Exit Sub
    End If

    Dim dictY As Object, dictN As Object, dictAll As Object
    Set dictY = CreateObject("Scripting.Dictionary")
    Set dictN = CreateObject("Scripting.Dictionary")
    Set dictAll = CreateObject("Scripting.Dictionary")

    Dim r As Long
    For r = 2 To lastRow
        Dim itFunc As String, pol As String, comp As String
        itFunc = Trim$(CStr(wsSrc.Cells(r, 1).Value))
        pol = Trim$(CStr(wsSrc.Cells(r, 5).Value))
        comp = UCase$(Trim$(CStr(wsSrc.Cells(r, 6).Value)))

        If Len(itFunc) = 0 Or Len(pol) = 0 Then GoTo NextR
        If comp <> "Y" And comp <> "N" Then GoTo NextR

        Dim key As String
        key = itFunc & "||" & pol
        dictAll(key) = True

        If comp = "Y" Then
            dictY(key) = NzLong(dictY, key) + 1
        Else
            dictN(key) = NzLong(dictN, key) + 1
        End If
NextR:
    Next r

    Dim outRow As Long: outRow = 2
    Dim k As Variant, parts() As String
    For Each k In dictAll.Keys
        parts = Split(CStr(k), "||")
        Dim yCnt As Long, nCnt As Long, total As Long
        yCnt = NzLong(dictY, k)
        nCnt = NzLong(dictN, k)
        total = yCnt + nCnt

        wsOut.Cells(outRow, 1).Value = parts(0)
        wsOut.Cells(outRow, 2).Value = parts(1)
        wsOut.Cells(outRow, 3).Value = yCnt
        wsOut.Cells(outRow, 4).Value = nCnt
        wsOut.Cells(outRow, 5).Value = total
        wsOut.Cells(outRow, 6).Value = IIf(total > 0, yCnt / total, 0)

        outRow = outRow + 1
    Next k

    wsOut.Columns("A:F").AutoFit
    wsOut.Columns("F").NumberFormat = "0.00%"
    LogLine logWs, "Build_ITPolicy_Summary", "OK", "IT-Policy summary generated."
    Exit Sub

Fail:
    LogLine logWs, "Build_ITPolicy_Summary", "Error", "Error " & Err.Number & ": " & Err.Description
End Sub

'===========================================================
' NORMALIZATION RULES
' - Treat NA/NR as Y
' - Treat blank / Not Answered as N
' - Flip for SA.010.033 and SA.010.028
'===========================================================
Private Function NormalizeToYN_WithFlip(ByVal raw As String, Optional ByVal questionId As String = "") As String
    Dim s As String
    s = LCase$(Trim$(CStr(raw)))
    s = Replace(s, vbCr, "")
    s = Replace(s, vbLf, "")
    s = Replace(s, " ", "")

    If Len(s) = 0 Then NormalizeToYN_WithFlip = "N": Exit Function
    If s = "notanswered" Or s = "notanswer" Then NormalizeToYN_WithFlip = "N": Exit Function

    If s = "na" Or s = "n/a" Or s = "n-a" Then NormalizeToYN_WithFlip = "Y": Exit Function
    If s = "nr" Or s = "n/r" Or s = "n-r" Then NormalizeToYN_WithFlip = "Y": Exit Function

    Dim q As String
    q = Canonical(questionId)

    Dim isFlip As Boolean
    isFlip = (q = "sa010033" Or q = "sa010028")

    If s = "y" Or s = "yes" Then
        NormalizeToYN_WithFlip = IIf(isFlip, "N", "Y")
        Exit Function
    End If

    If s = "n" Or s = "no" Then
        NormalizeToYN_WithFlip = IIf(isFlip, "Y", "N")
        Exit Function
    End If

    NormalizeToYN_WithFlip = "N"
End Function

Private Function Normalize_YNRNA_to_Y_BlankToN(ByVal raw As String, Optional ByVal questionId As String = "") As String
    Normalize_YNRNA_to_Y_BlankToN = NormalizeToYN_WithFlip(raw, questionId)
End Function

