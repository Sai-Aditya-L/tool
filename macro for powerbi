' TEMPLATE SHEET PICKER
'===========================================================
Private Function GetTemplateSheet(ByVal wb As Workbook) As Worksheet
    Dim tryNames As Variant
    tryNames = Array( _
        "OutputTemplate- Power BI Upload", _
        "OutputTemplate-Power BI Upload", _
        "OutputTemplate - Power BI Upload" _
    )

    Dim i As Long
    For i = LBound(tryNames) To UBound(tryNames)
        On Error Resume Next
        Set GetTemplateSheet = wb.Worksheets(CStr(tryNames(i)))
        On Error GoTo 0
        If Not GetTemplateSheet Is Nothing Then Exit Function
    Next i

    Dim ws As Worksheet
    For Each ws In wb.Worksheets
        If FindHeaderInRow(ws, 3, "Policy Sub-Domain", 1, 25) > 0 Then
            Set GetTemplateSheet = ws
            Exit Function
        End If
    Next ws

    Set GetTemplateSheet = Nothing
End Function

'===========================================================
' DEBUG LOGGING
'===========================================================
Private Sub LogDebug(ByVal dbgWs As Worksheet, ByVal sourceFile As String, ByVal itFunc As String, _
                    ByVal appName As String, ByVal metricName As String, ByVal trigQid As String, _
                    ByVal rawResp As String, ByVal norm As String, ByVal templateRow As Long)
    Dim lr As Long
    lr = dbgWs.Cells(dbgWs.Rows.Count, "A").End(xlUp).Row + 1
    dbgWs.Cells(lr, 1).Value = sourceFile
    dbgWs.Cells(lr, 2).Value = itFunc
    dbgWs.Cells(lr, 3).Value = appName
    dbgWs.Cells(lr, 4).Value = metricName
    dbgWs.Cells(lr, 5).Value = trigQid
    dbgWs.Cells(lr, 6).Value = rawResp
    dbgWs.Cells(lr, 7).Value = norm
    dbgWs.Cells(lr, 8).Value = templateRow
    dbgWs.Cells(lr, 9).Value = IIf(Len(trigQid) = 0, "Question ID column not found", "")
End Sub

'===========================================================
' FORMATTING
'===========================================================
Private Sub ApplyMetricsFormatting(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal lastDataRow As Long, _
                                  ByVal metricsStartCol As Long, ByVal metricsEndCol As Long)
    If lastDataRow < headerRow + 1 Then Exit Sub

    With ws.Range(ws.Cells(headerRow, 1), ws.Cells(headerRow, metricsEndCol))
        .Interior.Color = RGB(0, 51, 102)
        .Font.Color = RGB(255, 255, 255)
        .Font.Bold = True
        .HorizontalAlignment = xlCenter
    End With

    Dim rng As Range
    Set rng = ws.Range(ws.Cells(headerRow + 1, metricsStartCol), ws.Cells(lastDataRow, metricsEndCol))
    rng.FormatConditions.Delete
    rng.HorizontalAlignment = xlCenter

    With rng.FormatConditions.Add(Type:=xlCellValue, Operator:=xlEqual, Formula1:="=""Y""")
        .Interior.Color = RGB(0, 176, 80)
        .Font.Color = RGB(255, 255, 255)
        .Font.Bold = True
    End With

    With rng.FormatConditions.Add(Type:=xlCellValue, Operator:=xlEqual, Formula1:="=""N""")
        .Interior.Color = RGB(255, 255, 255)
        .Font.Color = RGB(0, 0, 0)
        .Font.Bold = True
    End With

    ws.Range(ws.Cells(headerRow, 1), ws.Cells(lastDataRow, metricsEndCol)).Borders.LineStyle = xlContinuous
End Sub

