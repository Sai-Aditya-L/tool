Private Function PickFolderSafe() As String
    On Error GoTo Fallback
    Dim fd As FileDialog
    Set fd = Application.FileDialog(msoFileDialogFolderPicker)
    fd.Title = "Select folder containing the assessment Excel files"
    If fd.Show = -1 Then
        PickFolderSafe = fd.SelectedItems(1)
    Else
        PickFolderSafe = ""
    End If
    Exit Function
Fallback:
    PickFolderSafe = InputBox("Paste the full folder path:", "Folder Path")
End Function

Private Function GetOrCreateSheet(ByVal wb As Workbook, ByVal sheetName As String) As Worksheet
    On Error Resume Next
    Set GetOrCreateSheet = wb.Worksheets(sheetName)
    On Error GoTo 0
    If GetOrCreateSheet Is Nothing Then
        Set GetOrCreateSheet = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))
        GetOrCreateSheet.Name = sheetName
    End If
End Function

Private Sub EnsureLogHeader(ByVal logWs As Worksheet)
    If Len(Trim$(CStr(logWs.Cells(1, 1).Value))) = 0 Then
        logWs.Range("A1:C1").Value = Array("File/Proc", "Status", "Notes")
        logWs.Rows(1).Font.Bold = True
    End If
End Sub

Private Sub LogLine(ByVal logWs As Worksheet, ByVal fileOrProc As String, ByVal status As String, ByVal notes As String)
    Dim lr As Long
    lr = logWs.Cells(logWs.Rows.Count, "A").End(xlUp).Row + 1
    logWs.Cells(lr, 1).Value = fileOrProc
    logWs.Cells(lr, 2).Value = status
    logWs.Cells(lr, 3).Value = notes
End Sub

Private Function FindHeaderInRow(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal headerText As String, _
                                 ByVal startCol As Long, ByVal endCol As Long) As Long
    Dim c As Long
    For c = startCol To endCol
        If Canonical(ws.Cells(headerRow, c).Text) = Canonical(headerText) Then
            FindHeaderInRow = c
            Exit Function
        End If
    Next c
    FindHeaderInRow = 0
End Function

Private Function Canonical(ByVal s As String) As String
    Dim i As Long, ch As String, out As String
    s = LCase$(Trim$(CStr(s)))
    out = ""
    For i = 1 To Len(s)
        ch = Mid$(s, i, 1)
        If (ch >= "a" And ch <= "z") Or (ch >= "0" And ch <= "9") Then out = out & ch
    Next i
    Canonical = out
End Function

Private Function IsCommentsColumn(ByVal ws As Worksheet, ByVal col As Long) As Boolean
    IsCommentsColumn = (InStr(1, Canonical(ws.Cells(3, col).Text), "comments", vbTextCompare) > 0)
End Function

Private Function GetValueForLabel(ByVal ws As Worksheet, ByVal labelText As String, ByVal appCol As Long, _
                                  ByVal rowStart As Long, ByVal rowEnd As Long, ByVal labelCol As Long) As String
    Dim r As Long
    For r = rowStart To rowEnd
        If Canonical(ws.Cells(r, labelCol).Text) = Canonical(labelText) Then
            GetValueForLabel = Trim$(ws.Cells(r, appCol).Text)
            Exit Function
        End If
    Next r
    GetValueForLabel = ""
End Function

Private Function NzLong(ByVal dict As Object, ByVal key As Variant) As Long
    If dict Is Nothing Then
        NzLong = 0
    ElseIf dict.Exists(key) Then
        NzLong = CLng(dict(key))
    Else
        NzLong = 0
    End If
End Function